static func get_mission(mission_id: String) -> Dictionary:
	return MISSIONS.get(mission_id, {}).duplicate(true)

static func exists(mission_id: String) -> bool:
	return MISSIONS.has(mission_id)

## Cadeia da história (ignora o template repetível). Ordenada por sequence.
static func chapter_chain(chapter_id: String) -> Array:
	var out: Array = []
	for mid in MISSIONS:
		var m: Dictionary = MISSIONS[mid]
		if str(m.get("chapter_id", "")) == chapter_id and not bool(m.get("repeatable", false)):
			out.append(mid)
	out.sort_custom(func(a, b): return int(MISSIONS[a]["sequence"]) < int(MISSIONS[b]["sequence"]))
	return out

## Alvo efetivo de conclusão (o repetível aceita 100/300/500; as demais usam required_count fixo).
static func effective_required(mission_id: String, chosen_count: int = -1) -> int:
	var m: Dictionary = MISSIONS.get(mission_id, {})
	if bool(m.get("repeatable", false)) and chosen_count > 0 and (m.get("available_counts", []) as Array).has(chosen_count):
		return chosen_count
	return int(m.get("required_count", 1))
