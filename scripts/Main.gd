	var back := Polygon2D.new(); back.polygon = PackedVector2Array([pos + Vector2(-44, 18), pos + Vector2(-26, -20), pos + Vector2(14, -28), pos + Vector2(40, -6), pos + Vector2(30, 22)]); back.color = Color("1e2636"); back.z_index = int(pos.y) - 2; _region_node.add_child(back)
	_cath_crystal(pos + Vector2(-18, 14), 72.0, Color(0.44, 0.70, 0.92, 0.7))
	_cath_crystal(pos + Vector2(6, 16), 88.0, Color(0.48, 0.74, 0.95, 0.72))
	_cath_crystal(pos + Vector2(26, 12), 60.0, Color(0.52, 0.78, 0.96, 0.7))

## ★★ AS FENDAS PROFUNDAS (BUILD_FENDAS_PROFUNDAS_F5) — L4 "o Silêncio": o NEGATIVO da Caverna, abaixo do Coração, onde
## o cristal e a memória acabam. Identidade por AUSÊNCIA: rocha nua/preta, escuro, fendas sem fundo, ZERO cristal/brilho/
## cor/movimento (só o respiro do que dorme). ZERO combate (o vazio é DELIBERADO — o conteúdo é o Silêncio). Pequena
## (1400x1100), grande de significado. 3 faixas N→S: BOCA (você desceu o poço) → CORREDOR-FENDA (estreito, sem fundo aos
## lados) → CÂMARA DO SILÊNCIO (as insinuações de O Que Dorme no Fundo: pegadas impossíveis, rachaduras anormais, a
## silhueta que respira — NÃO se alcança, NÃO se luta). Props procedurais via _fendas_*. SEM save/sistema/loot/NPC/boss.
func _build_fendas(size: Vector2) -> void:
	_current_boss = null
	_boss_name = ""
	# volta → a Catedral (sobe o poço; emerge na varanda = SEM combate instantâneo com o Coração)
	_build_portal(FENDAS_TO_CATHEDRAL, "cathedral_of_crystal", "↑ subir → a Catedral", true, CATHEDRAL_SPAWN)
	# escuridão extra ao sul (o fundo é o mais preto; o caminho some no escuro)
	_fendas_dark_overlay(size)

	# ════════ BOCA (norte) — você desceu o poço atrás do Coração; o cristal ficou para trás ════════
	for i in range(5):
		var st := ColorRect.new(); st.color = Color(0.05, 0.05, 0.07, 0.55 - 0.08 * float(i)); st.size = Vector2(150.0, 14.0); st.position = Vector2(625.0, 108.0 + float(i) * 13.0); st.z_index = -15; _region_node.add_child(st)
	_fendas_lone_light(Vector2(700.0, 210.0))   # a ÚNICA luz aqui é a SUA — fraca, cinza, sem cor de cristal
	_maw_marker(Vector2(700.0, 280.0), "fendas_top", "✦ [E] o fim do cristal", [
		"O poço atrás do Coração desce até onde o cristal não chega mais. A parede vira só rocha — preta, seca, rachada.",
		"Sem brilho, sem zumbido, sem aquela luz fria presa na pedra. A Memória Petrificada ficou lá em cima. Isto é o que havia ANTES dela: nada.",
	])

	# ════════ CORREDOR-FENDA (meio) — estreito e torto entre rocha nua, fendas SEM FUNDO aos lados ════════
	_fendas_rock_wall(Rect2(120.0, 320.0, 380.0, 40.0)); _fendas_rock_wall(Rect2(900.0, 320.0, 380.0, 40.0))   # estreitamento (deixa o vão central)
	_fendas_rock_wall(Rect2(120.0, 360.0, 40.0, 380.0)); _fendas_rock_wall(Rect2(1240.0, 360.0, 40.0, 380.0))  # paredes laterais
	_fendas_void(Rect2(170.0, 420.0, 210.0, 170.0)); _fendas_void(Rect2(1020.0, 440.0, 210.0, 160.0))          # fendas sem fundo (laterais)
	_fendas_crack(Vector2(520.0, 400.0), Vector2(640.0, 560.0)); _fendas_crack(Vector2(880.0, 420.0), Vector2(760.0, 580.0))

	# ════════ CÂMARA DO SILÊNCIO (fundo/sul) — onde as insinuações de O Que Dorme no Fundo se juntam ════════
	_fendas_rock_wall(Rect2(120.0, 898.0, 1160.0, 44.0))   # a BORDA da grande fenda (blocker = você PARA aqui, no brinque)
	_fendas_void(Rect2(120.0, 940.0, 1160.0, 160.0))       # a grande fenda sem fundo ao sul (o limite — não se passa)
	# pegadas IMPOSSÍVEIS: trilha grande demais, vinda do oeste, que some na fenda
	for fp in [Vector2(360.0, 720.0), Vector2(452.0, 778.0), Vector2(556.0, 826.0), Vector2(662.0, 862.0)]:
		_fendas_footprint(fp)
	_maw_marker(Vector2(556.0, 760.0), "fendas_steps", "✦ [E] as pegadas", [
		"Pegadas na rocha. Grandes demais — cada uma maior que você inteiro, fundas como se a pedra fosse barro fresco.",
		"Vêm do escuro a oeste e seguem até a beira da fenda. Ali param. O que andou aqui desceu — e não voltou pelo mesmo caminho.",
	])
	# rachaduras ANORMAIS irradiando de um ponto (como se algo enorme tivesse empurrado de baixo)
	for ai in range(7):
		var ang := -0.5 + float(ai) * 0.62
		_fendas_crack(Vector2(700.0, 980.0), Vector2(700.0, 980.0) + Vector2(cos(ang), sin(ang)) * 120.0)
	# ★ O QUE DORME NO FUNDO — só INSINUADO: silhueta vasta no escuro além da fenda, que RESPIRA devagar (não se alcança)
	_fendas_sleeper_shadow(Vector2(700.0, 1046.0))
	_maw_marker(Vector2(700.0, 876.0), "fendas_sleeper", "✦ [E] algo lá embaixo", [
		"Além da fenda, no fundo do fundo, o escuro tem uma FORMA. Vasta. Não se mexe — mas sobe e desce, devagar, como um peito.",
		"Você não consegue ver o que é, e algo em você agradece por isso. Não há caminho até lá. Ainda bem.",
		"O Silêncio aqui não é falta de som — é a presença DISSO. Tão grande e tão velho que nada ao redor ousa fazer barulho.",
	])

## overlay de escuridão das Fendas (vinheta densa pro preto; o fundo/sul é o mais negro). z baixo (acima do chão, abaixo
## das entidades) — não cobre o jogador, só "apaga" a periferia e o fundo.
func _fendas_dark_overlay(size: Vector2) -> void:
	var south := ColorRect.new(); south.color = Color(0.0, 0.0, 0.0, 0.34); south.size = Vector2(size.x, 320.0); south.position = Vector2(0.0, size.y - 320.0); south.z_index = -13; _region_node.add_child(south)
	var deeper := ColorRect.new(); deeper.color = Color(0.0, 0.0, 0.0, 0.5); deeper.size = Vector2(size.x, 150.0); deeper.position = Vector2(0.0, size.y - 150.0); deeper.z_index = -13; _region_node.add_child(deeper)

## a SUA luz (a única): disco cinza FRACO no chão (sem cor de cristal). Estático (sem pulsar = sem movimento).
func _fendas_lone_light(pos: Vector2) -> void:
	var poly := Polygon2D.new(); var pts := PackedVector2Array()
	for i in range(20):
		var a := TAU * float(i) / 20.0
		pts.append(Vector2(cos(a) * 70.0, sin(a) * 70.0 * 0.5))
	poly.polygon = pts; poly.position = pos; poly.color = Color(0.22, 0.23, 0.27, 0.10); poly.z_index = -14; _region_node.add_child(poly)

## parede de ROCHA NUA (blocker): cinza-escuro morto + trincas. Sem brilho/cor. z por base.
func _fendas_rock_wall(rect: Rect2) -> void:
	var z := int(rect.position.y + rect.size.y)
	var body := ColorRect.new(); body.color = Color("16161b"); body.size = rect.size; body.position = rect.position; body.z_index = z; _region_node.add_child(body)
	var edge := ColorRect.new(); edge.color = Color(0.0, 0.0, 0.0, 0.4); edge.size = Vector2(rect.size.x, 4.0); edge.position = rect.position; edge.z_index = z; _region_node.add_child(edge)
	var n := int(maxf(rect.size.x, rect.size.y) / 90.0) + 1
	for i in range(n):
		var t := (float(i) + 0.5) / float(n)
		var cr := Line2D.new()
		if rect.size.y >= rect.size.x: cr.points = PackedVector2Array([rect.position + Vector2(2.0, rect.size.y * t), rect.position + Vector2(rect.size.x - 2.0, rect.size.y * t + 12.0)])
		else: cr.points = PackedVector2Array([rect.position + Vector2(rect.size.x * t, 2.0), rect.position + Vector2(rect.size.x * t + 12.0, rect.size.y - 2.0)])
		cr.width = 1.5; cr.default_color = Color(0.0, 0.0, 0.0, 0.5); cr.z_index = z; _region_node.add_child(cr)
	_add_blocker(rect)

## fenda SEM FUNDO (blocker — não se entra): polígono PRETO + um fino rebordo (a beira). Lê como abismo, não parede.
func _fendas_void(rect: Rect2) -> void:
	# CATHEDRAL_CLEANUP_PACK_04: fenda sem fundo com void_crack (alpha real → bordas SUAVES, esticado ao rect) se
	# existir; senão o ColorRect preto + rebordo (fallback, borda dura). O blocker é o mesmo nos dois.
	var vtex := _try_load_tex("res://assets/tilesets/fendas/props/void_crack.png")
	if vtex != null:
		var tr := TextureRect.new(); tr.texture = vtex; tr.stretch_mode = TextureRect.STRETCH_SCALE
		tr.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
		tr.size = rect.size; tr.position = rect.position; tr.z_index = -12
		tr.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_region_node.add_child(tr)
	else:
		var v := ColorRect.new(); v.color = Color(0.0, 0.0, 0.0, 1.0); v.size = rect.size; v.position = rect.position; v.z_index = -12; _region_node.add_child(v)
		var rim := ColorRect.new(); rim.color = Color(0.10, 0.10, 0.13, 0.7); rim.size = Vector2(rect.size.x, 3.0); rim.position = rect.position + Vector2(0.0, -3.0); rim.z_index = -11; _region_node.add_child(rim)
	_add_blocker(rect)

## trinca escura no chão (deco, sem blocker): linha preta irregular.
func _fendas_crack(p1: Vector2, p2: Vector2) -> void:
	var mid := p1.lerp(p2, 0.5) + Vector2(8.0, -6.0)
	var ln := Line2D.new(); ln.points = PackedVector2Array([p1, mid, p2]); ln.width = 2.0; ln.default_color = Color(0.0, 0.0, 0.0, 0.6); ln.z_index = -13; _region_node.add_child(ln)

## pegada IMPOSSÍVEL (deco): mancha escura grande (maior que o herói), com um rebordo fundo. SEM blocker.
func _fendas_footprint(pos: Vector2) -> void:
	# CATHEDRAL_CLEANUP_PACK_04: pegada impossível como 1 sprite se existir; senão a mancha + dedos Polygon2D (fallback).
	var fp_tex := _try_load_tex("res://assets/tilesets/fendas/props/giant_footprint.png")
	if fp_tex != null:
		var s := Sprite2D.new(); s.texture = fp_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.position = pos; s.z_index = -12; _region_node.add_child(s)
		return
	var ft := Polygon2D.new(); var pts := PackedVector2Array()
	for i in range(14):
		var a := TAU * float(i) / 14.0
		pts.append(Vector2(cos(a) * 34.0, sin(a) * 50.0))
	ft.polygon = pts; ft.position = pos; ft.color = Color(0.03, 0.03, 0.04, 0.85); ft.z_index = -12; _region_node.add_child(ft)
	var toes := Polygon2D.new(); toes.polygon = PackedVector2Array([pos + Vector2(-22, -46), pos + Vector2(-8, -60), pos + Vector2(8, -60), pos + Vector2(22, -46)]); toes.color = Color(0.02, 0.02, 0.03, 0.85); toes.z_index = -12; _region_node.add_child(toes)

## ★ O QUE DORME NO FUNDO — só a INSINUAÇÃO: silhueta vasta e baixa no escuro além da fenda, que RESPIRA devagar (a
## ÚNICA coisa que se move nas Fendas = o pavor). NÃO é mob, NÃO se alcança, NÃO se luta. z baixo (lá no fundo).
func _fendas_sleeper_shadow(pos: Vector2) -> void:
	# SILHUETA de O Que Dorme (LANDMARKS_PACK_02): sprite real se existir; senão o Polygon2D (fallback). Indefinida de
	# propósito — a arte é massa quase-negra, sem rosto. O respiro (tween) segue por CÓDIGO sobre o nó que for.
	var node: Node2D
	var sleep_tex := _try_load_tex("res://assets/tilesets/fendas/props/fendas_sleeper.png")
	if sleep_tex != null:
		var sp := Sprite2D.new(); sp.texture = sleep_tex; sp.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		sp.position = pos; sp.z_index = -12; _region_node.add_child(sp); node = sp
	else:
		var sil := Polygon2D.new()
		sil.polygon = PackedVector2Array([pos + Vector2(-260, 60), pos + Vector2(-150, -10), pos + Vector2(-40, -34), pos + Vector2(60, -30), pos + Vector2(180, -6), pos + Vector2(280, 56), pos + Vector2(120, 90), pos + Vector2(-130, 88)])
		sil.color = Color(0.05, 0.05, 0.07, 0.92); sil.position = Vector2.ZERO; sil.z_index = -12; _region_node.add_child(sil); node = sil
	# o respiro: sobe e desce devagar (a única animação; lenta = sono, não ameaça imediata)
	if node.is_inside_tree():
		var base_y := node.position.y
		var tw := node.create_tween(); tw.set_loops()
		tw.tween_property(node, "position:y", base_y - 10.0, 4.2).set_trans(Tween.TRANS_SINE)
		tw.tween_property(node, "position:y", base_y, 4.2).set_trans(Tween.TRANS_SINE)

## ★★ OS CANAIS DE FERRO (BUILD_CANAIS_DE_FERRO_F5) — a 1ª camada da 2ª espinha do mundo: HORIZONTAL, não vertical.
## Um LABIRINTO de canais de água-negra entrelaçados em ilhas de sucata, onde se ENTRA (não se desce), se PERDE, e o
## terreno LUTA. Identidade: ferro/lodo/corrosão/sucata/abandono/reconstrução-errada. Ancorado na OFICINA de Halda
## (ilha-âncora=a margem). Navegação por MARCOS (sem minimapa). Atoleiros = becos de lodo (blocker) que enganam. O
## Remontado (elite que o brejo remonta) + O Ferro-Errante (raro que deriva). O Poço fica de HORIZONTE (silhueta+rota).
## Mobs reusam a rot-fauna; props procedurais; ZERO sistema/save/crafting/facção/cidade/história nova.
func _build_iron_channels(size: Vector2) -> void:
	_current_boss = null
	_boss_name = ""
	_canais_fog(size)   # névoa baixa: murk do brejo (não bloqueia visão = sem sistema; só atmosfera)

	# ════════ OFICINA-ILHA (oeste = "a margem") — chão firme, orientação, retorno ════════
	_canais_oficina(Vector2(300.0, 760.0))
	_build_service(Vector2(380.0, 880.0), "swamp_spring", "[E] beber da Fonte de Água Férrea")   # reusa a Fonte (descanso)
	_build_portal(CHANNELS_TO_SWAMP, "swamp", "↩ voltar → o Pântano", true, SWAMP_RETURN_FROM_CHANNELS)
	_maw_marker(Vector2(300.0, 600.0), "canais_oficina", "✦ [E] a oficina de Halda", [
		"Uma laje firme no meio do atoleiro: a oficina abandonada da Mestra Halda. Bigorna fria, engrenagens paradas, postes de ferro fincados.",
		"É o único chão seguro à vista. Daqui se parte para os canais — e é aqui que se volta, quando o brejo já confundiu demais.",
	])
	# o moat da ilha (água nos flancos N/S; a ponte ao leste = y640..860)
	_canais_water(Rect2(540.0, 120.0, 60.0, 520.0)); _canais_water(Rect2(540.0, 860.0, 60.0, 540.0))

	# ════════ OS CANAIS (o labirinto serpenteante W→E; água = paredes; gaps alternados forçam o zigue-zague) ════════
	_canais_water(Rect2(700.0, 120.0, 80.0, 860.0))    # W1 (gap SUL: y980+)
	_canais_water(Rect2(980.0, 520.0, 80.0, 880.0))    # W2 (gap NORTE: y<520)
	_canais_water(Rect2(1320.0, 120.0, 80.0, 860.0))   # W3 (gap SUL)
	_canais_water(Rect2(1660.0, 520.0, 80.0, 880.0))   # W4 (gap NORTE)
	# ATOLEIROS dead-end (o terreno como AMEAÇA): becos de lodo que enganam — a rota verdadeira é o outro lado
	_canais_atoleiro(Rect2(840.0, 1140.0, 160.0, 200.0), true)    # beco SUL do segmento A (a saída é NORTE)
	_canais_atoleiro(Rect2(1140.0, 200.0, 180.0, 180.0), true)    # beco NORTE do segmento B (a saída é SUL)
	_canais_atoleiro(Rect2(1480.0, 1160.0, 170.0, 200.0), true)   # beco SUL do segmento C (a saída é NORTE)

	# ════════ MARCOS (a orientação — charta-se por eles, sem minimapa/HUD/seta) ════════
	_canais_iron_post(Vector2(760.0, 1060.0))    # L1 (curva 1, sul de W1)
	_canais_machine(Vector2(1020.0, 300.0))      # L2 (curva 2, norte de W2)
	_canais_dead_gear(Vector2(1360.0, 1060.0))   # L3 (curva 3, sul de W3)
	_canais_iron_post(Vector2(1700.0, 300.0))    # L4 (curva 4, norte de W4)

	# ════════ O POÇO no HORIZONTE (leste) — silhueta-âncora + rota; NÃO expande/promove o Poço (só "há algo no centro") ══
	_canais_poco_silhouette(Vector2(2040.0, 760.0))
	_build_portal(CHANNELS_TO_PIT, "swamp_pit", "Trilha → o Buraco do Ferro-Velho", false)
	_maw_marker(Vector2(1880.0, 600.0), "canais_poco", "✦ [E] o que há no centro", [
		"Ao longe, sobre os canais, ergue-se uma colina de ferro-velho — tudo o que o brejo já engoliu, empilhado num só lugar.",
		"É o Buraco do Ferro-Velho, o centro de tudo. Algo grande mora ali. Os canais todos parecem, no fim, escorrer para lá.",
	])
	# lama de emergência sob os pontos do Remontado (visual, SEM blocker — "ergueu-se do atoleiro")
	for rp in CHANNELS_REMONTADO_POINTS:
		_canais_atoleiro(Rect2(rp.x - 62.0, rp.y - 38.0, 124.0, 76.0), false)

## névoa baixa do brejo (atmosfera; z baixo = não cobre o jogador nem bloqueia visão — sem sistema de fog-of-war).
func _canais_fog(size: Vector2) -> void:
	for c in [Vector2(0.30, 0.30), Vector2(0.62, 0.55), Vector2(0.45, 0.78), Vector2(0.80, 0.35)]:
		var h := ColorRect.new(); h.color = Color(0.40, 0.44, 0.38, 0.07); h.size = Vector2(size.x * 0.36, size.y * 0.30); h.position = Vector2(size.x * c.x - size.x * 0.18, size.y * c.y - size.y * 0.15); h.z_index = -10; _region_node.add_child(h)

## canal de água-negra (blocker): a "parede" do labirinto. Visual molhado/escuro + brilho de borda.
func _canais_water(rect: Rect2) -> void:
	var w := ColorRect.new(); w.color = Color(0.05, 0.07, 0.06, 0.92); w.size = rect.size; w.position = rect.position; w.z_index = -13; _region_node.add_child(w)
	# TILE de água-negra do Pacote 1 (render-only, clipado ao canal): textura real por cima do fill escuro (que cobre
	# bordas parciais). TextureRect STRETCH_TILE recorta ao rect do canal (canais têm 60–80px, mais estreitos que o tile).
	var wtex := _try_load_tex("res://assets/tilesets/iron_channels/iron_channels_channel_water_96.png")
	if wtex != null:
		var tr := TextureRect.new()
		tr.texture = wtex
		tr.stretch_mode = TextureRect.STRETCH_TILE
		tr.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		tr.size = rect.size; tr.position = rect.position; tr.z_index = -13
		tr.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_region_node.add_child(tr)
	var sheen := ColorRect.new(); sheen.color = Color(0.30, 0.42, 0.34, 0.10); sheen.size = Vector2(rect.size.x, 3.0); sheen.position = rect.position + Vector2(0.0, 2.0); sheen.z_index = -12; _region_node.add_child(sheen)
	_add_blocker(rect)

## atoleiro de lodo (blocking=true → blocker que ENGANA/prende; false → só a lama visual de onde o Remontado se ergue).
func _canais_atoleiro(rect: Rect2, blocking: bool) -> void:
	var m := ColorRect.new(); m.color = Color(0.18, 0.16, 0.11, 0.85) if blocking else Color(0.20, 0.18, 0.13, 0.6); m.size = rect.size; m.position = rect.position; m.z_index = -12; _region_node.add_child(m)
	for i in range(3):   # bolhas de gás (a lama "respira") — estático, sem tween (sem movimento que distraia)
		var b := Polygon2D.new(); var bp := PackedVector2Array()
		for k in range(8):
			var a := TAU * float(k) / 8.0
			bp.append(Vector2(cos(a) * 6.0, sin(a) * 6.0))
		b.polygon = bp; b.position = rect.position + Vector2(rect.size.x * (0.25 + 0.25 * float(i)), rect.size.y * 0.5); b.color = Color(0.26, 0.24, 0.16, 0.5); b.z_index = -11; _region_node.add_child(b)
	if blocking: _add_blocker(rect)

## MARCO — poste de ferro inclinado (silhueta distinta p/ orientação). SEM blocker (não trava a rota). z por base.
func _canais_iron_post(pos: Vector2) -> void:
	var z := int(pos.y)
	# VEINS_IRON_PROPS_PACK_05: poste como sprite se existir; senão ColorRects+base (fallback). Sem blocker (marco).
	var ip_tex := _try_load_tex("res://assets/tilesets/iron_channels/props/iron_post.png")
	if ip_tex != null:
		var s := Sprite2D.new(); s.texture = ip_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.offset = Vector2(0.0, -56.0); s.position = pos; s.z_index = z; _region_node.add_child(s)
		return
	var post := ColorRect.new(); post.color = Color("4a4038"); post.size = Vector2(14.0, 96.0); post.position = pos + Vector2(-7.0, -96.0); post.rotation = 0.16; post.z_index = z; _region_node.add_child(post)
	var rust := ColorRect.new(); rust.color = Color(0.5, 0.3, 0.16, 0.5); rust.size = Vector2(14.0, 30.0); rust.position = pos + Vector2(-7.0, -40.0); rust.rotation = 0.16; rust.z_index = z; _region_node.add_child(rust)
	var base := Polygon2D.new(); base.polygon = PackedVector2Array([pos + Vector2(-18, 0), pos + Vector2(18, 0), pos + Vector2(12, 8), pos + Vector2(-12, 8)]); base.color = Color("2e2a22"); base.z_index = z - 1; _region_node.add_child(base)

## MARCO — máquina meio-afundada (caixa enferrujada + uma engrenagem; silhueta inconfundível). SEM blocker. z por base.
func _canais_machine(pos: Vector2) -> void:
	var z := int(pos.y)
	# VEINS_IRON_PROPS_PACK_05: máquina como sprite se existir; senão caixa+engrenagem (fallback). Sem blocker (marco).
	var sm_tex := _try_load_tex("res://assets/tilesets/iron_channels/props/sunken_machine.png")
	if sm_tex != null:
		var s := Sprite2D.new(); s.texture = sm_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.offset = Vector2(0.0, -40.0); s.position = pos; s.z_index = z; _region_node.add_child(s)
		return
	var body := ColorRect.new(); body.color = Color("3e3a30"); body.size = Vector2(96.0, 44.0); body.position = pos + Vector2(-48.0, -30.0); body.rotation = -0.05; body.z_index = z; _region_node.add_child(body)
	var rust := ColorRect.new(); rust.color = Color(0.46, 0.28, 0.15, 0.45); rust.size = Vector2(96.0, 12.0); rust.position = pos + Vector2(-48.0, -2.0); rust.rotation = -0.05; rust.z_index = z; _region_node.add_child(rust)
	var gear := Polygon2D.new(); var gp := PackedVector2Array()
	for k in range(12):
		var a := TAU * float(k) / 12.0
		var rr: float = 26.0 if k % 2 == 0 else 19.0
		gp.append(Vector2(cos(a) * rr, sin(a) * rr))
	gear.polygon = gp; gear.position = pos + Vector2(34.0, -34.0); gear.color = Color("4a443a"); gear.z_index = z + 1; _region_node.add_child(gear)

## MARCO — engrenagem morta gigante encravada no lodo (silhueta distinta). SEM blocker. z por base.
func _canais_dead_gear(pos: Vector2) -> void:
	var z := int(pos.y)
	# VEINS_IRON_PROPS_PACK_05: engrenagem morta como sprite (centrado em pos) se existir; senão Polygon2D+hub (fallback).
	var dg_tex := _try_load_tex("res://assets/tilesets/iron_channels/props/dead_gear.png")
	if dg_tex != null:
		var s := Sprite2D.new(); s.texture = dg_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.position = pos; s.z_index = z; _region_node.add_child(s)
		return
	var gear := Polygon2D.new(); var gp := PackedVector2Array()
	for k in range(16):
		var a := TAU * float(k) / 16.0
		var rr: float = 56.0 if k % 2 == 0 else 42.0
		gp.append(Vector2(cos(a) * rr, sin(a) * rr * 0.78))
	gear.polygon = gp; gear.position = pos; gear.color = Color("403a31"); gear.z_index = z; _region_node.add_child(gear)
	var hub := Polygon2D.new(); var hp := PackedVector2Array()
	for k in range(10):
		var a := TAU * float(k) / 10.0
		hp.append(Vector2(cos(a) * 16.0, sin(a) * 12.0))
	hub.polygon = hp; hub.position = pos; hub.color = Color(0.5, 0.3, 0.16, 0.6); hub.z_index = z + 1; _region_node.add_child(hub)

## o POÇO no horizonte: uma COLINA de ferro-velho ao longe (a âncora de navegação — "o centro é por ali"). SEM blocker.
func _canais_poco_silhouette(pos: Vector2) -> void:
	# VEINS_IRON_PROPS_PACK_05: silhueta do Poço como 1 sprite (base ancorada) se existir; senão mound+cacos (fallback).
	var sp_tex := _try_load_tex("res://assets/tilesets/iron_channels/props/scrap_mound_pit.png")
	if sp_tex != null:
		var s := Sprite2D.new(); s.texture = sp_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.offset = Vector2(0.0, -24.0); s.position = pos + Vector2(0.0, 40.0); s.z_index = int(pos.y) - 2; _region_node.add_child(s)
		return
	var mound := Polygon2D.new(); mound.polygon = PackedVector2Array([pos + Vector2(-180, 80), pos + Vector2(-110, -40), pos + Vector2(-30, 10), pos + Vector2(40, -80), pos + Vector2(90, -20), pos + Vector2(170, 70)]); mound.color = Color(0.13, 0.13, 0.11, 0.92); mound.z_index = int(pos.y) - 2; _region_node.add_child(mound)
	# cacos de sucata espetados (silhueta jagged) + um leve brilho de ferro
	for sx in [-90.0, -20.0, 50.0, 110.0]:
		var spike := ColorRect.new(); spike.color = Color("2a2820"); spike.size = Vector2(8.0, 60.0); spike.position = pos + Vector2(sx, -40.0); spike.rotation = sx * 0.0014; spike.z_index = int(pos.y) - 1; _region_node.add_child(spike)

## a OFICINA de Halda (ilha-âncora): bigorna + engrenagem morta + postes + telhado caído. O chão firme reconhecível.
func _canais_oficina(pos: Vector2) -> void:
	# laje firme (chão + claro = "sólido")
	var slab := ColorRect.new(); slab.color = Color(0.26, 0.27, 0.22, 0.5); slab.size = Vector2(420.0, 360.0); slab.position = pos + Vector2(-210.0, -180.0); slab.z_index = -14; _region_node.add_child(slab)
	# bigorna (blocker pequeno; longe do spawn 320,760) — VEINS_IRON_PROPS_PACK_05: sprite se existir, senão ColorRect.
	var anvil_pos := pos + Vector2(-37.0, -52.0)   # centro da bigorna (sobre o blocker)
	var av_tex := _try_load_tex("res://assets/tilesets/iron_channels/props/halda_anvil.png")
	if av_tex != null:
		var s := Sprite2D.new(); s.texture = av_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.offset = Vector2(0.0, -22.0); s.position = anvil_pos; s.z_index = int(pos.y - 52.0); _region_node.add_child(s)
	else:
		var anvil := ColorRect.new(); anvil.color = Color("3a342c"); anvil.size = Vector2(46.0, 24.0); anvil.position = pos + Vector2(-60.0, -70.0); anvil.z_index = int(pos.y - 60.0); _region_node.add_child(anvil)
	_add_blocker(Rect2(pos.x - 60.0, pos.y - 64.0, 46.0, 20.0))
	_canais_dead_gear(pos + Vector2(120.0, -40.0))   # uma engrenagem parada (a marca de Halda)
	_canais_iron_post(pos + Vector2(-150.0, 60.0)); _canais_iron_post(pos + Vector2(150.0, 90.0))

## ★ A OUTRA MARGEM / R01 — A PRAIA DAS VELAS (THE_OTHER_SHORE_BUILD_01) = "o Espelho". A batida do RECONHECIMENTO:
## o jogador atravessa o mar esperando o novo e encontra o FAMILIAR torto — a Costa espelhada. SEM combate (é uma
## CHEGADA, não hunt; SEM apex/quest/recompensa/vendor/cidade). Reusa o vocabulário da Costa + o sistema de aves.
## Props procedurais (arte real plugada depois, padrão do projeto). Pequena de propósito: um espelho, não um destino.
func _build_praia_das_velas(size: Vector2) -> void:
	_current_boss = null
	_boss_name = ""
	# a barca de volta → Costa do Sal-Vento (a travessia é reversível; surge na Costa perto da barca = anti-loop)
	_build_portal(VELAS_TO_COAST, "saltwind_shore", "⛵ a barca → Costa do Sal-Vento", false, COAST_RETURN_FROM_VELAS)
	# ★ R02: a leste, ao longo da praia, leva ao Cais dos Ausentes (a 1ª área explorável da Outra Margem)
	_build_portal(VELAS_TO_CAIS, "cais_dos_ausentes", "⟶ o Cais dos Ausentes", false, CAIS_SPAWN)
	if GameState.set_story_flag("other_shore_reached"):
		_show_reward_popup("A Outra Margem — você chega… e reconhece")
	# o MAR a OESTE (você veio de lá; a praia de casa ficou do outro lado deste mar)
