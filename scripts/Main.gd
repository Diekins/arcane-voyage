	# ★ A ESCADA FÍSICA (chute) — corredor ESTREITO x1730..1810, do pé (y224) ao topo/crista (y150). ww=70 fecha o
	# resto do vão oeste (x1660..1730 e x1810..1880) nos DOIS níveis → só se sobe/desce pela escada (nada de lado
	# errado), e a troca é DEPENDENTE DO CAMINHO (latch: engata na base p/ subir, no topo p/ descer).
	_build_stair_chute(0, 1, 1770.0, 40.0, 224.0, 150.0, _region_node, terr, 70.0)
	# A VIGIA (THE_STONE_BUILD_03) — agora no TERRAÇO (nível 1), de costas, olhando o deserto lá EMBAIXO
	_build_stone_vigia(Vector2(2010.0, 132.0), terr, 1)
	# ★ AS PRIMEIRAS TESTEMUNHAS (THE_STONE_BUILD_04) — uma COMUNIDADE pequena, ocupada com a própria vida. Cada uma
