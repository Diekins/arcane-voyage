## A17.4 — CHEGADA na Hunt (chamado pelo HuntHost no START). Dá a PERCEPÇÃO de viagem mesmo reusando a cena atual:
## esconde o cenário/mobs/NPCs de PROGRESSÃO (`_region_node`), solta os limites da câmera p/ ela seguir o player no
## spot (já reposicionado pelo host), e mostra um banner curto de chegada. Barato, sem arte nova.
func on_hunt_enter(_ground_id: String, friendly_name: String, _anchor: Vector2) -> void:
	_hunt_travel_active = true
	# ★★★ FIELD FIX 01B: NÃO esconder `_region_node`. No mundo contínuo o ERRANTE é FILHO de `_region_node` (y-sort) —
	# escondê-lo tornava o próprio player invisível (bug de campo). O mundo permanece visível; os mobs de progressão
	# não interferem (a missão usa registry próprio owner=run_id). Escondo só os mobs de PROGRESSÃO (não o player/mapa).
	if _current_boss != null and is_instance_valid(_current_boss):
		_current_boss.visible = false
	for m in _mobs:
		if is_instance_valid(m): m.visible = false
	# ★★★ FIELD FIX 05/09/2026 — NPCs SOMEM DURANTE A ATIVIDADE.
	# Medido pela sonda: com o combate no centro de `plains`, o NPC `Aldric` fica a **72 px** do
	# ponto de luta — ele aparecia parado no meio da briga ("Mestre Aldric" no screenshot).
	# O `on_hunt_enter` já escondia mobs de progressão e boss, mas NPC não estava na lista.
	# ⛔ Só `visible = false` (reversível no `on_hunt_exit`): não desmonta o mundo contínuo.
	_hunt_hidden_npcs.clear()
	for n in _npcs:
		if is_instance_valid(n) and n.visible:
			n.visible = false
			_hunt_hidden_npcs.append(n)
	# câmera: guarda limites e os relaxa p/ não prender o herói no bbox da região anterior; snap ao novo spot (§18/§22)
	if _camera != null:
		_hunt_cam_limits = {"l": _camera.limit_left, "t": _camera.limit_top, "r": _camera.limit_right, "b": _camera.limit_bottom}
		_camera.limit_left = -10000000; _camera.limit_top = -10000000; _camera.limit_right = 10000000; _camera.limit_bottom = 10000000
		_camera.reset_smoothing()
	_build_environment(_ground_id + " " + friendly_name, _anchor)   # A28 — Living World no encounter
	_show_hunt_arrival(friendly_name)

## A28 — monta o ambiente (ground contínuo + props) no anchor do encounter, filho de _region_node (y-sort com o player).
## Determinístico por profile+anchor. Perfil derivado do ground/nome (HG_GROVE/SPIDER/CHAPTER_3 → grove; senão wolf).
func _build_environment(hint: String, anchor: Vector2) -> void:
	_free_environment()
	var profile := EnvironmentProfile.for_activity(hint)
	_environment = EnvironmentAssembler.new(); _environment.name = "LivingWorld"
	var host := _region_node if _region_node != null else self
	host.add_child(_environment)
	var q := "HIGH"
	if _graphics_quality_low(): q = "LOW"
	var sd := int(abs(hash(profile))) ^ int(anchor.x) * 131 ^ int(anchor.y) * 977
	_environment.assemble(profile, sd, Rect2(anchor - Vector2(700, 500), Vector2(1400, 1000)), anchor, q)
	_environment.build_scene(_player)

func _free_environment() -> void:
	if _environment != null and is_instance_valid(_environment):
		_environment.get_parent().remove_child(_environment); _environment.free()
	_environment = null

func _graphics_quality_low() -> bool:
	return false   # A28: gancho de qualidade (calibração/FIELD); default HIGH

## A17.4 — SAÍDA da Hunt (chamado pelo HuntHost no STOP): restaura cenário e câmera.
func on_hunt_exit() -> void:
	_hunt_travel_active = false
	_free_environment()   # A28 — remove o Living World ao sair do encounter
	if _current_boss != null and is_instance_valid(_current_boss):
		_current_boss.visible = true
	for m in _mobs:
		if is_instance_valid(m): m.visible = true
	# ★ devolve os NPCs escondidos na entrada (só os que ESTAVAM visíveis — não liga quem estava off)
	for n in _hunt_hidden_npcs:
		if is_instance_valid(n): n.visible = true
	_hunt_hidden_npcs.clear()
	if _camera != null and not _hunt_cam_limits.is_empty():
		_camera.limit_left = int(_hunt_cam_limits["l"]); _camera.limit_top = int(_hunt_cam_limits["t"])
		_camera.limit_right = int(_hunt_cam_limits["r"]); _camera.limit_bottom = int(_hunt_cam_limits["b"])
		_camera.reset_smoothing()
	_hunt_cam_limits = {}

## Banner de chegada "NOME / Caça Automática" que aparece e some (fade). Confirma visualmente a entrada na Hunt (§19).
func _show_hunt_arrival(friendly_name: String) -> void:
	if _hunt_arrival_layer == null:
		_hunt_arrival_layer = CanvasLayer.new(); _hunt_arrival_layer.layer = 55; add_child(_hunt_arrival_layer)
		_hunt_arrival_lbl = Label.new()
		_hunt_arrival_lbl.set_anchors_preset(Control.PRESET_CENTER_TOP)
		_hunt_arrival_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		_hunt_arrival_lbl.position = Vector2(0, 90)
		_hunt_arrival_lbl.add_theme_font_size_override("font_size", 28)
		_hunt_arrival_layer.add_child(_hunt_arrival_lbl)
	_hunt_arrival_lbl.text = "%s\nCaça Automática" % friendly_name
	_hunt_arrival_lbl.modulate = Color(1, 1, 1, 1)
	_hunt_arrival_layer.visible = true
	var tw := create_tween()
	tw.tween_interval(1.6)
	tw.tween_property(_hunt_arrival_lbl, "modulate:a", 0.0, 0.8)
	tw.tween_callback(func(): if _hunt_arrival_layer != null: _hunt_arrival_layer.visible = false)

## Overlay DEV: espelha HuntHost.debug_state() em texto. Só DEBUG; no-op em release.
func _hunt_dev_tick() -> void:
	if _hunt_dev_lbl == null or _hunthost == null: return
	if _hunt_dev_layer != null and not _hunt_dev_layer.visible: return   # escondido → não gasta montando texto
	var d := _hunthost.debug_state()
	var lines: Array = []
	for k in ["mode", "tick_owner", "ground_id", "shard_id", "spot_id", "mob_alive", "mob_hp", "kills", "xp", "items", "elite", "apex", "ticks", "cycles", "party_id", "remote_hunters"]:
		if d.has(k): lines.append("%s: %s" % [k, str(d[k])])
	_hunt_dev_lbl.text = "[HUNT DEV]\n" + "\n".join(lines)

## Alterna o Auto (botão/hotkey [P]). Canal ÚNICO — a UI do IdleHud também chama isto → sempre sincronizados.
func _toggle_autoplay() -> void:
	# FIELD FIX 01B: durante MISSÃO/BOSS o [P]/AUTO controla o AUTO da missão (pausa a luta, mantém lock §27), não o
	# AutoPlay de Progressão (que já está desligado no encounter).
	if _missionhost != null and _missionhost.is_active():
		_missionhost.toggle_auto()
		return
	if _hunthost != null and _hunthost.is_hunting():   # A20.9 — AUTO da Hunt (pausa encontro, mantém lock)
		_hunthost.toggle_auto()
		return
	if _autoplay != null:
		_autoplay.toggle()
		if _idlehud != null:
			_idlehud.refresh(true)

## Atualiza o rótulo do botão + o status curto (estado + kills da sessão). Barato; chamado no toggle e no tick.
func _refresh_autoplay_hud() -> void:
	if _autoplay == null:
		return
	if _autoplay_btn != null:
		_autoplay_btn.text = ("AUTO: ON" if _autoplay.enabled else "AUTO: OFF")
	if _autoplay_lbl != null:
		_autoplay_lbl.text = "%s · %d kills" % [_autoplay.state_label(), _autoplay.session_kills]

