func _on_boss_phase_fb(label: String, node) -> void:
	if _feedback == null or node == null or not is_instance_valid(node):
		return
	# `label` já é o rótulo (ESCUDO/...); empurro como toast de fase direto.
	_feedback.push_toast(GameFeedback.K_BOSS_PHASE, label, {"boss": str(node.get("boss_name"))})

## FATIA A8.1 — transição de fase → intro de boss/apex (1×/entrada) + banner de capítulo concluído.
func _on_stage_changed_fb(chapter: int, stage: int) -> void:
	if _feedback == null:
		return
	if chapter > _fb_last_chapter:
		var prev := ContentManifest.chapter(_fb_last_chapter)
		_feedback.push_chapter_clear(_fb_last_chapter, str(prev.get("display", "")))
		_fb_last_chapter = chapter
	var c := ContentManifest.chapter(chapter)
	if stage == 10:
		_feedback.push_boss_intro(str(c.get("boss_name", "")))
	elif stage == 5:
		_feedback.push_apex_intro(str(c.get("apex", "")))

