## Ponto de surgimento do Errante por região (coords do mundo).
func _region_spawn(region_id: String) -> Vector2:
	if _is_manifest_region(region_id):
		var mr := _manifest_for(region_id)
		if not mr.is_empty() and mr.has("spawn"):
			return Vector2(float(mr["spawn"][0]), float(mr["spawn"][1]))
	match region_id:
		"cave": return Vector2(440, 620)
		"starter_village": return Vector2(1100, 950)   # praça central (sul do cruzamento), chão aberto
		"swamp": return Vector2(320, 700)             # entrada oeste do Pântano (perto do retorno à Vila)
		"swamp_pit": return Vector2(290, 400)         # surge a leste da escada (auto-transição: NÃO em cima do portal de saída)
		"old_road": return Vector2(320, 650)          # entra pela ponta OESTE da Estrada Velha
		"ashen_grove": return Vector2(700, 1120)      # entra pela borda SUL do Bosque (vindo da Vila)
		"deep_grove": return DEEP_SPAWN               # entra acima da passagem sul (vindo do Bosque)
		"ancient_root_nest": return NEST_SPAWN        # entra perto do sul (vindo do Deep Grove)
		"saltwind_shore": return COAST_SPAWN          # entra pela ponta oeste (vindo da Estrada Velha)
		"castaway_sandbar": return SANDBAR_SPAWN       # chega do barco (sudoeste, perto do barco de volta)
		"salt_split_isle": return ISLE_SPAWN           # chega na Ilha pela ponta oeste
		"khet_sar_sands": return KHET_SPAWN            # desembarque na praia/oeste das dunas
		"khet_caravan_camp": return KHET_CAMP_SPAWN    # chega das Dunas Profundas (oeste do acampamento)
		"khet_oasis": return OASIS_SPAWN               # chega do Acampamento (oeste do oásis)
		"deep_dunes": return DUNES_SPAWN               # chega da Cidade (oeste das Dunas Profundas)
		"khet_sand_maw": return SANDMAW_SPAWN          # entra pela crista NORTE da Garganta (desce p/ a bacia)
		"khet_colonnade": return COLONNADE_SPAWN       # entra pela ala OESTE do salão de pilares
		"khet_citadel": return CITADEL_SPAWN           # entra pela brecha OESTE (pátio de entrada da cidadela)
		"great_archive": return ARCHIVE_SPAWN          # entra pela escada norte e desce à câmara
		"praia_das_velas": return VELAS_SPAWN          # desembarca na praia-espelho (oeste, vindo do mar)
		"cais_dos_ausentes": return CAIS_SPAWN         # chega da Praia das Velas (oeste do cais)
		"promontorio_do_espelho": return PROMONTORIO_SPAWN  # chega do Cais (oeste; sobe ao penhasco)
		"veins": return VEINS_SPAWN                         # desce da Caverna pela boca de mina (norte)
		"cathedral_of_crystal": return CATHEDRAL_SPAWN      # desce dos Veios pela Varanda Alta (sul, segura)
		"fendas": return FENDAS_SPAWN                       # desce o poço atrás do Coração (boca, norte)
		"iron_channels": return CHANNELS_SPAWN              # chega à Oficina-ilha (oeste = a margem)
		"vlab": return Vector2(150, 620)               # chão (nível 0), longe das estruturas (VERTICALITY F1)
		"arena": return Vector2(220, 500)              # ⚔️ Arena: surge a OESTE, de frente p/ as 3 baias de teste
		_: return Vector2(520, 840)

## A quest ativa é contextual à região: Vila/Planície = ch1; Caverna = ch2 se o ch1 já foi concluído.
func _update_active_quest_for_region(region_id: String) -> void:
	if _campaign_progress_locked():
		return   # macro-zona = sandbox: não re-aponta a quest ativa (current_region_id é stale por design)
	var q := "ch1-awakening"
	if region_id == "cave" and GameState.is_quest_completed("ch1-awakening"):
		q = "ch2-crystal-heart"
	if GameState.active_quest_id != q:
		GameState.set_active_quest(q)

func _set_world_combat(enabled: bool) -> void:
	if _current_boss != null:
		_current_boss.set("combat_enabled", enabled)
	for m in _mobs:
		if is_instance_valid(m):
			m.set("combat_enabled", enabled)

