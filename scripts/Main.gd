func _rebuild_shop_panel() -> void:
	if _shop_root == null:
		return
	_tip_hide()   # controles recriados → evita tooltip preso
	for c in _shop_root.get_children():
		c.queue_free()
	# fundo do painel por LOCAL (GODOT-SHOP-FORGE-RPG-SKIN-MVP-1): mural=madeira, Sila=balcão de madeira
	# polida, Dorn=ferro escuro/brasa. Cada serviço lê como um objeto diferente do mundo.
	if _shop_back != null:
		match _shop_kind:
			"board":      _shop_back.color = Color(0.12, 0.085, 0.05, 0.985)   # quadro de avisos (madeira)
			"blacksmith": _shop_back.color = Color(0.085, 0.078, 0.072, 0.985)  # ferro escuro/forja
			_:            _shop_back.color = Color(0.135, 0.10, 0.06, 0.985)    # balcão de madeira (Sila)
	if _shop_kind == "blacksmith":
		_rebuild_forge()
	elif _shop_kind == "board":
		_rebuild_board()
	else:
		_rebuild_merchant()

## Pool (ordenado) dos bounties REPETÍVEIS — base da rotação. Insertion order do dict BOUNTIES.
func _repeatable_bounty_pool() -> Array:
	var pool := []
	for bid in BOUNTIES:
		if bool(BOUNTIES[bid].get("repeatable", false)):
			pool.append(str(bid))
	return pool

## Ids dos contratos VISÍVEIS no mural agora (GODOT-BOUNTY-REPEATABLE-ROTATION-1):
##  (1) todos os FIXOS (repeatable=false) — sempre listados (one-time);
##  (2) janela rotativa de BOUNTY_ROTATION_SIZE do pool repetível, deslizando por board_rotation;
##  (3) + qualquer repetível ATIVO que tenha caído fora da janela (não esconde progresso aceito).
## Determinístico (só depende de board_rotation) e sem data real.
func _board_visible_bounties() -> Array:
	var vis := []
	for bid in BOUNTIES:
		if not bool(BOUNTIES[bid].get("repeatable", false)):
			vis.append(str(bid))   # fixos: sempre
	var pool := _repeatable_bounty_pool()
	if not pool.is_empty():
		var n := mini(BOUNTY_ROTATION_SIZE, pool.size())
		var start := GameState.board_rotation % pool.size()
		for i in range(n):
			var bid: String = pool[(start + i) % pool.size()]
			if not vis.has(bid):
				vis.append(bid)
		for bid in pool:   # repetível ativo fora da janela → mostra mesmo assim (não perde o aceito)
			if GameState.sq_state(bid) == "active" and not vis.has(bid):
				vis.append(bid)
	return vis

## Título de reputação (cosmético, GODOT-BOUNTY-BOARD-POLISH-1) derivado do nº de contratos
## concluídos. Sem perks — só sabor. Faixas: 0–2 Novato / 3–5 Confiável / 6–10 Caçador / 11+ Veterano.
func _board_reputation(n: int) -> String:
	if n >= 11: return "Veterano"
	if n >= 6: return "Caçador"
	if n >= 3: return "Confiável"
	return "Novato"

## Atualiza a rotação COBRANDO um custo modesto (GODOT-BOUNTY-BOARD-POLISH-1). Não cobra se o pool é
## pequeno demais p/ rotacionar; sem ouro → feedback e NÃO rotaciona. Sem recompensa (anti-exploit).
func _board_refresh() -> void:
	if _repeatable_bounty_pool().size() <= BOUNTY_ROTATION_SIZE:
		return   # nada a rotacionar (janela já mostra todos) → não cobra nem mexe
	if not GameState.spend_gold(BOARD_REFRESH_COST):
		_show_reward_popup("Ouro insuficiente: atualizar custa %d" % BOARD_REFRESH_COST)
		return
	GameState.bump_board_rotation()   # rotação avança só após o débito (state_changed reconstrói o painel)

## Painel do MURAL (BOUNTIES + REPEATABLE-ROTATION + POLISH): objetivo da campanha + nudge do tutorial
## no topo (read-only); linha de progresso (contratos concluídos + reputação cosmética); contratos
## VISÍVEIS (fixos + janela rotativa); e o "🔄 Atualizar" com CUSTO (só se há pool p/ rotacionar).
## Painel do MURAL repaginado (GODOT-CONTRACT-BOARD-UI-POLISH-1): cabeçalho FIXO (título + reputação +
## objetivo) → área de SCROLL com cards de contrato agrupados por estado (Disponíveis / Em andamento /
## Concluídos) → rodapé fixo (Atualizar + sair). SÓ UI: a lógica de aceitar/entregar/recompensa é a mesma.
func _rebuild_board() -> void:
	_board_header()
	# agrupa os contratos visíveis por estado (a lista/regras vêm de _board_visible_bounties, inalteradas)
	var avail := []
	var active := []
	var done := []
	for bid in _board_visible_bounties():
		match GameState.sq_state(str(bid)):
			"": avail.append(str(bid))
			"active": active.append(str(bid))
			_: done.append(str(bid))
	# SCROLL vertical com os cards (cabeçalho acima fica fixo; rodapé abaixo também)
	var scroll := ScrollContainer.new()
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	var vp := get_viewport_rect().size
	scroll.custom_minimum_size = Vector2(548, maxf(220.0, vp.y - 56.0 - 230.0))
	scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_shop_root.add_child(scroll)
	var list := VBoxContainer.new()
	list.add_theme_constant_override("separation", 8)
	list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.add_child(list)
	var idx := 0
	if not avail.is_empty():
		_board_section_title(list, "Disponíveis")
		for bid in avail:
			_board_card(list, str(bid), idx); idx += 1
	if not active.is_empty():
		_board_section_title(list, "Em andamento")
		for bid in active:
			_board_card(list, str(bid), idx); idx += 1
	if not done.is_empty():
		_board_section_title(list, "Concluídos")
		for bid in done:
			_board_card(list, str(bid), idx); idx += 1
	if avail.is_empty() and active.is_empty() and done.is_empty():
		_ui_section(list, "Nenhum contrato disponível no momento.")
	# rodapé FIXO (fora do scroll) — Atualizar (só se há pool p/ rotacionar) + sair
	if _repeatable_bounty_pool().size() > BOUNTY_ROTATION_SIZE:
		var can := GameState.hero_gold >= BOARD_REFRESH_COST
		_shop_button("↻ Atualizar contratos rotativos (%d ouro)" % BOARD_REFRESH_COST,
			Color("9fc0e0") if can else Color(0.6, 0.6, 0.66), func(): _board_refresh())
	_shop_title("[E] / [Esc] sair", 12, Color(1, 1, 1, 0.45))

