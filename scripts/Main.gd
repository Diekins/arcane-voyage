## escora de mina (cobertura vertical): viga de madeira apodrecida + trave no topo. blocker pequeno no pé. `submersa`
## = tom mais escuro/azulado (afundou na água). z por y.
func _veins_beam(pos: Vector2, h: float, submersa := false) -> void:
	var z := int(pos.y)
	# VEINS_IRON_PROPS_PACK_05: escora como sprite (escala h/128) se existir; senão ColorRects (fallback). Blocker mantido.
	var bm_tex := _try_load_tex("res://assets/tilesets/veins/props/mine_beam.png")
	if bm_tex != null:
		var s := Sprite2D.new(); s.texture = bm_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		var sc := h / 128.0; s.scale = Vector2(sc, sc); s.offset = Vector2(0.0, -64.0); s.position = pos; s.z_index = z
		if submersa: s.modulate = Color(0.72, 0.82, 0.98)   # tom afundado (azulado)
		_region_node.add_child(s)
	else:
		var wood: Color = Color("3a3026") if not submersa else Color("2a3340")
		var post := ColorRect.new(); post.color = wood; post.size = Vector2(16.0, h); post.position = pos + Vector2(-8.0, -h); post.z_index = z; _region_node.add_child(post)
		var cap := ColorRect.new(); cap.color = wood.darkened(0.2); cap.size = Vector2(40.0, 12.0); cap.position = pos + Vector2(-20.0, -h); cap.z_index = z; _region_node.add_child(cap)
		var grain := Line2D.new(); grain.points = PackedVector2Array([pos + Vector2(0, -h + 8), pos + Vector2(0, -6)]); grain.width = 1.5; grain.default_color = Color(0.0, 0.0, 0.0, 0.22); grain.z_index = z; _region_node.add_child(grain)
	_add_blocker(Rect2(pos.x - 8.0, pos.y - 8.0, 16.0, 18.0))

## carrinho de minério tombado (cobertura baixa): caixa inclinada + 1 roda. blocker no corpo. z por y.
func _veins_cart(pos: Vector2) -> void:
	var z := int(pos.y)
	# VEINS_IRON_PROPS_PACK_05: carrinho como sprite se existir; senão ColorRects+roda (fallback). Blocker mantido.
	var mc_tex := _try_load_tex("res://assets/tilesets/veins/props/mine_cart.png")
	if mc_tex != null:
		var s := Sprite2D.new(); s.texture = mc_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.offset = Vector2(0.0, -16.0); s.position = pos; s.z_index = z; _region_node.add_child(s)
	else:
		var body := ColorRect.new(); body.color = Color("4a4036"); body.size = Vector2(52.0, 30.0); body.position = pos + Vector2(-26.0, -22.0); body.rotation = 0.12; body.z_index = z; _region_node.add_child(body)
		var rust := ColorRect.new(); rust.color = Color(0.5, 0.32, 0.18, 0.4); rust.size = Vector2(52.0, 8.0); rust.position = pos + Vector2(-26.0, -22.0); rust.rotation = 0.12; rust.z_index = z; _region_node.add_child(rust)
		var wheel := Polygon2D.new(); var wp := PackedVector2Array()
		for i in range(10):
			var a := TAU * float(i) / 10.0
			wp.append(Vector2(cos(a) * 11.0, sin(a) * 11.0))
		wheel.polygon = wp; wheel.position = pos + Vector2(16.0, -4.0); wheel.color = Color("2e281f"); wheel.z_index = z; _region_node.add_child(wheel)
	_add_blocker(Rect2(pos.x - 26.0, pos.y - 14.0, 52.0, 26.0))

## trilho de minério (deco, SEM blocker): dois fios paralelos + dormentes. p1→p2.
func _veins_rail(p1: Vector2, p2: Vector2) -> void:
	var dir := (p2 - p1).normalized()
	var perp := Vector2(-dir.y, dir.x) * 5.0
	for s in [-1.0, 1.0]:
		var ln := Line2D.new(); ln.points = PackedVector2Array([p1 + perp * s, p2 + perp * s]); ln.width = 2.0; ln.default_color = Color(0.42, 0.40, 0.36, 0.5); ln.z_index = -13; _region_node.add_child(ln)
	var steps := int(p1.distance_to(p2) / 36.0)
	for i in range(steps):
		var c := p1.lerp(p2, float(i) / float(maxi(steps, 1)))
		var tie := Line2D.new(); tie.points = PackedVector2Array([c + perp * 1.6, c - perp * 1.6]); tie.width = 3.0; tie.default_color = Color(0.26, 0.22, 0.18, 0.5); tie.z_index = -14; _region_node.add_child(tie)

## veio de cristal BRUTO na parede (deco, SEM blocker): mancha escura + cacos de cristal pequenos incrustados (o
## precursor CRU do cristal CRESCIDO da Catedral). Brilha fraco.
func _veins_vein(pos: Vector2, h: float, rich := false) -> void:
	_cath_glow(pos + Vector2(0.0, 6.0), h * 0.4, Color(0.40, 0.64, 0.88, 0.08 if not rich else 0.16))
	# VEINS_IRON_PROPS_PACK_05: veio de cristal bruto como 1 sprite (escala por h) se existir; senão seam + cristais
	# (fallback, que já caem no crystal_shard). O glow acima segue por código. rich = maior+mais brilhante.
	var cv_tex := _try_load_tex("res://assets/tilesets/veins/props/crystal_vein_raw.png")
	if cv_tex != null:
		var s := Sprite2D.new(); s.texture = cv_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		var sc := (h / 96.0) * (1.0 if not rich else 1.3); s.scale = Vector2(sc, sc)
		s.offset = Vector2(0.0, -48.0); s.position = pos; s.z_index = int(pos.y) - 1
		if rich: s.modulate = Color(1.15, 1.15, 1.2)   # nó RICO brilha mais
		_region_node.add_child(s)
	else:
		var seam := Polygon2D.new(); seam.polygon = PackedVector2Array([pos + Vector2(-10, 12), pos + Vector2(-6, -h * 0.5), pos + Vector2(8, -h * 0.6), pos + Vector2(12, 6)]); seam.color = Color("20262f"); seam.z_index = int(pos.y) - 1; _region_node.add_child(seam)
		var n := 3 if not rich else 5
		for i in range(n):
			var off := Vector2(-8.0 + float(i) * 5.0, 6.0 - float(i % 3) * (h * 0.18))
			_cath_crystal(pos + off, (26.0 + float(i % 3) * 10.0) * (1.0 if not rich else 1.5), Color(0.46, 0.72, 0.92, 0.7 if not rich else 0.85))

## nó de veio RICO (deco): um veio mais brilhante/maior = o "olha, cristal" que puxa o olho (não é loot, é cenário).
