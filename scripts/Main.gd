		return "As Fendas Profundas"   # L4 "o Silêncio" — o negativo da Caverna (BUILD_FENDAS_PROFUNDAS_F5)
	if rid == "iron_channels":
		return "Os Canais de Ferro"   # 1ª camada da 2ª espinha (labirinto horizontal; BUILD_CANAIS_DE_FERRO_F5)
	if _is_manifest_region(rid):
		var mr := _manifest_for(rid)
		if not mr.is_empty():
			return str(mr.get("display_name", rid))
	return str(DataLoader.region(rid).get("name", rid))

## Painel de missão (tracker) no canto sup. direito — MENOR + esconde/mostra (GODOT-HUD-PANELS-ADJUST-1).
## Cabeçalho com botão-toggle; corpo (labels) some no toggle e o frame encolhe.
func _build_tracker(vp: Vector2, layer: CanvasLayer) -> void:
	var v := _make_frame_panel(layer, Vector2(vp.x - 262.0, 12.0), 250)
	_tracker_frame = v   # A17.10A: guardado p/ o HudShell esconder o tracker de Progressão durante a Hunt (exclusão)
	# cabeçalho: "MISSÃO ATUAL" + botão de esconder (à direita)
	var head_row := HBoxContainer.new()
	head_row.add_theme_constant_override("separation", 6)
	v.add_child(head_row)
	# cabeçalho diegético (GODOT-HUD-RPG-SKIN-MVP-1): "MISSÃO ATUAL" numa fita de bronze/couro (placa gravada)
	var head_ribbon := PanelContainer.new()
	var hrsb := StyleBoxFlat.new()
	hrsb.bg_color = Color(0.18, 0.13, 0.07, 0.9)        # couro/bronze escuro
	hrsb.set_border_width_all(1)
	hrsb.border_color = Color(0.66, 0.53, 0.3, 0.6)     # bronze
	hrsb.set_corner_radius_all(4)
	hrsb.content_margin_left = 8; hrsb.content_margin_right = 8
	hrsb.content_margin_top = 2; hrsb.content_margin_bottom = 2
	head_ribbon.add_theme_stylebox_override("panel", hrsb)
	head_ribbon.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	head_row.add_child(head_ribbon)
	var head := Label.new()
	head.text = "✦ TRILHA ATUAL"
	head.add_theme_font_size_override("font_size", 11)
	head.modulate = Color("f0c860")                     # dourado envelhecido
	head_ribbon.add_child(head)
	_tracker_toggle_btn = Button.new()
	_tracker_toggle_btn.add_theme_font_size_override("font_size", 11)
	_tracker_toggle_btn.custom_minimum_size = Vector2(22, 18)
	_tracker_toggle_btn.tooltip_text = "Esconder/mostrar a trilha  [M]"
	_tracker_toggle_btn.pressed.connect(_toggle_tracker_hud)
	head_row.add_child(_tracker_toggle_btn)
	# corpo (labels) — some no toggle
	_tracker_body = VBoxContainer.new()
	_tracker_body.add_theme_constant_override("separation", 3)
	v.add_child(_tracker_body)
	_tutorial_label = _stat_label(_tracker_body, 12, Color("7fe0c0"))
	_tutorial_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_tracker_title = _stat_label(_tracker_body, 15, Color(1, 1, 1, 1))
	_tracker_title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_tracker_obj = _stat_label(_tracker_body, 12, Color("cfd3da"))
	_tracker_obj.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_tracker_status = _stat_label(_tracker_body, 13, Color("e9c46a"))
	_tracker_reward = _stat_label(_tracker_body, 12, Color("d9c27a"))
	_tracker_reward.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_sidequest_label = _stat_label(_tracker_body, 12, Color("7fe0c0"))
	_sidequest_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_apply_tracker_visibility()

## Esconde/mostra o corpo do quadro de missão (frame encolhe; botão permanece).
func _toggle_tracker_hud() -> void:
	_tracker_hidden = not _tracker_hidden
	_apply_tracker_visibility()

func _apply_tracker_visibility() -> void:
	if _tracker_body != null:
		_tracker_body.visible = not _tracker_hidden
	if _tracker_toggle_btn != null:
		_tracker_toggle_btn.text = "▾" if _tracker_hidden else "▴"

func _refresh_tracker() -> void:
	if _tracker_title == null:
		return
	# dica de tutorial (banner do topo): some/colapsa quando o onboarding encerra
	if _tutorial_label != null:
		var hint := _tutorial_hint()
		_tutorial_label.text = ("Dica: " + hint) if hint != "" else ""
		_tutorial_label.visible = hint != ""
	var qid := GameState.active_quest_id
	var q := DataLoader.quest(qid)
	_tracker_title.text = str(q.get("title", qid))
	# objetivo: deriva de objective.monsterName (kill_monster) → "Derrotar X"; senão usa label.
	var obj: Dictionary = q.get("objective", {})
	var monster := str(obj.get("monsterName", ""))
	if monster != "":
		_tracker_obj.text = "Objetivo: Derrotar %s" % monster
	elif obj.has("label"):
		_tracker_obj.text = "Objetivo: %s" % str(obj["label"])
	else:
		_tracker_obj.text = "Objetivo: —"
	# status
	var done := GameState.is_quest_completed(qid)
	_tracker_status.text = "Status: %s" % ("Concluída" if done else "Em andamento")
	_tracker_status.modulate = Color("6fcf97") if done else Color("e9c46a")
	# reward (resolve narrativeReward.ref → relíquia; marca "recebido" se já no inventário)
	var reward := DataLoader.narrative_reward_for_quest(qid)
	if reward.is_empty():
		_tracker_reward.text = "Recompensa: —"
	else:
		var rid := DataLoader.relic_id_for_reward(reward)
		var rname := str(DataLoader.relic(rid).get("name", reward.get("ref", "—")))
		var suffix := "  (recebido)" if GameState.has_item(rid) else ""
		_tracker_reward.text = "Recompensa: %s%s" % [rname, suffix]
	# tarefas opcionais ATIVAS — side-quests de NPC (Vila) + bounties do mural (BOARD-BOUNTIES-1)
	if _sidequest_label != null:
		var act := PackedStringArray()
		for src in [SIDE_QUESTS, BOUNTIES]:
			for sqid in src:
				if GameState.sq_state(str(sqid)) == "active":
					var sq: Dictionary = src[sqid]
					act.append("• %s: %d/%d" % [str(sq["short"]), _sq_have(str(sqid)), int(sq["need"])])
		_sidequest_label.visible = act.size() > 0
		_sidequest_label.text = ("Tarefas:\n" + "\n".join(act)) if act.size() > 0 else ""

func _on_leveled_up(level: int) -> void:
	# P0.4 — REENQUADRAMENTO (só texto/ênfase/cor; XP, atributos, progressão e balanceamento INTACTOS): o nível é
	# "mais fôlego para a estrada / preparado para ir mais longe", não "ganhei um número". Tom pergaminho quente
	# (não a dourada de prêmio) p/ alinhar com a Fantasia do Errante (progressão = ALCANCE).
	_levelup_flash()
	_show_reward_popup("Nível %d — mais fôlego para seguir adiante." % level, Color("ffe6b0"))

## Toast curto ao subir de proficiência (GODOT-VOCATION-PROFICIENCY-MVP-1): "Arqueiro Nv 2" etc.
## Reusa o popup existente (sem UI nova/sem nó de z alto → CombatVfx z=4095 intacto).
