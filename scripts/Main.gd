## --- LOJA & FORJA (GODOT-VILLAGE-SERVICES-SHOP-1) ---
## Painel modal central (mesmo molde do de mochila): falar [E] com a Mercadora abre Comprar/Vender;
## com o Ferreiro abre a Forja. Reconstruído a cada abertura/mutação de estado. Sem drag-and-drop:
## clicar numa linha executa a transação (comprar/vender/forjar). [E]/[Esc] fecham.
func _build_shop_panel(_vp: Vector2, _layer: CanvasLayer) -> void:
	var slayer := CanvasLayer.new()
	slayer.layer = 16   # acima da mochila (15) — só um deles fica visível por vez
	add_child(slayer)
	_shop_panel = PanelContainer.new()
	_shop_panel.position = Vector2(_vp.x * 0.5 - 300.0, 56.0)
	_shop_panel.custom_minimum_size = Vector2(600, 0)
	# fundo OPACO atrás da moldura (a frame.png 9-slice tem miolo translúcido) → painel sólido RPG
	_shop_back = ColorRect.new()
	_shop_back.set_anchors_preset(Control.PRESET_FULL_RECT)
	_shop_back.color = Color(0.05, 0.06, 0.10, 0.97)
	_shop_back.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_shop_panel.add_child(_shop_back)
	# moldura ornamentada do HUD (mesma do tracker) → visual coeso de RPG (GODOT-RPG-INVENTORY-SHOP-LAYOUT-1)
	var sb := StyleBoxTexture.new()
	sb.texture = load(HUD_FRAME)
	sb.texture_margin_left = 26
	sb.texture_margin_right = 26
	sb.texture_margin_top = 26
	sb.texture_margin_bottom = 26
	sb.content_margin_left = 24
	sb.content_margin_right = 24
	sb.content_margin_top = 18
	sb.content_margin_bottom = 18
	_shop_panel.add_theme_stylebox_override("panel", sb)
	slayer.add_child(_shop_panel)
	_shop_root = VBoxContainer.new()
	_shop_root.add_theme_constant_override("separation", 5)
	_shop_panel.add_child(_shop_root)
	_shop_panel.visible = false
	GameState.state_changed.connect(func(): if _shop_open: _rebuild_shop_panel())

## Abre a loja/forja: fecha a mochila se aberta, trava o herói (já travado pela interação) e monta.
func _open_shop(kind: String) -> void:
	_shop_kind = kind
	_shop_tab = "buy"
	_shop_last_item = ""
	if _inv_open:
		_inv_open = false
		if _inv_panel != null:
			_inv_panel.visible = false
	_shop_open = true
	if _shop_panel != null:
		_shop_panel.visible = true
	_apply_equip_layer_visibility()   # loja aberta → não expõe o paperdoll fixo
	if _player != null and _player.has_method("set"):
		_player.set("locked", true)
	_rebuild_shop_panel()

func _close_shop() -> void:
	_shop_open = false
	_shop_last_item = ""
	_tip_hide()
	if _shop_panel != null:
		_shop_panel.visible = false
	_apply_equip_layer_visibility()   # volta o paperdoll fixo ao fechar a loja (se a mochila não estiver aberta)
	# destrava o Errante ao sair (a não ser que esteja abatido — aí o [R] cuida disso)
	if _player != null and _player.has_method("set") and not GameState.is_hero_defeated():
		_player.set("locked", false)

