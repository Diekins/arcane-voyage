		var s := Sprite2D.new(); s.texture = wg_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.offset = Vector2(0.0, -32.0); s.position = pos + Vector2(0.0, 16.0); s.z_index = int(pos.y)
		_region_node.add_child(s)
