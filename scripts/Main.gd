## FATIA A5 — loot table AGREGADA da região corrente (hostis reais, sem mobs de teste). Consumida pelo
## cálculo offline (drops agregados) e pelas taxas /h. Fonte = _mob_configs (data), sem construir a região.
func idlerewards_region_loot() -> Array:
	var out: Array = []
	var region := stagedirector_region_id()
	for cfg in _mob_configs(region):
		if str(cfg.get("id", "")) in ["mage_of_heaven", "musgo_voraz"]:
			continue   # mobs de teste/dev fora da economia (§17 da A3)
		for e in cfg.get("loot", []):
			out.append(e)
	return out

