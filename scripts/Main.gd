	_build_stone_witness(terr, Vector2(2148.0, 134.0), 1, "stone_jov", "a Jovem Testemunha", Color("a98f5e"), Color("75603c"), "sway", false, [
		"Ainda não sei o que olhar. Mas olho junto.",
