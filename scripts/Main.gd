## Faixa de seção GRAVADA (RPG-SKIN-1): fita de bronze/couro com texto em dourado envelhecido.
func _board_section_title(parent: Control, text: String) -> void:
	var p := PanelContainer.new()
	p.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var sb := StyleBoxFlat.new()
	sb.bg_color = Color(0.28, 0.20, 0.10, 0.95)
	sb.border_color = Color(0.55, 0.42, 0.20, 0.75); sb.border_width_top = 2; sb.border_width_bottom = 2
	sb.set_corner_radius_all(3)
	sb.content_margin_left = 10; sb.content_margin_right = 10; sb.content_margin_top = 2; sb.content_margin_bottom = 2
	p.add_theme_stylebox_override("panel", sb)
	var l := Label.new()
	l.text = text
	l.add_theme_font_size_override("font_size", 14)
	l.add_theme_color_override("font_color", Color("f0d49a"))
	l.add_theme_color_override("font_outline_color", Color(0.1, 0.06, 0.02, 0.8))
	l.add_theme_constant_override("outline_size", 2)
	p.add_child(l)
	parent.add_child(p)

## SELO curto (região / "repetível") — pequeno carimbo de cera/bronze com borda, não pílula de app.
func _board_tag(text: String, bg: Color, fg: Color) -> Control:
	var p := PanelContainer.new()
	var sb := StyleBoxFlat.new()
	sb.bg_color = bg; sb.set_corner_radius_all(8)
	sb.border_color = Color(fg.r, fg.g, fg.b, 0.4); sb.set_border_width_all(1)
	sb.content_margin_left = 8; sb.content_margin_right = 8; sb.content_margin_top = 1; sb.content_margin_bottom = 1
	p.add_theme_stylebox_override("panel", sb)
	p.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	var l := Label.new(); l.text = text; l.add_theme_font_size_override("font_size", 11); l.add_theme_color_override("font_color", fg)
	p.add_child(l)
	return p

## Rótulo de estado (não-clicável): "Em andamento X/Y" / "Concluído".
func _board_state_label(text: String, col: Color) -> Label:
	var l := Label.new(); l.text = text
	l.add_theme_font_size_override("font_size", 13); l.modulate = col
	l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	return l

## Card de contrato (GODOT-CONTRACT-BOARD-UI-POLISH-1): leitura em camadas — linha 1 nome + tag de região
## (+ "repetível") + ação/estado à direita; linha 2 objetivo/descrição (autowrap, não corta). A lógica de
## aceitar/entregar/recompensa é EXATAMENTE a de antes (sq_set/_sidequest_reward; sq_state/_sq_have/_quest_def).
func _board_card(parent: Control, bid: String, idx: int) -> void:
	var b: Dictionary = _quest_def(bid)
	var need := int(b["need"])
	var title := str(b["title"])
	var region := str(b.get("region", ""))
	var rep := bool(b.get("repeatable", false))
	var st := GameState.sq_state(bid)
	var card := PanelContainer.new()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var csb := StyleBoxFlat.new()
	# ficha de PERGAMINHO/couro escuro (RPG-SKIN-1): tom quente amarelado-marrom, alternado
	csb.bg_color = Color(0.17, 0.13, 0.085, 0.96) if (idx % 2 == 0) else Color(0.14, 0.105, 0.07, 0.96)
	csb.border_color = Color(0.46, 0.35, 0.18, 0.6); csb.set_border_width_all(1); csb.set_corner_radius_all(5)
	csb.set_content_margin_all(8)
	card.add_theme_stylebox_override("panel", csb)
	parent.add_child(card)
	var vb := VBoxContainer.new()
	vb.add_theme_constant_override("separation", 3)
	card.add_child(vb)
	# --- linha 1: nome + tags + ação/estado à direita ---
	var row1 := HBoxContainer.new()
	row1.add_theme_constant_override("separation", 8)
	vb.add_child(row1)
	var name_l := Label.new()
	name_l.text = title
	name_l.add_theme_font_size_override("font_size", 15)
	name_l.add_theme_color_override("font_color", Color("f0d49a"))
	name_l.add_theme_color_override("font_outline_color", Color(0.1, 0.06, 0.02, 0.7))
	name_l.add_theme_constant_override("outline_size", 1)
	row1.add_child(name_l)
	if region != "":
		row1.add_child(_board_tag(region, Color(0.30, 0.17, 0.10, 0.95), Color("e8d2a6")))   # selo de cera
	if rep and st == "":
		row1.add_child(_board_tag("repetível", Color(0.24, 0.16, 0.10, 0.95), Color("d8b888")))
	var spacer := Control.new()
	spacer.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row1.add_child(spacer)
	match st:
		"":
			row1.add_child(_board_seal_button("Assinar", Color("ffe6b0"), func(): GameState.sq_set(bid, "active")))   # MESMA ação de aceitar
		"active":
			if _sq_have(bid) >= need:
				row1.add_child(_board_seal_button("Entregar", Color("d4f0c4"), func(): _sidequest_reward(bid)))   # MESMA entrega/recompensa
			else:
				row1.add_child(_board_state_label("em andamento  %d/%d" % [_sq_have(bid), need], Color("d8c088")))
		_:
			row1.add_child(_board_state_label("✓ Concluído", Color(0.72, 0.62, 0.45)))
	# --- linha 2: objetivo / descrição (curto, com quebra de linha; nunca corta no lado direito) ---
	var desc := Label.new()
	desc.add_theme_font_size_override("font_size", 12)
	desc.add_theme_color_override("font_color", Color("c9b896"))   # tinta clara sobre pergaminho
	desc.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	desc.custom_minimum_size = Vector2(496, 0)
	match st:
		"":
			desc.text = str(b.get("desc", ""))
		"active":
			if _sq_have(bid) >= need:
				desc.text = "Pronto para entregar — %d ouro, %d XP" % [int(b["gold"]), int(b["xp"])]
			else:
				desc.text = str(b.get("short", b.get("desc", "")))
		_:
			desc.text = "Recompensa recebida."
	vb.add_child(desc)
	# concluídos: pergaminho amarelado/apagado (sépia), não parecem clicáveis (sem botão)
	if st != "" and st != "active":
		card.modulate = Color(0.92, 0.84, 0.7, 0.5)

func _rebuild_merchant() -> void:
	# Identidade diegética por LOCAL (GODOT-CARAVAN-CAMP-DIEGETIC-POLISH-1): no Acampamento o balcão é da Yalla
	# (caravana/deserto); na Vila segue a Sila. Mesma loja/estoque/preços — só título + flavor mudam.
	var in_camp := GameState.is_current_region("khet_caravan_camp")
	_ui_head(_shop_root, ("Balcão da Yalla" if in_camp else "Balcão da Sila"), "Ouro: %d" % GameState.hero_gold)
	_shop_flavor(("✦ Mercadoria de caravana — o que as dunas pouparam, eu vendo." if in_camp else "✦ Mercadoria da vila — escolha uma peça do balcão."), Color("c9b896"))
	_shop_accent(Color(0.6, 0.48, 0.27, 0.7))   # ripa de madeira/bronze (balcão)
	_shop_equip_hint()
	var tabs := HBoxContainer.new()
	tabs.add_theme_constant_override("separation", 8)
	_shop_root.add_child(tabs)
	_shop_tab_button(tabs, "Comprar", "buy")
	_shop_tab_button(tabs, "Vender", "sell")
	var sep := HSeparator.new()
	_shop_root.add_child(sep)
	if _shop_tab == "sell":
		_merchant_sell_list()
	else:
		_merchant_buy_list()
	_shop_title("[E] / [Esc] sair   ·   passe o mouse p/ detalhes", 12, Color(1, 1, 1, 0.45))

func _merchant_buy_list() -> void:
	# FLECHAS — munição do arco à venda em LOTE de 100 (GODOT-ARROWS-SHOP-AMMO-1): independente da mana; stack
	# até 500. Sempre no topo (descoberta); "cheio" quando no teto. Custo = nº do próximo lote × preço/flecha.
	var room := GameState.arrows_max - GameState.arrows_current
	var aqty := mini(GameState.ARROWS_BUNDLE, room)   # 100, ou o resto até 500
	var acost := aqty * ARROW_BUY_PRICE
	var amid := "Munição do arco · %d/%d" % [GameState.arrows_current, GameState.arrows_max]
	var aicon := ItemDB.icon_path("bow_simple")
	if room <= 0:
		_ui_item_row(_shop_root, "", "Flechas", Color(0.62, 0.64, 0.7), amid, "cheio (máx %d)" % GameState.arrows_max, Color(0.6, 0.62, 0.66), null, "", 178.0, aicon, "")
	elif GameState.hero_gold < acost:
		_ui_item_row(_shop_root, "", "Flechas", Color(0.62, 0.64, 0.7), amid, "%d (sem ouro)" % acost, Color(0.6, 0.55, 0.5), null, "Compra +%d flechas (%d por flecha). Stack até %d." % [aqty, ARROW_BUY_PRICE, GameState.arrows_max], 178.0, aicon, "")
	else:
		_ui_item_row(_shop_root, "", "Flechas  (+%d)" % aqty, Color("e7ecf5"), amid, "%d ouro" % acost, Color("ffe08a"), func(): _buy_arrows(), "Compra +%d flechas (%d por flecha). Stack até %d." % [aqty, ARROW_BUY_PRICE, GameState.arrows_max], 178.0, aicon, "")
	for id in ItemDB.SHOP_STOCK:
		var bid := str(id)
		var cost := ItemDB.price(bid)
		var afford := GameState.hero_gold >= cost
		var col := str(ItemDB.get_item(bid).get("color", ""))
		if afford:
			_ui_item_row(_shop_root, col, ItemDB.display_name(bid), Color(ItemDB.rarity_color(bid)), _item_mid(bid),
				"%d ouro" % cost, Color("ffe08a"), func(): _shop_buy(bid), _item_detail(bid), 178.0, ItemDB.icon_path(bid), _item_tooltip_bb(bid, "shop_buy"))
		else:
			_ui_item_row(_shop_root, col, ItemDB.display_name(bid), Color(0.62, 0.64, 0.7), _item_mid(bid),
				"%d (sem ouro)" % cost, Color(0.6, 0.55, 0.5), null, _item_detail(bid), 178.0, ItemDB.icon_path(bid), _item_tooltip_bb(bid, "shop_buy"))

func _merchant_sell_list() -> void:
	_ui_section(_shop_root, "Itens da mochila (vende pela metade do preço)")
	var any_item := false
	for entry in GameState.backpack:
		var iid := str(entry.get("id", ""))
		var val := ItemDB.sell_value(iid)
		if val <= 0:
			continue
		any_item = true
		var qty := int(entry.get("qty", 1))
		var qsfx := (" x%d" % qty) if qty > 1 else ""
		var col := str(ItemDB.get_item(iid).get("color", ""))
		_ui_item_row(_shop_root, col, ItemDB.display_name(iid) + qsfx, Color("e7ecf5"), _item_mid(iid),
			"vender %d" % val, Color("a9e0b0"), func(): _do_sell_item(iid), _item_detail(iid), 178.0, ItemDB.icon_path(iid), _item_tooltip_bb(iid, "shop_sell"))
	if not any_item:
		_ui_section(_shop_root, "  (nada para vender)")
	_ui_section(_shop_root, "Materiais de caça")
	if GameState.materials.is_empty():
		_ui_section(_shop_root, "  (sem materiais)")
	for m in GameState.materials:
		var mn := str(m)
		var mq := int(GameState.materials[m])
		var mv := ItemDB.material_value(mn)
		_ui_item_row(_shop_root, "8a8f5a", "%s x%d" % [mn, mq], Color("dfe6d6"), "material",
			"vender %d" % mv, Color("a9e0b0"), func(): _do_sell_material(mn), "", 178.0, ItemDB.material_icon_path(mn), _material_tooltip_bb(mn))

func _rebuild_forge() -> void:
	# Identidade diegética por LOCAL (GODOT-CARAVAN-CAMP-DIEGETIC-POLISH-1): no Acampamento a forja é do Kesh
	# (ferreiro nômade); na Vila segue o Dorn. Mesma forja/receitas/upgrades — só título + flavor mudam.
	var in_camp := GameState.is_current_region("khet_caravan_camp")
	_ui_head(_shop_root, ("Forja do Kesh" if in_camp else "Forja do Dorn"), "Ouro: %d" % GameState.hero_gold)
	_shop_flavor(("⚒ Bigorna de estrada — metal gasto pela areia, reparado para a próxima rota." if in_camp else "⚒ Bancada do ferreiro — brasas acesas, traga ouro e materiais."), Color("d8b08a"))
	_shop_accent(Color(0.78, 0.42, 0.18, 0.8))   # brasa/laranja-bronze (forja)
	_shop_equip_hint()
	# compacto: só a contagem (a lista completa estourava a largura e cortava na tela). Detalhe
	# do que cada receita precisa está na linha/tooltip de cada item; os materiais, na mochila [I].
	_ui_section(_shop_root, "Materiais na mochila: %d tipos   ·   detalhes em [I]" % GameState.materials.size())
	_forge_commission_row("dorn_cristal")   # encomenda do Dorn (side-quest GODOT-VILLAGE-SIDEQUESTS-CHAIN-1)
	var sep := HSeparator.new()
	_shop_root.add_child(sep)
	for rid in ItemDB.RECIPE_ORDER:
		_forge_recipe_row(str(rid))
	_shop_title("[E] / [Esc] sair   ·   passe o mouse nos ícones p/ ver nome/custo", 12, Color(1, 1, 1, 0.45))

## Linha de receita da Forja (GODOT-SHOP-FORGE-RPG-SKIN-MVP-1 → ÍCONES de custo): ícone do resultado |
## nome | ÍCONES dos materiais/ouro (com xN; hover mostra nome/raridade/qtd) | ação. Ícone fica vermelho/
## apagado quando FALTA o material/ouro. Receitas/custos/ação INALTERADOS (só a apresentação do custo muda).
func _forge_recipe_row(crid: String) -> void:
	var r := ItemDB.recipe(crid)
	var craftable := GameState.can_craft(crid)
	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 10)
	_shop_root.add_child(row)
	# ícone do RESULTADO (hover = o que você forja)
	var tx = _load_tex(ItemDB.icon_path(crid))
	if tx != null:
		var ir := TextureRect.new()
		ir.texture = tx
		ir.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		ir.custom_minimum_size = Vector2(28, 28); ir.size = Vector2(28, 28)
		ir.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		ir.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		_attach_tip(ir, _item_tooltip_bb(crid, "forge"))
		row.add_child(ir)
	else:
		var sw := ColorRect.new(); sw.custom_minimum_size = Vector2(16, 16)
		sw.color = Color(ItemDB.rarity_color(crid)); sw.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		row.add_child(sw)
	# NOME do resultado
	var nm := Label.new()
	nm.text = ItemDB.display_name(crid)
	nm.add_theme_font_size_override("font_size", 14)
	nm.modulate = Color(ItemDB.rarity_color(crid)) if craftable else Color(0.62, 0.64, 0.7)
	nm.custom_minimum_size = Vector2(190, 0)
	nm.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	nm.mouse_filter = Control.MOUSE_FILTER_PASS
	_attach_tip(nm, _item_tooltip_bb(crid, "forge"))
	row.add_child(nm)
	# CUSTO em ÍCONES (materiais + ouro) — hover de cada um mostra o nome/detalhe; falta = vermelho/apagado
	var cost := HBoxContainer.new()
	cost.add_theme_constant_override("separation", 10)
	cost.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	cost.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(cost)
	var mats: Dictionary = r.get("materials", {})
	for mn0 in mats:
		var mn := str(mn0)
		var need := int(mats[mn0])
		var ok := GameState.material_count(mn) >= need
		var swatch := Color(str(ItemDB.RARITY_COLOR.get(ItemDB.material_rarity(mn), "b8c0c8")))
		cost.add_child(_cost_chip(ItemDB.material_icon_path(mn), need, ok, _material_tooltip_bb(mn), swatch))
	var goldc := int(r.get("gold", 0))
	if goldc > 0:
		var gtip := "[b][color=#ffe080]Ouro[/color][/b]\n[color=#cfd3da]Custo de forja: %d[/color]" % goldc
		cost.add_child(_cost_chip("res://assets/ui/hud/gold.png", goldc, GameState.hero_gold >= goldc, gtip, Color("ffe080")))
	# AÇÃO (idêntica): forjar (habilitado) ou rótulo "faltam recursos"
	if craftable:
		var b := Button.new()
		b.text = "forjar"
		b.add_theme_font_size_override("font_size", 13)
		b.add_theme_color_override("font_color", Color("cfe8cf"))
		b.custom_minimum_size = Vector2(132, 0)
		b.pressed.connect(func(): _shop_craft(crid))
		row.add_child(b)
	else:
		var dl := Label.new()
		dl.text = "faltam recursos"
		dl.add_theme_font_size_override("font_size", 12)
		dl.modulate = Color(0.6, 0.55, 0.5)
		dl.custom_minimum_size = Vector2(132, 0)
		dl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		dl.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		row.add_child(dl)

## Chip de custo (RPG-SKIN): ícone do material/ouro + "xN", com tooltip de nome no hover. `ok=false`
## (falta o recurso) → ícone vermelho/apagado + número âmbar-avermelhado. Só apresentação.
func _cost_chip(icon_path: String, qty: int, ok: bool, bb: String, swatch: Color) -> Control:
	var chip := HBoxContainer.new()
	chip.add_theme_constant_override("separation", 2)
	chip.mouse_filter = Control.MOUSE_FILTER_PASS
	_attach_tip(chip, bb)
	var tx = _load_tex(icon_path)
	if tx != null:
		var ir := TextureRect.new()
		ir.texture = tx
		ir.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		ir.custom_minimum_size = Vector2(26, 26); ir.size = Vector2(26, 26)
		ir.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		ir.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		ir.modulate = Color(1, 1, 1, 1) if ok else Color(1.0, 0.5, 0.5, 0.5)   # falta → vermelho/apagado
		ir.mouse_filter = Control.MOUSE_FILTER_IGNORE
		chip.add_child(ir)
	else:
		var sw := ColorRect.new()
		sw.custom_minimum_size = Vector2(16, 16)
		sw.color = swatch if ok else Color(0.5, 0.3, 0.3, 0.6)
		sw.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		sw.mouse_filter = Control.MOUSE_FILTER_IGNORE
		chip.add_child(sw)
	var q := Label.new()
	q.text = "x%d" % qty
	q.add_theme_font_size_override("font_size", 12)
	q.modulate = Color("d8e0c8") if ok else Color("e0a0a0")
	q.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	q.mouse_filter = Control.MOUSE_FILTER_IGNORE
	chip.add_child(q)
	return chip

## Linha de "encomenda" do Ferreiro no painel da Forja (side-quest via serviço): aceitar/entregar/feito.
func _forge_commission_row(qid: String) -> void:
	var q: Dictionary = _quest_def(qid)
	var mat := str(q["mat"]); var need := int(q["need"])
	match GameState.sq_state(qid):
		"":
			_shop_button("📋 Encomenda do Dorn — traga %d %s (Caverna). Clique p/ ACEITAR." % [need, mat],
				Color("ffe08a"), func(): GameState.sq_set(qid, "active"))
		"active":
			var have := GameState.material_count(mat)
			if have >= need:
				_shop_button("📋 Encomenda PRONTA — entregar %d %s → %d ouro" % [need, mat, int(q["gold"])],
					Color("a9e0b0"), func(): _sidequest_reward(qid))
			else:
				_shop_button("📋 Encomenda: %s  %d/%d  (Caverna)" % [mat, mini(have, need), need], Color(0.7, 0.72, 0.78), null)
		_:
			pass   # concluída → não polui o painel

## Compra/forja que lembram o item p/ o atalho "equipar agora" (só se for equipável e der certo).
func _shop_buy(id: String) -> void:
	if GameState.buy_item(id):
		_shop_toast("Comprado: %s" % ItemDB.display_name(id), Color("9fe07a"))
		if ItemDB.is_equippable(id):
			_shop_last_item = id

## Compra um LOTE de flechas na loja (GODOT-ARROWS-SHOP-AMMO-1): +100 (ou o resto até o teto), gasta ouro.
func _buy_arrows() -> void:
	if GameState.buy_arrows_bundle(ARROW_BUY_PRICE):
		_shop_toast("+%d flechas" % GameState.ARROWS_BUNDLE, Color("9fe07a"))

func _shop_craft(id: String) -> void:
	if GameState.craft(id):
		_shop_toast("Forjado: %s" % ItemDB.display_name(id), Color("e8c267"))
		if ItemDB.is_equippable(id):
			_shop_last_item = id

## Venda (item/material) com toast de confirmação — wrappers p/ os botões da loja (GODOT-VERTICAL-SLICE-POLISH-AFK-1).
func _do_sell_item(id: String) -> void:
	if GameState.sell_item(id):
		_shop_toast("Vendido: +%d ouro" % ItemDB.sell_value(id), Color("a9e0b0"))

func _do_sell_material(mat_name: String) -> void:
	if GameState.sell_material(mat_name):
		_shop_toast("Vendido: +%d ouro" % ItemDB.material_value(mat_name), Color("a9e0b0"))

## Toast curto de confirmação da loja/forja no _popup_layer (acima do painel; sobrevive ao rebuild do
## _shop_root). Sobe e some sozinho. Só apresentação — não toca economia. Null-safe.
func _shop_toast(text: String, color: Color) -> void:
	if _popup_layer == null:
		return
	var vp := get_viewport_rect().size
	var l := Label.new()
	l.text = text
	l.add_theme_font_size_override("font_size", 18)
	l.add_theme_color_override("font_color", color)
	l.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.85))
	l.add_theme_constant_override("outline_size", 4)
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.size = Vector2(380, 26)
	l.position = Vector2(vp.x * 0.5 - 190.0, vp.y * 0.5 - 150.0)
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_popup_layer.add_child(l)
	var tw := create_tween()
	tw.tween_property(l, "position:y", l.position.y - 26.0, 0.85)
	tw.parallel().tween_property(l, "modulate:a", 0.0, 0.85)
	tw.tween_callback(l.queue_free)

## Linha contextual "equipar agora" (após comprar/forjar um equipável que ainda esteja na mochila).
func _shop_equip_hint() -> void:
	var iid := _shop_last_item
	if iid == "" or not ItemDB.is_equippable(iid) or GameState.backpack_count(iid) <= 0:
		_shop_last_item = ""   # já equipado / vendido / sumiu → não insistir
		return
	_shop_button("✓ %s na mochila — clique p/ EQUIPAR AGORA" % ItemDB.display_name(iid), Color("ffe08a"), func():
		_equip_with_feedback(iid)
		_shop_last_item = "")

## Texto do custo de uma receita ("Pano Rasgado x4, Carne Crua x2, 60 gold").
func _recipe_cost_text(r: Dictionary) -> String:
	var parts := PackedStringArray()
	var mats: Dictionary = r.get("materials", {})
	for m in mats:
		parts.append("%s x%d" % [str(m), int(mats[m])])
	var g := int(r.get("gold", 0))
	if g > 0:
		parts.append("%d ouro" % g)
	return ", ".join(parts)

## Painel translúcido estilizado (StyleBoxFlat) num canto; devolve o VBox de conteúdo.
## --- HUD COM SPRITES DO BANCO (GODOT-HUD-SPRITES-1) ---
## Barra emoldurada (NinePatch frame.png + preenchimento ColorRect + rótulo central com contorno).
## Retorna [root: Control, fill: ColorRect, label: Label, inner_w: float]. Atualize fill.size.x e label.text.
func _hud_bar(parent: Node, pos: Vector2, w: float, h: float, margin: int, fill_color: Color, font_size: int) -> Array:
	var root := Control.new()
	root.position = pos
	root.size = Vector2(w, h)
	parent.add_child(root)
	var frame := NinePatchRect.new()
	frame.texture = load(HUD_FRAME)
	frame.patch_margin_left = margin
	frame.patch_margin_right = margin
	frame.patch_margin_top = margin
	frame.patch_margin_bottom = margin
	frame.size = Vector2(w, h)
	root.add_child(frame)
	var inset := 7.0
	var fill := ColorRect.new()
	fill.color = fill_color
	fill.position = Vector2(inset, inset)
	fill.size = Vector2(w - 2.0 * inset, h - 2.0 * inset)
	root.add_child(fill)
	var lbl := Label.new()
	lbl.size = Vector2(w, h)
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	lbl.add_theme_font_size_override("font_size", font_size)
	lbl.add_theme_color_override("font_color", Color(1, 1, 1))
	lbl.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.85))
	lbl.add_theme_constant_override("outline_size", 4)
	root.add_child(lbl)
	return [root, fill, lbl, w - 2.0 * inset]

