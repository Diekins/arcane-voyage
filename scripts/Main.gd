## Monta os baús da região. PRECEDÊNCIA: se houver baús AUTORADOS no Studio (marker kind:"chest" num
## studio_*.json cujo map.id == region_id), usa-os; senão cai no fallback dev (`_chest_defs`). Dedup por
## id (Studio e fallback nunca duplicam). NÃO depende do Studio: sem export → fallback sempre presente.
func _build_chests(region_id: String) -> void:
	var defs := _studio_chest_defs(region_id)
	if defs.is_empty():
		defs = _chest_defs(region_id)   # fallback dev só quando NÃO há baús autorados
	var seen := {}
	for cfg in defs:
		var id := str(cfg.get("id", ""))
		if id == "":
			continue   # já avisado na normalização
		if seen.has(id):
			push_warning("[Chest] id duplicado ignorado em %s: %s" % [region_id, id])
			continue
		seen[id] = true
		_spawn_chest(cfg)

## Baús AUTORADOS pelo Studio p/ a região: acha o studio_*.json com map.id == region_id (via MapLoader),
## valida o schema mínimo e extrai os markers kind:"chest" normalizados. [] se não houver mapa/baús.
## Coordenadas dos baús são no espaço de mundo da região (mesmo de _chest_defs) — ver CHESTS_CONTRACT.md.
func _studio_chest_defs(region_id: String) -> Array:
	var ml := MapLoader.new()
	var path := ml.find_map_for_target(region_id)
	if path == "" or not ml.load_map_json(path):
		return []
	if not ml.validate_min().is_empty():
		push_warning("[Chest] studio map de '%s' inválido — baús autorados ignorados" % region_id)
		return []
	return _chests_from_maploader(ml)

## Extrai baús (markers kind:"chest") de um MapLoader já carregado, normalizados ao contrato.
func _chests_from_maploader(ml) -> Array:
	var out := []
	for mk in ml.markers:
		if mk is Dictionary and str(mk.get("kind", "")) == "chest":
			var cfg := _normalize_chest(mk)
			if not cfg.is_empty():
				out.append(cfg)
	return out

## Normaliza+valida um marker de baú ao contrato {id, x, y, loot}. {} (com warning) se inválido:
## id ausente ou x/y não-numéricos. Loot é saneado por _normalize_chest_loot.
func _normalize_chest(mk: Dictionary) -> Dictionary:
	var id := str(mk.get("id", ""))
	if id == "":
		push_warning("[Chest] marker chest sem id — ignorado")
		return {}
	if not (mk.has("x") and mk.has("y")):
		push_warning("[Chest] baú '%s' sem x/y — ignorado" % id)
		return {}
	return {"id": id, "x": float(mk.get("x", 0.0)), "y": float(mk.get("y", 0.0)),
		"loot": _normalize_chest_loot(mk.get("loot", {}), id)}

## Saneia o loot do contrato: gold>0 (negativo avisado/ignorado), materiais qtd>0, itens existentes no
## ItemDB. Campos inválidos viram warning e são DESCARTADOS (sem crash). Devolve só o que é válido.
func _normalize_chest_loot(raw, id: String) -> Dictionary:
	var loot := {}
	if not (raw is Dictionary):
		return loot
	var gold := int(raw.get("gold", 0))
	if gold > 0:
		loot["gold"] = gold
	elif gold < 0:
		push_warning("[Chest] '%s' gold<0 ignorado" % id)
	var rawmats = raw.get("materials", {})
	if rawmats is Dictionary:
		var mats := {}
		for m in rawmats:
			var q := int(rawmats[m])
			if q > 0:
				mats[str(m)] = q
			else:
				push_warning("[Chest] '%s' material '%s' qtd<=0 ignorado" % [id, str(m)])
		if not mats.is_empty():
			loot["materials"] = mats
	var rawitems = raw.get("items", [])
	if rawitems is Array:
		var items := []
		for iid in rawitems:
			if ItemDB.exists(str(iid)):
				items.append(str(iid))
			else:
				push_warning("[Chest] '%s' item inválido '%s' ignorado" % [id, str(iid)])
		if not items.is_empty():
			loot["items"] = items
	return loot

## Desenha um baú procedural (sem dependência de sprite). FECHADO = marrom + cadeado, registra como
## interagível; ABERTO (no save) = cinza/tampa erguida, inerte (não entra em _chests).
func _spawn_chest(cfg: Dictionary) -> void:
	var id := str(cfg.get("id", ""))
	if id == "":
		push_warning("[Chest] ignorado: baú sem id")
		return
	var pos := Vector2(float(cfg.get("x", 0.0)), float(cfg.get("y", 0.0)))
	var opened := GameState.is_chest_opened(id)
	var node := Node2D.new()
	node.position = pos
	node.z_index = int(pos.y)
	# sombra
	var sh := Polygon2D.new()
	var sp := PackedVector2Array()
	for i in range(14):
		var a := TAU * i / 14.0
		sp.append(Vector2(cos(a) * 20.0, sin(a) * 7.0 + 14.0))
	sh.polygon = sp
	sh.color = Color(0, 0, 0, 0.22)
	sh.z_index = -1
	node.add_child(sh)
	# corpo do baú
	var box := Polygon2D.new()
	box.polygon = PackedVector2Array([Vector2(-18, -4), Vector2(18, -4), Vector2(18, 12), Vector2(-18, 12)])
	box.color = Color("6b4a2a") if not opened else Color("4a4a4a")
	node.add_child(box)
	# tampa (fechada = arco baixo; aberta = erguida/inclinada)
	var lid := Polygon2D.new()
	if opened:
		lid.polygon = PackedVector2Array([Vector2(-18, -6), Vector2(18, -10), Vector2(18, -16), Vector2(-18, -12)])
		lid.color = Color("3a3a3a")
	else:
		lid.polygon = PackedVector2Array([Vector2(-18, -14), Vector2(18, -14), Vector2(18, -4), Vector2(-18, -4)])
		lid.color = Color("8a6332")
	node.add_child(lid)
	# cadeado/ferragem (só fechado)
	if not opened:
		var lock := Polygon2D.new()
		lock.polygon = PackedVector2Array([Vector2(-4, -8), Vector2(4, -8), Vector2(4, 2), Vector2(-4, 2)])
		lock.color = Color("d8b24a")
		node.add_child(lock)
	# prompt de interação
	var prompt := Label.new()
	prompt.text = "Abrir baú  [E]"
	prompt.position = Vector2(-44, -52)
	prompt.modulate = Color("e8c267")
	prompt.add_theme_font_size_override("font_size", 14)
	prompt.visible = false
	node.add_child(prompt)
	_region_node.add_child(node)
	# só FECHADO é interagível; aberto fica inerte (cenário)
	if not opened:
		_chests.append({"node": node, "prompt": prompt, "pos": pos, "id": id, "loot": cfg.get("loot", {})})

## Abre um baú: entrega o loot UMA vez (guard via GameState.open_chest), marca aberto no save, troca o
## visual p/ aberto e remove da lista de interagíveis. Baú já aberto = no-op (não duplica).
func _open_chest(chest: Dictionary) -> void:
	var id := str(chest.get("id", ""))
	if not GameState.open_chest(id):
		return   # já estava aberto (ex.: clique repetido) → nada a entregar
	var lines := _grant_chest_loot(chest.get("loot", {}))
	_chests.erase(chest)
	# troca o visual p/ "aberto": reconstrói o nó no lugar (sem sprite dependente)
	var node = chest.get("node")
	var npos: Vector2 = chest.get("pos", _player.position if _player != null else Vector2.ZERO)
	if node != null and is_instance_valid(node):
		node.queue_free()
	_spawn_chest({"id": id, "x": npos.x, "y": npos.y})   # respawn como ABERTO (opened=true no save)
	var msg := ("Baú: " + ", ".join(lines)) if not lines.is_empty() else "Baú vazio."
	_show_reward_popup(msg)
	_spawn_world_text(npos, "Baú aberto", Color("ffe08a"), -34.0)

## Entrega o loot de um baú (gold/materiais/itens). Item inválido (não existe no ItemDB) é IGNORADO
## com warning (sem crash). Retorna as linhas legíveis do que foi concedido (p/ o popup).
func _grant_chest_loot(loot) -> Array:
	var lines := []
	if typeof(loot) != TYPE_DICTIONARY:
		return lines
	var gold := int(loot.get("gold", 0))
	if gold > 0:
		GameState.add_gold(gold)
		lines.append("+%d ouro" % gold)
	var mats = loot.get("materials", {})
	if mats is Dictionary:
		for m in mats:
			var q := int(mats[m])
			if q > 0:
				GameState.add_material(str(m), q)
				lines.append("%s x%d" % [str(m), q])
	var items = loot.get("items", [])
	if items is Array:
		for iid in items:
			if ItemDB.exists(str(iid)):
				GameState.backpack_add(str(iid), 1)
				lines.append(ItemDB.display_name(str(iid)))
			else:
				push_warning("[Chest] item inválido ignorado no loot: %s" % str(iid))
	return lines

## Despacha o serviço pelo seu tipo.
func _use_service(svc) -> void:
	match str(svc.get("kind", "")):
		"healer": _use_healer()
		"quest_board": _use_quest_board()
		"shrine": _use_shrine()
		"swamp_spring": _use_swamp_spring()
		"stash": _open_stash()   # Baú do Errante (GODOT-VILLAGE-STASH-MVP-1)
		"future_exit": _use_future_exit(svc)
		"story_marker": _use_story_marker(svc)   # marco one-time editor-authored (GODOT-MAPLOADER-SERVICES-INTERACTIONS-PILOT-1)

## Marco one-time editor-authored (GODOT-MAPLOADER-SERVICES-INTERACTIONS-PILOT-1): na 1ª vez seta a story_flag e
## dá a recompensa (xp/ouro/itens — reusa add_xp/add_gold/backpack_add, sem ItemDB/economia nova); depois, só
## o texto de "já reclamado". IDEMPOTENTE via set_story_flag (sem campo de save novo). Reward/flag/textos vêm do JSON.
func _use_story_marker(svc) -> void:
	if _campaign_progress_locked():
		_show_local_dialogue(str(svc.get("title", "Marco")), ["(área de teste do mundo contínuo) este marco não conta aqui."])
		return   # macro = sandbox: não seta story_flag nem concede a recompensa one-time canônica
	var flag := str(svc.get("flag", ""))
	var before = svc.get("dialogue_before", [])
	var after = svc.get("dialogue_after", [])
	var title := str(svc.get("title", "Marco"))
	if flag != "" and GameState.is_story_flag(flag):
		_show_local_dialogue(title, after if not (after as Array).is_empty() else ["Você já recolheu o que havia aqui."])
		return
	# 1ª vez: seta a flag (idempotente) e concede a recompensa
	var granted := []
	if flag == "" or GameState.set_story_flag(flag):
		var reward = svc.get("reward", {})
		if typeof(reward) == TYPE_DICTIONARY:
			var xp := int(reward.get("xp", 0))
			var gold := int(reward.get("gold", 0))
			if xp > 0:
				GameState.add_xp(xp); granted.append("+%d XP" % xp)
			if gold > 0:
				GameState.add_gold(gold); granted.append("+%d ouro" % gold)
			for iid in reward.get("items", []):
				if ItemDB.exists(str(iid)):
					GameState.backpack_add(str(iid), 1); granted.append(ItemDB.display_name(str(iid)))
				else:
					push_warning("[StoryMarker] item inválido ignorado: %s" % str(iid))
	var lines := []
	for ln in before:
		lines.append(str(ln))
	if not granted.is_empty():
		lines.append("Recompensa: " + ", ".join(granted) + ".")
	if lines.is_empty():
		lines = ["..."]
	_show_local_dialogue(title, lines)

## Curandeira: restaura o HP do Errante ao máximo atual (sem custo, sem mexer em inventário).
func _use_healer() -> void:
	# RECURSOS DE CLASSE: repõe só MANA (regenera por design). FLECHAS agora são munição comprada na loja da
	# Sila (GODOT-ARROWS-SHOP-AMMO-1) → NÃO entram no refill grátis (loop de gastar→comprar). Não toca ouro.
	GameState.restore_mana_full()
	# Identidade diegética por LOCAL (GODOT-CARAVAN-CAMP-DIEGETIC-POLISH-1): no Acampamento de Caravana o
	# "healer" é o braseiro dos viajantes (sem a Curandeira da Vila). Comportamento idêntico (HP+mana).
	var in_camp := GameState.is_current_region("khet_caravan_camp")
	var in_post := GameState.is_current_region("khet_waystation")   # Posto de Khet-Sar (editor-authored)
	var who := "Curandeira Lysa"
	if in_camp:
		who = "Braseiro dos Viajantes"
	elif in_post:
		who = "Descanso do Posto"
	if GameState.hero_hp >= GameState.hero_hp_max:
		var full_line := "Você já está em plena forma, Errante. Mana reposta — siga em paz."
		if in_camp:
			full_line = "Você se senta junto ao fogo, mas já está inteiro. Mana reposta — siga quando quiser."
		elif in_post:
			full_line = "O posto está calmo; você já está inteiro. Mana reposta — bom descanso."
		_show_local_dialogue(who, [full_line])
		return
	GameState.reset_hero_hp()   # HP atual → máximo
	_heal_vfx()
	if _player != null:
		_spawn_world_text(_player.position, "HP restaurado", Color("9fe0a0"), -8.0)
	if in_camp:
		_show_local_dialogue(who, [
			"O calor do braseiro afrouxa os músculos cansados da estrada.",
			"Feridas tratadas — HP restaurado ao máximo; a mana voltou a fluir.",
		])
	else:
		_show_local_dialogue(who, [
			"Descanse um momento... pronto.",
			"Suas feridas foram tratadas — HP restaurado ao máximo.",
		])

## Fonte de Água Férrea (GODOT-SWAMP-QUESTS-AND-SERVICE-1): cura PARCIAL (40% do HP máx), UMA vez por
## visita ao Pântano (flag transiente _swamp_heal_used, reabastece ao reentrar; NÃO persiste no save).
## Menos conveniente que a curandeira da Vila (cura cheia/ilimitada) — apoio mínimo de sobrevivência.
func _use_swamp_spring() -> void:
	if _swamp_heal_used:
		_show_local_dialogue("Fonte de Água Férrea", [
			"A água turvou — o ferro assentou no fundo.",
			"Espere a fonte assentar (ou descanse na Vila).",
		])
		return
	var maxhp := GameState.max_hp_total()
	if GameState.hero_hp >= maxhp:
		_show_local_dialogue("Fonte de Água Férrea", ["Você já está em plena forma, Errante."])
		return
	var amt := int(ceil(float(maxhp) * 0.4))
	GameState.heal_hero(amt)
	_swamp_heal_used = true
	_heal_vfx()
	if _player != null:
		_spawn_world_text(_player.position, "+%d HP" % amt, Color("9fe0a0"), -8.0)
	_show_local_dialogue("Fonte de Água Férrea", [
		"A água morna e metálica revigora um pouco. (+%d HP)" % amt,
		"A fonte turva — beba de novo só na próxima passagem.",
	])

## Marcador visual da fonte (procedural): poça de água escura + aro de musgo. Sem colisão (atravessável).
func _build_swamp_spring(pos: Vector2) -> void:
	var node := Node2D.new()
	node.position = pos
	node.z_index = -15
	var ring := Polygon2D.new()
	var rp := PackedVector2Array()
	for i in range(16):
		var a := TAU * i / 16.0
		rp.append(Vector2(cos(a) * 42.0, sin(a) * 26.0))
	ring.polygon = rp
	ring.color = Color(0.22, 0.30, 0.22, 0.85)   # aro de musgo
	node.add_child(ring)
	var water := Polygon2D.new()
	var wp := PackedVector2Array()
	for i in range(16):
		var a := TAU * i / 16.0
		wp.append(Vector2(cos(a) * 32.0, sin(a) * 19.0))
	water.polygon = wp
	water.color = Color(0.18, 0.34, 0.36, 0.95)   # água férrea (ciano-esverdeado escuro)
	node.add_child(water)
	_region_node.add_child(node)

## --- FUTURE_EXIT (GODOT-NORTH-REGION-1): saída VISÍVEL e BLOQUEADA (promessa de mundo) ---
## Interagível LOCAL (reusa _services, kind "future_exit") que ao [E] só mostra um texto — NÃO troca de
## região. `id` estável + `target_doc` documentam o destino FUTURO (não implementado aqui). Sem sistema
## global de world-gates: é só um marcador local. Visual = boca de gruta escura cruzada por raízes negras.
func _build_future_exit(pos: Vector2, id: String, title: String, msg: Array, target_doc: String = "deep_grove") -> void:
	var node := Node2D.new()
	node.position = pos
	node.z_index = int(pos.y)
	_add_ground_shadow(node, 46.0, 14.0, 6.0)
	# boca de gruta (escura)
	var mouth := Polygon2D.new()
	var mp := PackedVector2Array()
	for i in range(18):
		var a := TAU * i / 18.0
		mp.append(Vector2(cos(a) * 58.0, sin(a) * 44.0 - 18.0))
	mouth.polygon = mp
	mouth.color = Color(0.04, 0.05, 0.06, 1.0)
	node.add_child(mouth)
	# raízes negras cruzando a boca (selo)
	for i in range(5):
		var root := ColorRect.new()
		root.size = Vector2(118, 9)
		root.position = Vector2(-59, -52 + i * 16)
		root.rotation = (-0.18 if i % 2 == 0 else 0.16)
		root.color = Color(0.10, 0.09, 0.08, 0.96)
		node.add_child(root)
	# pulso frio entre as raízes (toque de magia "além")
	var pulse := Polygon2D.new()
	var pp := PackedVector2Array()
	for i in range(12):
		var a := TAU * i / 12.0
		pp.append(Vector2(cos(a) * 22.0, sin(a) * 16.0 - 16.0))
	pulse.polygon = pp
	pulse.color = Color(0.34, 0.6, 0.7, 0.22)
	node.add_child(pulse)
	var prompt := Label.new()
	prompt.text = "[E] examinar a passagem selada"
	prompt.position = Vector2(-92, -78)
	prompt.modulate = Color("c9b6e0")
	prompt.add_theme_font_size_override("font_size", 14)
	prompt.visible = false
	node.add_child(prompt)
	_tag_on_top(prompt)
	_region_node.add_child(node)
	# registra como serviço kind "future_exit" (interação por proximidade, igual aos demais serviços)
	_services.append({"node": node, "prompt": prompt, "pos": pos, "kind": "future_exit", "id": id, "title": title, "msg": msg, "target_doc": target_doc})

## Interage com a future_exit: SÓ mostra o texto (não transporta). O `target_doc` fica documentado p/ quando
## a região destino existir (aí vira um _build_portal normal). Promessa de mundo, não bug.
func _use_future_exit(svc) -> void:
	# BARCO DA COSTA (GODOT-COAST-BOAT-REPAIR-QUEST-1): o cais quebrado vira turn-in de reparo (payoff).
	if str(svc.get("id", "")) == "coast_sea_gate":
		_coast_boat_interact()
		return
	# GESTO DO ERRANTE no cais (EASTERN_SEA_BUILD_03): assentar uma tábua com o Cael. Opcional, em-sessão, SEM save.
	if str(svc.get("id", "")) == "cais_gesture":
		_cais_gesture(svc)
		return
	# A VELA NA JANELA (THE_HOMESTEAD_BUILD_01): renovar a vela da Casa Guardada. Em-sessão (a chama firma um instante),
	# SEM save/recompensa/sistema — você participa do "deixar pronto" da Morada.
	if str(svc.get("id", "")) == "casa_vela":
		_casa_vela_gesture(svc)
		return
	# DEIXAR SUA MARCA NO POSTE (THE_HOMESTEAD_BUILD_02): o gesto do Limiar. Em-sessão, sem save/recompensa/sistema.
	if str(svc.get("id", "")) == "limiar_mark":
		_limiar_mark_gesture(svc)
		return
	# BATER O FERRO (THE_HOMESTEAD_BUILD_03): o gesto das Raízes (o continuar). Em-sessão, sem save/recompensa/sistema.
	if str(svc.get("id", "")) == "forja_bater":
		_forja_bater_gesture(svc)
		return
	# RITUAL DA VIGÍLIA (THE_STONE_BUILD_07): "Carregar um Nome" com a Guardiã dos Nomes. Em-sessão, SEM save/recompensa.
	if str(svc.get("id", "")) == "stone_guard":
		_stone_carry_a_name(svc)
		return
	# O CAMINHO AO PROMONTÓRIO (R02→R03): o Vigia da Maré "guarda a passagem" — com tide_watcher_passed, o caminho
	# abre (R03 ainda não construída → texto-placeholder); sem a flag, o Vigia bloqueia. (THE_OTHER_SHORE_BUILD_02)
	if str(svc.get("id", "")) == "cais_promontorio":
		if GameState.is_story_flag("tide_watcher_passed"):
			_pending_spawn = PROMONTORIO_SPAWN
			load_region("promontorio_do_espelho")   # R03: a revelação (THE_OTHER_SHORE_BUILD_03)
		else:
			_show_local_dialogue("o caminho ao promontório", [
				"A trilha segue a maré para o leste, rumo a um penhasco alto.",
				"Mas o Vigia da Maré a cruza, indo e vindo, sem nunca passar. Enquanto ele vigiar, ninguém passa.",
			])
		return
	# HORIZONTE ABERTO da Ilha: com salt_isle_cleared, ZARPA p/ os Areais de Khet-Sar (novo continente,
	# GODOT-KHET-SAR-SANDS-MVP-1); sem a flag, mantém o texto de bloqueio (gate = a própria flag).
	if str(svc.get("id", "")) == "salt_isle_horizon":
		if GameState.is_story_flag("salt_isle_cleared"):
			_pending_spawn = KHET_SPAWN
			load_region("khet_sar_sands")
		else:
			_show_local_dialogue("Horizonte Aberto", [
				"O mar adiante ruge para além da fenda de sal.",
				"O Guardião do Sal Partido ainda domina a ilha — vença-o antes de sonhar com o que há além.",
			])
		return
	# DUNAS PROFUNDAS (Khet-Sar): com a Sentinela caída, ADENTRA o Acampamento de Caravana
	# (GODOT-KHET-CARAVAN-CAMP-MVP-1, 1º hub do novo continente); sem a flag, mantém o texto de bloqueio
	# (gate = a própria flag, mesmo padrão do Horizonte→Khet-Sar).
	if str(svc.get("id", "")) == "khet_deep_dunes":
		if GameState.is_story_flag("khet_sar_sentinel_defeated"):
			_pending_spawn = KHET_CAMP_SPAWN
			load_region("khet_caravan_camp")
		else:
			_show_local_dialogue("Dunas Profundas", [
				"O vento quente sopra do interior, carregando areia e o eco de algo que vigia.",
				"A Sentinela de Khet-Sar guarda a passagem — derrote-a antes de adentrar as dunas profundas.",
			])
		return
	# ALTAR DE SAL (Oásis): lore do mini-evento "Eco do Sal" (GODOT-KHET-OASIS-SALT-ECHO-EVENT-1). SÓ texto —
	# o "combate" são os mobs ao redor (spawnados enquanto NÃO limpo); a recompensa/flag vêm da morte do Eco.
	# Texto muda após khet_oasis_salt_echo_cleansed. NÃO transporta, NÃO dá recompensa aqui (idempotência no kill).
	if str(svc.get("id", "")) == "khet_oasis_salt_altar":
		if GameState.is_story_flag("khet_oasis_salt_echo_cleansed"):
			_show_local_dialogue("Altar de Sal", [
				"O altar repousa quieto, os cristais frios sob a mão. A água do oásis voltou a ser doce.",
				"Resta o eco distante da estrada — os portões de Khet-Sar ainda aguardam.",
			])
		else:
			_show_local_dialogue("Altar de Sal", [
				"A água tem gosto de sal e ferro. No altar, marcas gastas de caravanas que passaram — e algo responde ao teu toque.",
				"Formas de sal e vento se erguem das dunas ao redor. Silencie o Eco do Sal e a água há de aquietar.",
			])
		return
	# PORTÕES DA CIDADE (Acampamento) → CIDADE DE KHET-SAR (GODOT-KHET-SAR-CITY-RUNTIME-LINK-1): agora TRANSPORTA
	# p/ khet_sar_city (editor-authored via MapLoader). Gate = caravan_camp_reached (já setado ao construir o camp,
	# linha ~1734 → trivialmente aberto aqui; reusa flag existente, ZERO sistema novo). Entrada usa a spawn do
	# manifesto (850,940) — não seto _pending_spawn (load_region cai em _region_spawn → spawn do JSON).
	if str(svc.get("id", "")) == "khet_city_gate":
		if GameState.is_story_flag("caravan_camp_reached"):
			load_region("khet_sar_city")
		else:
			_show_local_dialogue("Portões da Cidade", [
				"Para além das tendas, muralhas de adobe recortam o horizonte — a cidade de Khet-Sar, erguida sobre o sal e a areia.",
				"Os guardas da caravana dizem que seus portões ainda permanecem fechados ao forasteiro. Por ora, descanse no acampamento.",
			])
		return
	_show_local_dialogue(str(svc.get("title", "Passagem Selada")), svc.get("msg", ["A passagem está bloqueada."]))
	if str(svc.get("id", "")).begins_with("curio_"):
		_mark_discovery_seen(svc)   # P0.1: a descoberta deixa um RASTRO (assenta o marco), não um prêmio

## P0.1 — DESCOBERTA = RASTRO, não prêmio. Ao OBSERVAR um marco/micro-história ([E]), ele ASSENTA em sessão: o pulso
## "respirando" para, o halo dá uma última respiração e descansa numa brasa baixa e estável, e o prompt perde o ✦
## (segue relegível como "[E] …"). Reconhecimento atmosférico SEM save/contador/coleção/recompensa — só sinaliza que
## algo foi VISTO. Idempotente por nó (set_meta). Em região recarregada o marco volta a respirar (o mundo não mantém
## livro-razão; só reage à sua presença).
func _mark_discovery_seen(svc) -> void:
	var node = svc.get("node")
	if node == null or not is_instance_valid(node):
		return
	if node.has_meta("av_seen"):
		return
	node.set_meta("av_seen", true)
	# halo: para o pulso e assenta numa brasa quieta (uma respiração final → descanso). Sem palavras, sem número.
	var pulse = svc.get("pulse")
	if pulse != null and pulse is Tween and pulse.is_valid():
		pulse.kill()
	var halo = svc.get("halo")
	if halo != null and is_instance_valid(halo):
		halo.color = Color(0.85, 0.62, 0.34, 0.10)   # brasa morna em repouso (mais quente/apagada que o chamado)
		if node.is_inside_tree():
			var tw: Tween = node.create_tween()
			tw.tween_property(halo, "modulate:a", 1.0, 0.25).set_trans(Tween.TRANS_SINE)   # respiração final
			tw.tween_property(halo, "modulate:a", 0.6, 0.9).set_trans(Tween.TRANS_SINE)    # e descansa
		else:
			halo.modulate.a = 0.6
	# prompt: deixa de "chamar" (cai o ✦) e esmaece um tom; continua relegível para quem quiser reler.
	var prompt = svc.get("prompt")
	if prompt != null and is_instance_valid(prompt):
		prompt.text = str(prompt.text).replace("✦ [E] ", "[E] ")
		prompt.modulate = Color(0.82, 0.76, 0.62, 0.85)

## Reparo do Barco da Costa (GODOT-COAST-BOAT-REPAIR-QUEST-1): turn-in de materiais costeiros no barco
## encalhado. ANTES: lista requisitos (have/need) sem consumir nada. COM TUDO: consome EXATAMENTE os
## requisitos, seta a flag boat_repaired, dá recompensa modesta. DEPOIS: estado pronto (NÃO transporta —
## open_sea fica para o Pacote C). Reusa material_count/consume_material/story_flag/add_xp/add_gold/
## backpack_add/_show_local_dialogue. Não toca drops/economia/portais/contratos da Costa.
const BOAT_REPAIR_REQ := {"Madeira de Naufrágio": 5, "Sal Cristalizado": 3, "Concha Polida": 2}
const BOAT_REPAIR_XP := 90
const BOAT_REPAIR_GOLD := 60
func _coast_boat_interact() -> void:
	# JÁ REPARADO → ZARPA para o Banco de Areia dos Náufragos (GODOT-CASTAWAY-SANDBAR-MVP-1). O gate é a flag
	# boat_repaired (set no reparo) → só transporta com o barco consertado. Spawn na ponta sudoeste do banco.
	if GameState.is_story_flag("boat_repaired"):
		_pending_spawn = SANDBAR_SPAWN
		load_region("castaway_sandbar")
		return
	# checa requisitos (sem consumir): monta have/need e descobre se falta algo
	var tem_tudo := true
	var linhas_req := PackedStringArray()
	for mat in BOAT_REPAIR_REQ:
		var need := int(BOAT_REPAIR_REQ[mat])
		var have := GameState.material_count(str(mat))
		if have < need:
			tem_tudo = false
		linhas_req.append("• %s  %d/%d" % [str(mat), mini(have, need), need])
	if not tem_tudo:
		var lines := ["O barco encalhado tem o casco rachado e a vela podre. Para consertá-lo, reúna:"]
		lines.append_array(linhas_req)
		lines.append("Cace pela Costa — os destroços e o sal vêm das criaturas da maré.")
		_show_local_dialogue("Reparar o Barco", lines)
		return
	# TEM TUDO → consome exatamente os requisitos, repara, recompensa
	for mat in BOAT_REPAIR_REQ:
		GameState.consume_material(str(mat), int(BOAT_REPAIR_REQ[mat]))
	GameState.set_story_flag("boat_repaired")
	GameState.add_xp(BOAT_REPAIR_XP)
	GameState.add_gold(BOAT_REPAIR_GOLD)
	GameState.backpack_add("potion_mana", 1)
	_show_local_dialogue("Barco Reparado", [
		"As tábuas rangem, o sal cede, e o barco volta a respirar.",
		"Recompensa: %d XP, %d ouro e 1 Poção de Mana." % [BOAT_REPAIR_XP, BOAT_REPAIR_GOLD],
		"A rota ao leste ainda dorme — a travessia fica para uma próxima jornada.",
	])

## EASTERN_SEA_BUILD_03 — o PRIMEIRO GESTO do Errante na travessia: assentar uma tábua com o Cael. OPCIONAL.
## Em-sessão (sem save/flag), sem recompensa, sem objetivo: a tábua solta vai pro vão do cais e uma linha contida
## muda só a percepção ("coloquei a mão nisso"). Nada parte, nada abre. Idempotente por nó (set_meta).
func _cais_gesture(svc) -> void:
	var node = svc.get("node")
	if node != null and node.has_meta("av_gesture_done"):
		_show_local_dialogue("O Cais", [
			"A tábua que você assentou continua ali. O Cael acena com a cabeça, sem parar de martelar.",
		])
		return
	var plank = svc.get("plank")
	var to: Vector2 = svc.get("plank_to", Vector2.ZERO)
	if plank != null and is_instance_valid(plank) and plank.is_inside_tree():
		var tw: Tween = plank.create_tween()
		tw.set_parallel(true)
		tw.tween_property(plank, "position", to, 0.6).set_trans(Tween.TRANS_SINE)
		tw.tween_property(plank, "rotation", 0.0, 0.6).set_trans(Tween.TRANS_SINE)
		tw.tween_property(plank, "color", Color("8a6a40"), 0.5)
	elif plank != null and is_instance_valid(plank):
		plank.position = to; plank.rotation = 0.0
	if node != null:
		node.set_meta("av_gesture_done", true)
		var pr = svc.get("prompt")
		if pr != null:
			pr.text = "[E] o cais — há uma tábua sua aqui"
	_show_local_dialogue("Uma Tábua a Mais", [
		"Você segura a tábua no lugar enquanto as mãos trêmulas do Cael a pregam. Leva um instante.",
		"— Obrigado. Mais uma. Um dia chega. — ele diz, sem parar.",
		"Nada parte. Nada se abre. Mas agora há uma marca sua nesta travessia.",
	])

