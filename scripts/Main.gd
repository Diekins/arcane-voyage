## Planície com grama/terra reais (tiled via Sprite2D + texture_repeat) + props (árvores/pedras/
## arbustos/flores) + entrada de caverna real. Sem colisão (props são visuais).
func _build_plains_map(size: Vector2) -> void:
	var base := ColorRect.new()   # base verde por baixo (seguro caso o texture_repeat não tile)
	base.size = size
	base.color = Color("3c6b34")
	base.z_index = -21
	_region_node.add_child(base)
	var grass := Sprite2D.new()
	grass.texture = _try_load_tex("res://assets/tilesets/plains/grass.png")
	grass.centered = false
	grass.texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
	grass.region_enabled = true
	grass.region_rect = Rect2(0, 0, size.x, size.y)
	grass.z_index = -20
	_region_node.add_child(grass)
	# caminho de terra (faixa horizontal cruzando o mapa, na altura das clareiras jogáveis)
	var path := Sprite2D.new()
	path.texture = _try_load_tex("res://assets/tilesets/plains/dirt.png")
	path.centered = false
	path.texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
