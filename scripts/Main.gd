	var stash_pos := Vector2(_size.x * 0.58, _size.y * 0.78)
	_build_service(stash_pos, "stash", "[E] abrir o Baú do Errante")
	_build_stash_chest(stash_pos)
	# ★ A CASA GUARDADA + MAREN (THE_HOMESTEAD_BUILD_01): a Vila = "a Morada". Um lar tido em pé para um ausente que
