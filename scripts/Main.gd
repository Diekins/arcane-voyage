## Aplica a FORMA/FRASE da TABELA (ou do cfg inline, que vence) a um mob. Default circle = legado.
## (COMBAT_LANGUAGE_PASS_01 + BOSS_IDENTITY_PASS_01: `cycle` = frase de boss.)
func _apply_combat_language(mob: Node2D, cfg: Dictionary) -> void:
	var lang: Dictionary = MOB_COMBAT_LANGUAGE.get(str(cfg.get("id", "")), {})
	var cycle: Array = cfg.get("tele_cycle", lang.get("cycle", []))
	var shp: String
	var rch: float
	var cone_d: float
	var half_w: float
	if not cycle.is_empty():
		var b0: Dictionary = cycle[0]   # 1º beat = representante (fallback + piso de windup)
		shp = str(b0.get("shape", "circle"))
		rch = float(b0.get("reach", 220.0))
		cone_d = float(b0.get("cone", 70.0))
		half_w = float(b0.get("half", 36.0))
	else:
		shp = str(cfg.get("tele_shape", lang.get("shape", "circle")))
		rch = float(cfg.get("tele_reach", lang.get("reach", 220.0)))
		cone_d = float(cfg.get("cone_deg", lang.get("cone", 70.0)))
		half_w = float(cfg.get("tele_half_width", 36.0))
	mob.set("telegraph_cycle", cycle)
	mob.set("telegraph_shape", shp)
	mob.set("telegraph_reach", rch if rch > 0.0 else 220.0)
	mob.set("telegraph_half_width", half_w)
	mob.set("cone_degrees", cone_d)
	# LEGIBILIDADE: um telegraph com FORMA precisa de um instante visível; piso suave de windup p/ shaped (0.3s).
	# NÃO toca dano/HP/cooldown/XP/alcance-de-ataque — só o tempo do aviso (o objetivo é justamente ficar legível).
	if shp != "circle" or not cycle.is_empty():
		mob.set("windup_time", maxf(0.3, float(cfg.get("windup", 0.4))))

## Cria todos os mobs de UMA config (mesmo tipo/stat/loot) nos seus spawns. Várias configs por
## região = variedade de mobs (mesma engine de Mob.gd; NÃO é sistema novo).
func _spawn_mob_group(cfg: Dictionary) -> void:
	for spawn in cfg["spawns"]:
		var mob := Node2D.new()
		mob.set_script(load("res://scripts/Mob.gd"))
		mob.position = spawn + _mob_build_offset   # macro: +offset → coords GLOBAIS (0 em produção)
		mob.set("mob_id", cfg["id"])
		mob.set("visual_key", cfg.get("visual", ""))   # reusa arte de outro mob (WAVE-2); "" = usa o próprio id
		mob.set("mob_name", cfg["name"])
		# FATIA A3: guarda os STATS-BASE IMUTÁVEIS e aplica o stage scaling da fase corrente (deriva do base).
		# NÃO muta o catálogo (cfg é um dict literal fresco por chamada). Encounter recebe o multiplicador extra.
		var base_hp := int(cfg["hp"])
		var base_dmin := int(cfg["dmg_min"])
		var base_dmax := int(cfg["dmg_max"])
		mob.set("has_base_stats", true)
		mob.set("base_max_hp", base_hp)
		mob.set("base_damage_min", base_dmin)
		mob.set("base_damage_max", base_dmax)
		var s_hp := base_hp
		var s_dmin := base_dmin
		var s_dmax := base_dmax
		if _stagedirector != null:
			var sc: Dictionary = _stagedirector.scale_for_current(base_hp, base_dmin, base_dmax)
			s_hp = int(sc["max_hp"]); s_dmin = int(sc["damage_min"]); s_dmax = int(sc["damage_max"])
		mob.set("max_hp", s_hp)
		mob.set("xp_reward", cfg["xp"])
		mob.set("gold_reward", cfg["gold"])
		mob.set("damage_min", s_dmin)
		mob.set("damage_max", s_dmax)
		mob.set("aggro_range", cfg["aggro"])
		mob.set("attack_range", cfg["atk_range"])
		mob.set("attack_cooldown", cfg["cooldown"])
		mob.set("windup_time", cfg.get("windup", 0.4))
		mob.set("recover_time", cfg.get("recover", 0.25))
		mob.set("speed", cfg["speed"])
		mob.set("respawn_seconds", cfg["respawn"])
		mob.set("body_color", cfg["color"])
		mob.set("body_radius", cfg["radius"])
		mob.set("shape", cfg["shape"])
		# LINGUAGEM DE COMBATE (COMBAT_LANGUAGE_PASS_01): a FORMA do telegraph vem da TABELA por família (mob_id),
		# data-driven; ausente da tabela = "circle" (legado idêntico). Cfg inline ("tele_shape"…) sobrescreve a tabela.
		_apply_combat_language(mob, cfg)
		mob.set("side_faces_left", cfg.get("side_left", false))
		mob.set("can_flip", cfg.get("can_flip", true))
		mob.set("show_back", cfg.get("show_back", false))   # default false = perfil ao subir; true reativa a arte de costas (Coloso)
		mob.set("can_wander", cfg.get("can_wander", true))
		mob.set("wander_radius", cfg.get("wander_radius", 120.0))
		# RANGED opcional (GODOT-RANGED-COMBAT-MVP-1): default false → melee inalterado
		mob.set("ranged", cfg.get("ranged", false))
		mob.set("projectile_speed", cfg.get("proj_speed", 420.0))
		mob.set("projectile_color", cfg.get("proj_color", Color(0.86, 0.93, 0.97)))
		mob.set("projectile_impact_vfx", cfg.get("impact_vfx", "impact_blue_magic"))
		mob.set("projectile_hit_radius", cfg.get("proj_hit_radius", 70.0))
		mob.set("loot_table", cfg["loot"])
		# LINGUAGEM DOS GUARDIÕES: tematiza o telegraph (cor/raio) p/ elites-guardião — ANTES do add_child (Mob._ready lê).
		var gtel = GUARDIAN_TELEGRAPH.get(str(cfg["id"]), null)
		if gtel != null:
			mob.set("telegraph_color", gtel["color"])
			mob.set("telegraph_scale", gtel["scale"])
		_region_node.add_child(mob)
		if _macro_mode:
			mob.z_index = 0   # macro: grupo y-sort (z=0 relativo); _update_depth_sort não mexe sob _macro_mode
			mob.z_as_relative = true
		else:
			mob.z_index = int(spawn.y)   # produção: y-sort manual (atualizado por _update_depth_sort ao mover)
		mob.call("set_blockers", _blockers)   # macro: _blockers já é o conjunto GLOBAL completo (pass após o loop de zonas)
		if is_instance_valid(_player): mob.call("set_player", _player)   # guard: nunca passar um player liberado
		mob.connect("died", _on_mob_died)
		mob.connect("attack_hero", _on_enemy_attack.bind(mob))
		_mobs.append(mob)

