	match region_id:
		"plains": return Color("3c6b34")   # verde-grama
		"cave": return Color("1b2030")      # rocha escura
		"swamp": return Color("2c352a")     # lodo verde-oliva escuro (Pântano de Ferro)
		"iron_channels": return Color("20281f")  # lodo de ferro mais ESCURO/morto (mais fundo no brejo que o Pântano)
		"swamp_pit": return Color("181d1a")  # fundo do poço: bem escuro/subterrâneo
		"old_road": return Color("4a4636")   # terra/pedra seca da estrada velha (poeira/musgo)
		"ashen_grove": return Color("23282a") # solo de cinza/folhas mortas do bosque arcano (escuro/frio)
		"deep_grove": return Color("15171a")  # coração das raízes: solo mais escuro/antigo (subterrâneo do bosque)
