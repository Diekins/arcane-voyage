func _build_wolf(pos: Vector2) -> Node2D:
	var node := Node2D.new()
	node.name = "Wolf"
	node.set_script(load("res://scripts/Wolf.gd"))
	node.position = pos
	# HP derivado de bosses.json (wolf-alpha.knownStats.hp ≈ 150); senão default 60.
	# Setar ANTES de add_child para o _ready() do Wolf inicializar hp = hp_max corretamente.
	var hp_from_data := _boss_hp_from_data("wolf-alpha")
	if hp_from_data > 0:
		node.set("hp_max", hp_from_data)
	node.z_index = int(pos.y)   # y-sort inicial (atualizado por _update_depth_sort ao mover)
	_region_node.add_child(node)
	# usar métodos de Object (call/connect) p/ não exigir o tipo estático do script Wolf.
	if is_instance_valid(_player): node.call("set_player", _player)   # guard: nunca passar um player liberado
	node.connect("defeated", _on_boss_defeated)
	node.connect("attack_hero", _on_enemy_attack.bind(node))
	_register_boss_base_and_scale(node)   # FATIA A3.75: base imutável + scaling de fase inicial
	# se o save já marca o Lobo como derrotado, nasce derrotado (sem re-disparar guardian-felled).
	if GameState.has_defeated_boss("Lobo Alfa"):
		node.call("force_defeated_state")
	return node

## FATIA A3.75 — grava os STATS-BASE IMUTÁVEIS do boss e aplica o scaling da fase corrente (encontro de
## BOSS). Deriva do base (a config data/@export) → nunca acumula. Só age se o nó tem os campos base.
func _register_boss_base_and_scale(node) -> void:
	if node == null or not is_instance_valid(node):
		return
	if not (node.get("has_base_stats") != null):
		return   # nó sem os campos base (defesa; Wolf/Golem têm)
	node.set("has_base_stats", true)
	node.set("base_max_hp", int(node.get("hp_max")))
	node.set("base_damage_min", int(node.get("damage_min")))
	node.set("base_damage_max", int(node.get("damage_max")))
	if _stagedirector != null:
		var sc: Dictionary = _stagedirector.scale_boss_for_current(int(node.get("hp_max")), int(node.get("damage_min")), int(node.get("damage_max")))
		node.set("hp_max", int(sc["max_hp"]))
		node.set("damage_min", int(sc["damage_min"]))
		node.set("damage_max", int(sc["damage_max"]))
		node.set("hp", int(sc["max_hp"]))   # nasce cheio já escalado

## Golem de Cristal jogável (mesmo padrão do Lobo). HP de bosses.json (crystal-golem ≈ 600).
## `arena=true` (⚔️ Arena de Teste DEV): NÃO é boss — pula a fiação de derrota/recompensa e o force_defeated do save,
## então nasce SEMPRE vivo e atacando (spell pra esquivar) e matá-lo NÃO toca progressão/save. Só `attack_hero`
## (→ _on_enemy_attack, onde mora o guard da esquiva) é ligado nesse modo.
func _build_golem(pos: Vector2, arena := false) -> Node2D:
	var node := Node2D.new()
	node.name = "Golem"
	node.set_script(load("res://scripts/Golem.gd"))
	node.position = pos
	var hp_from_data := _boss_hp_from_data("crystal-golem")
	if hp_from_data > 0:
		node.set("hp_max", hp_from_data)
	node.z_index = int(pos.y)   # y-sort inicial (atualizado por _update_depth_sort ao mover)
	_region_node.add_child(node)
	if is_instance_valid(_player): node.call("set_player", _player)   # guard: nunca passar um player liberado
	node.connect("attack_hero", _on_enemy_attack.bind(node))
	if arena:
		return node   # DEV: sem boss-defeat/recompensa/force_defeated — só o telegraph de spell
	node.connect("defeated", _on_boss_defeated)
	_register_boss_base_and_scale(node)   # FATIA A3.75: base imutável + scaling de fase inicial
	# se o save já marca o Golem como derrotado, nasce derrotado (sem re-disparar golem-felled).
	if GameState.has_defeated_boss("Golem de Cristal"):
		node.call("force_defeated_state")
	return node

## Deriva o HP de um boss de bosses.json → knownStats.hp (string lore tipo "~150"/"~600").
## Extrai só os dígitos; se não der, devolve 0 (o script do boss usa seu default).
func _boss_hp_from_data(boss_id: String) -> int:
	var b := DataLoader.boss(boss_id)
	var stats: Dictionary = b.get("knownStats", {})
	var raw := str(stats.get("hp", ""))
	var digits := ""
	for ch in raw:
		if ch >= "0" and ch <= "9":
			digits += ch
	return int(digits) if digits != "" else 0

## ════════ FATIA A7.4 — SPAWN DATA-DRIVEN DE BOSS (dispatcher por boss_id do ContentManifest) ════════
## Os bosses com ARTE/script dedicado (Lobo/Golem) continuam pelos seus builders (PRESERVADOS). Os 8 canônicos
## sem script rodam no BossController genérico (encontro executável; arte placeholder). `_make_boss_node` é o
## ponto único que resolve boss_id → nó do boss, para o runtime dirigido pelo manifesto. ADITIVO: plains/cave
## não passam por aqui (mantêm _build_wolf/_build_golem diretos) — este dispatcher é p/ os capítulos do manifesto.
func _make_boss_node(boss_id: String, pos: Vector2) -> Node2D:
	match BossDefinition.script_of(boss_id):
		"Wolf.gd":
			return _build_wolf(pos)
		"Golem.gd":
			return _build_golem(pos)
		_:
			return _build_manifest_boss(boss_id, pos)

## Boss genérico (BossController) para um boss_id do manifesto sem script dedicado. Mesmo padrão do _build_wolf:
## HP de bosses.json (× hp_mult da definição), base imutável + scaling de fase, sinais de derrota/ataque, e
## nasce derrotado se o save já o marca. Summons/hazards do controller têm teto e cleanup (sem node leak).
func _build_manifest_boss(boss_id: String, pos: Vector2) -> Node2D:
	var node := BossController.new()
	node.name = "Boss_" + boss_id
	node.position = pos
	var hp_from_data := _boss_hp_from_data(boss_id)
	var hp_max := int(round(float(maxi(hp_from_data, 300)) * BossDefinition.hp_mult(boss_id)))
	# dano-base do boss: usa o mesmo default de encontro; o scaling de fase ajusta pela A3.
	node.configure(boss_id, hp_max, 10, 16)
	node.z_index = int(pos.y)
	if _region_node != null:
		_region_node.add_child(node)
	if is_instance_valid(_player):
		node.call("set_player", _player)
	node.connect("defeated", _on_boss_defeated)
	node.connect("attack_hero", _on_enemy_attack.bind(node))
	# FATIA A8: telegraph/fase do boss → bus de feedback (o render desenha a forma/banner; field-deferido).
	node.connect("telegraph_started", _on_boss_telegraph_fb.bind(node))
	node.connect("phase_changed", _on_boss_phase_fb.bind(node))
	_register_boss_base_and_scale(node)
	if GameState.has_defeated_boss(BossDefinition.display_name(boss_id)):
		node.call("force_defeated_state")
	return node

## FATIA A8 — handlers de feedback (empurram p/ o bus; render field-deferido). Guardas contra bus ausente.
func _on_prestige_done_fb(new_prestige: int, new_master: int) -> void:
	if _feedback == null:
