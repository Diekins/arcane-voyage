	_bag_btn.size = Vector2(bag_sz, bag_sz)
	_bag_btn.icon = _load_tex(ItemDB.ICON_DIR + "bag.png")
	_bag_btn.expand_icon = true
	_bag_btn.tooltip_text = "Mochila  [I]"
	_bag_btn.pressed.connect(_toggle_inventory)
	_eq_content.add_child(_bag_btn)
	# raiz das CÉLULAS (limpa+redesenha no refresh)
	_eq_slots_root = Control.new()
	_eq_slots_root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_eq_content.add_child(_eq_slots_root)
	_refresh_equip_hud()
	_apply_equip_hud_visibility()

## Esconde/mostra o paperdoll de equipamento (toggle do jogador). O botão-olho permanece.
func _toggle_equip_hud() -> void:
	_equip_hud_hidden = not _equip_hud_hidden
	_apply_equip_hud_visibility()

func _apply_equip_hud_visibility() -> void:
	if _eq_content != null:
		_eq_content.visible = not _equip_hud_hidden
	if _eq_toggle_btn != null:
		_eq_toggle_btn.text = "⚔" if _equip_hud_hidden else "✕"

## Atualiza o paperdoll fixo (chamado em state_changed + no boot). EQUIPADO: cover opaco ESCONDE a dica
## embutida da sprite + ícone do item por cima. VAZIO: cover oculto → mostra a dica embutida. OFFHAND
## bloqueado por arma 2-mãos: cover vermelho.
func _refresh_equip_hud() -> void:
	if _eq_slots_root == null:
		return
	for c in _eq_slots_root.get_children():   # limpa e redesenha as 8 células limpas
		c.queue_free()
	var pos: Vector2 = _eq_hud_geo.get("pos", Vector2.ZERO)
	var s: float = _eq_hud_geo.get("scale", EQR_SCALE)
	var cell := EQ_CELL * s
	for slot in EQ_SLOT_POS:
		var sl := str(slot)
		var center: Vector2 = pos + (EQ_SLOT_POS[sl] as Vector2) * s
		_eq_slot_cell(_eq_slots_root, sl, center, cell, float(EQ_FIT[sl]) * s, 0)
	if _bag_btn != null:
		_bag_btn.modulate = Color("ffe0a0") if _inv_open else Color(1, 1, 1, 1)

## Carrega uma textura de res:// com cache leve; null se o path for "" ou não existir (fallback seguro).
var _tex_cache: Dictionary = {}
func _load_tex(path: String):
	if path == "":
		return null
	if _tex_cache.has(path):
		return _tex_cache[path]
	var t = load(path) if ResourceLoader.exists(path) else null
	_tex_cache[path] = t
	return t

