## LANDMARK_PILOT_01 — um MARCO visível à distância que PUXA o jogador pra frente (por horizonte, não recompensa).
## Uma TORRE ARRUINADA alta, no centro-leste dos Areais (região aberta): erguida ANTES de ser alcançada — o jogador
## a vê do outro lado das areias e quer chegar perto. SEM [E]/UI/marcador/quest/recompensa: só a silhueta e a
## vontade. Cenário aditivo (Polygon2D), blocker fino só no pé (objeto real que se alcança). Save-safe.
func _build_desert_landmark(size: Vector2) -> void:
	var b := Vector2(size.x * 0.76, size.y * 0.43)   # centro-leste, na direção da travessia O→E
	var node := Node2D.new(); node.position = b; node.z_index = int(b.y); node.rotation = 0.025   # leve inclinação (arruinada)
	_add_ground_shadow(node, 70.0, 16.0, 26.0)
	var body := Polygon2D.new()   # fuste cônico (base larga → topo estreito), arenito
	body.polygon = PackedVector2Array([Vector2(-50, 0), Vector2(50, 0), Vector2(40, -150), Vector2(32, -300), Vector2(-30, -300), Vector2(-42, -150)])
	body.color = Color("a98a52"); node.add_child(body)
	var crown := Polygon2D.new()   # coroa QUEBRADA (topo irregular)
	crown.polygon = PackedVector2Array([Vector2(-30, -300), Vector2(32, -300), Vector2(24, -352), Vector2(8, -316), Vector2(-6, -372), Vector2(-20, -322)])
	crown.color = Color("9c7e49"); node.add_child(crown)
	var shade := Polygon2D.new()   # sombra interna (lado leste) p/ volume
	shade.polygon = PackedVector2Array([Vector2(8, -4), Vector2(50, 0), Vector2(40, -150), Vector2(32, -300), Vector2(14, -300)])
	shade.color = Color(0.0, 0.0, 0.0, 0.16); node.add_child(shade)
	for wy in [-90.0, -170.0, -240.0]:   # frestas/janelas escuras (dão escala)
		var win := ColorRect.new()
		win.color = Color(0.12, 0.10, 0.08, 0.85); win.size = Vector2(12.0, 22.0); win.position = Vector2(-6.0, wy)
		node.add_child(win)
	for cy in [-60.0, -130.0, -210.0]:   # trincas de erosão
		var crack := Line2D.new()
		crack.points = PackedVector2Array([Vector2(-20, cy), Vector2(-6, cy + 18.0), Vector2(-14, cy + 40.0)])
		crack.width = 2.0; crack.default_color = Color(0.0, 0.0, 0.0, 0.22); node.add_child(crack)
	_region_node.add_child(node)
	# entulho no pé (alguém/algo ergueu isto, e o tempo derrubou parte)
	_add_dry_rock(b + Vector2(-70.0, 18.0), 22.0)
	_add_dry_rock(b + Vector2(78.0, 10.0), 26.0)
	_add_dry_rock(b + Vector2(-30.0, 30.0), 16.0)
	# blocker FINO só no pé (a torre é sólida; o jogador chega ao sopé e contorna — não prende)
	_add_blocker(Rect2(b.x - 44.0, b.y - 14.0, 88.0, 20.0))

## ★ A GARGANTA DAS AREIAS (KHETSAR_HUNT_REGION_01) — a 1ª HUNT projetada DEPOIS do combate novo. Bacia-cemitério
## onde as dunas engoliram caravanas; predomínio de RUSHERS (chacais que botam) + 1 sweeper + 1 zoner ranged + 1
## apex (Chacal-Mor). O LUGAR grita "perigo" antes do 1º golpe: ossadas, destroços, um pórtico de costelas. Bacia
## 2000x1400 (entra pela crista NORTE e DESCE). Reusa _build_portal/_build_mobs (chamado pelo pipeline); props
## procedurais (Polygon2D/ColorRect), ZERO arte/save/sistema/economia/progressão novos.
func _build_khet_sand_maw(size: Vector2) -> void:
	_current_boss = null
	_boss_name = ""
	# retorno → Areais de Khet-Sar (oeste, perto da entrada; surge nos Areais ACIMA da boca = anti-loop)
	_build_portal(SANDMAW_TO_SANDS, "khet_sar_sands", "Trilha → Areais de Khet-Sar", true, SANDS_RETURN_FROM_MAW)
	# 1ª chegada: marco de descoberta (sem gate — desvio aberto)
	if GameState.set_story_flag("sand_maw_reached"):
		_show_reward_popup("A Garganta das Areias — onde as dunas engolem caravanas inteiras")
	# crista de entrada: faixa mais escura no NORTE (o leito desce; "você está descendo pra dentro de algo")
	var lip := ColorRect.new(); lip.color = Color(0.0, 0.0, 0.0, 0.16); lip.size = Vector2(size.x, 150.0); lip.position = Vector2(0.0, 150.0); lip.z_index = -16
	_region_node.add_child(lip)
	# ── PÓRTICO DE OSSOS — landmark de ENTRADA: você passa sob uma arcada de costelas ("isto é perigoso") ──
	_maw_bone_arch(Vector2(size.x * 0.5, 470.0))
	# ── ESTANDARTE TOMBADO — landmark ALTO, visível de longe (puxa o jogador pra dentro da bacia) ──
	_maw_banner(Vector2(size.x * 0.74, size.y * 0.42))
	# ── DESTROÇO CENTRAL — a maior caravana engolida (cover + discovery) ──
	_maw_wreck(Vector2(size.x * 0.5, size.y * 0.56))
	# ── ossadas/destroços espalhados: cover que quebra a linha de tiro do zoner e dá flanco aos rushers ──
	_maw_ribcage(Vector2(760.0, 760.0), 30.0)
	_maw_ribcage(Vector2(1360.0, 980.0), 34.0)
	_maw_ribcage(Vector2(1180.0, 560.0), 26.0)
	_add_dry_rock(Vector2(560.0, 1040.0), 26.0)
	_add_dry_rock(Vector2(1560.0, 760.0), 30.0)
	_add_dry_rock(Vector2(980.0, 1180.0), 24.0)
	_add_dry_rock(Vector2(1640.0, 1140.0), 22.0)
	# roda partida + caixotes saqueados (pequenos detalhes do saque)
	for wp in [Vector2(900.0, 640.0), Vector2(1460.0, 660.0), Vector2(700.0, 1140.0)]:
		_maw_broken_wheel(wp)
	# ── PACK07 deco ADITIVA (sem blocker): ossos pequenos + pano de caravana rasgado (a fila que não passou) ──
	_khet_deco_sprite(Vector2(1040.0, 860.0), "res://assets/tilesets/khet/props/khet_small_bones.png", Vector2(0.0, -18.0))
	_khet_deco_sprite(Vector2(620.0, 700.0), "res://assets/tilesets/khet/props/khet_small_bones.png", Vector2(0.0, -18.0))
	_khet_deco_sprite(Vector2(1280.0, 1120.0), "res://assets/tilesets/khet/props/khet_torn_caravan_cloth.png", Vector2(1.0, -30.0))
	# ── DESCOBERTAS pequenas (grim, hunt; future_exit só texto) ──
	_maw_marker(Vector2(size.x * 0.5 + 70.0, size.y * 0.56 + 36.0), "maw_manifest", "✦ [E] manifesto de carga", [
		"Tábua rachada, presa nos destroços. A tinta resistiu ao sol:",
		"«Caravana do Sétimo Selo — 40 cabeças, 12 carroças, rumo à Cidade.»",
		"Abaixo, outra letra, apressada: «nenhuma passou da Garganta».",
	])
	_maw_marker(Vector2(420.0, 560.0), "maw_cairn", "✦ [E] a cova rasa", [
		"Alguém empilhou os ossos com cuidado, em fileiras.",
		"Na metade, as fileiras viram um monte — quem empilhava virou osso também.",
	])

## Pórtico de costelas: duas curvas de osso que se encontram no alto — o jogador passa POR BAIXO (vão central livre;
## blocker só nos pés). É a 1ª coisa que se vê ao descer: "algo grande morreu aqui, e não foi sozinho".
func _maw_bone_arch(pos: Vector2) -> void:
	var z := int(pos.y)
	for sgn in [-1.0, 1.0]:
		var rib := Line2D.new()
		rib.points = PackedVector2Array([
			pos + Vector2(sgn * 150.0, 8.0), pos + Vector2(sgn * 138.0, -120.0),
			pos + Vector2(sgn * 96.0, -210.0), pos + Vector2(sgn * 40.0, -250.0), pos + Vector2(0.0, -258.0)])
		rib.width = 16.0; rib.default_color = Color("d8cfb4"); rib.joint_mode = Line2D.LINE_JOINT_ROUND
		rib.begin_cap_mode = Line2D.LINE_CAP_ROUND; rib.end_cap_mode = Line2D.LINE_CAP_ROUND
		rib.z_index = z; _region_node.add_child(rib)
		# costelas menores penduradas na arcada (textura de "gaiola torácica")
		for t in [0.3, 0.55, 0.78]:
			var hang := Line2D.new()
			var bx: float = pos.x + sgn * (150.0 - 130.0 * t)
			var by: float = pos.y + 8.0 - 250.0 * t
			hang.points = PackedVector2Array([Vector2(bx, by), Vector2(bx - sgn * 26.0, by + 40.0)])
			hang.width = 7.0; hang.default_color = Color(0.84, 0.80, 0.68, 0.9); hang.z_index = z; _region_node.add_child(hang)
		_add_blocker(Rect2(pos.x + sgn * 150.0 - 14.0, pos.y - 6.0, 28.0, 24.0))   # pé da arcada = sólido (contorna)

## Estandarte tombado de caravana: mastro inclinado + bandeira esfarrapada. Landmark alto/visível (puxa pra dentro).
func _maw_banner(pos: Vector2) -> void:
	var z := int(pos.y)
	var node := Node2D.new(); node.position = pos; node.z_index = z; node.rotation = 0.14
	_add_ground_shadow(node, 30.0, 9.0, 12.0)
	var pole := ColorRect.new(); pole.color = Color("5a4a32"); pole.size = Vector2(8.0, 250.0); pole.position = Vector2(-4.0, -250.0); node.add_child(pole)
	var flag := Polygon2D.new()   # bandeira rasgada (tremula congelada)
	flag.polygon = PackedVector2Array([Vector2(4, -244), Vector2(96, -232), Vector2(70, -206), Vector2(98, -182), Vector2(58, -176), Vector2(4, -190)])
	flag.color = Color("7c3b2e"); node.add_child(flag)
	var tear := Polygon2D.new(); tear.polygon = PackedVector2Array([Vector2(70, -206), Vector2(98, -182), Vector2(80, -190)]); tear.color = Color(0.0, 0.0, 0.0, 0.18); node.add_child(tear)
	_region_node.add_child(node)
	_add_blocker(Rect2(pos.x - 8.0, pos.y - 8.0, 20.0, 16.0))   # pé do mastro

## Destroço de caravana (carroça meio enterrada): casco inclinado + aro + lona rasgada. Cover sólido + sombra.
func _maw_wreck(pos: Vector2) -> void:
	var z := int(pos.y)
	var node := Node2D.new(); node.position = pos; node.z_index = z; node.rotation = -0.08
	_add_ground_shadow(node, 96.0, 22.0, 18.0)
	var hull := Polygon2D.new()   # caixa da carroça, afundando na areia
	hull.polygon = PackedVector2Array([Vector2(-110, 6), Vector2(110, 6), Vector2(96, -70), Vector2(-92, -82)])
	hull.color = Color("6a5334"); node.add_child(hull)
	var plank := Polygon2D.new(); plank.polygon = PackedVector2Array([Vector2(-92, -82), Vector2(96, -70), Vector2(92, -58), Vector2(-90, -68)]); plank.color = Color(0.0, 0.0, 0.0, 0.18); node.add_child(plank)
	var canopy := Polygon2D.new()   # arco de lona rasgada (costelas da cobertura)
	canopy.polygon = PackedVector2Array([Vector2(-86, -78), Vector2(-40, -140), Vector2(30, -150), Vector2(80, -100), Vector2(60, -92), Vector2(24, -126), Vector2(-30, -120), Vector2(-66, -74)])
	canopy.color = Color("9a8a64"); node.add_child(canopy)
	var wheel := Polygon2D.new()   # uma roda tombada
	var wp := PackedVector2Array()
	for i in range(16):
		var a := TAU * i / 16.0
		wp.append(Vector2(cos(a) * 40.0 - 120.0, sin(a) * 16.0 + 8.0))
	wheel.polygon = wp; wheel.color = Color("4a3a26"); node.add_child(wheel)
	_region_node.add_child(node)
	_add_blocker(Rect2(pos.x - 100.0, pos.y - 18.0, 200.0, 36.0))   # casco = cover sólido (contorna)

## Caixa torácica de besta de carga (ossada): arcos brancos = cover baixo + um osso longo. Blocker pequeno no centro.
func _maw_ribcage(pos: Vector2, r: float) -> void:
	var z := int(pos.y)
	# IRON_KHET_PACK_06: ossada como sprite (reuso triplo: Garganta/Cidadela/Areais) se existir; senão costelas+espinha Line2D (fallback). Blocker mantido.
	var rc_tex := _try_load_tex("res://assets/tilesets/khet/props/giant_ribcage.png")
	if rc_tex != null:
		var k := (2.9 * r) / 192.0   # largura-alvo ~2.9r mapeada à textura 192px (escala por raio do call-site; F5 PACK06: 2.3→2.9 p/ presença da arte da ossada)
		var s := Sprite2D.new(); s.texture = rc_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.scale = Vector2(k, k); s.offset = Vector2(0.0, -64.0); s.position = pos; s.z_index = z; _region_node.add_child(s)   # base (pivot bottom) na linha de chão
	else:
		for i in range(5):
			var off := (float(i) - 2.0) * (r * 0.42)
			var rib := Line2D.new()
			rib.points = PackedVector2Array([pos + Vector2(off, r * 0.5), pos + Vector2(off * 0.7, -r * 0.7), pos + Vector2(off * 0.3, -r)])
			rib.width = 5.0; rib.default_color = Color(0.86, 0.82, 0.70, 0.95); rib.z_index = z; _region_node.add_child(rib)
		var spine := Line2D.new(); spine.points = PackedVector2Array([pos + Vector2(-r, r * 0.5), pos + Vector2(r * 1.2, r * 0.62)])
		spine.width = 6.0; spine.default_color = Color(0.80, 0.76, 0.64, 0.95); spine.z_index = z; _region_node.add_child(spine)
	_add_blocker(Rect2(pos.x - r * 0.5, pos.y - 4.0, r, 16.0))

## Roda partida meio enterrada (detalhe pequeno do saque; sem blocker).
func _maw_broken_wheel(pos: Vector2) -> void:
	var z := int(pos.y)
	# PACK07: roda partida como sprite (base via bbox-alfa, off.y=-34) se existir; senão arco Line2D (fallback). Deco, sem blocker.
	var w_tex := _try_load_tex("res://assets/tilesets/khet/props/khet_broken_wheel.png")
	if w_tex != null:
		var s := Sprite2D.new(); s.texture = w_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.offset = Vector2(0.0, -34.0); s.position = pos; s.z_index = z; _region_node.add_child(s)
	else:
		var arc := Line2D.new()
		var pts := PackedVector2Array()
		for i in range(9):
			var a := PI * 0.15 + PI * 1.05 * float(i) / 8.0
			pts.append(pos + Vector2(cos(a) * 30.0, sin(a) * 12.0))
		arc.points = pts; arc.width = 6.0; arc.default_color = Color("4a3a26"); arc.z_index = z; _region_node.add_child(arc)

## PACK07: prop decorativo ADITIVO de Khet (sprite, SEM blocker; base/centro via bbox-alfa passado em `off`).
## Aditivo → sem fallback procedural: simplesmente ausente se a arte sumir (guard). Render-only.
func _khet_deco_sprite(pos: Vector2, path: String, off: Vector2, k: float = 1.0) -> void:
	var tex := _try_load_tex(path)
	if tex == null:
		return
	var s := Sprite2D.new(); s.texture = tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	s.scale = Vector2(k, k); s.offset = off; s.position = pos; s.z_index = int(pos.y); _region_node.add_child(s)

## Marcador de descoberta (future_exit só texto) — pequeno, grim, hunt (NÃO contemplativo). Reusa o pipeline de _services.
func _maw_marker(pos: Vector2, id: String, prompt_txt: String, lines: Array) -> void:
	var node := Node2D.new(); node.position = pos; node.z_index = int(pos.y)
	var prompt := Label.new(); prompt.text = prompt_txt; prompt.position = Vector2(-70.0, -52.0); prompt.modulate = Color("e8c79a")
	prompt.add_theme_font_size_override("font_size", 14)
	prompt.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.95)); prompt.add_theme_constant_override("outline_size", 5)
	prompt.visible = false; node.add_child(prompt); _tag_on_top(prompt)
	_region_node.add_child(node)
	_services.append({"node": node, "prompt": prompt, "pos": pos, "kind": "future_exit", "id": id, "title": prompt_txt, "msg": lines})

## ★ A COLUNATA SOTERRADA (KHETSAR_HUNT_REGION_02) — a hunt-IRMÃ da Garganta, escola OPOSTA de combate. Templo
## enterrado de PILARES: as colunas são cobertura → o combate é POSICIONAMENTO ("escolher onde ficar"), não fuga.
## Predomínio de SWEEPERS (cone) + ZONERS (circle/ranged); line RARÍSSIMO. Salão 2100x1400 (ala oeste = entrada).
## Reusa _build_portal/_build_mobs (pipeline); props procedurais (colunas em pé/tombadas + ídolo caído), ZERO arte/
## save/sistema/economia/progressão novos. NÃO compete com a Pedra (lá = memória viva; aqui = dever MORTO/abandono).
func _build_khet_colonnade(size: Vector2) -> void:
	_current_boss = null
	_boss_name = ""
	# retorno → Areais de Khet-Sar (oeste; surge nos Areais ABAIXO da boca norte = anti-loop)
	_build_portal(COLONNADE_TO_SANDS, "khet_sar_sands", "Trilha → Areais de Khet-Sar", true, SANDS_RETURN_FROM_COLONNADE)
	if GameState.set_story_flag("colonnade_reached"):
		_show_reward_popup("A Colunata Soterrada — um salão de pilares que a areia engoliu inteiro")
	# ── PÓRTICO DE ENTRADA (oeste): dois tocos de coluna + um lintel rachado atravessado ("você entra num salão") ──
	_col_pillar(Vector2(470.0, 560.0), 110.0, true)
	_col_pillar(Vector2(470.0, 900.0), 110.0, true)
	var lintel := ColorRect.new(); lintel.color = Color("b0a074"); lintel.size = Vector2(36.0, 360.0); lintel.position = Vector2(452.0, 470.0); lintel.rotation = 0.04; lintel.z_index = 470; _region_node.add_child(lintel)
	# ── CAMPO DE PILARES (cobertura que cria pistas e bolsões = a geografia É a lição) ──
	for p in [Vector2(640, 440), Vector2(980, 440), Vector2(1360, 440), Vector2(1740, 440),
			Vector2(1700, 780), Vector2(640, 1090), Vector2(1010, 1090), Vector2(1400, 1090),
			Vector2(1800, 1090), Vector2(1120, 620), Vector2(1580, 640), Vector2(840, 920), Vector2(1500, 1180)]:
		_col_pillar(p, 150.0 + float(int(p.x + p.y) % 70), (int(p.x) % 3 == 0))
	# ── COLUNAS TOMBADAS (cobertura BAIXA; rasgam o espaço em pistas) ──
	_col_toppled(Vector2(720, 660), 230.0)
	_col_toppled(Vector2(1500, 520), 200.0)
	_col_toppled(Vector2(900, 1250), 240.0)
	_col_toppled(Vector2(1640, 980), 200.0)
	_col_toppled(Vector2(1160, 880), 220.0)
	# ── ÍDOLO CAÍDO (landmark central; o Guardião-Mor ainda guarda seu posto ao lado) ──
	_col_idol(Vector2(1300.0, 700.0))
	# ── PACK07 deco ADITIVA (sem blocker): o friso visível sob o marcador "friso partido" + cacos de saque ──
	_khet_deco_sprite(Vector2(760.0, 1100.0), "res://assets/tilesets/khet/props/khet_colonnade_lintel.png", Vector2(1.0, -26.0))
	_khet_deco_sprite(Vector2(1300.0, 1000.0), "res://assets/tilesets/khet/props/khet_loot_scatter.png", Vector2(0.0, -26.0))   # ao SUL do ídolo (aberto; longe da faixa vertical dos pilares altos)
	_khet_deco_sprite(Vector2(1640.0, 1150.0), "res://assets/tilesets/khet/props/khet_loot_scatter.png", Vector2(0.0, -26.0))
	# ── DESCOBERTAS (2, pequenas/grim, micro-histórias de DEVER MORTO; não-contemplativas, não competem com a Pedra) ──
	_maw_marker(Vector2(760.0, 1100.0), "colon_frieze", "✦ [E] o friso partido", [
		"Um friso baixo, meio na areia: figuras curvadas carregam algo sobre a cabeça, em fila.",
		"A última figura não carrega nada — só aponta para baixo, para onde o salão afundou.",
	])
	_maw_marker(Vector2(1300.0 + 90.0, 700.0 + 60.0), "colon_oath", "✦ [E] a pedra do juramento", [
		"Aos pés do ídolo, uma laje gravada: «enquanto a coluna ficar de pé, o guardião fica».",
		"A coluna atrás dela caiu há muito tempo. O guardião não soube — e nunca deixou o posto.",
	])
	# ★ PORTA DO FUNDO → A Cidadela Partida (KHETSAR_HUNT_REGION_03): o salão leva MAIS ADENTRO, ao punho fortificado.
	_build_portal(COLONNADE_TO_CITADEL, "khet_citadel", "↠ A Cidadela Partida", true, CITADEL_SPAWN)
	var citmk := Node2D.new(); citmk.position = COLONNADE_TO_CITADEL + Vector2(0.0, -44.0); citmk.z_index = int(COLONNADE_TO_CITADEL.y)
	var citl := Label.new(); citl.text = "Os pilares dão lugar a muralhas. Algo foi defendido até o fim aqui."; citl.position = Vector2(-160.0, -24.0); citl.modulate = Color("d8c4a0")
	citl.add_theme_font_size_override("font_size", 13); citl.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.9)); citl.add_theme_constant_override("outline_size", 5)
	citmk.add_child(citl); _tag_on_top(citl); _region_node.add_child(citmk)

## Coluna de pé (tambores de arenito empilhados): fuste claro + linhas de junta + sombra leste + capitel (se inteira).
## Cobertura sólida (blocker no pé). `broken` = topo irregular sem capitel. z = int(pos.y) (y-sort: passa atrás/frente).
func _col_pillar(pos: Vector2, h: float, broken: bool) -> void:
	var z := int(pos.y)
	var node := Node2D.new(); node.position = pos; node.z_index = z
	_add_ground_shadow(node, 30.0, 9.0, 10.0)
	# PACK07: pilar em pé como sprite (escala uniforme por h; flip_h por paridade p/ variar a repetição) se existir;
	# senão fuste+juntas+capitel/lasca de polígono (fallback, `broken` ainda usado). Blocker+sombra mantidos.
	var p_tex := _try_load_tex("res://assets/tilesets/khet/props/khet_standing_pillar.png")
	if p_tex != null:
		var k := h / 110.0   # content-height 110 (bbox y[13..122]) → escala p/ a altura pedida; base via off.y=-58
		var s := Sprite2D.new(); s.texture = p_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.scale = Vector2(k, k); s.offset = Vector2(0.0, -58.0); s.flip_h = (int(pos.x) % 2 == 0); node.add_child(s)
	else:
		var shaft := Polygon2D.new()   # fuste levemente afilado
		shaft.polygon = PackedVector2Array([Vector2(-24, 4), Vector2(24, 4), Vector2(20, -h), Vector2(-20, -h)])
		shaft.color = Color("c2b288"); node.add_child(shaft)
		var shade := Polygon2D.new()   # sombra do lado leste (volume)
		shade.polygon = PackedVector2Array([Vector2(6, 4), Vector2(24, 4), Vector2(20, -h), Vector2(8, -h)])
		shade.color = Color(0.0, 0.0, 0.0, 0.16); node.add_child(shade)
		for i in range(1, int(h / 44.0) + 1):   # juntas dos tambores
			var jy := -44.0 * float(i)
			var jl := Line2D.new(); jl.points = PackedVector2Array([Vector2(-22, jy), Vector2(22, jy)])
			jl.width = 2.0; jl.default_color = Color(0.0, 0.0, 0.0, 0.18); node.add_child(jl)
		if broken:   # topo quebrado (lasca diagonal)
			var brk := Polygon2D.new(); brk.polygon = PackedVector2Array([Vector2(-20, -h), Vector2(20, -h), Vector2(6, -h - 18.0), Vector2(-14, -h - 8.0)])
			brk.color = Color("b3a274"); node.add_child(brk)
		else:        # capitel (bloco mais largo no topo)
			var cap := ColorRect.new(); cap.color = Color("cdbd90"); cap.size = Vector2(58.0, 16.0); cap.position = Vector2(-29.0, -h - 16.0); node.add_child(cap)
	_region_node.add_child(node)
	_add_blocker(Rect2(pos.x - 24.0, pos.y - 8.0, 48.0, 22.0))   # pé = sólido (contorna)

## Coluna tombada (deitada): fileira de tambores cilíndricos = cobertura BAIXA. Blocker comprido e fino.
func _col_toppled(pos: Vector2, length: float) -> void:
	var z := int(pos.y)
	# PACK07: coluna tombada como sprite (escala uniforme p/ cobrir `length`; flip_h por paridade) se existir; senão
	# fuste deitado+juntas de polígono (fallback). pos = ponta ESQ → sprite centrado no meio do vão. Blocker mantido.
	var t_tex := _try_load_tex("res://assets/tilesets/khet/props/khet_toppled_column.png")
	if t_tex != null:
		var k := length / 150.0   # content-width 150 (bbox x[5..154]) → cobre o comprimento; conteúdo já centrado em y (off=0)
		var s := Sprite2D.new(); s.texture = t_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.scale = Vector2(k, k); s.offset = Vector2(0.0, 0.0); s.flip_h = (int(pos.y) % 2 == 0)
		s.position = pos + Vector2(length * 0.5, 0.0); s.z_index = z; _region_node.add_child(s)
	else:
		var bar := Polygon2D.new()   # corpo do fuste deitado
		bar.polygon = PackedVector2Array([pos + Vector2(0, -16), pos + Vector2(length, -16), pos + Vector2(length, 16), pos + Vector2(0, 16)])
		bar.color = Color("b6a67c"); bar.z_index = z; _region_node.add_child(bar)
		var top := Polygon2D.new(); top.polygon = PackedVector2Array([pos + Vector2(0, -16), pos + Vector2(length, -16), pos + Vector2(length, -10), pos + Vector2(0, -10)]); top.color = Color(1, 1, 1, 0.10); top.z_index = z; _region_node.add_child(top)
		var n := int(length / 46.0)
		for i in range(1, n + 1):   # juntas dos tambores tombados
			var dx := 46.0 * float(i)
			var jl := Line2D.new(); jl.points = PackedVector2Array([pos + Vector2(dx, -16), pos + Vector2(dx, 16)])
			jl.width = 2.0; jl.default_color = Color(0.0, 0.0, 0.0, 0.20); jl.z_index = z; _region_node.add_child(jl)
	_add_blocker(Rect2(pos.x, pos.y - 14.0, length, 28.0))

## Ídolo caído (estátua colossal de face na areia): cabeça meio enterrada (um olho lavrado) + antebraço partido.
## Landmark central; o apex guarda seu lado. Sombra grande + blocker só na cabeça (contorna).
func _col_idol(pos: Vector2) -> void:
	var z := int(pos.y)
	var node := Node2D.new(); node.position = pos; node.z_index = z
	_add_ground_shadow(node, 110.0, 26.0, 20.0)
	# IRON_KHET_PACK_06: ídolo colossal caído como sprite (signature de Khet) se existir; senão cabeça+olho+antebraço de polígono (fallback). Sombra+blocker mantidos.
	var id_tex := _try_load_tex("res://assets/tilesets/khet/props/colossal_idol.png")
	if id_tex != null:
		var k := 320.0 / 256.0   # largura-alvo ~320 mapeada à textura 256px
		var s := Sprite2D.new(); s.texture = id_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		# PACK06B (ídolo tombado/soterrado): conteúdo ocupa só o topo do canvas (bbox-alfa bottom ty=152, centro-x=135)
		# → offset ajustado p/ a BASE DO CONTEÚDO assentar na areia e centrar na sombra (antes -96 deixava boiando).
		s.scale = Vector2(k, k); s.offset = Vector2(-7.0, -56.0); node.add_child(s)
	else:
		var head := Polygon2D.new()   # cabeça gigante de perfil, afundando
		head.polygon = PackedVector2Array([Vector2(-120, 30), Vector2(-90, -70), Vector2(-10, -96), Vector2(70, -70), Vector2(110, 10), Vector2(80, 40), Vector2(-60, 44)])
		head.color = Color("a99a72"); node.add_child(head)
		var shade := Polygon2D.new(); shade.polygon = PackedVector2Array([Vector2(70, -70), Vector2(110, 10), Vector2(80, 40), Vector2(30, 20)]); shade.color = Color(0.0, 0.0, 0.0, 0.16); node.add_child(shade)
		var brow := Line2D.new(); brow.points = PackedVector2Array([Vector2(-60, -54), Vector2(0, -68)]); brow.width = 8.0; brow.default_color = Color(0.0, 0.0, 0.0, 0.28); node.add_child(brow)
		var eye := Polygon2D.new(); eye.polygon = PackedVector2Array([Vector2(-46, -36), Vector2(-18, -44), Vector2(-20, -26), Vector2(-44, -22)]); eye.color = Color(0.06, 0.05, 0.04, 0.85); node.add_child(eye)   # olho lavrado (escuro)
		var lips := Line2D.new(); lips.points = PackedVector2Array([Vector2(-30, 6), Vector2(40, 0)]); lips.width = 6.0; lips.default_color = Color(0.0, 0.0, 0.0, 0.22); node.add_child(lips)
		# antebraço partido caído ao lado (escala)
		var arm := Polygon2D.new(); arm.polygon = PackedVector2Array([Vector2(120, 70), Vector2(250, 86), Vector2(250, 116), Vector2(120, 104)]); arm.color = Color("a3946e"); node.add_child(arm)
	_region_node.add_child(node)
	_add_blocker(Rect2(pos.x - 120.0, pos.y - 6.0, 230.0, 44.0))   # cabeça/face = sólido (contorna por cima/baixo)

## ★ A CIDADELA PARTIDA (KHETSAR_HUNT_REGION_03) — o CAPSTONE: exige MOVIMENTO (esquiva/line) + POSIÇÃO (cobertura/
## cone/circle) na MESMA luta. Muralhas (cobertura) cercam pátios abertos (campos de morte); guardiões de pedra
## (Colunata) e saqueadores do deserto (Garganta) coexistem. Encontros DELIBERADOS criam dilemas: fugir do tiro do
## Olho te joga na rota do Saqueador; esquivar a investida te leva ao leque do Guardião. Mundo 2400x1500. Reusa
## _build_portal/_build_mobs + props procedurais (muralhas/portão/trono); ZERO arte/save/sistema/progressão novos.
func _build_khet_citadel(size: Vector2) -> void:
	_current_boss = null
	_boss_name = ""
	# retorno → Colunata (oeste; surge na Colunata perto do portal do fundo = anti-loop)
	_build_portal(CITADEL_TO_COLONNADE, "khet_colonnade", "Trilha → A Colunata Soterrada", true, COLONNADE_RETURN_FROM_CITADEL)
	if GameState.set_story_flag("citadel_reached"):
		_show_reward_popup("A Cidadela Partida — o punho de pedra que o deserto não terminou de engolir")
	# ── MURALHAS (cobertura) que formam pátios + corredores = a geografia do DILEMA ──
	# Rampart NORTE (com uma brecha no meio = a entrada do tiro)
	_cit_wall(Vector2(160, 320), 760.0, false); _cit_wall(Vector2(1180, 320), 820.0, false)
	# Rampart SUL (com brecha)
	_cit_wall(Vector2(360, 1140), 720.0, false); _cit_wall(Vector2(1380, 1140), 760.0, false)
	# Muralhas internas (a GAUNTLET — corredores e becos)
	_cit_wall(Vector2(840, 470), 340.0, true); _cit_wall(Vector2(1300, 640), 380.0, true)
	# O TORREÃO (keep) a leste, ao redor do trono — N e S fechados, aberto a OESTE (você entra pelo pátio)
	_cit_wall(Vector2(1860, 540), 560.0, false); _cit_wall(Vector2(1860, 980), 560.0, false)
	# ── PORTÃO PARTIDO (landmark de entrada, oeste) ──
	_cit_gate(Vector2(360, 760))
	# ── TRONO/DAIS (landmark central do keep; o apex tem corte aqui) ──
	_cit_dais(Vector2(2080, 760))
	# ── escombros: colunas tombadas + ossadas de saque (as 2 ecologias) + rodas ──
	_col_toppled(Vector2(520, 560), 200.0); _col_toppled(Vector2(1480, 980), 220.0)
	_col_pillar(Vector2(1160, 980), 120.0, true); _col_pillar(Vector2(1640, 640), 130.0, true)
	_maw_ribcage(Vector2(700, 980), 30.0); _maw_ribcage(Vector2(1520, 620), 28.0)
	_maw_broken_wheel(Vector2(960, 700)); _maw_broken_wheel(Vector2(1720, 940))
	# ── PACK07 deco ADITIVA (sem blocker): saque/ossos espalhados nos pátios das 2 ecologias ──
	_khet_deco_sprite(Vector2(480.0, 960.0), "res://assets/tilesets/khet/props/khet_loot_scatter.png", Vector2(0.0, -26.0))   # aos pés do "último posto" (aberto; longe dos pilares altos)
	_khet_deco_sprite(Vector2(620.0, 1040.0), "res://assets/tilesets/khet/props/khet_small_bones.png", Vector2(0.0, -18.0))
	_khet_deco_sprite(Vector2(1500.0, 1060.0), "res://assets/tilesets/khet/props/khet_torn_caravan_cloth.png", Vector2(1.0, -30.0))
	# ── DESCOBERTAS (2, grim; as DUAS ecologias se encontrando) ──
	_maw_marker(Vector2(420.0, 920.0), "cit_standlast", "✦ [E] o último posto", [
		"Encostado na muralha, um guardião de pedra rachado, ainda de pé, ainda virado pro portão.",
		"Aos pés dele, ossos de chacal e cinzas de fogueira. O que ele guardava virou toca.",
	])
	_maw_marker(Vector2(2080.0 + 70.0, 760.0 + 70.0), "cit_throne", "✦ [E] o trono partido", [
		"O trono está rachado em dois. Quem sentava nele há muito virou areia.",
		"Mas a corte não se desfez — só trocou de dono. Algo grande ainda manda aqui.",
	])
	# ★ ATRÁS DO TRONO: a escada que DESCE ao Grande Arquivo (THE_GREAT_ARCHIVE_BUILD_01). O combate acaba aqui; a
	# descoberta começa. Marca discreta de boca de escada (não-porta) + portal.
	var stairhole := ColorRect.new(); stairhole.color = Color(0.05, 0.05, 0.07, 0.9); stairhole.size = Vector2(96.0, 48.0); stairhole.position = CITADEL_TO_ARCHIVE + Vector2(-48.0, -10.0); stairhole.z_index = int(CITADEL_TO_ARCHIVE.y) - 2; _region_node.add_child(stairhole)
	_build_portal(CITADEL_TO_ARCHIVE, "great_archive", "↡ descer → o Grande Arquivo", false, ARCHIVE_SPAWN)
	var arcmk := Node2D.new(); arcmk.position = CITADEL_TO_ARCHIVE + Vector2(0.0, -52.0); arcmk.z_index = int(CITADEL_TO_ARCHIVE.y)
	var arcl := Label.new(); arcl.text = "Atrás do trono, degraus descem para o escuro. O barulho fica para trás."; arcl.position = Vector2(-180.0, -24.0); arcl.modulate = Color("b9b4c4")
	arcl.add_theme_font_size_override("font_size", 13); arcl.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.9)); arcl.add_theme_constant_override("outline_size", 5)
	arcmk.add_child(arcl); _tag_on_top(arcl); _region_node.add_child(arcmk)

## Muralha (rampart): face superior + face frontal (altura 2.5D) + aresta. Cobertura SÓLIDA (blocker no footprint).
func _cit_wall(pos: Vector2, length: float, vertical: bool) -> void:
	var th := 36.0
	var w: float = th if vertical else length
	var h: float = length if vertical else th
	var zb := int(pos.y + h)
	var top := ColorRect.new(); top.color = Color("b3a07a"); top.size = Vector2(w, h); top.position = pos; top.z_index = zb; _region_node.add_child(top)
	var front := ColorRect.new(); front.color = Color("8c7a58"); front.size = Vector2(w, 16.0); front.position = pos + Vector2(0.0, h); front.z_index = zb; _region_node.add_child(front)
	var edge := ColorRect.new(); edge.color = Color(0.0, 0.0, 0.0, 0.14); edge.size = Vector2(w, 5.0); edge.position = pos; edge.z_index = zb; _region_node.add_child(edge)
	# trincas (textura de ruína)
	for t in [0.3, 0.66]:
		var cr := Line2D.new()
		if vertical: cr.points = PackedVector2Array([pos + Vector2(0.0, h * t), pos + Vector2(th, h * t + 14.0)])
		else: cr.points = PackedVector2Array([pos + Vector2(w * t, 0.0), pos + Vector2(w * t + 14.0, th)])
		cr.width = 2.0; cr.default_color = Color(0.0, 0.0, 0.0, 0.20); cr.z_index = zb; _region_node.add_child(cr)
	_add_blocker(Rect2(pos.x, pos.y, w, h))

## Portão partido (landmark de entrada): dois pilares grossos + um lintel CAÍDO atravessado. Blocker só nos pilares.
func _cit_gate(pos: Vector2) -> void:
	var z := int(pos.y + 60.0)
	for sx in [-90.0, 90.0]:
		var post := ColorRect.new(); post.color = Color("a08a60"); post.size = Vector2(40.0, 120.0); post.position = pos + Vector2(sx - 20.0, -120.0); post.z_index = z; _region_node.add_child(post)
