	_stash_info.add_theme_font_size_override("font_size", 13); _stash_info.add_theme_color_override("font_color", Color("cdb98a"))
	frame.add_child(_stash_info)
	var close := Button.new()
	close.text = "Fechar [Esc]"
	close.position = Vector2(W * 0.5 - 70.0, H - 40.0); close.size = Vector2(140, 30)
	close.pressed.connect(_close_stash)
	frame.add_child(close)

func _stash_set_info(text: String) -> void:
	if _stash_info != null:
		_stash_info.text = text

## Uma coluna do Baú: cabeçalho + scroll com grade de slots (preenche com nichos vazios p/ cara de arca).
func _stash_grid(parent: Control, pos: Vector2, w: float, h: float, header: String, deposit: bool) -> void:
	var hdr := Label.new()
	hdr.text = header; hdr.position = pos
	hdr.add_theme_font_size_override("font_size", 14); hdr.add_theme_color_override("font_color", Color("f0d49a"))
	parent.add_child(hdr)
	var scroll := ScrollContainer.new()
	scroll.position = pos + Vector2(0, 24); scroll.size = Vector2(w, h)
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	parent.add_child(scroll)
	var grid := GridContainer.new()
	grid.columns = 5
	grid.add_theme_constant_override("h_separation", 6)
	grid.add_theme_constant_override("v_separation", 6)
	scroll.add_child(grid)
	var entries := _stash_entries(deposit)
	for e in entries:
		_stash_slot(grid, e, deposit)
	for _i in range(maxi(0, 15 - entries.size())):   # nichos vazios → arca cheia de molduras
		_stash_slot(grid, {}, deposit)

## Itens/materiais de uma coluna como dados estruturados (kind/key/qty/icon/name/type/action). Mesma
## enumeração do MVP (materiais + itens stackable da mochila p/ guardar; player_stash p/ retirar).
func _stash_entries(deposit: bool) -> Array:
	var out := []
	if deposit:
		for name in GameState.materials.keys():
			var n: int = GameState.material_count(str(name))
			if n > 0:
				out.append({"name": str(name), "qty": n, "type": "Material", "icon": ItemDB.material_icon_path(str(name)),
					"fb": Color(0.42, 0.38, 0.22), "action": (func(nm, q): return func(): GameState.stash_deposit_material(nm, q)).call(str(name), n)})
		for e in GameState.backpack:
			var id := str(e.get("id", ""))
			if id != "" and ItemDB.is_stackable(id):
				var q := int(e.get("qty", 1))
				out.append({"name": _item_name(id), "qty": q, "type": "Item", "icon": ItemDB.icon_path(id),
					"fb": _stash_fb_color(str(ItemDB.get_item(id).get("color", ""))), "action": (func(i, qq): return func(): GameState.stash_deposit_item(i, qq)).call(id, q)})
	else:
		var mats: Dictionary = GameState.player_stash.get("materials", {})
		for name in mats.keys():
			var n: int = int(mats[name])
			out.append({"name": str(name), "qty": n, "type": "Material", "icon": ItemDB.material_icon_path(str(name)),
				"fb": Color(0.42, 0.38, 0.22), "action": (func(nm, q): return func(): GameState.stash_withdraw_material(nm, q)).call(str(name), n)})
		var its: Dictionary = GameState.player_stash.get("items", {})
		for id in its.keys():
			var q: int = int(its[id])
			out.append({"name": _item_name(str(id)), "qty": q, "type": "Item", "icon": ItemDB.icon_path(str(id)),
				"fb": _stash_fb_color(str(ItemDB.get_item(str(id)).get("color", ""))), "action": (func(i, qq): return func(): GameState.stash_withdraw_item(i, qq)).call(str(id), q)})
	return out

func _stash_fb_color(hex: String) -> Color:
	return Color(hex) if hex != "" else Color(0.40, 0.34, 0.20)

## Um slot da grade (Button 56² com nicho de madeira/bronze). e={} → nicho VAZIO (desabilitado). Senão:
## ícone do item/material (fallback = quadrado tonal + 2 letras se não houver) + qty no canto + hover→rodapé.
func _stash_slot(grid: Control, e: Dictionary, deposit: bool) -> void:
	var slot := Button.new()
	slot.custom_minimum_size = Vector2(56, 56)
	slot.focus_mode = Control.FOCUS_NONE
	var nb := StyleBoxFlat.new()
	nb.bg_color = Color(0.13, 0.10, 0.07, 0.95)
	nb.border_color = Color(0.42, 0.32, 0.16, 0.8); nb.set_border_width_all(1); nb.set_corner_radius_all(4)
	var nh := nb.duplicate(); nh.bg_color = Color(0.20, 0.15, 0.09, 0.98); nh.border_color = Color("e8c267")
	slot.add_theme_stylebox_override("normal", nb)
	slot.add_theme_stylebox_override("hover", nh)
	slot.add_theme_stylebox_override("pressed", nh)
	slot.add_theme_stylebox_override("focus", nb)
	grid.add_child(slot)
	if e.is_empty():
		slot.disabled = true
		return
	var icon_path := str(e.get("icon", ""))
	var tex = _load_tex(icon_path) if icon_path != "" else null
	if tex != null:
		var ir := TextureRect.new()
		ir.texture = tex
		ir.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		ir.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		ir.set_anchors_preset(Control.PRESET_FULL_RECT)
		ir.offset_left = 4; ir.offset_top = 4; ir.offset_right = -4; ir.offset_bottom = -4
		ir.mouse_filter = Control.MOUSE_FILTER_IGNORE
		slot.add_child(ir)
	else:   # FALLBACK consistente: quadrado tonal + 2 letras (nunca quebra)
		var fb := ColorRect.new()
		fb.color = e.get("fb", Color(0.40, 0.34, 0.20))
		fb.set_anchors_preset(Control.PRESET_FULL_RECT)
		fb.offset_left = 8; fb.offset_top = 8; fb.offset_right = -8; fb.offset_bottom = -8
		fb.mouse_filter = Control.MOUSE_FILTER_IGNORE
		slot.add_child(fb)
		var ab := Label.new()
		ab.text = str(e.get("name", "?")).substr(0, 2)
		ab.set_anchors_preset(Control.PRESET_FULL_RECT)
		ab.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER; ab.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		ab.add_theme_font_size_override("font_size", 16); ab.add_theme_color_override("font_color", Color("1a140c"))
		ab.mouse_filter = Control.MOUSE_FILTER_IGNORE
		slot.add_child(ab)
	var qty := int(e.get("qty", 1))
	if qty > 1:
		var ql := Label.new()
		ql.text = "%d" % qty
		ql.set_anchors_preset(Control.PRESET_FULL_RECT)
		ql.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT; ql.vertical_alignment = VERTICAL_ALIGNMENT_BOTTOM
		ql.offset_right = -4; ql.offset_bottom = -2
		ql.add_theme_font_size_override("font_size", 13); ql.add_theme_color_override("font_color", Color("ffe9b8"))
		ql.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.95)); ql.add_theme_constant_override("outline_size", 3)
		ql.mouse_filter = Control.MOUSE_FILTER_IGNORE
		slot.add_child(ql)
	var nm := str(e.get("name", "")); var typ := str(e.get("type", "")); var act := "guardar" if deposit else "retirar"
	var info := "%s  x%d  ·  %s  ·  Clique para %s" % [nm, qty, typ, act]
	slot.mouse_entered.connect((func(t): return func(): _stash_set_info(t)).call(info))
	slot.pressed.connect(e["action"])

func _item_name(id: String) -> String:
	return str(ItemDB.get_item(id).get("name", id))

