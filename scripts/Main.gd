	_build_portal(VILLAGE_TO_NORTH, "ashen_grove", "Trilha Norte → Bosque de Cinza", true)
	# serviços mínimos do hub (GODOT-VILLAGE-SERVICES-1) — âncoras de interação [E] sobre os
