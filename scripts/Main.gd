## --- PROPS PROCEDURAIS DO ACAMPAMENTO (GODOT-KHET-CARAVAN-CAMP-MVP-1) ---
## Tudo Polygon2D/ColorRect (ZERO asset). y-sort por z_index = pos.y (≤4096 → CombatVfx z=4095 intacto).
## Blocker fino e centrado (menor que o visual) p/ dar fisicalidade SEM prender o jogador nas bordas.

## Disco aproximado por polígono (rodas da carroça / pedras da fogueira), sem asset.
func _camp_disc(center: Vector2, r: float, color: Color, segs: int = 14) -> Polygon2D:
	var pts := PackedVector2Array()
	for i in range(segs):
		var a := TAU * float(i) / float(segs)
		pts.append(center + Vector2(cos(a), sin(a)) * r)
	var poly := Polygon2D.new()
	poly.polygon = pts
	poly.color = color
	return poly

## Fogueira: anel de pedras + lenha cruzada + chama (chamas em camadas). Sem blocker (descanso encosta aqui).
func _build_camp_campfire(pos: Vector2) -> void:
	var node := Node2D.new()
	node.position = pos
	node.z_index = int(pos.y)
	_add_ground_shadow(node, 34.0, 11.0, 6.0)
	# anel de pedras
	for off in [Vector2(-28, 4), Vector2(28, 4), Vector2(0, 16), Vector2(-18, -8), Vector2(18, -8)]:
		node.add_child(_camp_disc(off, 8.0, Color(0.42, 0.40, 0.37)))
	# lenha cruzada (dois toras marrons)
	var log1 := Polygon2D.new()
	log1.polygon = PackedVector2Array([Vector2(-22, 2), Vector2(22, -6), Vector2(24, 0), Vector2(-20, 8)])
	log1.color = Color(0.34, 0.22, 0.12)
	node.add_child(log1)
	var log2 := Polygon2D.new()
	log2.polygon = PackedVector2Array([Vector2(-22, -6), Vector2(22, 2), Vector2(20, 8), Vector2(-24, 0)])
	log2.color = Color(0.30, 0.19, 0.10)
	node.add_child(log2)
	# chama (laranja externo + amarelo interno)
	var flame := Polygon2D.new()
	flame.polygon = PackedVector2Array([Vector2(0, -34), Vector2(13, -6), Vector2(0, 2), Vector2(-13, -6)])
	flame.color = Color("e8772a")
	node.add_child(flame)
	var core := Polygon2D.new()
	core.polygon = PackedVector2Array([Vector2(0, -22), Vector2(7, -5), Vector2(0, 0), Vector2(-7, -5)])
	core.color = Color("f6d24a")
	node.add_child(core)
	_region_node.add_child(node)

## Tenda de caravana: corpo triangular (tecido) + sombra + abertura escura + estaca. Blocker fino na base.
func _build_camp_tent(pos: Vector2, w: float, h: float, cloth: Color) -> void:
	var node := Node2D.new()
	node.position = pos
	node.z_index = int(pos.y)
	_add_ground_shadow(node, w * 0.5, h * 0.16, 4.0)
	var hw := w * 0.5
	# corpo (triângulo: ápice no topo, base no chão)
	var body := Polygon2D.new()
	body.polygon = PackedVector2Array([Vector2(0, -h), Vector2(hw, 0), Vector2(-hw, 0)])
	body.color = cloth
	node.add_child(body)
	# lado em sombra (metade direita mais escura → volume)
	var shade := Polygon2D.new()
	shade.polygon = PackedVector2Array([Vector2(0, -h), Vector2(hw, 0), Vector2(0, 0)])
	shade.color = cloth.darkened(0.22)
	node.add_child(shade)
	# abertura/entrada (fenda escura ao centro da base)
	var flap := Polygon2D.new()
	flap.polygon = PackedVector2Array([Vector2(0, -h * 0.42), Vector2(w * 0.13, 0), Vector2(-w * 0.13, 0)])
	flap.color = Color(0.12, 0.09, 0.06)
	node.add_child(flap)
	# estaca de topo
	var pole := ColorRect.new()
	pole.size = Vector2(3, 12); pole.position = Vector2(-1.5, -h - 10)
	pole.color = Color(0.30, 0.20, 0.12)
	node.add_child(pole)
	_region_node.add_child(node)
	# blocker fino e centrado (não prende nas pontas)
	_add_blocker(Rect2(pos.x - hw * 0.55, pos.y - h * 0.30, hw * 1.1, h * 0.30))

## Carroça de caravana: leito de madeira + toldo abaulado + duas rodas. Blocker no leito.
func _build_camp_wagon(pos: Vector2) -> void:
	var node := Node2D.new()
	node.position = pos
	node.z_index = int(pos.y)
	_add_ground_shadow(node, 56.0, 14.0, 8.0)
	# rodas (atrás do leito)
	node.add_child(_camp_disc(Vector2(-34, 2), 16.0, Color(0.22, 0.15, 0.09)))
	node.add_child(_camp_disc(Vector2(34, 2), 16.0, Color(0.22, 0.15, 0.09)))
	node.add_child(_camp_disc(Vector2(-34, 2), 6.0, Color(0.42, 0.30, 0.18)))
	node.add_child(_camp_disc(Vector2(34, 2), 6.0, Color(0.42, 0.30, 0.18)))
	# leito de madeira
	var bed := ColorRect.new()
	bed.size = Vector2(96, 30); bed.position = Vector2(-48, -28)
	bed.color = Color(0.40, 0.27, 0.15)
	node.add_child(bed)
	# toldo abaulado (tecido cru)
	var canopy := Polygon2D.new()
	canopy.polygon = PackedVector2Array([Vector2(-44, -26), Vector2(-30, -58), Vector2(30, -58), Vector2(44, -26)])
	canopy.color = Color("d9c39a")
	node.add_child(canopy)
	var canopy_sh := Polygon2D.new()   # nervura/sombra do toldo
	canopy_sh.polygon = PackedVector2Array([Vector2(2, -26), Vector2(2, -58), Vector2(30, -58), Vector2(44, -26)])
	canopy_sh.color = Color("c4ab7e")
	node.add_child(canopy_sh)
	_region_node.add_child(node)
	_add_blocker(Rect2(pos.x - 48, pos.y - 26, 96, 30))

## Oásis de Khet-Sar (GODOT-KHET-OASIS-MVP-1): RESPIRO assetless entre Acampamento e Cidade — região SEGURA
