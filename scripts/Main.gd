	match GameState.tutorial_step:
		"talk_elder":
			return [
				"Você chegou à Vila dos Novatos, Errante. Aqui ninguém ergue a lâmina contra você — descanse o quanto precisar.",
				"A trilha segue a leste, para a Planície. Na praça há um mural com recados de quem passou por aqui, se quiser olhar.",
			]
