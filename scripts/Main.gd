	_khet_deco_sprite(Vector2(300.0, 980.0), "res://assets/tilesets/eastern_sea/props/eastern_signal_lantern.png", Vector2(0.0, -50.0))
	# bancada do Reparador + cordas em rolo + ferramentas, junto ao navio
