## + manchas de sal + destroços de madeira + conchas/âncoras (visuais) + FAIXA DE MAR ao sul (visível,
## bloqueada — promessa de expansão, sem navegação). Mantém LIVRES: corredor de entrada (oeste) e o
## acesso ao cais (sul-centro).
func _scatter_coast_decor(size: Vector2, blockers_only: bool = false) -> void:
	# EASTERN_SEA_PROPS_PACK_08: props decorativos do Mar Oriental (aditivo; roda nos 2 modos pois esta
	# função roda 1x por build). Antes do early-return de blockers_only p/ aparecer também com chão pintado.
	_scatter_eastern_sea_props(size)
	# CHÃO PINTADO da Costa (GODOT-SALTWIND-ASSET-INTEGRATION-1): a arte terrain-only já traz
	# areia/sal/maré/espuma/mar → aqui SÓ colisão + props SÓLIDOS (a arte não tem pedras/âncora/
	# destroços) + marco da rota antiga. A linha d'água pintada foi MEDIDA em y≈1105 (espuma ~1100,
	# mar ≥1105) → o blocker do mar SEGUE a arte (não mais o antigo 1166) → player não pisa na água.
	if blockers_only:
		var water_top := size.y - 195.0   # ≈1105 p/ size.y=1300 → casa com a espuma/mar pintados
		_add_blocker(Rect2(0, water_top, size.x, size.y - water_top))   # mar intransponível a pé
		for n in [Vector2(0.16, 0.20), Vector2(0.42, 0.16), Vector2(0.70, 0.18), Vector2(0.88, 0.30), Vector2(0.22, 0.68), Vector2(0.80, 0.66), Vector2(0.60, 0.78)]:
			_add_rock(Vector2(size.x * n.x, size.y * n.y), 26.0)   # pedras sólidas (visual+blocker; arte não as tem)
		for d in [[Vector2(0.20, 0.30), 0.4], [Vector2(0.78, 0.40), 0.6]]:
			_add_driftwood(Vector2(size.x * (d[0] as Vector2).x, size.y * (d[0] as Vector2).y), d[1] as float, true)   # destroço sólido
		_add_anchor(Vector2(820, size.y - 230.0))   # âncora quebrada (marco da rota antiga) — na areia, acima da água
		return
	# --- FALLBACK PROCEDURAL (arte ausente): cenário completo desenhado em código ---
	# FAIXA DE MAR ao sul (visual) + blocker da arrebentação (player não entra no mar)
	var sea_y := size.y - 140.0
	var sea := ColorRect.new()
	sea.size = Vector2(size.x, size.y - sea_y)
	sea.position = Vector2(0, sea_y)
	sea.color = Color(0.16, 0.34, 0.46, 0.92)   # azul-petróleo do mar revolto
	sea.z_index = -20
	_region_node.add_child(sea)
	var deep := ColorRect.new()                  # água mais funda/escura ao sul (profundidade)
	deep.size = Vector2(size.x, 56)
	deep.position = Vector2(0, size.y - 56)
	deep.color = Color(0.10, 0.24, 0.36, 0.55)
	deep.z_index = -19
	_region_node.add_child(deep)
	var wet := ColorRect.new()                   # FAIXA DE MARÉ: areia molhada/escura antes do mar (transição clara)
	wet.size = Vector2(size.x, 74)
	wet.position = Vector2(0, sea_y - 74)
	wet.color = Color(0.62, 0.55, 0.40, 0.45)
	wet.z_index = -19
	_region_node.add_child(wet)
	var foam := ColorRect.new()                  # linha de espuma na arrebentação (borda do mar bem legível)
	foam.size = Vector2(size.x, 12)
	foam.position = Vector2(0, sea_y - 5)
	foam.color = Color(0.88, 0.92, 0.94, 0.62)
	foam.z_index = -18
	_region_node.add_child(foam)
	var foam2 := ColorRect.new()                 # 2ª crista de espuma um pouco mais ao sul
	foam2.size = Vector2(size.x, 6)
	foam2.position = Vector2(0, sea_y + 22)
	foam2.color = Color(0.82, 0.88, 0.9, 0.4)
	foam2.z_index = -18
	_region_node.add_child(foam2)
	_add_blocker(Rect2(0, sea_y + 6, size.x, size.y - sea_y))   # o mar é intransponível a pé
	# pedras costeiras (blocker) nas bordas/quadrantes, longe do corredor de entrada e do cais central
	for n in [Vector2(0.16, 0.20), Vector2(0.42, 0.16), Vector2(0.70, 0.18), Vector2(0.88, 0.30), Vector2(0.22, 0.68), Vector2(0.80, 0.66), Vector2(0.60, 0.78)]:
		_add_rock(Vector2(size.x * n.x, size.y * n.y), 26.0)
	# manchas de SAL (visual, sem colisão, z negativo) — crostas claras na areia
	for n in [Vector2(0.34, 0.40), Vector2(0.56, 0.30), Vector2(0.72, 0.50), Vector2(0.28, 0.56), Vector2(0.64, 0.62)]:
		var salt := Polygon2D.new()
		var sp := PackedVector2Array()
		var sr := randf_range(28.0, 46.0)
		for i in range(12):
			var a := TAU * i / 12.0
			sp.append(Vector2(cos(a) * sr, sin(a) * sr * 0.55))
		salt.polygon = sp
		salt.position = Vector2(size.x * n.x, size.y * n.y)
		salt.color = Color(0.93, 0.92, 0.86, 0.5)
		salt.z_index = -17
		_region_node.add_child(salt)
	# DESTROÇOS de madeira (tábuas/cascos — visual; algumas viram blocker baixo)
	for d in [[Vector2(0.20, 0.30), 0.4, true], [Vector2(0.50, 0.46), -0.3, false], [Vector2(0.78, 0.40), 0.6, true], [Vector2(0.40, 0.66), 0.1, false], [Vector2(0.66, 0.34), -0.5, false]]:
		_add_driftwood(Vector2(size.x * (d[0] as Vector2).x, size.y * (d[0] as Vector2).y), d[1], d[2])
	# CONCHAS / cacos de âncora (visual pequeno, z negativo) — vestígios da rota antiga
	for n in [Vector2(0.30, 0.48), Vector2(0.58, 0.52), Vector2(0.46, 0.36), Vector2(0.74, 0.60), Vector2(0.24, 0.40)]:
		var sh := ColorRect.new()
		sh.size = Vector2(randf_range(8.0, 14.0), randf_range(8.0, 14.0))
		sh.position = Vector2(size.x * n.x, size.y * n.y)
		sh.rotation = randf_range(-0.8, 0.8)
		sh.color = Color(0.86, 0.8, 0.7, 0.85)
		sh.z_index = -16
		_region_node.add_child(sh)
	# POSTES DO CAIS na arrebentação (restos da doca entrando no mar) — visual, flanqueando o cais quebrado
	for px in [950.0, 1010.0, 1190.0, 1250.0]:
		var post := ColorRect.new()
		post.size = Vector2(12, 46)
		post.position = Vector2(px - 6, sea_y - 30)
		post.rotation = randf_range(-0.12, 0.12)
		post.color = Color(0.34, 0.24, 0.16, 0.95)   # estaca apodrecida
		post.z_index = int(sea_y) + 2
		_region_node.add_child(post)
	# ÂNCORA QUEBRADA encalhada perto do cais (marco da rota antiga) — visual + blocker baixo
	_add_anchor(Vector2(820, size.y - 230.0))
	# MARCAS DE VENTO/SAL na areia (estrias claras varridas pelo vento) — visual, z negativo
	for w in [[Vector2(0.40, 0.24), 0.18], [Vector2(0.62, 0.44), -0.12], [Vector2(0.30, 0.62), 0.1], [Vector2(0.78, 0.30), -0.2], [Vector2(0.52, 0.7), 0.05]]:
		var streak := ColorRect.new()
		streak.size = Vector2(randf_range(90.0, 150.0), 5.0)
		streak.position = Vector2(size.x * (w[0] as Vector2).x, size.y * (w[0] as Vector2).y)
		streak.rotation = w[1]
		streak.color = Color(0.96, 0.93, 0.82, 0.28)   # estria de sal/areia clara
		streak.z_index = -17
		_region_node.add_child(streak)
	# PEDRAS CLARAS na linha d'água (legibilidade da borda do mar) — visual menor
	for px2 in [380.0, 700.0, 1480.0, 1820.0]:
		var wr := Polygon2D.new()
		var wp := PackedVector2Array()
		for i in range(8):
			var a := TAU * i / 8.0
			wp.append(Vector2(cos(a) * 20.0, sin(a) * 13.0))
		wr.polygon = wp
		wr.position = Vector2(px2, sea_y - 10.0)
		wr.color = Color(0.78, 0.76, 0.70, 0.9)
		wr.z_index = int(sea_y)
		_region_node.add_child(wr)

## Âncora quebrada encalhada (GODOT-COAST-DESERT-VISUAL-PASS-1): haste + braço de ferro escuro. Marco
## visual da rota antiga; blocker baixo (atravanca um pouco, mas não fecha caminho).
func _add_anchor(pos: Vector2) -> void:
	var node := Node2D.new()
	node.position = pos
	node.z_index = int(pos.y)
	node.rotation = -0.4
	_add_ground_shadow(node, 26.0, 8.0, 6.0)
	var shaft := ColorRect.new()
	shaft.size = Vector2(10, 52)
	shaft.position = Vector2(-5, -40)
	shaft.color = Color(0.22, 0.24, 0.27, 0.96)   # ferro escuro corroído
	node.add_child(shaft)
	var arm := ColorRect.new()
	arm.size = Vector2(44, 9)
	arm.position = Vector2(-22, 2)
	arm.color = Color(0.24, 0.26, 0.29, 0.96)
	node.add_child(arm)
	var ring := ColorRect.new()
	ring.size = Vector2(16, 10)
	ring.position = Vector2(-8, -46)
	ring.color = Color(0.26, 0.28, 0.31, 0.96)
	node.add_child(ring)
	_region_node.add_child(node)
	_add_blocker(Rect2(pos.x - 18, pos.y - 4, 36, 16))

## Destroço de madeira (tábua/casco) à beira-mar: tábua marrom inclinada. `solid`=true vira blocker baixo.
func _add_driftwood(pos: Vector2, angle: float, solid: bool) -> void:
	var node := Node2D.new()
	node.position = pos
	node.rotation = angle
	node.z_index = int(pos.y)
	_add_ground_shadow(node, 30.0, 8.0, 6.0)
	var plank := ColorRect.new()
	plank.size = Vector2(64, 16)
	plank.position = Vector2(-32, -8)
	plank.color = Color(0.42, 0.30, 0.20, 0.95)   # madeira encharcada/escurecida
	node.add_child(plank)
	var plank2 := ColorRect.new()
	plank2.size = Vector2(40, 12)
	plank2.position = Vector2(-10, -2)
	plank2.rotation = 0.5
	plank2.color = Color(0.5, 0.36, 0.24, 0.9)
	node.add_child(plank2)
	_region_node.add_child(node)
	if solid:
		_add_blocker(Rect2(pos.x - 30, pos.y - 8, 60, 18))

## Ossos presos no chão (VISUAL, sem colisão, z negativo): alguns cacos pálidos cruzados.
func _add_bones(pos: Vector2) -> void:
	var node := Node2D.new()
	node.position = pos
	node.z_index = -16
	for i in range(3):
		var b := ColorRect.new()
		b.size = Vector2(randf_range(18.0, 30.0), 5.0)
		b.position = Vector2(-12 + i * 6, -8 + i * 7)
		b.rotation = randf_range(-0.8, 0.8)
		b.color = Color(0.74, 0.72, 0.64, 0.7)   # osso pálido
		node.add_child(b)
	_region_node.add_child(node)

func _scatter_cave_decor(size: Vector2) -> void:
	var crystals := [Vector2(0.2, 0.3), Vector2(0.45, 0.2), Vector2(0.62, 0.42), Vector2(0.8, 0.28), Vector2(0.32, 0.72), Vector2(0.7, 0.76), Vector2(0.52, 0.86), Vector2(0.9, 0.6)]
	for n in crystals:
		_add_crystal(Vector2(size.x * n.x, size.y * n.y), 60.0)
	var rocks := [Vector2(0.15, 0.5), Vector2(0.55, 0.62), Vector2(0.85, 0.45), Vector2(0.4, 0.34)]
	for n in rocks:
		_add_rock(Vector2(size.x * n.x, size.y * n.y), 32.0)

