## Lago raso do oásis (assetless): elipses em camadas (margem úmida → água turquesa → reflexo) + brilhos.
## ATRAVESSÁVEL (sem blocker; água rasa). z=-17 (acima do chão -20/trilha -18, abaixo dos props).
## z_base: z do lago. Default -17 (chamada via _manifest_prop water_ellipse / chão base -20). O Oásis runtime
## passa z mais alto (acima do overlay de chão tileado z -10..-3) p/ a água renderizar SOBRE os tiles, mantendo-se
## abaixo de props/NPCs (z=pos.y ≥ 0). (GODOT-KHET-OASIS-GROUND-V12-RUNTIME-1)
func _build_oasis_lake(center: Vector2, rx: float, ry: float, z_base: int = -17) -> void:
	var node := Node2D.new()
	node.position = center
	node.z_index = z_base
	# margem úmida (elipse maior, areia escura molhada)
	var margin := Polygon2D.new()
	var mp := PackedVector2Array()
	for k in range(30):
		var a := TAU * k / 30.0
		mp.append(Vector2(cos(a) * (rx + 18.0), sin(a) * (ry + 12.0)))
	margin.polygon = mp
	margin.color = Color("a98a5a")
	node.add_child(margin)
	# corpo d'água (turquesa-esverdeado)
	var water := Polygon2D.new()
	var wp := PackedVector2Array()
	for k in range(30):
		var a := TAU * k / 30.0
		wp.append(Vector2(cos(a) * rx, sin(a) * ry))
	water.polygon = wp
	water.color = Color("3f7d86")
	node.add_child(water)
	# reflexo claro (elipse menor deslocada p/ cima)
	var shine := Polygon2D.new()
	var sp := PackedVector2Array()
	for k in range(24):
		var a := TAU * k / 24.0
		sp.append(Vector2(cos(a) * rx * 0.55, sin(a) * ry * 0.5) + Vector2(-rx * 0.18, -ry * 0.22))
	shine.polygon = sp
	shine.color = Color(0.62, 0.84, 0.86, 0.5)
	node.add_child(shine)
	_region_node.add_child(node)
	# brilhos pontuais (reusa _add_floor_glow, atravessável)
	_add_floor_glow(center + Vector2(-50, -10), 26.0, Color(0.85, 0.96, 0.96, 0.16))
	_add_floor_glow(center + Vector2(70, 24), 20.0, Color(0.85, 0.96, 0.96, 0.13))

## Palmeira procedural (assetless): tronco levemente curvo + frondes verdes radiais no topo. Blocker fino na base.
func _add_palm(pos: Vector2, h: float) -> void:
	var node := Node2D.new()
	node.position = pos
	node.z_index = int(pos.y)
	_add_ground_shadow(node, h * 0.22, h * 0.08, 4.0)
	var tw := h * 0.09
	var trunk := Polygon2D.new()   # tronco curvando levemente p/ a direita
	trunk.polygon = PackedVector2Array([Vector2(-tw, 0), Vector2(tw, 0), Vector2(tw * 0.7, -h * 0.55), Vector2(h * 0.10, -h), Vector2(h * 0.10 - tw * 1.2, -h), Vector2(-tw * 0.7, -h * 0.55)])
	trunk.color = Color("8a6a3f")
	node.add_child(trunk)
	var top := Vector2(h * 0.06, -h)
	var green := Color("4f7a3c")
	var gd := Color("3f6630")
	var ii := 0
	for ang in [-2.7, -2.1, -1.57, -1.0, -0.4, 0.25]:   # frondes em leque (em torno do "para cima" -1.57)
		var dir := Vector2(cos(ang), sin(ang))
		var perp := Vector2(-dir.y, dir.x)
		var L := h * 0.5
		var frond := Polygon2D.new()
		frond.polygon = PackedVector2Array([top, top + dir * L + perp * 7.0, top + dir * L * 1.05, top + dir * L - perp * 7.0])
		frond.color = green if ii % 2 == 0 else gd
		node.add_child(frond)
		ii += 1
	_region_node.add_child(node)
	_add_blocker(Rect2(pos.x - tw, pos.y - 6.0, tw * 2.0, 14.0))

## Marco de sal / altar (assetless): base de pedra + cristais de sal pálidos empilhados + leve brilho. Lore/visual.
func _build_salt_altar(pos: Vector2) -> void:
	var node := Node2D.new()
	node.position = pos
	node.z_index = int(pos.y)
	_add_ground_shadow(node, 28.0, 9.0, 4.0)
	var base := ColorRect.new()
	base.size = Vector2(52, 18); base.position = Vector2(-26, -16)
	base.color = Color("9c8f7a")   # pedra
	node.add_child(base)
	var c1 := Polygon2D.new()       # cristal central
	c1.polygon = PackedVector2Array([Vector2(0, -56), Vector2(15, -16), Vector2(-15, -16)])
	c1.color = Color("e6e0cf")
	node.add_child(c1)
	var c2 := Polygon2D.new()       # cristal lateral menor
	c2.polygon = PackedVector2Array([Vector2(-18, -34), Vector2(-6, -16), Vector2(-26, -16)])
	c2.color = Color("d8d0bb")
	node.add_child(c2)
	var c3 := Polygon2D.new()
	c3.polygon = PackedVector2Array([Vector2(18, -30), Vector2(28, -16), Vector2(8, -16)])
	c3.color = Color("d8d0bb")
	node.add_child(c3)
	_region_node.add_child(node)
	_add_floor_glow(pos + Vector2(0, -6), 24.0, Color(0.78, 0.86, 0.9, 0.12))   # halo frio (sal/runa)
	_add_blocker(Rect2(pos.x - 26, pos.y - 12, 52, 16))

## ===== MapLoader PILOTO (GODOT-MAPLOADER-NEW-REGION-PILOT-1) =====
## Carrega regiões NOVAS authored pelo Map Editor (export v1.1) a partir do JSON. NÃO migra regiões existentes
## (que seguem com seus _build_<id>). Fonte da verdade do LAYOUT da região editor-authored = o arquivo JSON;
## lógica/gates ficam no runtime (ex.: _portal_gate_open). Campos consumidos: id/size/spawn/ground/portals/
## future_exits/npcs (lore simples)/props procedurais/blockers. IGNORADOS (read-only/sem simular): interactions,
## runtime_only, mobs/chests/services (fora do escopo do piloto — ver notes do relatório). z dos props ≤ pos.y «
## 4095 (CombatVfx intacto); SEM CANVAS_ITEM_Z_MAX.

func _is_editor_authored(region_id: String) -> bool:
	return EDITOR_AUTHORED.has(region_id)

## LEGACY OVERRIDE (GODOT-MAPLOADER-LEGACY-OVERRIDE-PILOT-1): override ativo+válido p/ uma região ANTIGA?
## (flag opt-in em LEGACY_OVERRIDE_ENABLED + JSON válido). Se sim, o runtime usa o layout do JSON em vez do
## _build_<id> original; se não, cai no builder (fallback seguro). Opt-in 1 região por vez — NUNCA global.
func _is_legacy_overridden(region_id: String) -> bool:
	if not LEGACY_OVERRIDE_ENABLED.get(region_id, false):
		return false
	return not _manifest_for(region_id).is_empty()

## True se o LAYOUT da região vem de um manifesto (editor-authored NOVO ou override legado ATIVO). Usado nos
## mesmos pontos de decisão (dispatch/getters/_mob_configs/_chest_defs) — editor-authored segue idêntico.
func _is_manifest_region(region_id: String) -> bool:
	return _is_editor_authored(region_id) or _is_legacy_overridden(region_id)

## Carrega (e cacheia) o bloco "region" do manifesto v1.1 — de EDITOR_AUTHORED (regiões novas) OU de
## LEGACY_OVERRIDES (override legado opt-in). {} se faltar/inválido (→ fallback seguro: editor-authored cai em
## _build_plains; região antiga cai no _build_<id> original). VALIDA: JSON dict + region dict + id casa + size/spawn.
func _manifest_for(region_id: String) -> Dictionary:
	if _manifest_cache.has(region_id):
		return _manifest_cache[region_id]
	var path := ""
	if EDITOR_AUTHORED.has(region_id):
		path = EDITOR_AUTHORED[region_id]
	elif LEGACY_OVERRIDE_ENABLED.get(region_id, false) and LEGACY_OVERRIDES.has(region_id):
		path = LEGACY_OVERRIDES[region_id]
	if path == "":
		_manifest_cache[region_id] = {}
		return {}
	var mr := {}
	if FileAccess.file_exists(path):
		var f := FileAccess.open(path, FileAccess.READ)
		if f != null:
			var txt := f.get_as_text()
			f.close()
			var j = JSON.parse_string(txt)
			if typeof(j) == TYPE_DICTIONARY and j.has("region") and typeof(j["region"]) == TYPE_DICTIONARY:
				var r: Dictionary = j["region"]
				# validação mínima: id casa + campos essenciais (size/spawn). Senão → {} (fallback).
				if str(r.get("id", "")) != region_id:
					push_warning("[MapLoader] override de %s tem region.id divergente (%s) → fallback" % [region_id, str(r.get("id", ""))])
				elif not (r.has("size") and r.has("spawn")):
					push_warning("[MapLoader] manifesto de %s sem size/spawn → fallback" % region_id)
				else:
					mr = r
	if mr.is_empty():
		push_warning("[MapLoader] manifesto v1.1 ausente/inválido para %s (%s) → builder original" % [region_id, path])
	else:
		print("[MapLoader] região %s carregada do manifesto: %s" % [region_id, path])
	_manifest_cache[region_id] = mr
	return mr

## Sistemas runtime-only de uma região LEGADA quando o override está ativo (GODOT-MAPLOADER-LEGACY-OVERRIDE-PILOT-1):
## o override controla só o LAYOUT; bosses/NPCs-de-campanha/lógica especial seguem aqui no código. old_road NÃO
## tem runtime-only → no-op. ⏭️ plains (próximo pacote) usará isto p/ _build_wolf (Lobo Alfa) + _build_aldric.
func _legacy_runtime_extras(region_id: String) -> void:
	match region_id:
		"plains":
			# Conteúdo runtime-only de plains que o override NÃO deve controlar: boss Lobo Alfa + NPC de campanha
			# Aldric (Ato 1). REUSA os builders existentes (zero lógica nova de quest). Este hook só roda no ramo
			# _is_manifest_region de load_region (override ATIVO+válido); no fallback _build_plains já monta os dois
			# → NUNCA duplica. Posições/stats idênticos ao _build_plains original. Aldric é removido do npcs[] do
			# manifesto justamente p/ não ser recriado como NPC-lore por _build_from_manifest (anti-duplicação).
			_aldric = _build_aldric(Vector2(980, 720))
			_wolf = _build_wolf(Vector2(1480, 1110))
			_current_boss = _wolf
			_boss_name = "Lobo Alfa"
			_boss_dmg_min = 16
			_boss_dmg_max = 24
		_:
			pass   # old_road e demais: nenhum sistema runtime-only a re-adicionar

## Chão de uma região editor-authored: cor base + faixa de trilha (do manifesto) + bordas. SEM scatter
## (os props vêm do manifesto em _build_from_manifest). Espelha o mínimo do _build_shape_map.
func _build_manifest_ground(region_id: String, size: Vector2) -> void:
	var mr := _manifest_for(region_id)
	var ground = mr.get("ground", {})
	var base := ColorRect.new()
	base.size = size
	base.color = Color(str(ground.get("base_color", "#cdb083")))
	base.z_index = -20
	_region_node.add_child(base)
	# v1.2 (GODOT-GROUND-TILES-V12-RUNTIME-KHET-SAR-1): chão TILEADO opcional. Presente → base_key em grade +
	# layers nas células; vence o path_band v1.1 (a estrada/praça vêm dos tiles). Ausente → cai no path_band abaixo.
	# RENDER-ONLY: só Sprite2D em z negativo (atrás de props/NPCs em z=pos.y; « 4095 → CombatVfx intacto). Sem blocker.
	var tiles = ground.get("tiles", null)
	if typeof(tiles) == TYPE_DICTIONARY:
		_build_ground_tiles(tiles, size)
		_add_map_borders(size)
		return
	var band = ground.get("path_band", null)
	if typeof(band) == TYPE_DICTIONARY:
		var pc = ground.get("path_color_rgba", [0.7, 0.58, 0.36, 0.4])
		var p := ColorRect.new()
		var h := float(band.get("height", 150))
		var cy := float(band.get("center_y", size.y * 0.5))
		p.size = Vector2(size.x, h)
		p.position = Vector2(0, cy - h * 0.5)
		p.color = Color(float(pc[0]), float(pc[1]), float(pc[2]), float(pc[3]) if pc.size() > 3 else 1.0)
		p.z_index = -18
		_region_node.add_child(p)
	_add_map_borders(size)

## Chão TILEADO v1.2 (GODOT-GROUND-TILES-V12-RUNTIME-KHET-SAR-1): base_key repetido em grade por toda a região +
## layers em ordem nas células "c,r" (pixel = c*tile_size, r*tile_size). RENDER-ONLY (Sprite2D, sem blocker/colisão/
## interação). z negativo: base grid -19, layers -18+i (todos « 0 → atrás de props/NPCs em z=pos.y; « 4095 CombatVfx).
## asset_key relativo a res://assets/. Tile faltando = pulado (push_warning), o base_color cobre o buraco.
## z_base: base grid em z_base, layers em z_base+1.. (cap z_base+7, sempre « 0). Editor-authored usa -19 (chão base
## em -20); overlay de região runtime-authored usa -10 (acima do chão procedural base -20/path -18/decor -16/-15).
func _build_ground_tiles(tiles: Dictionary, size: Vector2, z_base: int = -19, nearest: bool = false) -> void:
	var ts := int(tiles.get("tile_size", 96))
	if ts <= 0:
		ts = 96
	var cols := int(ceil(size.x / float(ts)))
	var rows := int(ceil(size.y / float(ts)))
	# 1) base_key em grade por toda a região
	var base_key := str(tiles.get("base_key", ""))
	if base_key != "":
		var base_tex := _try_load_tex("res://assets/" + base_key)
		if base_tex != null:
			for r in range(rows):
				for c in range(cols):
					var s := Sprite2D.new()
					s.texture = base_tex
					s.centered = false
					s.position = Vector2(c * ts, r * ts)
					s.z_index = z_base
					if nearest: s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
					_region_node.add_child(s)
	# 2) layers em ordem (cada layer um z acima da anterior, ainda « 0)
	var zl := z_base + 1
	for L in tiles.get("layers", []):
		var key := str(L.get("key", ""))
		if key == "":
			continue
		var tex := _try_load_tex("res://assets/" + key)
		if tex == null:
			continue
		for cell in L.get("cells", []):
			var parts := str(cell).split(",")
			if parts.size() < 2:
				continue
			var s := Sprite2D.new()
			s.texture = tex
			s.centered = false
			s.position = Vector2(int(parts[0]) * ts, int(parts[1]) * ts)
			s.z_index = zl
			if nearest: s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
			_region_node.add_child(s)
		zl = min(zl + 1, z_base + 7)   # mantém os layers abaixo de 0 (props/NPCs ≥ 0)

## Monta a região editor-authored a partir do manifesto: portais, future_exits, NPCs (lore), props procedurais.
## Blockers dos props procedurais são gerados pelos próprios helpers (determinístico, = runtime); blockers[]
## "manual"/"editor" do manifesto são adicionados à parte. Mobs/chests/services ficam para um pacote futuro.
func _build_from_manifest(region_id: String) -> void:
	_current_boss = null
	_boss_name = ""
	var mr := _manifest_for(region_id)
	if mr.is_empty():
		_build_plains(_region_size)   # fallback SEGURO (nunca quebra a sessão)
		return
	# PORTAIS
	for pt in mr.get("portals", []):
		var pos := _mpos(pt.get("position", [0, 0]))
		var spawn_at: Vector2 = _mpos(pt["target_spawn"]) if pt.get("target_spawn", null) != null else Vector2.INF
		_build_portal(pos, str(pt.get("target_region", "")), str(pt.get("label", "Passagem")), bool(pt.get("draw_door", true)), spawn_at)
	# FUTURE EXITS (só texto; default branch do _use_future_exit mostra title+msg)
	for fe in mr.get("future_exits", []):
		var fpos := _mpos(fe.get("position", [0, 0]))
		var node := Node2D.new()
		node.position = fpos
		node.z_index = int(fpos.y)
		var prompt := Label.new()
		prompt.text = "[E] " + str(fe.get("label", "olhar"))
		prompt.position = Vector2(-80, -88)
		prompt.modulate = Color("f0d29a")
		prompt.add_theme_font_size_override("font_size", 14)
		prompt.visible = false
		node.add_child(prompt)
		_tag_on_top(prompt)
		_region_node.add_child(node)
		var msg := []
		for ln in fe.get("notes", []):
			msg.append(str(ln))
		if msg.is_empty():
			msg = ["O caminho adiante ainda aguarda outra jornada."]
		_services.append({"node": node, "prompt": prompt, "pos": fpos, "kind": "future_exit", "id": str(fe.get("id", "fexit")), "title": str(fe.get("label", "Passagem")), "msg": msg})
	# NPCs (lore + serviço opcional: service "merchant"/"blacksmith" abre a loja/forja via _talk_to_npc → _open_shop)
	for np in mr.get("npcs", []):
		var npos := _mpos(np.get("position", [0, 0]))
		var lines := []
		for ln in np.get("dialogue", []):
			lines.append(str(ln))
		if lines.is_empty():
			lines = ["..."]
		var key := str(np.get("sprite_key", "npcs/village/elder"))
		if key == "":
			key = "npcs/village/elder"
		var svc_kind := ""
		var sv = np.get("service", null)
		if typeof(sv) == TYPE_STRING:
			svc_kind = sv   # "merchant"/"blacksmith" → abre loja/forja compartilhada; "" = só fala (lore)
		_build_villager(npos, key, str(np.get("name", "Viajante")), lines, svc_kind, bool(np.get("wander", false)))
	# SERVICES não-NPC (GODOT-MAPLOADER-SERVICES-INTERACTIONS-PILOT-1): healer/rest/shrine/quest_board → _build_service
	# (interação por [E] dispatchada em _use_service, que já existe). merchant/blacksmith vêm como NPC (acima).
	for sv2 in mr.get("services", []):
		var skind := str(sv2.get("kind", ""))
		if skind == "rest":
			skind = "healer"   # "rest" é alias amigável do editor → healer (HP+mana)
		if skind in ["healer", "shrine", "quest_board"]:
			_build_service(_mpos(sv2.get("position", [0, 0])), skind, str(sv2.get("label", "[E] usar")))
		elif skind != "":
			push_warning("[MapLoader] service kind não suportado no piloto: %s" % skind)
	# INTERACTIONS simples (marco one-time com flag + recompensa 1×): vira um serviço kind "story_marker" clicável.
	# A lógica (flag/recompensa idempotente) roda no runtime (_use_story_marker); o JSON só descreve.
	for it in mr.get("interactions", []):
		if str(it.get("type", "")) != "one_time_story_marker":
			continue   # outros tipos (ex.: kill:X) são runtime-only/descritivos → ignorados aqui
		var ipos := _mpos(it.get("position", [0, 0]))
		if ipos == Vector2.ZERO and not it.has("position"):
			continue   # sem posição não é clicável
		var inode := Node2D.new()
		inode.position = ipos
		inode.z_index = int(ipos.y)
		var iprompt := Label.new()
		iprompt.text = "[E] " + str(it.get("label", "examinar"))
		iprompt.position = Vector2(-80, -88)
		iprompt.modulate = Color("f0d29a")
		iprompt.add_theme_font_size_override("font_size", 14)
		iprompt.visible = false
		inode.add_child(iprompt)
		_tag_on_top(iprompt)
		_region_node.add_child(inode)
		var dbefore := []
		for ln in it.get("dialogue_before", []):
			dbefore.append(str(ln))
		var dafter := []
		for ln in it.get("dialogue_after", []):
			dafter.append(str(ln))
		_services.append({"node": inode, "prompt": iprompt, "pos": ipos, "kind": "story_marker",
			"id": str(it.get("id", "marker")), "title": str(it.get("label", "Marco")),
			"flag": str(it.get("flag", "")), "reward": it.get("reward", {}),
			"dialogue_before": dbefore, "dialogue_after": dafter})
	# PROPS: type "sprite" (asset_key → sprite REAL, ysort; blocker vem do blockers[] do manifesto) OU procedural
	# (placeholder assetless; o helper adiciona o próprio blocker determinístico).
	for pr in mr.get("props", []):
		if str(pr.get("type", "")) == "sprite" and pr.has("asset_key"):
			_manifest_sprite_prop(str(pr["asset_key"]), _mpos(pr.get("position", [0, 0])))
		else:
			_manifest_prop(str(pr.get("procedural_type", "")), _mpos(pr.get("position", [0, 0])), pr.get("params", {}))
	# BLOCKERS do manifesto: adiciona TODOS como colisão pura. Regiões com props PROCEDURAIS trazem blockers[]
	# VAZIO (o helper já cria os deles) → no-op aqui; regiões com props SPRITE (editor-authored, ex.: khet_sar_city)
	# trazem o footprint de cada prédio em blockers[] (sprite não gera blocker sozinho). (GODOT-KHET-SAR-CITY-RUNTIME-LINK-1)
	for b in mr.get("blockers", []):
		var r = b.get("rect", null)
		if typeof(r) == TYPE_ARRAY and r.size() >= 4:
			_add_blocker(Rect2(float(r[0]), float(r[1]), float(r[2]), float(r[3])))
	if region_id == "khet_sar_city":
		# KHET-SAR_BUILD_01: a Cidade deixa de ser o fim do continente — saída LESTE para as Dunas Profundas.
		_build_portal(CITY_TO_DUNES, "deep_dunes", "Portão Leste → Dunas Profundas", true, DUNES_SPAWN)
		# ★ CORTE 4 (KHETSAR_CONSOLIDATION_BUILD_01) — a Cidade diz sua RESPOSTA (soltar/seguir vivendo). Uma inscrição
		# gasta na praça do portão (perto do spawn 850,940), [E] só-texto, sem NPC-explicador. Dá voz à 3ª resposta de
		# Khet-Sar (Arquivo=guardar · Pedra=carregar · Cidade=seguir) sem virar manifesto.
		_maw_marker(Vector2(956.0, 996.0), "city_creed", "✦ [E] uma inscrição gasta", [
			"Lavrada na pedra do portão, comida pelo sol mas ainda legível:",
			"«Aqui ninguém te pergunta o nome. A cidade segue — com ele, ou sem ele.»",
		])
	if region_id == "khet_sar_city" and _desert_city_atmo_on():
		_build_desert_city_atmo()   # DESERT CITY ATMO: praça do portão "viva" (atmosfera aditiva, atrás de flag, SÓ aqui)

## [x,y] (Array do JSON) -> Vector2.
func _mpos(a) -> Vector2:
	if typeof(a) == TYPE_ARRAY and a.size() >= 2:
		return Vector2(float(a[0]), float(a[1]))
	return Vector2.ZERO

## DESERT CITY ATMO — piloto ligado? (const de produção OU override de self-test OU env). OFF = cidade idêntica.
func _desert_city_atmo_on() -> bool:
	return DESERT_CITY_ATMO_ENABLED or _desertcity_force or OS.has_environment("AV_DESERT_CITY_ATMO")

## DESERT CITY ATMO — vida de cenário da PRAÇA DO PORTÃO (sul de khet_sar_city, ~y∈[820,1138]: spawn 850,940 → portão
## 850,1138). Atmosfera ADITIVA, SÓ aqui: densidade estática (mercadoria/pegadas/mancha/desgaste, ladeando o eixo de
## passagem x≈850, SEM blocker), poeira à deriva, toldo de mercado que balança, 1 silhueta de borda que cruza e IGNORA
## o jogador (sem colisão/Area2D), e 1 leito de áudio com fade-in (DORMENTE sem asset — jogo mudo hoje). NÃO toca
## quest/loja/NPC/economia/combate/save/UI. Tudo marcado av_desertcity. Provar em 10s: "vivo" + "não é sobre mim".
func _build_desert_city_atmo() -> void:
	var KC := "res://assets/tilesets/khet_sar_city/"
	# 1) DENSIDADE ESTÁTICA (P0) — mercadoria usada e desacompanhada, ladeando a entrada (eixo x≈850), VISUAL/sem blocker.
	_dca_prop(KC + "market_stall.png", Vector2(610, 905))
	_dca_prop(KC + "market_stall.png", Vector2(1095, 915))
	_dca_prop(KC + "props/clay_pot_cluster.png", Vector2(662, 965))
	_dca_prop(KC + "props/small_crate_sacks.png", Vector2(1040, 975))
	_dca_prop(KC + "props/small_crate_sacks.png", Vector2(560, 858))
	# marcas de uso no chão da praça (mancha de tempero permanente, chão polido pelo trânsito, pegadas cruzadas)
	_dca_stain(Vector2(900, 1012), Color(0.55, 0.18, 0.13, 0.22))
	_dca_polish(Vector2(850, 982), 72.0)
	_dca_polish(Vector2(842, 1082), 56.0)
	for fp in [Vector2(820, 1042), Vector2(884, 1002), Vector2(806, 958), Vector2(902, 1062)]:
		_dca_footprints(fp)
	# 2) PROPS ANIMADOS (P1) — toldos de mercado que balançam de leve (sway sutil) + um fio de fumaça.
	_dca_awning(KC + "market_canopy_red.png", Vector2(610, 866))
	_dca_awning(KC + "market_canopy_red.png", Vector2(1095, 876))
	_dca_smoke(Vector2(1130, 838))
	# 3) FLUXO VISUAL (P1) — poeira à deriva pela praça (motes que cruzam e reciclam, indiferentes ao jogador).
	for i in range(7):
		_dca_dust_mote(Vector2(600.0 + 150.0 * float(i), 902.0 + (58.0 if i % 2 == 0 else -28.0)))
	# 4) ANONIMATO/TRÂNSITO (P1) — UMA silhueta cruzando a borda sul, do oeste ao leste, ignorando o jogador.
	_dca_crosser(Vector2(-60, 1092), Vector2(1760, 1074), 30.0)
	# 5) ÁUDIO (P0) — leito de murmúrio com FADE-IN ao montar a praça (o gradiente da chegada). DORMENTE sem asset.
	_dca_murmur()

## prop estático VISUAL (ysort pelo pé, SEM blocker — não trava passagem nem inicia interação)
func _dca_prop(path: String, pos: Vector2) -> void:
	var tex := _try_load_tex(path)
	if tex == null:
		return
	var s := Sprite2D.new()
	s.texture = tex
	s.position = pos
	s.z_index = int(pos.y)
	s.set_meta("av_desertcity", true)
	_region_node.add_child(s)

## mancha permanente no chão (elipse achatada, z negativo)
func _dca_stain(pos: Vector2, col: Color) -> void:
	var poly := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(18):
		var a := TAU * i / 18.0
		pts.append(Vector2(cos(a) * 26.0, sin(a) * 16.0))
	poly.polygon = pts
	poly.position = pos
	poly.color = col
	poly.z_index = -16
	poly.set_meta("av_desertcity", true)
	_region_node.add_child(poly)

## chão polido pelo trânsito (desgaste por repetição) — elipse clara achatada
func _dca_polish(pos: Vector2, r: float) -> void:
	var poly := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(20):
		var a := TAU * i / 20.0
		pts.append(Vector2(cos(a) * r, sin(a) * r * 0.42))
	poly.polygon = pts
	poly.position = pos
	poly.color = Color(0.80, 0.68, 0.46, 0.10)
	poly.z_index = -15
	poly.set_meta("av_desertcity", true)
	_region_node.add_child(poly)

## pegadas cruzadas (Line2D curto e quebrado, gasto)
func _dca_footprints(pos: Vector2) -> void:
	var line := Line2D.new()
	line.width = 2.0
	line.default_color = Color(0.42, 0.34, 0.22, 0.34)
	line.points = PackedVector2Array([pos + Vector2(-12, 5), pos + Vector2(-2, -3), pos + Vector2(9, 4), pos + Vector2(16, -2)])
	line.z_index = -14
	line.set_meta("av_desertcity", true)
	_region_node.add_child(line)

## toldo de mercado com sway sutil (cloth ao vento) — amplitude minúscula p/ NÃO virar cartoon
func _dca_awning(path: String, pos: Vector2) -> void:
	var tex := _try_load_tex(path)
	if tex == null:
		return
	var s := Sprite2D.new()
	s.texture = tex
	s.position = pos
	s.z_index = int(pos.y)
	s.set_meta("av_desertcity", true)
	_region_node.add_child(s)
	if s.is_inside_tree():
		s.rotation = -0.014
		var tw := s.create_tween()
		tw.set_loops()
		tw.tween_property(s, "rotation", 0.014, 2.6).set_trans(Tween.TRANS_SINE)
		tw.tween_property(s, "rotation", -0.014, 2.6).set_trans(Tween.TRANS_SINE)

## fio de fumaça leve — alguns motes que sobem, surgem e se dissolvem, em loop
func _dca_smoke(pos: Vector2) -> void:
	for i in range(3):
		var m := Polygon2D.new()
		var pts := PackedVector2Array()
		for j in range(10):
			var a := TAU * j / 10.0
			pts.append(Vector2(cos(a) * 6.0, sin(a) * 6.0))
		m.polygon = pts
		m.position = pos + Vector2(float(i) * 3.0 - 3.0, 0.0)
		m.color = Color(0.62, 0.58, 0.52, 0.0)
		m.z_index = int(pos.y) + 1
		m.set_meta("av_desertcity", true)
		_region_node.add_child(m)
		if m.is_inside_tree():
			var dur := 3.4 + float(i) * 0.5
			var top: Vector2 = m.position + Vector2(-8.0, -48.0)
			var start: Vector2 = m.position
			var tw := m.create_tween()
			tw.set_loops()
			tw.tween_property(m, "color:a", 0.16, dur * 0.4).set_trans(Tween.TRANS_SINE)
			tw.parallel().tween_property(m, "position", top, dur)
			tw.tween_property(m, "color:a", 0.0, dur * 0.6)
			tw.tween_property(m, "position", start, 0.0)

## mote de poeira à deriva (cruza a praça e recicla, indiferente)
func _dca_dust_mote(pos: Vector2) -> void:
	var m := Polygon2D.new()
	var pts := PackedVector2Array()
	for j in range(8):
		var a := TAU * j / 8.0
		pts.append(Vector2(cos(a) * 2.2, sin(a) * 2.2))
	m.polygon = pts
	m.position = pos
	m.color = Color(0.86, 0.78, 0.60, 0.0)
	m.z_index = 5
	m.set_meta("av_desertcity", true)
	_region_node.add_child(m)
	if m.is_inside_tree():
		var start: Vector2 = pos
		var drift: Vector2 = pos + Vector2(220.0, -18.0)
		var tw := m.create_tween()
		tw.set_loops()
		tw.tween_property(m, "color:a", 0.22, 1.2)
		tw.parallel().tween_property(m, "position", drift, 5.0).set_trans(Tween.TRANS_SINE)
		tw.tween_property(m, "color:a", 0.0, 1.2)
		tw.tween_property(m, "position", start, 0.0)

## silhueta humanoide de borda que cruza e IGNORA o jogador (NÃO é um ator: Polygon2D, sem colisão/Area2D/interação)
func _dca_crosser(from: Vector2, to: Vector2, speed: float) -> void:
	var sil := Polygon2D.new()
	sil.polygon = PackedVector2Array([
		Vector2(-5, -2), Vector2(-4, -20), Vector2(-2, -27), Vector2(2, -27),
		Vector2(4, -20), Vector2(5, -2), Vector2(2, 0), Vector2(-2, 0),
	])
	sil.position = from
	sil.color = Color(0.16, 0.13, 0.12, 0.5)
	sil.z_index = int(from.y)
	sil.set_meta("av_desertcity", true)
	_region_node.add_child(sil)
	if sil.is_inside_tree():
		var dur: float = from.distance_to(to) / max(speed, 1.0)
		var tw := sil.create_tween()
		tw.set_loops()
		tw.tween_property(sil, "position", to, dur)
		tw.tween_property(sil, "position", from, 0.0)

## leito de murmúrio da cidade com fade-in (o gradiente da chegada). DORMENTE sem asset: o jogo é mudo hoje, então
## sem o arquivo de murmúrio o nó fica silencioso (sem música nova obrigatória); um drop-in futuro o acende.
func _dca_murmur() -> void:
	var ap := AudioStreamPlayer.new()
	ap.set_meta("av_desertcity", true)
	ap.volume_db = -80.0
	if ResourceLoader.exists(DESERT_CITY_MURMUR_PATH):
		var st = load(DESERT_CITY_MURMUR_PATH)
		if st != null:
			if "loop" in st:
				st.loop = true
			ap.stream = st
	_region_node.add_child(ap)
	if ap.stream != null and ap.is_inside_tree():
		ap.play()
		var tw := ap.create_tween()
		tw.tween_property(ap, "volume_db", -20.0, 2.4)   # fade-in discreto (volume baixo)

## Prop SPRITE de manifesto editor-authored (GODOT-KHET-SAR-CITY-RUNTIME-LINK-1): carrega o PNG real por asset_key
