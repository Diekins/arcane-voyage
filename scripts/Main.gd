## Contrato de um baú (ver godot/docs/CHESTS_CONTRACT.md):
##   { "id": String (único/estável), "x": float, "y": float,
##     "loot": { "gold": int?, "materials": {nome:qtd}?, "items": [id_do_ItemDB,...]? } }
## Estado "aberto" mora em GameState.opened_chests (persistido). Conteúdo/posição vêm daqui (fallback
## em código) OU, no futuro, de objetos kind:"chest" de um mapa do Studio via MapLoader — MESMO contrato.

## Baú interagível mais próximo (só FECHADOS entram em _chests) ou null.
func _nearest_chest():
	if _player == null:
		return null
	var best = null
	var best_d := INTERACT_RADIUS
	for c in _chests:
		var d: float = _player.position.distance_to(c["pos"])
		if d <= best_d:
			best_d = d
			best = c
	return best

