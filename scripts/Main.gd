## Mapa de SHAPES (Caverna + fallback): chão base + grade + caminho + bordas + decoração-shape.
func _build_shape_map(region_id: String, size: Vector2) -> void:
	var base := ColorRect.new()
	base.size = size
	base.color = _ground_base_color(region_id)
	base.z_index = -20
	_region_node.add_child(base)
	_add_tile_grid(region_id, size)
	var path := ColorRect.new()   # trilha horizontal atravessando o mapa
	path.size = Vector2(size.x, 150)
	path.position = Vector2(0, size.y * 0.5 - 75)
	path.color = _path_color(region_id)
	path.z_index = -18
	_region_node.add_child(path)
	_add_map_borders(size)
	if region_id == "cave":
		_scatter_cave_decor(size)
	elif region_id == "swamp":
		_scatter_swamp_decor(size)
	elif region_id == "swamp_pit":
		_scatter_pit_decor(size)
	elif region_id == "old_road":
		_scatter_ruins_decor(size)
	elif region_id == "ashen_grove":
		_scatter_grove_decor(size)
	elif region_id == "deep_grove":
		_scatter_deep_grove_decor(size)
	elif region_id == "ancient_root_nest":
		_scatter_ancient_nest_decor(size)
	elif region_id == "saltwind_shore":
		_scatter_coast_decor(size)
	elif region_id == "castaway_sandbar" or region_id == "salt_split_isle" or region_id == "khet_sar_sands" or region_id == "khet_caravan_camp" or region_id == "khet_oasis":
		_scatter_desert_decor(region_id, size)   # bioma seco (GODOT-DESERT-BIOME-POLISH-1): sem árvores verdes
	else:
		_scatter_plains_decor(size)

## --- PÂNTANO/POÇO com tiles/props reais (GODOT-SWAMP-VISUAL-PASS-1) ---

## Chão de pântano (GODOT-SWAMP-TERRAIN-PACK-4): textura GRANDE única (1536×960) ESCALADA p/ cobrir a
## região — SEM texture_repeat → zero grade/costura. `mod` mistura com a cor base por baixo (alpha<1
## funde com o verde; mais escuro no poço). Retorna false se a textura faltar (cai no fallback procedural).
func _swamp_floor(size: Vector2, mod: Color) -> bool:
	var tex := _try_load_tex(SW + "ground_large.png")
	if tex == null:
		return false
	var s := Sprite2D.new()
	s.texture = tex
	s.centered = false
	s.scale = Vector2(size.x / float(tex.get_width()), size.y / float(tex.get_height()))
	s.modulate = mod
	s.z_index = -21
	_region_node.add_child(s)
	return true

## Prop SÓLIDO (sprite ysort + blocker no pé). foot = (largura, altura) do bloqueio.
func _swamp_solid(path: String, pos: Vector2, foot: Vector2, base_off: float = 30.0) -> void:
	_add_prop(path, pos, 0, true, base_off)
	_add_blocker(Rect2(pos.x - foot.x * 0.5, pos.y + 2.0, foot.x, foot.y))

## Mapa do Pântano: CHÃO CONTÍNUO (cor base + manchas/poças ORGÂNICAS, sem grade de tiles — os tiles do
## pack não são seamless) + PROPS reais sólidos NAS MESMAS posições do decor procedural (blockers
## equivalentes → spawns já validados seguem livres) + detalhe de chão atravessável.
func _build_swamp_map(size: Vector2) -> void:
	var base := ColorRect.new(); base.size = size; base.color = Color("2c352a"); base.z_index = -22
	_region_node.add_child(base)
	# textura de chão rica (mistura c/ o verde por alpha); fallback = manchas procedurais
	if not _swamp_floor(size, Color(1, 1, 1, 0.82)):
		_swamp_ground_patches(size)
	for n in [Vector2(0.4, 0.55), Vector2(0.7, 0.72), Vector2(0.33, 0.7), Vector2(0.55, 0.4)]:
		_swamp_pool(Vector2(size.x * n.x, size.y * n.y))   # poças orgânicas (atravessáveis)
	_add_map_borders(size)
	var posts := ["props/stump.png", "props/iron_post.png", "props/mossrock.png"]
	var tnorm := [Vector2(0.12, 0.2), Vector2(0.34, 0.12), Vector2(0.56, 0.18), Vector2(0.78, 0.14), Vector2(0.9, 0.34), Vector2(0.16, 0.82), Vector2(0.44, 0.9), Vector2(0.68, 0.84), Vector2(0.88, 0.8)]
	for i in range(tnorm.size()):
		_swamp_solid(SW + posts[i % posts.size()], Vector2(size.x * tnorm[i].x, size.y * tnorm[i].y), Vector2(28, 22), 30.0)
	for n in [Vector2(0.26, 0.42), Vector2(0.62, 0.6), Vector2(0.8, 0.46)]:
		_swamp_solid(SW + "props/scrap.png", Vector2(size.x * n.x, size.y * n.y), Vector2(52, 26), 26.0)
	for n in [Vector2(0.2, 0.5), Vector2(0.5, 0.3), Vector2(0.62, 0.28), Vector2(0.3, 0.85), Vector2(0.72, 0.5)]:
		_add_prop(SW + "props/reeds.png", Vector2(size.x * n.x, size.y * n.y), -14)   # detalhe sem blocker
	for n in [Vector2(0.45, 0.46), Vector2(0.55, 0.78), Vector2(0.24, 0.62)]:
		_add_prop(SW + "props/fungus.png", Vector2(size.x * n.x, size.y * n.y), -13)
	for n in [Vector2(0.38, 0.4), Vector2(0.68, 0.66)]:
		_add_prop(SW + "props/roots.png", Vector2(size.x * n.x, size.y * n.y), -13)

## Mapa do Poço (subárea): CHÃO CONTÍNUO escuro (cor base + manchas, SEM grade de tiles) + anel de
## sucata/postes nas bordas (mesmas posições → blockers equivalentes; centro livre p/ a arena) + halo.
func _build_pit_map(size: Vector2) -> void:
	var base := ColorRect.new(); base.size = size; base.color = Color("181d1a"); base.z_index = -22
	_region_node.add_child(base)
	# mesma textura de chão, ESCURECIDA p/ leitura subterrânea; fallback = manchas
	if not _swamp_floor(size, Color(0.55, 0.55, 0.6, 0.92)):
		_swamp_ground_patches(size, Color(0.10, 0.09, 0.07, 0.5))
	_add_map_borders(size)
	var ring := [Vector2(0.12, 0.2), Vector2(0.88, 0.2), Vector2(0.12, 0.82), Vector2(0.88, 0.82), Vector2(0.5, 0.12), Vector2(0.5, 0.9)]
	for i in range(ring.size()):
		var p := Vector2(size.x * ring[i].x, size.y * ring[i].y)
		_swamp_solid(SW + ("props/scrap.png" if i % 2 == 0 else "props/iron_post.png"), p, Vector2(50, 26), 28.0)
	var halo := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(18):
		var a := TAU * i / 18.0
		pts.append(Vector2(cos(a) * 150.0, sin(a) * 96.0))
	halo.polygon = pts
	halo.position = Vector2(size.x * 0.55, size.y * 0.55)
	halo.color = Color(0.35, 0.20, 0.14, 0.22)
	halo.z_index = -16
	_region_node.add_child(halo)

## Manchas de terreno ORGÂNICAS (Polygon2D irregular, z acima da base, SEM colisão) — quebram a cor
## chapada do chão sem grade de tiles. `col` = variação leve da base (lama / terra batida do poço).
func _swamp_ground_patches(size: Vector2, col: Color = Color(0.20, 0.26, 0.18, 0.5)) -> void:
	var spots := [Vector2(0.22, 0.3), Vector2(0.5, 0.22), Vector2(0.78, 0.36), Vector2(0.32, 0.62), Vector2(0.6, 0.7), Vector2(0.84, 0.66), Vector2(0.45, 0.85), Vector2(0.15, 0.5)]
	for s in spots:
		var poly := Polygon2D.new()
		var pts := PackedVector2Array()
		var rr := randf_range(120.0, 220.0)
		for i in range(14):
			var a := TAU * i / 14.0
			pts.append(Vector2(cos(a) * rr * randf_range(0.7, 1.25), sin(a) * rr * 0.62 * randf_range(0.7, 1.25)))
		poly.polygon = pts
		poly.position = Vector2(size.x * s.x, size.y * s.y)
		poly.color = col
		poly.z_index = -20
		_region_node.add_child(poly)

## Poça orgânica (não-quadrada) atravessável.
func _swamp_pool(pos: Vector2) -> void:
	var poly := Polygon2D.new()
	var pts := PackedVector2Array()
	var rr := randf_range(46.0, 74.0)
	for i in range(13):
		var a := TAU * i / 13.0
		pts.append(Vector2(cos(a) * rr * randf_range(0.8, 1.2), sin(a) * rr * 0.6 * randf_range(0.8, 1.2)))
	poly.polygon = pts
	poly.position = pos
	poly.color = Color(0.14, 0.22, 0.16, 0.7)   # água escura
	poly.z_index = -18
	_region_node.add_child(poly)

## --- RUÍNAS DA ESTRADA VELHA com tiles/props reais (GODOT-OLD-ROAD-VISUAL-PASS-1) ---

## Chão por TEXTURA GRANDE genérico (path explícito): 1 Sprite2D escalado, SEM texture_repeat → sem
## grade/costura. Retorna false se a textura faltar (fallback procedural). NÃO toca o chão do Pântano.
func _big_floor(size: Vector2, mod: Color, path: String) -> bool:
	var tex := _try_load_tex(path)
	if tex == null:
		return false
	var s := Sprite2D.new()
	s.texture = tex
	s.centered = false
	s.scale = Vector2(size.x / float(tex.get_width()), size.y / float(tex.get_height()))
	s.modulate = mod
	s.z_index = -21
	_region_node.add_child(s)
	return true

## Mapa das Ruínas: CHÃO contínuo por textura grande (sem grade) + colunas/entulho REAIS nas MESMAS
## posições do `_scatter_ruins_decor` com blockers IDÊNTICOS (spawns já validados seguem livres) +
## detalhe atravessável (marcos/lajes/runa/arbusto). Fallback procedural se a textura faltar.
func _build_old_road_map(size: Vector2) -> void:
	var base := ColorRect.new(); base.size = size; base.color = Color("4a4636"); base.z_index = -22
	_region_node.add_child(base)
	if not _big_floor(size, Color(1, 1, 1, 0.9), OR + "ground_large.png"):
		_scatter_ruins_decor(size)
		_add_map_borders(size)
		return
	_add_map_borders(size)
	# COLUNAS partidas (blocker idêntico ao _add_column) nas mesmas posições
	for n in [Vector2(0.1, 0.15), Vector2(0.3, 0.1), Vector2(0.55, 0.16), Vector2(0.78, 0.12), Vector2(0.9, 0.3), Vector2(0.12, 0.85), Vector2(0.4, 0.9), Vector2(0.7, 0.85), Vector2(0.88, 0.82)]:
		var pc := Vector2(size.x * n.x, size.y * n.y)
		_add_prop(OR + "props/broken_column.png", pc, 0, true, 30.0)
		_add_blocker(Rect2(pc.x - 12, pc.y + 2, 24, 20))
	# ENTULHO (blocker idêntico ao _add_rock(24)) nas mesmas posições
	for n in [Vector2(0.25, 0.45), Vector2(0.6, 0.6), Vector2(0.82, 0.4), Vector2(0.45, 0.72)]:
		var pr := Vector2(size.x * n.x, size.y * n.y)
		_add_prop(OR + "props/rubble_pile.png", pr, 0, true, 26.0)
		_add_blocker(Rect2(pr.x - 24, pr.y - 12, 48, 24))
	# DETALHE atravessável (sem blocker) — marcos/lajes/runa/arbusto, longe de spawns/portais
	for n in [Vector2(0.5, 0.3), Vector2(0.65, 0.78), Vector2(0.2, 0.6)]:
		_add_prop(OR + "props/broken_milestone.png", Vector2(size.x * n.x, size.y * n.y), -14)
	for n in [Vector2(0.4, 0.5), Vector2(0.72, 0.46), Vector2(0.3, 0.32)]:
		_add_prop(OR + "props/cracked_flagstone.png", Vector2(size.x * n.x, size.y * n.y), -15)
	for n in [Vector2(0.55, 0.56), Vector2(0.85, 0.66)]:
		_add_prop(OR + "props/rune_stone.png", Vector2(size.x * n.x, size.y * n.y), -13)
	for n in [Vector2(0.36, 0.84), Vector2(0.6, 0.2)]:
		_add_prop(OR + "props/dead_shrub.png", Vector2(size.x * n.x, size.y * n.y), -13)

func _add_tile_grid(region_id: String, size: Vector2) -> void:
	var col := Color(1, 1, 1, 0.05) if region_id == "plains" else Color(0.5, 0.8, 0.95, 0.05)
	var step := 192
	for x in range(step, int(size.x), step):
		var v := ColorRect.new()
		v.size = Vector2(2, size.y)
		v.position = Vector2(x, 0)
		v.color = col
		v.z_index = -19
		_region_node.add_child(v)
	for y in range(step, int(size.y), step):
		var h := ColorRect.new()
		h.size = Vector2(size.x, 2)
		h.position = Vector2(0, y)
		h.color = col
		h.z_index = -19
		_region_node.add_child(h)

func _add_map_borders(size: Vector2) -> void:
	if _suppress_internal_borders:
		return   # macro-zona: cada região NÃO emparedа; só a borda do mundo inteiro é desenhada (_macro_world_border)
	# P1.5-B — HORIZONTES NATURAIS: nos 4 biomas seguros (Costa/Caverna/Pântano/Deserto), a borda deixa de ser uma
	# "moldura de vazio" e passa a dissolver o lugar na sua própria matéria (mar/escuro/névoa/areia) — insinuando
	# que o lugar CONTINUA além do alcance. Não some, não vira caminho, não toca bounds/save/mecânica. Demais
	# regiões: borda escura ANTIGA, intacta (Estrada/Planície/cluster/limiares NÃO autorizados).
	var biome := _region_biome(_horizon_build_region)
	if biome != "":
		_add_horizon_borders(size, biome)
		return
	var t := 36.0
	var col := Color(0.05, 0.06, 0.08, 0.85)
	var rects := [
		Rect2(0, 0, size.x, t), Rect2(0, size.y - t, size.x, t),
		Rect2(0, 0, t, size.y), Rect2(size.x - t, 0, t, size.y),
	]
	for r in rects:
		var b := ColorRect.new()
		b.size = r.size
		b.position = r.position
		b.color = col
		b.z_index = -17
		_region_node.add_child(b)

## Bioma de uma região p/ a linguagem de horizonte (P1.5-B). "" = sem tratamento (borda antiga). Só os 4 autorizados.
func _region_biome(region_id: String) -> String:
	match region_id:
		"saltwind_shore", "castaway_sandbar", "salt_split_isle", "praia_das_velas", "cais_dos_ausentes", "promontorio_do_espelho":
			return "costa"
		"cave", "veins", "cathedral_of_crystal", "fendas":
			return "caverna"
		"swamp", "swamp_pit", "iron_channels":
			return "pantano"
		_:
			return "deserto" if region_id.begins_with("khet") else ""

## Tom da "matéria" em que o lugar se dissolve na borda (P1.5-B). Hazes claras (continuação atmosférica) p/ costa/
## pântano/deserto; profundidade escura fria p/ caverna (o escuro é honesto, mas com gradiente = profundidade).
func _horizon_color(biome: String) -> Color:
	match biome:
		"costa":   return Color(0.58, 0.69, 0.76)   # bruma do mar (distância)
		"pantano": return Color(0.60, 0.64, 0.60)   # névoa do brejo
		"deserto": return Color(0.85, 0.77, 0.58)   # calor/areia ao longe
		"caverna": return Color(0.03, 0.035, 0.05)  # profundidade fria
		_:         return Color(0.05, 0.06, 0.08)

## Borda-horizonte: em vez de 1 faixa escura chapada, um GRADIENTE de 6 camadas que vai da matéria do bioma (forte
## na borda externa) dissolvendo-se para dentro — lê como "o lugar recua/continua", não "o mundo acabou". Ocupa só
## a margem não-andável (depth=MAP_MARGIN); NÃO altera bounds/câmera/colisão (puramente visual).
func _add_horizon_borders(size: Vector2, biome: String) -> void:
	var elem := _horizon_color(biome)
	var depth := MAP_MARGIN          # mesma margem não-andável → o jogador nunca "entra" na bruma
	var layers := 6
	var max_a: float = 0.94 if biome == "caverna" else 0.82
	var band := depth / float(layers)
	for i in range(layers):
		var a: float = max_a * (1.0 - float(i) / float(layers))   # i=0 = camada EXTERNA (forte) → interna (fraca)
		var c := Color(elem.r, elem.g, elem.b, a)
		var rects := [
			Rect2(0, float(i) * band, size.x, band),                       # topo
			Rect2(0, size.y - float(i + 1) * band, size.x, band),          # base
			Rect2(float(i) * band, 0, band, size.y),                       # esquerda
			Rect2(size.x - float(i + 1) * band, 0, band, size.y),          # direita
		]
		for r in rects:
			var b := ColorRect.new()
			b.size = r.size
			b.position = r.position
			b.color = c
			b.z_index = -17
			b.set_meta("av_horizon", true)
			_region_node.add_child(b)

func _add_tree(pos: Vector2) -> void:
	var node := Node2D.new()
	node.position = pos
	_add_ground_shadow(node, 30.0, 9.0, 6.0)
	var trunk := ColorRect.new()
	trunk.size = Vector2(14, 26)
	trunk.position = Vector2(-7, -20)
	trunk.color = Color("4a3526")
	node.add_child(trunk)
	var canopy := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(16):
		var a := TAU * i / 16.0
		pts.append(Vector2(cos(a) * 40.0, sin(a) * 34.0 - 44.0))
	canopy.polygon = pts
	canopy.color = Color("2f5a30")
	node.add_child(canopy)
	_region_node.add_child(node)
	_add_blocker(Rect2(pos.x - 12, pos.y - 8, 24, 24))   # tronco

func _add_rock(pos: Vector2, r: float, draw_visual: bool = true) -> void:
	_add_blocker(Rect2(pos.x - r, pos.y - r * 0.5, r * 2.0, r))
	if not draw_visual:   # chão pintado já mostra a pedra: só o blocker
		return
	var node := Node2D.new()
	node.position = pos
	_add_ground_shadow(node, r * 0.9, r * 0.3, 4.0)
	var rock := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(8):
		var a := TAU * i / 8.0
		pts.append(Vector2(cos(a) * r, sin(a) * r * 0.7))
	rock.polygon = pts
	rock.color = Color("5b5e66")
	node.add_child(rock)
	_region_node.add_child(node)

func _add_crystal(pos: Vector2, h: float) -> void:
	var node := Node2D.new()
	node.position = pos
	_add_ground_shadow(node, h * 0.4, h * 0.14, 6.0)
	var c := Polygon2D.new()
	c.polygon = PackedVector2Array([Vector2(0, -h), Vector2(h * 0.34, -h * 0.4), Vector2(0, 0), Vector2(-h * 0.34, -h * 0.4)])
	c.color = Color(0.42, 0.76, 0.86, 0.9)
	node.add_child(c)
	_region_node.add_child(node)
	_add_blocker(Rect2(pos.x - h * 0.3, pos.y - h * 0.2, h * 0.6, h * 0.35))   # base do cristal

func _scatter_plains_decor(size: Vector2) -> void:
	var trees := [Vector2(0.1, 0.18), Vector2(0.28, 0.1), Vector2(0.5, 0.16), Vector2(0.72, 0.12), Vector2(0.9, 0.22), Vector2(0.14, 0.84), Vector2(0.4, 0.9), Vector2(0.64, 0.86), Vector2(0.86, 0.82), Vector2(0.95, 0.5)]
	for n in trees:
		_add_tree(Vector2(size.x * n.x, size.y * n.y))
	var rocks := [Vector2(0.22, 0.4), Vector2(0.58, 0.62), Vector2(0.78, 0.34), Vector2(0.35, 0.52)]
	for n in rocks:
		_add_rock(Vector2(size.x * n.x, size.y * n.y), 26.0)

## Decor de BIOMA SECO (GODOT-DESERT-BIOME-POLISH-1): substitui o scatter de planície (árvores VERDES) nas
## regiões de areia/deserto. ASSETLESS (Polygon2D/Line2D): cactos + pedras secas/arenito (com blocker pequeno)
## e ossos/tufos de capim seco/manchas de areia (decorativos, SEM colisão). z dos sólidos = int(pos.y) (y-sort),
## decor-de-chão em z negativo — tudo « 4095 (CombatVfx intacto). NÃO mexe em mob/gate/progressão.
##  • castaway_sandbar / salt_split_isle / khet_sar_sands: REUSA as posições já validadas do _scatter_plains_decor
##    (4 "rochas" + 10 "árvores"), TODAS com blocker → navegação dos mobs IDÊNTICA à shippada; só o visual muda.
##  • khet_caravan_camp: layout ESPARSO de bordas/cantos que EVITA props/serviços/spawn/trilha do hub
##    (resolve a sobreposição pedra×tenda NE do QA sem gambiarra local — a posição 0.78,0.34 não é usada aqui).
func _scatter_desert_decor(region_id: String, size: Vector2) -> void:
	var solids := []   # cacto/pedra seca → recebem blocker pequeno
	var softs := []    # ossos/tufo/areia → decorativos, sem colisão
	if region_id == "khet_caravan_camp":
		solids = [Vector2(0.087, 0.17), Vector2(0.96, 0.15), Vector2(0.10, 0.90), Vector2(0.95, 0.90), Vector2(0.07, 0.40)]
		softs = [Vector2(0.47, 0.18), Vector2(0.505, 0.95), Vector2(0.96, 0.56), Vector2(0.30, 0.93), Vector2(0.72, 0.93)]
	elif region_id == "khet_oasis":
		# Oásis: centro (lago/altar/NPC) montado no builder → scatter SÓ nas bordas/cantos (cacto/pedra) + softs.
		solids = [Vector2(0.08, 0.16), Vector2(0.92, 0.16), Vector2(0.10, 0.86), Vector2(0.90, 0.86)]
		softs = [Vector2(0.50, 0.09), Vector2(0.06, 0.50), Vector2(0.94, 0.50), Vector2(0.30, 0.92)]
	else:
		solids = [
			Vector2(0.22, 0.4), Vector2(0.58, 0.62), Vector2(0.78, 0.34), Vector2(0.35, 0.52),
			Vector2(0.1, 0.18), Vector2(0.28, 0.1), Vector2(0.5, 0.16), Vector2(0.72, 0.12), Vector2(0.9, 0.22),
			Vector2(0.14, 0.84), Vector2(0.4, 0.9), Vector2(0.64, 0.86), Vector2(0.86, 0.82), Vector2(0.95, 0.5),
		]
		softs = [Vector2(0.2, 0.3), Vector2(0.66, 0.46), Vector2(0.46, 0.76), Vector2(0.82, 0.66), Vector2(0.3, 0.66)]
	var i := 0
	for n in solids:
		var p := Vector2(size.x * n.x, size.y * n.y)
		if i % 2 == 0:
			_add_cactus(p, 42.0 + float(i % 3) * 8.0)
		else:
			_add_dry_rock(p, 24.0)
		i += 1
	var j := 0
	for n in softs:
		var p := Vector2(size.x * n.x, size.y * n.y)
		match j % 3:
			0: _add_bones(p)
			1: _add_dry_tuft(p)
			_: _add_floor_glow(p, 42.0, Color(0.85, 0.74, 0.5, 0.12))   # mancha de areia clara (atravessável)
		j += 1

## Pedra seca/arenito (assetless): mesma forma de _add_rock, paleta de deserto + y-sort. Blocker pequeno.
func _add_dry_rock(pos: Vector2, r: float) -> void:
	_add_blocker(Rect2(pos.x - r, pos.y - r * 0.5, r * 2.0, r))
	var node := Node2D.new()
	node.position = pos
	node.z_index = int(pos.y)
	_add_ground_shadow(node, r * 0.9, r * 0.3, 4.0)
	var rock := Polygon2D.new()
	var pts := PackedVector2Array()
	for k in range(8):
		var a := TAU * k / 8.0
		pts.append(Vector2(cos(a) * r, sin(a) * r * 0.66))
	rock.polygon = pts
	rock.color = Color("a98c5c")   # arenito/rocha seca
	node.add_child(rock)
	var top := Polygon2D.new()   # faceta superior clara → volume sob o sol
	top.polygon = PackedVector2Array([Vector2(-r * 0.7, -r * 0.2), Vector2(r * 0.7, -r * 0.2), Vector2(r * 0.5, -r * 0.5), Vector2(-r * 0.5, -r * 0.5)])
	top.color = Color("c2a878")
	node.add_child(top)
	_region_node.add_child(node)

## Cacto colunar simples (assetless): tronco + 2 braços, verde-sálvia (lê como deserto, não floresta). Blocker
## pequeno só na base (braços/topo atravessáveis). y-sort por pos.y.
func _add_cactus(pos: Vector2, h: float) -> void:
	var node := Node2D.new()
	node.position = pos
	node.z_index = int(pos.y)
	_add_ground_shadow(node, h * 0.28, h * 0.10, 4.0)
	var green := Color("5f7d4a")
	var gd := Color("4d6a3c")
	var w := h * 0.26
	var trunk := Polygon2D.new()
	trunk.polygon = PackedVector2Array([Vector2(-w * 0.5, 0), Vector2(w * 0.5, 0), Vector2(w * 0.5, -h), Vector2(-w * 0.5, -h)])
	trunk.color = green
	node.add_child(trunk)
	var arml := Polygon2D.new()   # braço esquerdo (barra vertical)
	arml.polygon = PackedVector2Array([Vector2(-w * 1.0, -h * 0.45), Vector2(-w * 0.6, -h * 0.45), Vector2(-w * 0.6, -h * 0.8), Vector2(-w * 1.0, -h * 0.8)])
	arml.color = gd
	node.add_child(arml)
	var armr := Polygon2D.new()   # braço direito
	armr.polygon = PackedVector2Array([Vector2(w * 0.6, -h * 0.55), Vector2(w * 1.0, -h * 0.55), Vector2(w * 1.0, -h * 0.9), Vector2(w * 0.6, -h * 0.9)])
	armr.color = gd
	node.add_child(armr)
	_region_node.add_child(node)
	_add_blocker(Rect2(pos.x - w * 0.6, pos.y - 8.0, w * 1.2, 16.0))

