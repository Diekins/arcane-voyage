## BARRA compacta de recurso (GODOT-HUD-COMPACT-VITALS-MANA-BAR-1): MANA azul (cajado/livro) / FLECHAS
## ciano (arco); escondida p/ espada/lança/desarmado. Largura do fill = atual/max (mesmos valores do
## GameState; NÃO toca custo/regen). Atualiza via state_changed (equipar/gastar/regenerar).
func _refresh_class_resource_hud() -> void:
	if _resource_bar_root == null or _resource_fill == null or _resource_label == null:
		return
	var show := true
	var cur := 0
	var mx := 1
	var col := Color("3f7fe0")   # azul (mana)
	var txt := ""
	match GameState.current_weapon_type():
		"bow":
			cur = GameState.arrows_current; mx = GameState.arrows_max
			col = Color("5fc6e0")   # ciano = flechas
			txt = "Flechas %d / %d" % [cur, mx]
		"staff":
			cur = GameState.mana_current; mx = GameState.mana_max
			col = Color("3f7fe0")   # azul = mana
			txt = "Mana %d / %d" % [cur, mx]
		"book":
			cur = GameState.mana_current; mx = GameState.mana_max
			col = Color("6a7be8")   # azul-violeta = mana do Oráculo
			txt = "Mana %d / %d" % [cur, mx]
			if GameState.shield_active():
				txt += "  ◈%d" % GameState.shield_amount   # escudo só quando ativo
		_:
			show = false
	_resource_bar_root.visible = show   # esconde a barra inteira (frame+fill+label) p/ melee/desarmado
	if show:
		_resource_fill.color = col
		_resource_fill.size.x = _resource_inner_w * clampf(float(cur) / float(maxi(1, mx)), 0.0, 1.0)
		_resource_label.text = txt

func _refresh_hero_hud() -> void:
	var defeated := GameState.is_hero_defeated()
	var maxhp := GameState.max_hp_total()
	if _hp_fill != null:
		_hp_fill.size.x = _hp_inner_w * clampf(float(GameState.hero_hp) / float(maxi(1, maxhp)), 0.0, 1.0)
	if _hp_label != null:
		_hp_label.text = "CAÍDO — [R]" if defeated else "%d / %d" % [GameState.hero_hp, maxhp]
	if _lvl_label != null:
		_lvl_label.text = str(GameState.hero_level)
	if _xp_fill != null:
		_xp_fill.size.x = _xp_inner_w * clampf(float(GameState.hero_xp) / float(maxi(1, GameState.hero_xp_to_next)), 0.0, 1.0)
	if _xp_label != null:
		_xp_label.text = "XP %d / %d" % [GameState.hero_xp, GameState.hero_xp_to_next]
	if _gold_label != null:
		_gold_label.text = "%d" % GameState.hero_gold
	if _defeat_label != null:
		_defeat_label.visible = defeated
	# ao cair, trava o herói (+ visual abatido) e desliga o combate (o [R]/recuperar reabilita).
	if defeated:
		if _player != null:
			_player.set("locked", true)
			if _player.has_method("set_downed"):
				_player.call("set_downed", true)
		_set_world_combat(false)

func _refresh_debug() -> void:
	if _debug_label == null:
		return
	_debug_label.text = "DEBUG  [F5] itens-teste · [F6] cena · [F7/F8] level± · [F9] ch1 · [F10] derrotar Lobo · [F12] reset       Lv %d · cenas %d" % [GameState.hero_level, GameState.seen_dialogues.size()]

func _refresh_inventory_hud() -> void:
	if _setmat_label == null:
		return
	# conta peças do Set Errante (relics com inSet) possuídas vs total — data-driven.
	var set_total := 0
	var set_owned := 0
	for r in DataLoader.relics:
		if bool(r.get("inSet", false)):
			set_total += 1
			if GameState.has_item(str(r.get("id", ""))):
				set_owned += 1
	# materiais ENXUTOS no HUD (GODOT-HUD-BAG-EQUIP-ICONS-1): só a contagem de tipos; a lista com
	# ícones/valores fica no painel da mochila [I] (tira a poluição do texto corrido).
	_setmat_label.text = "Set Errante %d/%d   ·   Materiais: %d tipos" % [set_owned, set_total, GameState.materials.size()]

func _on_item_granted(_item_id: String, item_name: String) -> void:
	_show_reward_popup("Recebeu: %s" % item_name)

## EQUIPAR COM FEEDBACK DE PROGRESSO (POLISH_PASS_03 — P1 #2 da auditoria da 1ª hora): equipar era MUDO.
## Captura os stats ANTES, equipa, e mostra o DELTA flutuando no Errante ("+3 ataque   +1 defesa") + popup
## curto. Só APRESENTAÇÃO — a lógica de equip/stats permanece toda no GameState. Sidegrade mostra mistos
## (ex.: "+2 velocidade   -8 HP máx") com honestidade, em vez de esconder a troca.
func _equip_with_feedback(id: String) -> void:
	var atk0 := GameState.attack_bonus()
	var def0 := GameState.defense_bonus()
	var spd0 := GameState.speed_bonus()
	var mag0 := GameState.magic_bonus()
	var hp0 := GameState.max_hp_total()
	if not GameState.equip(id):
		return
	if _codex != null:   # FATIA A7: equipar um item também o DESCOBRE no Códice (§44)
		_codex.discover(id)
	var parts := PackedStringArray()
	_append_stat_delta(parts, "ataque", GameState.attack_bonus() - atk0)
	_append_stat_delta(parts, "defesa", GameState.defense_bonus() - def0)
	_append_stat_delta(parts, "velocidade", GameState.speed_bonus() - spd0)
	_append_stat_delta(parts, "magia", GameState.magic_bonus() - mag0)
	_append_stat_delta(parts, "HP máx", GameState.max_hp_total() - hp0)
	var nm := ItemDB.display_name(id)
	if parts.is_empty():
		_show_reward_popup("%s equipado" % nm, Color("d8d2c4"))
		return
	var summary := "   ".join(parts)
	if _player != null:
		_spawn_world_text(_player.position, summary, Color("ffe08a"), -10.0)
	_show_reward_popup("%s  ·  %s" % [nm, summary], Color("ffe08a"))

## Acrescenta "±N rótulo" à lista SE o delta for não-nulo (omite stats que não mudaram).
func _append_stat_delta(parts: PackedStringArray, label: String, d: int) -> void:
	if d != 0:
		parts.append("%s%d %s" % ["+" if d > 0 else "", d, label])

## Lampejo quente curto na tela ao subir de nível (POLISH_PASS_03): dá uma BATIDA ao nível (antes era só
## texto que aparecia/sumia). Pura apresentação sobre o _popup_layer; não toca progressão.
func _levelup_flash() -> void:
	if _popup_layer == null:
		return
	var fx := ColorRect.new()
	fx.color = Color(1.0, 0.86, 0.45, 0.0)
	fx.position = Vector2.ZERO
	fx.size = get_viewport_rect().size
	fx.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_popup_layer.add_child(fx)
	var tw := create_tween()
	tw.tween_property(fx, "color:a", 0.22, 0.10)
	tw.tween_property(fx, "color:a", 0.0, 0.45)
	tw.tween_callback(fx.queue_free)

## FATIA A8.1 — MIGRADO: os 30+ call-sites deste popup agora passam pelo BUS (GameFeedback) → FeedbackRenderer,
## sem duplicar (não cria mais Label próprio quando o bus existe). Fallback legado só se o bus ainda não subiu
## (segurança de boot). Isto centraliza loot/nível/boss/sistema/etc. num canal priorizado e limitado.
func _show_reward_popup(text: String, color: Color = Color("ffd24a")) -> void:
	if _feedback != null:
		_feedback.push_system(text)
		return
	if _popup_layer == null:
		return
	var lbl := Label.new()
	lbl.text = text
	lbl.add_theme_font_size_override("font_size", 26)
	lbl.modulate = color
	lbl.position = Vector2(get_viewport_rect().size.x * 0.5 - 170.0, 108.0)
	_popup_layer.add_child(lbl)
	var tw := create_tween()
	tw.tween_interval(1.5)
	tw.tween_property(lbl, "modulate:a", 0.0, 0.9)
	tw.tween_callback(lbl.queue_free)

func _refresh_boss_hud() -> void:
	if _boss_root == null:
		return
	if _current_boss == null or not is_instance_valid(_current_boss):
		_boss_root.visible = false   # região sem boss
		return
	_boss_root.visible = true
	var alive: bool = _current_boss.is_alive()
	var hpmax: int = maxi(1, int(_current_boss.hp_max))
	var hpcur: int = int(_current_boss.hp) if alive else 0
	if _boss_fill != null:
		_boss_fill.size.x = _boss_inner_w * clampf(float(hpcur) / float(hpmax), 0.0, 1.0)
	if _boss_label != null:
		_boss_label.text = ("%s — DERROTADO" % _boss_name) if not alive else "%s   %d / %d" % [_boss_name, hpcur, hpmax]

func _build_dialog() -> void:
	_dialog = load("res://scripts/DialoguePanel.gd").new()
	add_child(_dialog)
	_dialog.dialogue_closed.connect(_on_dialogue_closed)
	TriggerDispatcher.request_scene.connect(_on_request_scene)
