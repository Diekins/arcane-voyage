## boss-system (a Matriarca é Mob elite). Retorno SUL p/ o Bosque, surgindo logo abaixo do selo.
func _build_deep_grove(_size: Vector2) -> void:
	_add_lore_marker(Vector2(_size.x * 0.76, _size.y * 0.28), "root", "tocar a raiz que pulsa", "Raiz que Pulsa", [
		"Uma raiz negra, grossa como um braço, pulsa devagar — como se respirasse.",
		"Não há árvore acima grande o bastante para tê-la criado.",
		"De onde vem o que cresce aqui embaixo?",
	], true)
	_build_rastro_colhedora(_size)   # MICRO-HISTÓRIA (Lote 2): O Rastro da Colhedora
