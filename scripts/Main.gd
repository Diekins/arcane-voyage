## FATIA A8.1 — ENTRADA REAL do refino pela UI (usa RefineUIModel + empurra feedback autoritativo p/ o bus).
## O widget de suporte (toggles) é field-deferido; este método é o que ele chamaria. roll01<0 = sorteio real.
func do_refine(slot: String, selection: Dictionary, roll01: float = -1.0) -> Dictionary:
	if not RefineUIModel.allowed(selection):
		return {"ok": false, "reason": "combinação de suporte inválida"}
	var res := RefineUIModel.attempt(GameState, slot, selection, roll01)
	if _feedback != null:
		_feedback.push_refine(res)
		if int(res.get("cp_delta", 0)) != 0:
			_feedback.push_cp(int(res["cp_delta"])); _feedback.flush_cp()
	return res

## ════════ FATIA A7.4.1 — WORLD WIRING (chamado pelo WorldContentRouter, caminho REAL do loader) ════════
## Carrega a região do world_context (via o loader REAL `load_region`/`_route_enter`, que já faz teardown+player-
## spawn+notify) SE for diferente da região corrente. Guarda de re-entrância: `load_region`→notify_region_changed→
## stage_changed→router→aqui; ao voltar, a região já casa ⇒ no-op. `_route_enter` respeita macro-cluster contínuo.
func world_route_enter(region_id: String) -> void:
	if region_id == "" or _world_routing:
		return
	if region_id == GameState.current_region_id:
		return   # já estamos nela — nada a fazer (evita rebuild redundante, §22)
	_route_enter(region_id)   # → load_region (que seta/limpa _world_routing e suprime o router durante a troca)

## Garante que o BOSS do capítulo (via ContentManifest/StageDirector) exista na fase 10. Se a região já spawnou o
## boss CERTO (plains→Lobo/cave→Golem, casados pelo nome), preserva. Senão, spawna o boss do manifesto pelo
## dispatcher REAL `_make_boss_node`. Idempotente. Fora da fase 10 → no-op.
func ensure_stage_boss() -> void:
	if _stagedirector == null or _world_routing:
		return   # durante uma carga de região o boss é spawnado DEPOIS (pelo chamador), não no meio do teardown
	if _stagedirector.stage_type() != "boss":
		return
	var bid := _stagedirector.boss_id()
	if bid == "":
		return
	var want_name := str(_manifest_boss_name())   # nome (minúsculo) do boss do capítulo, p/ casar com o vivo
	if _current_boss != null and is_instance_valid(_current_boss):
		if str(_boss_name).to_lower() == want_name:
			return   # a região já colocou o boss do capítulo (Lobo/Golem) — preserva, não duplica
	var pos := _player_start + Vector2(320, 0)
	if _region_size.x > 0.0:
		pos.x = clampf(pos.x, MAP_MARGIN + 40.0, _region_size.x - MAP_MARGIN - 40.0)
	var node := _make_boss_node(bid, pos)
	_current_boss = node
	_boss_name = BossDefinition.display_name(bid)
	if node != null and node.has_method("set_blockers"):
		node.call("set_blockers", _blockers)

## Nome (minúsculo) do boss do capítulo corrente pelo manifesto (casa com _boss_name/_on_boss_defeated).
func _manifest_boss_name() -> String:
	if _stagedirector == null:
		return ""
	var c := ContentManifest.chapter(_stagedirector.chapter)
	return str(c.get("boss_name", "")).to_lower()

