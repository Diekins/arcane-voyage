## Conteúdo PRINCIPAL da capa: emblema + título + subtítulo + botões (Continuar/Novo Jogo/Sair).
func _title_render_main() -> void:
	_title_clear_content()
	var col := VBoxContainer.new()
	col.add_theme_constant_override("separation", 14)
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_title_content.add_child(col)
	# emblema
	var emblem := TextureRect.new()
	emblem.texture = _load_tex(TITLE_HUD_BADGE)
	emblem.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	emblem.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	emblem.custom_minimum_size = Vector2(92, 92)
	emblem.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	emblem.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(emblem)
	# título grande
	var title := Label.new()
	title.text = "Arcane Voyage"
	title.add_theme_font_size_override("font_size", 60)
	title.add_theme_color_override("font_color", Color("f0c860"))   # dourado envelhecido
	title.add_theme_color_override("font_outline_color", Color(0.06, 0.04, 0.02, 0.9))
	title.add_theme_constant_override("outline_size", 6)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	col.add_child(title)
	# divisor gravado (flourish)
	var fl := TextureRect.new()
	fl.texture = _load_tex(TITLE_FLOURISH)
	fl.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	fl.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	fl.custom_minimum_size = Vector2(240, 22)
	fl.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	fl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(fl)
	# subtítulo
	var sub := Label.new()
	sub.text = "A Jornada do Errante"
	sub.add_theme_font_size_override("font_size", 22)
	sub.add_theme_color_override("font_color", Color("c9b896"))
	sub.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	sub.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	col.add_child(sub)
	var gap := Control.new(); gap.custom_minimum_size = Vector2(0, 16); col.add_child(gap)
	# botões RPG (placas/selos). Continuar reflete o save atual; sem save → desabilitado e claro.
	var has_save := FileAccess.file_exists(GameState.SAVE_PATH)
	if has_save:
		col.add_child(_title_button("Continuar  ·  Nível %d" % GameState.hero_level, Color("ffe6b0"), _enter_game, true))
	else:
		col.add_child(_title_button("Continuar  (sem progresso)", Color(0.6, 0.55, 0.5), Callable(), false))
	col.add_child(_title_button("Novo Jogo", Color("ffe6b0"), _title_render_confirm, true))
	col.add_child(_title_button("Sair", Color("e6c0c8"), func(): get_tree().quit(), true))

## Confirmação do Novo Jogo (protege o save: só reseta após o jogador confirmar explicitamente).
func _title_render_confirm() -> void:
	_title_clear_content()
	var col := VBoxContainer.new()
	col.add_theme_constant_override("separation", 14)
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_title_content.add_child(col)
	var t := Label.new()
	t.text = "Começar uma Nova Jornada?"
	t.add_theme_font_size_override("font_size", 30)
	t.add_theme_color_override("font_color", Color("f0c860"))
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	t.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	col.add_child(t)
	var warn := Label.new()
	warn.text = "Isto APAGA o progresso atual e não pode ser desfeito."
	warn.add_theme_font_size_override("font_size", 16)
	warn.add_theme_color_override("font_color", Color("e0a0a0"))
	warn.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	warn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	col.add_child(warn)
	var gap := Control.new(); gap.custom_minimum_size = Vector2(0, 14); col.add_child(gap)
	col.add_child(_title_button("Confirmar — apagar e começar", Color("ffd2d2"), _do_new_game, true))
	col.add_child(_title_button("Voltar", Color("d8e0c8"), _title_render_main, true))

## Reset SEGURO (mesmo fluxo do F12): apaga o save e volta ao estado inicial, recarrega a Vila, e entra.
func _do_new_game() -> void:
	GameState.reset_save()
	load_region("starter_village")
	_enter_game()

## Sai da capa: esconde o overlay, destrava o Errante (se não estiver caído) e devolve o controle normal.
func _enter_game() -> void:
	_title_open = false
	if _title_layer != null:
		_title_layer.visible = false
	if _player != null and _player.has_method("set") and not GameState.is_hero_defeated():
		_player.set("locked", false)
	if _camera != null and _camera.has_method("reset_smoothing"):
		_camera.reset_smoothing()

func _title_clear_content() -> void:
	if _title_content == null:
		return
	for c in _title_content.get_children():
		c.queue_free()

## Botão da capa em estilo placa/selo RPG (grande p/ toque futuro). `enabled=false` → cinza e inerte.
func _title_button(text: String, fg: Color, cb: Callable, enabled: bool) -> Button:
	var b := Button.new()
	b.text = text
	b.add_theme_font_size_override("font_size", 20)
	b.add_theme_color_override("font_color", fg if enabled else Color(0.55, 0.52, 0.48))
	b.add_theme_color_override("font_color_hover", Color(1, 1, 1))
	b.custom_minimum_size = Vector2(340, 54)   # grande → confortável p/ toque (mobile-ready)
	b.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	b.focus_mode = Control.FOCUS_NONE
	var base := StyleBoxFlat.new()
	base.bg_color = Color(0.20, 0.14, 0.07, 0.96) if enabled else Color(0.12, 0.11, 0.10, 0.85)
	base.border_color = Color(0.62, 0.48, 0.24, 0.9) if enabled else Color(0.4, 0.38, 0.34, 0.6)
	base.set_border_width_all(2); base.set_corner_radius_all(9)
	base.content_margin_left = 16; base.content_margin_right = 16
	base.content_margin_top = 8; base.content_margin_bottom = 8
	var hov := base.duplicate()
	hov.bg_color = Color(0.30, 0.20, 0.10, 0.99)
	hov.border_color = Color(0.82, 0.64, 0.32, 1.0)
	b.add_theme_stylebox_override("normal", base)
	b.add_theme_stylebox_override("hover", hov if enabled else base)
	b.add_theme_stylebox_override("pressed", hov if enabled else base)
	b.add_theme_stylebox_override("disabled", base)
	if enabled and cb.is_valid():
		b.pressed.connect(cb)
	else:
		b.disabled = true
	return b

## As 5 maestrias na ordem pedida + classe + multiplicador de efeito + unidade + frase de evolução.
## (read-only: multiplicador só p/ EXIBIR o bônus efetivo; o cálculo real mora no GameState.)
## GODOT-MASTERY-TOME-UI-SKIN-1: +"tint" (selo de classe DISCRETO) e +"arch" (arquétipo da arma que ATIVA
## a maestria) — só p/ exibir Potencial vs Ativo; o gating real mora nas funções *_bonus do GameState.
const _MASTERY_UI := [
	{"key": "guard",     "cls": "Guerreiro", "mult": 2, "unit": "defesa",      "tint": "b0563a", "arch": "melee",   "how": "Sobe ao sofrer dano real com arma melee + escudo."},
	{"key": "stance",    "cls": "Lanceiro",  "mult": 2, "unit": "dano",        "tint": "8a9a4a", "arch": "reach",   "how": "Sobe ao acertar com lança em alcance ideal."},
	{"key": "precision", "cls": "Arqueiro",  "mult": 2, "unit": "dano",        "tint": "caa64e", "arch": "ranged",  "how": "Sobe ao acertar flechas."},
	{"key": "arcane",    "cls": "Mago",      "mult": 2, "unit": "dano",        "tint": "5ec8e0", "arch": "magic",   "how": "Sobe ao acertar magias de cajado."},
	{"key": "presage",   "cls": "Oráculo",  "mult": 3, "unit": "cura/escudo", "tint": "b78cff", "arch": "support", "how": "Sobe ao curar, proteger ou enfraquecer com efeito real."},
]

## Bônus ATIVO AGORA de uma maestria (read-only): chama a função REAL gated por arma do GameState (mesma do
## combate) p/ as 4 de combate; p/ presságio (sem getter) usa o arquétipo "support" (livro do Oráculo).
## NÃO altera nada — só ESPELHA o que já é calculado. Retorna o bônus efetivo na arma equipada (0 se inativa).
func _mastery_active_bonus(key: String, potential: int) -> int:
	match key:
		"guard":     return GameState.guard_defense_bonus()
		"arcane":    return GameState.arcane_damage_bonus()
		"precision": return GameState.precision_damage_bonus()
		"stance":    return GameState.stance_damage_bonus()
		"presage":   return potential if GameState.current_combat_archetype() == "support" else 0
		_:           return 0

## Painel de Maestrias como TOMO/grimório do Errante (GODOT-MASTERY-TOME-UI-SKIN-1): capa de couro + páginas
## de pergaminho; cada maestria = uma ENTRADA de tomo (selo de classe + nível + barra de XP + Potencial/Ativo
## + como evolui). READ-ONLY: lê nível/XP/bônus e ECHOA o gating real (funções *_bonus do GameState). Sem
## tocar GameState/CLASS_MASTERY_DEFS/cálculo/save. CombatVfx z=4095 intacto (layer 16, sem z alto).
func _rebuild_mastery_panel() -> void:
	if _mastery_root == null:
		return
	for c in _mastery_root.get_children():
		c.queue_free()
	var vp := get_viewport_rect().size
	var W := 680.0
	var H := 588.0
	# --- CAPA DO TOMO: couro/madeira escura + borda bronze envelhecida ---
	var frame := Panel.new()
	var sb := StyleBoxFlat.new()
	sb.bg_color = Color(0.12, 0.09, 0.06, 0.98)         # couro/madeira escura (capa)
	sb.border_color = Color(0.62, 0.50, 0.28, 0.9); sb.set_border_width_all(2); sb.set_corner_radius_all(12)
	frame.add_theme_stylebox_override("panel", sb)
	frame.position = (vp - Vector2(W, H)) * 0.5
	frame.size = Vector2(W, H)
	frame.mouse_filter = Control.MOUSE_FILTER_STOP
	_mastery_root.add_child(frame)
	# título em placa de bronze gravada
	var title_ribbon := Panel.new()
	var trsb := StyleBoxFlat.new()
	trsb.bg_color = Color(0.18, 0.13, 0.07, 0.92)
	trsb.set_border_width_all(1); trsb.border_color = Color(0.66, 0.53, 0.3, 0.6); trsb.set_corner_radius_all(5)
	title_ribbon.add_theme_stylebox_override("panel", trsb)
	title_ribbon.position = Vector2(18, 12); title_ribbon.size = Vector2(248, 34)
	title_ribbon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	frame.add_child(title_ribbon)
	var title := Label.new()
	title.text = "✦ Tomo do Errante"
	title.position = Vector2(28, 16); title.add_theme_font_size_override("font_size", 20)
	title.add_theme_color_override("font_color", Color("f0c860"))   # dourado envelhecido
	frame.add_child(title)
	var subtitle := Label.new()
	subtitle.text = "Maestrias Exclusivas"
	subtitle.position = Vector2(280, 22); subtitle.add_theme_font_size_override("font_size", 13)
	subtitle.add_theme_color_override("font_color", Color("c9b896"))
	frame.add_child(subtitle)
	var hint := Label.new()
	hint.text = "[C] / [Esc] fecha"
	hint.position = Vector2(W - 138.0, 20); hint.add_theme_font_size_override("font_size", 12)
	hint.add_theme_color_override("font_color", Color("9a8e74"))
	frame.add_child(hint)
	# --- ENTRADAS DO TOMO (5 cards de pergaminho) ---
	var card_x := 20.0
	var card_w := W - 40.0
	var card_h := 90.0
	var pitch := 96.0
	var y0 := 58.0
	var i := 0
	for d in _MASTERY_UI:
		var key := str(d["key"])
		var nm := str((GameState.CLASS_MASTERY_DEFS.get(key, {}) as Dictionary).get("name", key))
		var lvl := GameState.mastery_level(key)
		var xp := int(GameState.class_mastery.get(key, {}).get("xp", 0))
		var nxt := GameState.xp_to_next_mastery(key)
		var potential := GameState.mastery_bonus(key) * int(d["mult"])
		var active := _mastery_active_bonus(key, potential)
		var tint := Color(str(d["tint"]))
		var cy := y0 + float(i) * pitch
		# card de pergaminho
		var card := Panel.new()
		var csb := StyleBoxFlat.new()
		csb.bg_color = Color(0.17, 0.135, 0.092, 0.96)   # pergaminho envelhecido escuro
		csb.set_border_width_all(1); csb.border_color = Color(0.5, 0.42, 0.25, 0.55); csb.set_corner_radius_all(7)
		card.add_theme_stylebox_override("panel", csb)
		card.position = Vector2(card_x, cy); card.size = Vector2(card_w, card_h)
		card.mouse_filter = Control.MOUSE_FILTER_IGNORE
		frame.add_child(card)
		# selo/lombada de classe (faixa vertical na cor da classe — identidade discreta)
		var seal := Panel.new()
		var ssb := StyleBoxFlat.new()
		ssb.bg_color = tint; ssb.set_corner_radius_all(3)
		seal.add_theme_stylebox_override("panel", ssb)
		seal.position = Vector2(card_x + 6.0, cy + 8.0); seal.size = Vector2(6.0, card_h - 16.0)
		seal.mouse_filter = Control.MOUSE_FILTER_IGNORE
		frame.add_child(seal)
		var tx := card_x + 22.0
		# linha 1: nome (na cor da classe) — classe · Nível N
		var l1 := Label.new()
		l1.text = "%s   —   %s        Nível %d" % [nm, str(d["cls"]), lvl]
		l1.position = Vector2(tx, cy + 8.0); l1.add_theme_font_size_override("font_size", 16)
		l1.add_theme_color_override("font_color", tint.lerp(Color("ffe9b8"), 0.45))   # cor da classe suavizada (legível)
		frame.add_child(l1)
		# barra de XP (visual; baseada no xp/nxt já calculado) + texto XP
		var bar_w := 230.0
		var bar_bg := Panel.new()
		var bgsb := StyleBoxFlat.new()
		bgsb.bg_color = Color(0.07, 0.055, 0.04, 1.0); bgsb.set_border_width_all(1)
		bgsb.border_color = Color(0.5, 0.42, 0.25, 0.5); bgsb.set_corner_radius_all(4)
		bar_bg.add_theme_stylebox_override("panel", bgsb)
		bar_bg.position = Vector2(tx, cy + 34.0); bar_bg.size = Vector2(bar_w, 10.0)
		bar_bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
		frame.add_child(bar_bg)
		var frac := clampf(float(xp) / float(maxi(1, nxt)), 0.0, 1.0)
		var fill := ColorRect.new()
		fill.color = Color("d9b25a")   # âmbar = progresso (doc §2)
		fill.position = Vector2(tx + 2.0, cy + 36.0); fill.size = Vector2((bar_w - 4.0) * frac, 6.0)
		fill.mouse_filter = Control.MOUSE_FILTER_IGNORE
		frame.add_child(fill)
		var xpl := Label.new()
		xpl.text = "XP %d / %d" % [xp, nxt]
		xpl.position = Vector2(tx + bar_w + 12.0, cy + 30.0); xpl.add_theme_font_size_override("font_size", 12)
		xpl.add_theme_color_override("font_color", Color("c9b896"))
		frame.add_child(xpl)
		# linha de bônus: Potencial vs Ativo (Ativo = bônus efetivo na arma equipada AGORA). RichTextLabel p/
		# as duas cores na mesma linha — SÓ exibição (não toca valor/cálculo).
		var act_col := "8fd08f" if active > 0 else "9a8e74"   # ativo = verde; inativo = sépia apagado
		var rbl := RichTextLabel.new()
		rbl.bbcode_enabled = true; rbl.scroll_active = false; rbl.fit_content = true
		rbl.autowrap_mode = TextServer.AUTOWRAP_OFF
		rbl.add_theme_font_size_override("normal_font_size", 13)
		rbl.add_theme_color_override("default_color", Color("e8d6a6"))
		rbl.text = "Potencial [color=#f0c860]+%d %s[/color]   ·   Ativo [color=#%s]+%d[/color]" % [potential, str(d["unit"]), act_col, active]
		rbl.position = Vector2(tx, cy + 48.0); rbl.size = Vector2(card_w - 40.0, 20.0)
		rbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
		frame.add_child(rbl)
		# como evolui (sépia discreto)
		var l3 := Label.new()
		l3.text = str(d["how"])
		l3.position = Vector2(tx, cy + 68.0); l3.add_theme_font_size_override("font_size", 11)
		l3.add_theme_color_override("font_color", Color("9a8e74"))
		frame.add_child(l3)
		i += 1
	var close := Button.new()
	close.text = "Fechar  [C]"
	close.position = Vector2(W * 0.5 - 70.0, H - 42.0); close.size = Vector2(140, 32)
	close.pressed.connect(_close_mastery)
	frame.add_child(close)

func _toggle_inventory() -> void:
	_inv_open = not _inv_open
	if _inv_panel != null:
		_inv_panel.visible = _inv_open
	if _inv_open:
		_rebuild_inventory_panel()
	else:
		_tip_hide()
	_apply_equip_layer_visibility()   # esconde o paperdoll FIXO enquanto a mochila aberta o mostra (sem duplicar)
	_refresh_equip_hud()

## O paperdoll FIXO da direita some quando a loja OU a mochila está aberta (a mochila já mostra o seu).
func _apply_equip_layer_visibility() -> void:
	if _eq_layer != null:
		_eq_layer.visible = not (_shop_open or _inv_open)

## Fecha QUALQUER overlay aberto (mochila/loja/tooltip) — chamado na troca de região p/ não ficar preso
## ao atravessar um portal com a mochila/loja aberta (GODOT-VERTICAL-SLICE-POLISH-AFK-1). Null-safe (roda
## também no 1º load do boot, quando os painéis ainda nem existem).
func _close_overlays() -> void:
	if _stash_open:
		_close_stash()   # Baú do Errante (GODOT-VILLAGE-STASH-MVP-1)
	if _mastery_open:
		_close_mastery()   # Painel de Maestrias (GODOT-MASTERY-UI-MVP-1)
	if _shop_open:
		_close_shop()
	if _inv_open:
		_inv_open = false
		if _inv_panel != null:
			_inv_panel.visible = false
		_apply_equip_layer_visibility()
		_refresh_equip_hud()
	_tip_hide()

## TextureRect centrado em `center` (coords do _inv_root) com size FIXO; nunca vaza (EXPAND_IGNORE_SIZE
## + KEEP_ASPECT_CENTERED). No-op se a textura não existir (fallback = mostra o slot embutido da sprite).
func _inv_icon_node(parent: Control, path: String, center: Vector2, isize: float, mod := Color(1, 1, 1, 1)) -> void:
	var tx = _load_tex(path)
	if tx == null:
		return
	var ir := TextureRect.new()
	ir.texture = tx
	ir.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	ir.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	ir.position = center - Vector2(isize, isize) * 0.5
	ir.size = Vector2(isize, isize)
	ir.modulate = mod
	ir.mouse_filter = Control.MOUSE_FILTER_IGNORE
	parent.add_child(ir)

## Label simples (não captura mouse) no painel.
func _inv_text(parent: Control, text: String, pos: Vector2, fsize: int, color: Color) -> Label:
	var l := Label.new()
	l.text = text
	l.position = pos
	l.add_theme_font_size_override("font_size", fsize)
	l.modulate = color
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	parent.add_child(l)
	return l

