	title.text = "Baú do Errante"
	title.position = Vector2(20, 12); title.add_theme_font_size_override("font_size", 22)
	title.add_theme_color_override("font_color", Color("e8c879"))
	title.add_theme_color_override("font_outline_color", Color(0.12, 0.08, 0.03, 0.9)); title.add_theme_constant_override("outline_size", 3)
	frame.add_child(title)
	var lore := Label.new()
	lore.text = "O que é guardado aqui permanece — o Baú reconhece o vínculo do Errante com a Vila."
	lore.position = Vector2(20, 44); lore.add_theme_font_size_override("font_size", 12)
	lore.add_theme_color_override("font_color", Color("b89a6a"))
	frame.add_child(lore)
	var divider := ColorRect.new()   # separador vertical Mochila | Baú
	divider.color = Color(0.45, 0.35, 0.18, 0.5)
	divider.position = Vector2(W * 0.5 - 1.0, 72.0); divider.size = Vector2(2, H - 150.0)
	frame.add_child(divider)
	var colw := W * 0.5 - 40.0
	var colh := H - 156.0
	_stash_grid(frame, Vector2(24, 74), colw, colh, "Mochila", true)
	_stash_grid(frame, Vector2(W * 0.5 + 16.0, 74), colw, colh, "Baú do Errante", false)
	_stash_info = Label.new()
