				var s2 := ColorRect.new(); s2.color = Color(0.78, 0.74, 0.6, 0.6); s2.size = Vector2(2.0, 34.0); s2.position = Vector2(float(gx), -42.0); s2.rotation = -0.5; node.add_child(s2)
