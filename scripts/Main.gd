## EASTERN_SEA_EXPANSION_BUILD_01 — O CAIS QUEBRADO sendo CONSERTADO agora. Torna a promessa marítima TANGÍVEL:
## sinais de reparo (tábuas novas no meio das podres, serragem, estaleiro), vestígios de embarcações e MANTIMENTOS
## atados pra uma partida futura. NÃO inicia viagem, NÃO cria região/navegação — só cenário aditivo a LESTE do barco
## (oeste é o estaleiro antigo do Maro). Tudo Polygon2D/ColorRect, sem blocker (não prende), sem save/quest/recompensa.
func _build_cais_em_reparo(boat: Vector2) -> void:
	var base := boat + Vector2(170.0, 8.0)   # leste do barco (Maro fica a oeste em ~1010)
	# 1) JETTY quebrado descendo pro mar (sul): deck de tábuas PODRES com vãos no fim + 2 tábuas NOVAS no início (reparo)
	for i in range(7):
		var plank := ColorRect.new()
		var fresh: bool = i < 2   # as 2 do início (junto à praia) são madeira NOVA = o conserto recomeçado
		if i == 5:
			continue   # vão: tábua faltando (quebrado)
		plank.color = Color("8a6a40") if fresh else Color("46382a")
		plank.size = Vector2(54.0, 11.0)
		plank.position = base + Vector2(-27.0, 30.0 + float(i) * 22.0)
		plank.z_index = -2
		_region_node.add_child(plank)
		if i % 2 == 0:   # estaca de apoio sob algumas tábuas
			var post := ColorRect.new()
			post.color = Color("3a2e22"); post.size = Vector2(7.0, 26.0)
			post.position = base + Vector2(-4.0, 34.0 + float(i) * 22.0)
			post.z_index = -3
			_region_node.add_child(post)
	# 2) ESTALEIRO de reparo (lado da praia): serragem, pilha de tábuas novas, cavalete + serra, rolo de corda
	_add_floor_glow(base + Vector2(40.0, -6.0), 56.0, Color(0.80, 0.68, 0.42, 0.18))   # serragem fresca no chão
	for k in range(3):   # pilha de tábuas novas
		var fp := ColorRect.new()
		fp.color = Color("9a7748"); fp.size = Vector2(70.0, 9.0)
		fp.position = base + Vector2(24.0, -22.0 - float(k) * 11.0)
		fp.z_index = int(base.y) - 2 + k
		_region_node.add_child(fp)
	# cavalete (X de pernas + travessa) com uma serra encostada
	for sgn in [-1.0, 1.0]:
		var leg := ColorRect.new()
		leg.color = Color("5a3f28"); leg.size = Vector2(6.0, 30.0)
		leg.position = base + Vector2(86.0 + sgn * 9.0, -28.0); leg.rotation = sgn * 0.5
		leg.z_index = int(base.y)
		_region_node.add_child(leg)
	var topbar := ColorRect.new()
	topbar.color = Color("6b4a2f"); topbar.size = Vector2(40.0, 7.0); topbar.position = base + Vector2(66.0, -34.0)
	topbar.z_index = int(base.y); _region_node.add_child(topbar)
	var saw := Polygon2D.new()   # serra encostada no cavalete
	saw.polygon = PackedVector2Array([Vector2(0, 0), Vector2(28, -22), Vector2(31, -19), Vector2(4, 2)])
	saw.position = base + Vector2(96.0, -30.0); saw.color = Color("c9ccd2"); saw.z_index = int(base.y) + 1
	_region_node.add_child(saw)
	var rope := Polygon2D.new()   # rolo de corda
	var rp := PackedVector2Array()
	for i in range(18):
		var a := TAU * i / 18.0
		rp.append(Vector2(cos(a) * 13.0, sin(a) * 8.0))
	rope.polygon = rp; rope.position = base + Vector2(-46.0, 6.0); rope.color = Color("b89a5e"); rope.z_index = int(base.y)
	_region_node.add_child(rope)
	# 3) MANTIMENTOS atados pra a partida (sob uma lona): caixotes + barril + um fardo de vela
	for cx in [0.0, 30.0]:
		var crate := ColorRect.new()
		crate.color = Color("7a5a34"); crate.size = Vector2(26.0, 24.0)
		crate.position = base + Vector2(120.0 + cx, 4.0); crate.z_index = int(base.y)
		_region_node.add_child(crate)
	var barrel := Polygon2D.new()
	var bp := PackedVector2Array()
	for i in range(16):
		var a := TAU * i / 16.0
		bp.append(Vector2(cos(a) * 15.0, sin(a) * 17.0))
	barrel.polygon = bp; barrel.position = base + Vector2(150.0, -22.0); barrel.color = Color("6b4a2f"); barrel.z_index = int(base.y)
	_region_node.add_child(barrel)
	var tarp := ColorRect.new()   # lona cobrindo parte dos mantimentos
	tarp.color = Color(0.45, 0.43, 0.36, 0.85); tarp.size = Vector2(70.0, 18.0); tarp.position = base + Vector2(116.0, -10.0); tarp.rotation = 0.05
	tarp.z_index = int(base.y) + 1; _region_node.add_child(tarp)
	var sail := Polygon2D.new()   # fardo de vela enrolada (pálida), pronta pra içar
	sail.polygon = PackedVector2Array([Vector2(-24, 6), Vector2(24, 6), Vector2(16, -8), Vector2(-16, -8)])
	sail.position = base + Vector2(80.0, 18.0); sail.color = Color(0.82, 0.80, 0.72, 0.95); sail.z_index = int(base.y)
	_region_node.add_child(sail)
	# 4) âncora + lanterna de trabalho (alguém vem mexer aqui até de noite)
	_add_anchor(base + Vector2(-40.0, 40.0))
	_add_floor_glow(base + Vector2(8.0, -2.0), 34.0, Color(1.0, 0.82, 0.45, 0.14))   # halo de lanterna (trabalho noturno)
	# 5) O ROSTO do reparo (EASTERN_SEA_BUILD_02): Velho Cael, o calafate que recomeçou o conserto. SÓ conversa —
	# não-herói, não quest giver, sem recompensa. NÃO sabe de Maro nem da Outra Margem; não resolve mistério.
	_build_villager(base + Vector2(54.0, 34.0), "npcs/village/elder", "Velho Cael", [
		"Calafetei barcos a vida toda nesta praia. As mãos já tremem no formão — mas ainda sabem o que fazer.",
		"Consertar o cais não traz ninguém de volta. Eu sei. Mas é o que faço com a falta: em vez de só olhar o mar, prego uma tábua.",
		"O mar levou gente minha. Pra onde, ninguém sabe — não pergunte. Só quero que, quando alguém quiser partir de novo, o cais aguente.",
		"Tem uma moça que vem olhar o mar todo dia. Ela espera; eu martelo. Cada um carrega do seu jeito.",
	], "", false)
	# 6) O GESTO DO ERRANTE (EASTERN_SEA_BUILD_03): uma tábua nova SOLTA caída ao lado do vão, e um [E] OPCIONAL
	# pra assentá-la com o Cael. Não é missão/objetivo/recompensa; ao usar, a tábua vai pro lugar (em-sessão, sem
	# save) e uma linha contida muda só a PERCEPÇÃO ("coloquei a mão nisso"). Nada parte, nada abre.
	var loose := ColorRect.new()
	loose.color = Color("9a7748"); loose.size = Vector2(54.0, 11.0)
	loose.position = base + Vector2(44.0, 150.0); loose.rotation = 0.6
	loose.z_index = -1
	_region_node.add_child(loose)
	var gn := Node2D.new(); gn.position = base + Vector2(18.0, 122.0); gn.z_index = int(base.y)
	var ghalo := Polygon2D.new()
	var ghp := PackedVector2Array()
	for i in range(20):
		var ang := TAU * i / 20.0
		ghp.append(Vector2(cos(ang) * 30.0, sin(ang) * 17.0 + 2.0))
	ghalo.polygon = ghp; ghalo.color = Color(0.95, 0.78, 0.45, 0.13); ghalo.z_index = -1; gn.add_child(ghalo)
	var gprompt := Label.new()
	gprompt.text = "✦ [E] segurar a tábua pro Cael pregar"
	gprompt.position = Vector2(-100.0, -92.0); gprompt.modulate = Color("ffe6b0")
	gprompt.add_theme_font_size_override("font_size", 15)
	gprompt.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.95))
	gprompt.add_theme_constant_override("outline_size", 6); gprompt.visible = false
	gn.add_child(gprompt); _tag_on_top(gprompt)
	_region_node.add_child(gn)
	_services.append({
		"node": gn, "prompt": gprompt, "pos": gn.position, "kind": "future_exit",
		"id": "cais_gesture", "title": "O Cais", "msg": [],
		"plank": loose, "plank_to": base + Vector2(-27.0, 140.0),
	})

