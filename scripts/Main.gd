	var z := int(pos.y)
	var node := Node2D.new(); node.position = pos; node.z_index = z
	_add_ground_shadow(node, 24.0, 8.0, 8.0)
	var mast := Line2D.new(); mast.points = PackedVector2Array([Vector2(0, 6), Vector2(48, -220)]); mast.width = 10.0; mast.default_color = Color("6a5638"); mast.begin_cap_mode = Line2D.LINE_CAP_ROUND; mast.end_cap_mode = Line2D.LINE_CAP_ROUND; node.add_child(mast)
	var yard := Line2D.new(); yard.points = PackedVector2Array([Vector2(18, -110), Vector2(64, -150)]); yard.width = 6.0; yard.default_color = Color("5a4a30"); node.add_child(yard)
	var sail := Polygon2D.new(); sail.polygon = PackedVector2Array([Vector2(28, -118), Vector2(60, -146), Vector2(54, -100), Vector2(34, -88)]); sail.color = Color(0.8, 0.78, 0.7, 0.5); node.add_child(sail)
	_region_node.add_child(node)
	_add_blocker(Rect2(pos.x - 8.0, pos.y - 4.0, 18.0, 16.0))

## Passadiço quebrado descendo ao mar (tábuas faltando = "preparado para zarpar, e parou"). Blocker comprido fino.
func _cais_dock(pos: Vector2, length: float) -> void:
	var z := int(pos.y)
	var deck := ColorRect.new(); deck.color = Color("6a5840"); deck.size = Vector2(60.0, length); deck.position = pos + Vector2(-30.0, 0.0); deck.z_index = z; _region_node.add_child(deck)
	var n := int(length / 26.0)
	for i in range(n):   # tábuas (algumas faltando → fenda escura)
		if i % 4 == 2:
			var gap := ColorRect.new(); gap.color = Color(0.10, 0.16, 0.18, 0.7); gap.size = Vector2(60.0, 8.0); gap.position = pos + Vector2(-30.0, float(i) * 26.0); gap.z_index = z + 1; _region_node.add_child(gap)
		else:
			var pl := Line2D.new(); pl.points = PackedVector2Array([pos + Vector2(-30.0, float(i) * 26.0), pos + Vector2(30.0, float(i) * 26.0)]); pl.width = 1.5; pl.default_color = Color(0.0, 0.0, 0.0, 0.2); pl.z_index = z + 1; _region_node.add_child(pl)
	_add_blocker(Rect2(pos.x - 30.0, pos.y, 60.0, length * 0.5))

## ★ A OUTRA MARGEM / R03 — O PROMONTÓRIO DO ESPELHO (THE_OTHER_SHORE_BUILD_03) = a REVELAÇÃO. O ponto mais distante:
## do alto, o jogador VÊ a outra praia olhando de volta. SEM combate/apex/boss/sistema. Pequeno. Fecha o arco. A Pedra
## da Travessia (oposto do Arquivo: poucos nomes, todos lidos) + a Vela Içada + a Guardadora. "A saudade tem duas praias."
func _build_promontorio_do_espelho(size: Vector2) -> void:
	_current_boss = null
	_boss_name = ""
	# volta → o Cais dos Ausentes (oeste; desce do penhasco)
	_build_portal(PROM_TO_CAIS, "cais_dos_ausentes", "⟵ descer ao Cais dos Ausentes", false, CAIS_RETURN_FROM_PROM)
	if GameState.set_story_flag("other_shore_arc_complete"):
		_show_reward_popup("O Promontório do Espelho — você chega ao fim, e entende que não há fim")
	# ── O MAR lá embaixo (ao SUL, sob o penhasco) + a beira (lip) que impede de cair ──
	var sea := ColorRect.new(); sea.color = Color("3a5666"); sea.size = Vector2(size.x, 250.0); sea.position = Vector2(0.0, 760.0); sea.z_index = -16; _region_node.add_child(sea)
	var lip := ColorRect.new(); lip.color = Color("4a4a40"); lip.size = Vector2(size.x, 16.0); lip.position = Vector2(0.0, 748.0); lip.z_index = -14; _region_node.add_child(lip)
	_add_blocker(Rect2(0.0, 750.0, size.x, 16.0))   # a beira do penhasco: você para aqui e OLHA (não cai)
	# ★ A OUTRA PRAIA — a casa, na bruma do horizonte (uma linha de costa pálida + a LUZ acesa de quem espera lá)
	var farcoast := Polygon2D.new(); farcoast.polygon = PackedVector2Array([Vector2(220, 916), Vector2(540, 906), Vector2(900, 912), Vector2(1240, 904), Vector2(1380, 916), Vector2(1380, 940), Vector2(220, 940)])
	farcoast.color = Color(0.5, 0.52, 0.56, 0.45); farcoast.z_index = -15; _region_node.add_child(farcoast)
	var homelight := Polygon2D.new(); var hlp := PackedVector2Array()
	for i in range(10):
		var a := TAU * float(i) / 10.0
		hlp.append(Vector2(cos(a) * 5.0, sin(a) * 5.0))
	homelight.polygon = hlp; homelight.position = Vector2(760.0, 904.0); homelight.color = Color("ffcf8a"); homelight.z_index = -14; _region_node.add_child(homelight)
	if homelight.is_inside_tree():
		var htw := homelight.create_tween(); htw.set_loops()
		htw.tween_property(homelight, "modulate:a", 0.4, 3.0).set_trans(Tween.TRANS_SINE)
		htw.tween_property(homelight, "modulate:a", 1.0, 3.0).set_trans(Tween.TRANS_SINE)
	# capim ralo + pedras do penhasco (área contemplativa, esparsa)
	for gp in [Vector2(500, 380), Vector2(980, 320), Vector2(1300, 460), Vector2(420, 600), Vector2(1180, 700)]:
		var tuft := Polygon2D.new(); tuft.polygon = PackedVector2Array([Vector2(-5, 0), Vector2(-2, -12), Vector2(0, 0), Vector2(2, -10), Vector2(5, 0)]); tuft.position = gp; tuft.color = Color(0.42, 0.5, 0.34, 0.8); tuft.z_index = int(gp.y); _region_node.add_child(tuft)
	for rp in [Vector2(620, 460), Vector2(1080, 540)]:
		_add_dry_rock(rp, 24.0)
	# ── ★ LANDMARK PRINCIPAL — A PEDRA DA TRAVESSIA (poucos nomes, todos lidos; o oposto do Grande Arquivo) ──
	_prom_pedra_travessia(Vector2(760.0, 660.0))
	# ── ★ LANDMARK SECUNDÁRIO — A VELA IÇADA (uma vela erguida no penhasco, virada pra casa: "alguém está aqui") ──
	_prom_vela_icada(Vector2(1180.0, 580.0))
	# AMBIENTE: gaivotas do horizonte (reusa o sistema de aves)
	_build_world_life_fauna(size)
	# ── A GUARDADORA DAS VELAS — última presença: lê os nomes dos que chegaram (NPC, só fala) ──
	_build_villager(Vector2(880.0, 640.0), "npcs/village/elder", "a Guardadora das Velas", [
		"Eu fico aqui em cima, lendo a pedra. São poucos nomes; dá pra ler todos, todo dia. É o que faço.",
		"Guardo as velas. Cada uma que cruza é alguém chegando — eu vejo, e gravo o nome na pedra, pra que a travessia não tenha sido em vão.",
		"Por que fiquei? Alguém tem que ler os nomes dos que chegaram. Senão a gente atravessa o mar e some, como se nunca tivesse cruzado.",
		"Do outro lado tem outra praia, igual a esta. Lá, alguém olha pra cá esperando uma vela. Você foi uma vela pra alguém. E um dia, eu leio o seu nome aqui.",
	], "", false)
	# ── A REVELAÇÃO [E] (na beira, virado pro mar): ver a outra praia olhando de volta ──
	_maw_marker(Vector2(620.0, 724.0), "prom_vista", "✦ [E] olhar a outra praia", [
		"Do alto do promontório, o mar se abre — e lá longe, na bruma, uma linha de costa. A praia de casa. Você a vê daqui.",
		"Há uma luz acesa, pequena. Alguém, naquela praia, olha este mesmo mar — esperando uma vela.",
		"Não havia um fim do mar esperando você. Havia outra praia, e ela está olhando de volta. A saudade tem duas praias — e agora você esteve nas duas.",
	])

## A PEDRA DA TRAVESSIA: uma pedra fincada na beira, virada pro mar, com POUCOS nomes gravados (todos legíveis — o
## oposto do Grande Arquivo). Os que atravessaram e chegaram deixaram seu nome ao pisar em terra. [E] = a descoberta.
func _prom_pedra_travessia(pos: Vector2) -> void:
	var z := int(pos.y)
	var node := Node2D.new(); node.position = pos; node.z_index = z
	_add_ground_shadow(node, 30.0, 9.0, 8.0)
	var stone := Polygon2D.new(); stone.polygon = PackedVector2Array([Vector2(-26, 6), Vector2(-20, -110), Vector2(8, -132), Vector2(26, -104), Vector2(22, 6)]); stone.color = Color("8a8a7c"); node.add_child(stone)
	var shade := Polygon2D.new(); shade.polygon = PackedVector2Array([Vector2(8, -132), Vector2(26, -104), Vector2(22, 6), Vector2(6, 4)]); shade.color = Color(0.0, 0.0, 0.0, 0.14); node.add_child(shade)
	# os POUCOS nomes gravados (marcas legíveis, espaçadas — dá pra contar)
	for ny in [-92.0, -68.0, -44.0, -20.0, 4.0]:
		var nm := Line2D.new(); nm.points = PackedVector2Array([Vector2(-14, ny), Vector2(2, ny - 2.0), Vector2(12, ny + 3.0)]); nm.width = 1.6; nm.default_color = Color(0.2, 0.2, 0.18, 0.9); node.add_child(nm)
	# pequena oferenda na base (algumas pedrinhas + um tufo) — vivo, cuidado, ≠ o frio do Arquivo
	for ox in [-18.0, -6.0, 10.0]:
		var peb := Polygon2D.new(); var pp := PackedVector2Array()
		for i in range(8):
			var a := TAU * float(i) / 8.0
			pp.append(Vector2(cos(a) * 4.0, sin(a) * 3.0))
		peb.polygon = pp; peb.position = Vector2(ox, 10.0); peb.color = Color("b0aa98"); node.add_child(peb)
	_region_node.add_child(node)
	_add_blocker(Rect2(pos.x - 24.0, pos.y - 6.0, 48.0, 18.0))
	# [E] a descoberta — poucos nomes, todos lidos; entre eles, o eco de Maro (atravessou e chegou; não está aqui)
	var mk := Node2D.new(); mk.position = pos + Vector2(0.0, 36.0); mk.z_index = int(pos.y + 36.0)
	var mp := Label.new(); mp.text = "✦ [E] a Pedra da Travessia"; mp.position = Vector2(-72.0, -34.0); mp.modulate = Color("cdd9e0")
	mp.add_theme_font_size_override("font_size", 14); mp.add_theme_color_override("font_outline_color", Color(0.04, 0.05, 0.06, 0.95)); mp.add_theme_constant_override("outline_size", 5); mp.visible = false
	mk.add_child(mp); _tag_on_top(mp); _region_node.add_child(mk)
	_services.append({"node": mk, "prompt": mp, "pos": mk.position, "kind": "future_exit", "id": "prom_pedra", "title": "a Pedra da Travessia", "msg": [
		"Uma pedra fincada na beira, virada pro mar. Nela, nomes gravados — poucos, fundos, lidos tantas vezes que a pedra os guarda lisos.",
		"Não há milhares aqui. Há os que atravessaram e CHEGARAM a esta praia; cada um deixou o nome ao pisar em terra. «Edda. Bram. Lis. Ture. Sefo.»",
		"E, entre eles, um que você conhece de ouvir falar: «Maro». Ele atravessou. Chegou aqui. Depois… o mar tem dessas — quem chega a uma margem às vezes parte pra outra. O nome ficou; ele, não.",
		"São poucos, e por isso todos são lidos. Um dia, alguém lê o seu.",
	]})

## A VELA IÇADA (landmark secundário): um mastro com UMA vela erguida no alto do penhasco, virada pro mar — não pra
## zarpar, mas pra ser VISTA da outra praia: "alguém está aqui". Tremula de leve. Memorável. Blocker fino no pé.
func _prom_vela_icada(pos: Vector2) -> void:
	var z := int(pos.y)
	var node := Node2D.new(); node.position = pos; node.z_index = z
	_add_ground_shadow(node, 26.0, 8.0, 8.0)
	var mast := Line2D.new(); mast.points = PackedVector2Array([Vector2(0, 4), Vector2(0, -190)]); mast.width = 8.0; mast.default_color = Color("6a5638"); mast.begin_cap_mode = Line2D.LINE_CAP_ROUND; mast.end_cap_mode = Line2D.LINE_CAP_ROUND; node.add_child(mast)
	var sail := Polygon2D.new(); sail.polygon = PackedVector2Array([Vector2(0, -180), Vector2(86, -150), Vector2(74, -96), Vector2(0, -70)]); sail.color = Color("d9d2c2"); node.add_child(sail)
	var seam := Line2D.new(); seam.points = PackedVector2Array([Vector2(0, -180), Vector2(0, -70)]); seam.width = 2.0; seam.default_color = Color(0.0, 0.0, 0.0, 0.12); node.add_child(seam)
	var patch := Polygon2D.new(); patch.polygon = PackedVector2Array([Vector2(40, -150), Vector2(64, -140), Vector2(58, -118), Vector2(38, -126)]); patch.color = Color(0.0, 0.0, 0.0, 0.10); node.add_child(patch)
	_region_node.add_child(node)
	if sail.is_inside_tree():
		var tw := sail.create_tween(); tw.set_loops()
		tw.tween_property(sail, "skew", 0.05, 2.4).set_trans(Tween.TRANS_SINE)
		tw.tween_property(sail, "skew", -0.03, 2.6).set_trans(Tween.TRANS_SINE)
	_add_blocker(Rect2(pos.x - 6.0, pos.y - 4.0, 14.0, 16.0))

## JOURNEY_SURPRISE_PILOT_01 — surpresa NA TRAVESSIA (não escondida): uma PORTA solta, em pé, sozinha no campo
## aberto da Planície, perto do corredor Vila↔Caverna. Sem casa, sem paredes — só a porta. Faz o jogador parar
## uns segundos ("não esperava ver isso aqui"). Pass-through (SEM blocker: dá pra atravessar e nada acontece).
## [E] opcional com leitura curta e SEM explicação. Sem combate/quest/recompensa/save/evento-aleatório (fixa).
func _build_lone_door(pos: Vector2) -> void:
	var z := int(pos.y)
	var lpost := ColorRect.new(); lpost.color = Color("5a4632"); lpost.size = Vector2(10.0, 72.0); lpost.position = pos + Vector2(-30.0, -72.0); lpost.z_index = z; _region_node.add_child(lpost)
	var rpost := ColorRect.new(); rpost.color = Color("5a4632"); rpost.size = Vector2(10.0, 72.0); rpost.position = pos + Vector2(20.0, -72.0); rpost.z_index = z; _region_node.add_child(rpost)
	var lintel := ColorRect.new(); lintel.color = Color("644d34"); lintel.size = Vector2(70.0, 12.0); lintel.position = pos + Vector2(-35.0, -82.0); lintel.z_index = z; _region_node.add_child(lintel)
	var panel := ColorRect.new(); panel.color = Color("3e3120"); panel.size = Vector2(40.0, 66.0); panel.position = pos + Vector2(-26.0, -70.0); panel.rotation = 0.22; panel.z_index = z - 1; _region_node.add_child(panel)   # entreaberta
	var sill := ColorRect.new(); sill.color = Color("6a6a64"); sill.size = Vector2(72.0, 8.0); sill.position = pos + Vector2(-36.0, -6.0); sill.z_index = z - 2; _region_node.add_child(sill)   # soleira gasta
	# o campo reclamou a soleira: um tufo de capim/flor na base (a vida segue por cima do que foi casa)
	for off in [Vector2(-30.0, 2.0), Vector2(26.0, 0.0)]:
		var tuft := Polygon2D.new()
		tuft.polygon = PackedVector2Array([Vector2(-5, 0), Vector2(-2, -10), Vector2(0, 0), Vector2(2, -9), Vector2(5, 0)])
		tuft.position = pos + off; tuft.color = Color(0.36, 0.55, 0.30, 0.9); tuft.z_index = z - 1
		_region_node.add_child(tuft)
	# [E] inline (future_exit, só texto; a porta É o objeto; halo azul-frio = "estranho aqui")
	var node := Node2D.new(); node.position = pos; node.z_index = z
	var halo := Polygon2D.new()
	var gp := PackedVector2Array()
	for i in range(20):
		var a := TAU * i / 20.0
		gp.append(Vector2(cos(a) * 40.0, sin(a) * 22.0 - 30.0))
	halo.polygon = gp; halo.color = Color(0.45, 0.7, 0.85, 0.13); halo.z_index = -1; node.add_child(halo)
	var prompt := Label.new()
	prompt.text = "✦ [E] a porta solta"
	prompt.position = Vector2(-70.0, -116.0); prompt.modulate = Color("ffe6b0")
	prompt.add_theme_font_size_override("font_size", 15)
	prompt.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.95))
	prompt.add_theme_constant_override("outline_size", 6); prompt.visible = false
	node.add_child(prompt); _tag_on_top(prompt)
	_region_node.add_child(node)
	var pt: Tween = null
	if node.is_inside_tree():
		pt = node.create_tween(); pt.set_loops()
		pt.tween_property(halo, "modulate:a", 0.5, 1.8).set_trans(Tween.TRANS_SINE)
		pt.tween_property(halo, "modulate:a", 1.0, 1.8).set_trans(Tween.TRANS_SINE)
	_services.append({
		"node": node, "prompt": prompt, "pos": pos, "kind": "future_exit",
		"id": "lone_door", "title": "A Porta Solta", "halo": halo, "pulse": pt,
		"msg": [
			"Uma porta. Só a porta — em pé, sozinha no campo aberto. Sem casa, sem paredes, sem o resto.",
			"A maçaneta ainda gira. Do outro lado: mais capim, o mesmo vento.",
			"Houve uma casa aqui? Ou a porta chegou primeiro? Você atravessa, e nada muda. Só segue.",
		],
	})

## KHET-SAR_BUILD_01 — DUNAS PROFUNDAS: 1º trecho jogável ALÉM da Cidade (a Cidade vira PASSAGEM, não o fim).
## Curto, aberto e VAZIO de propósito: a civilização some, a trilha se perde, vestígios afloram meio soterrados,
## e a jornada PARECE continuar (future_exit só texto, NÃO transporta). SEM chefe/mob/sistema/Soterrado/Sal — só a
## 1ª respiração da região. Cenário aditivo; o leito de áudio da família "desert" toca aqui (WorldAmbience).
func _build_deep_dunes(size: Vector2) -> void:
	_current_boss = null
	_boss_name = ""
	_build_portal(DUNES_TO_CITY, "khet_sar_city", "Trilha → Cidade de Khet-Sar", true, CITY_RETURN_FROM_DUNES)
	# (A) CIVILIZAÇÃO QUE SOME — últimos cacos da Cidade no OESTE, e nada depois
	for wp in [Vector2(120.0, 300.0), Vector2(80.0, 760.0)]:
		var wall := ColorRect.new(); wall.color = Color("9c7a4e"); wall.size = Vector2(40.0, 90.0); wall.position = wp; wall.z_index = int(wp.y); _region_node.add_child(wall)
		var top := ColorRect.new(); top.color = Color("7a5d38"); top.size = Vector2(40.0, 16.0); top.position = wp + Vector2(0.0, 38.0); top.z_index = int(wp.y) + 1; _region_node.add_child(top)
	var lamp := ColorRect.new(); lamp.color = Color("5a5650"); lamp.size = Vector2(8.0, 78.0); lamp.position = Vector2(260.0, 560.0); lamp.rotation = 0.18; lamp.z_index = 560; _region_node.add_child(lamp)   # poste partido (último sinal urbano)
	# (B) TRILHA PERDIDA — manchas de caminho que afinam e somem indo pro leste
	for i in range(7):
		var seg := ColorRect.new()
		seg.color = Color(0.66, 0.56, 0.38, clampf(0.30 - float(i) * 0.04, 0.02, 0.30))
		seg.size = Vector2(120.0 - float(i) * 10.0, 26.0 - float(i) * 2.0)
		seg.position = Vector2(360.0 + float(i) * 150.0, 500.0 + sin(float(i)) * 30.0)
		seg.z_index = -4
		_region_node.add_child(seg)
	# (C) VESTÍGIOS MEIO SOTERRADOS — o que a areia engoliu, aflorando (mais perto da Cidade; raros adiante)
	_dunes_buried_wheel(Vector2(560.0, 640.0))
	_dunes_buried_post(Vector2(720.0, 380.0))
	_dunes_buried_crate(Vector2(900.0, 600.0))
	_dunes_buried_wheel(Vector2(1180.0, 720.0))
	# (C2) KHET-SAR_BUILD_02 — a EVIDÊNCIA: uma caravana INTEIRA meio engolida pela areia (a frase virando prova).
	# Puramente VISUAL: sem [E]/texto/narração — um vislumbre que se passa, não um destino.
	_build_dunes_swallowed_caravan(Vector2(1080.0, 400.0))
	# DEEP_DUNES VISUAL PASS (fase1): carga espalhada da caravana (aditivo, sem blocker; offsets bbox). Terreno aberto
	# em volta da caravana (1080,400) e do caixote (900,600); longe do arco (1300,720) e da faixa vertical de props altos.
	_khet_deco_sprite(Vector2(1000.0, 470.0), "res://assets/tilesets/khet/props/khet_loot_scatter.png", Vector2(0.0, -26.0))
	_khet_deco_sprite(Vector2(1170.0, 460.0), "res://assets/tilesets/khet/props/khet_torn_caravan_cloth.png", Vector2(1.0, -30.0))
	_khet_deco_sprite(Vector2(960.0, 350.0), "res://assets/tilesets/khet/props/khet_small_bones.png", Vector2(0.0, -18.0))
	_khet_deco_sprite(Vector2(840.0, 560.0), "res://assets/tilesets/khet/props/khet_loot_scatter.png", Vector2(0.0, -26.0))
	# (C3) KHET-SAR_BUILD_03 — a SOMBRA do Soterrado: arquitetura MONUMENTAL aflorando (escala de CIDADE, não de
	# caravana). Arco quebrado + colunas isoladas + laje de pavimento = uma avenida soterrada. Puramente visual.
	_build_dunes_buried_arch(Vector2(1300.0, 720.0))
	# (C4) KHET-SAR_BUILD_04 — o TERRITÓRIO: elementos alinhados afloram com frequência crescente (uma GRADE de
	# cidade). A revelação vem do CONJUNTO: o jogador anda SOBRE uma cidade. Sem texto/[E]/blocker (andável).
	_build_dunes_buried_grid()
	# PACK10 deco ADITIVA (assinaturas da cidade soterrada; sem blocker; offsets por bbox_alpha). Terreno aberto, fora
	# do spawn(300,500)/portal(120,500)/future_exit(1820,900)/blocker do arco(x1184-1416,y714-738)/Pedra(x>1600).
	_khet_deco_sprite(Vector2(1180.0, 360.0), "res://assets/tilesets/deep_dunes/props/dead_camp_scrap.png", Vector2(-6.0, -23.0))   # acampamento morto perto da caravana
	_khet_deco_sprite(Vector2(700.0, 560.0), "res://assets/tilesets/deep_dunes/props/buried_stela_marker.png", Vector2(-4.0, -36.0))   # estela soterrada (alta; nada pequeno atrás)
