# (paperdoll limpo): controle total → vazio mostra ghost faint, equipado mostra SÓ o item (sem fundo).
const EQ_PANEL_W := 250.0
const EQ_PANEL_H := 378.0
const EQ_CELL := 62.0
# 9 slots em paperdoll: coluna CENTRAL = linha do corpo (cabeça·peito·calça·botas); topo = acessório+cabeça;
# laterais = mãos (arma/mão-sec.) e joias (bracelete/anel). (GODOT-INVENTORY-SLOTS-ACCESSORY-BRACELET-1)
const EQ_SLOT_POS := {
	"accessory": Vector2(50, 58), "head": Vector2(125, 58),
	"weapon": Vector2(50, 146), "chest": Vector2(125, 146), "offhand": Vector2(200, 146),
	"bracelet": Vector2(50, 234), "legs": Vector2(125, 234), "ring": Vector2(200, 234),
	"boots": Vector2(125, 322),
}
const EQ_FIT := {"head": 46.0, "weapon": 50.0, "chest": 48.0, "offhand": 48.0, "legs": 48.0, "boots": 48.0, "accessory": 42.0, "bracelet": 42.0, "ring": 40.0}
const EQ_SLOT_LABEL := {"head": "Cabeça", "weapon": "Arma", "chest": "Peito", "offhand": "Mão sec.", "legs": "Calça", "boots": "Botas", "accessory": "Acessório", "bracelet": "Bracelete", "ring": "Anel"}
# ui_000 (grade) — posições NATIVAS (492x497) p/ ancorar o ✕ embutido e o valor do ouro NA arte
const INV_CLOSE_NATIVE := Vector2(457, 40)        # centro do ✕ embutido (canto sup-dir do frame)
const INV_GOLD_RECT_TL := Vector2(158, 427)       # topo-esq do recesso do número (À DIREITA das moedas embutidas)
const INV_GOLD_RECT_SZ := Vector2(216, 46)        # tamanho do recesso → ouro centralizado V+H dentro dele

## Painel ABERTO de RPG (GODOT-INVENTORY-ART-DIRECTED-REBUILD-1): janela unificadora + ESQUERDA painel de
## equipamento DESENHADO por mim (slots próprios, sem ghost embutido conflitando) + DIREITA grade de mochila
## (ui_000) com o OURO na área de moedas da arte e o ✕ usando o botão embutido do frame. Header só com título
## + stats. O paperdoll FIXO da direita some enquanto este painel está aberto.
func _rebuild_inventory_panel() -> void:
	if _inv_root == null:
		return
	_tip_hide()   # os controles vão ser recriados → evita tooltip preso
	for c in _inv_root.get_children():
		c.queue_free()
	var vp := get_viewport_rect().size
	var s := 0.76
	var inv_sz := INV_NATIVE * s
	var gap := 26.0
	var total_w := EQ_PANEL_W + gap + inv_sz.x
	var header_h := 80.0   # 2 linhas de stats (cabem na coluna esquerda) → não passam por baixo das abas
	var ox := (vp.x - total_w) * 0.5
	var oy := 50.0
	var eq_pos := Vector2(ox, oy + header_h)
	var inv_pos := Vector2(ox + EQ_PANEL_W + gap, oy + header_h)
	var body_h := maxf(EQ_PANEL_H, inv_sz.y)
	var foot_y := oy + header_h + body_h + 12.0

	# --- JANELA unificadora (atrás de tudo) → vira UMA peça de RPG, não tabela solta ---
	# GODOT-INVENTORY-RPG-SKIN-MVP-1: couro/madeira escura + borda bronze envelhecida (bolsa do Errante)
	var win := Panel.new()
	var wsb := StyleBoxFlat.new()
	wsb.bg_color = Color(0.12, 0.09, 0.06, 0.97)        # couro/madeira escura
	wsb.set_border_width_all(2)
	wsb.border_color = Color(0.62, 0.5, 0.28, 0.7)      # bronze/dourado envelhecido
	wsb.set_corner_radius_all(10)
	win.add_theme_stylebox_override("panel", wsb)
	win.position = Vector2(ox - 22.0, oy - 16.0)
	win.size = Vector2(total_w + 44.0, (foot_y + 28.0) - (oy - 16.0))
