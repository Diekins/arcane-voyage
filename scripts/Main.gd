## Visual do buraco no chão do Pântano (procedural): elipse escura + aro de terra revolvida.
func _build_pit_hole(pos: Vector2) -> void:
	if _add_portal_sprite(pos, "cave_mouth"):
		return   # sprite estável do pack; fallback procedural abaixo
	var node := Node2D.new()
	node.position = pos
	node.z_index = -15
	var rim := Polygon2D.new()
	var rp := PackedVector2Array()
	for i in range(18):
		var a := TAU * i / 18.0
		rp.append(Vector2(cos(a) * 60.0, sin(a) * 38.0))
	rim.polygon = rp
	rim.color = Color(0.20, 0.16, 0.12, 0.9)   # terra revolvida
	node.add_child(rim)
	var hole := Polygon2D.new()
	var hp := PackedVector2Array()
	for i in range(18):
		var a := TAU * i / 18.0
		hp.append(Vector2(cos(a) * 44.0, sin(a) * 27.0))
	hole.polygon = hp
	hole.color = Color(0.02, 0.02, 0.03, 1.0)   # escuridão do buraco
	node.add_child(hole)
	_region_node.add_child(node)

## --- MAPA TOP-DOWN ---
## Planície usa TILESET REAL (GODOT-PLAINS-TILESET-1) quando os assets existem; Caverna e qualquer
## fallback continuam com shapes (GODOT-VISUAL-PIVOT-1). Decoração é VISUAL (sem colisão).
## ★★★ INSTRUMENTAÇÃO DO RESOLVEDOR (05/09/2026) — region_id → builder de chão que REALMENTE rodou
## ("PAINTED" · "MANIFEST" · "VILLAGE" · "LEGACY_TILES").
## Existe porque meu 1º teste provou que o `ground_painted.png` EXISTIA e mesmo assim o campo
## continuou no mapa velho: o ramo do MANIFESTO vencia. ★★★ Medir o ASSET ≠ medir a DECISÃO.
var ground_builder_used: Dictionary = {}

func _build_topdown_map(region_id: String, size: Vector2) -> void:
	_horizon_build_region = region_id   # P1.5-B: o chão+bordas saem DAQUI (antes do dispatcher) → contexto da borda por bioma
	# Manifesto (editor-authored OU legacy override ativo) vence as branches de tileset explícitas:
	# o chão vem do JSON (base_color + trilha), não do tileset do builder. (GODOT-MAPLOADER-LEGACY-OVERRIDE-PILOT-1)
	# ★★★ MAP RESOLVER (05/09/2026, 2ª correção) — CHÃO PINTADO É O DE MAIOR PRIORIDADE.
	# ROOT CAUSE do field (2ª rodada): mesmo depois de o pintado passar à frente dos tiles, o Ch1
	# CONTINUAVA no mapa velho — porque `data/map_editor_overrides/plains.json` existe, logo
	# `_is_manifest_region("plains")` é TRUE e o ramo do MANIFESTO vencia todo mundo, montando o
	# chão a partir do JSON (base_color + trilha de tiles).
	# ★★★ A lição: meu 1º teste provou que o ARQUIVO pintado existia, mas nunca provou QUAL RAMO
	# rodava. Medir a existência do asset ≠ medir a decisão do resolvedor.
	# ⚠️ Isto troca SÓ O CHÃO. Os props do manifesto continuam vindo por `_build_from_manifest`,
	# que é chamado à parte — nada de cenário editor-authored se perde.
	if _region_has_painted_ground(region_id) and region_id != "starter_village":
		ground_builder_used[region_id] = "PAINTED"
		print("[PVE MAP] PAINTED region=%s path=res://assets/tilesets/%s/ground_painted.png" % [region_id, region_id])
		_build_grove_painted_map(region_id, size)
	elif _is_manifest_region(region_id):
		ground_builder_used[region_id] = "MANIFEST"
		print("[PVE MAP] MANIFEST region=%s (sem ground_painted.png)" % region_id)
		_build_manifest_ground(region_id, size)   # editor-authored / legacy override: chão base + trilha do manifesto
	elif region_id == "starter_village" and ResourceLoader.exists("res://assets/tilesets/starter_village/plaza.png"):
		ground_builder_used[region_id] = "VILLAGE"
		_build_village_map(size)
	elif region_id == "plains" and ResourceLoader.exists("res://assets/tilesets/plains/grass.png"):
		ground_builder_used[region_id] = "LEGACY_TILES"
		push_warning("[PVE MAP] LEGACY_FALLBACK region=plains map=MAP_PLAINS reason=sem ground_painted.png")
		_build_plains_map(size)
	elif region_id == "cave" and ResourceLoader.exists("res://assets/tilesets/cave/cave_floor.png"):
		ground_builder_used[region_id] = "LEGACY_TILES"
		push_warning("[PVE MAP] LEGACY_FALLBACK region=cave map=MAP_CAVE reason=sem ground_painted.png")
		_build_cave_map(size)
	elif region_id == "swamp" and ResourceLoader.exists("res://assets/tilesets/swamp/mud.png"):
		_build_swamp_map(size)
	elif region_id == "swamp_pit" and ResourceLoader.exists("res://assets/tilesets/swamp/mud.png"):
		_build_pit_map(size)
	elif region_id == "old_road" and ResourceLoader.exists(OR + "ground_large.png"):
		_build_old_road_map(size)
	elif region_id == "ashen_grove" and _region_has_painted_ground("ashen_grove"):
		_build_grove_painted_map("ashen_grove", size)
	elif region_id == "deep_grove" and _region_has_painted_ground("deep_grove"):
		_build_grove_painted_map("deep_grove", size)
	elif region_id == "ancient_root_nest" and _region_has_painted_ground("ancient_root_nest"):
		_build_grove_painted_map("ancient_root_nest", size)
	elif region_id == "saltwind_shore" and _region_has_painted_ground("saltwind_shore"):
		_build_grove_painted_map("saltwind_shore", size)   # Costa: chão pintado terrain-only (GODOT-SALTWIND-ASSET-INTEGRATION-1)
	else:
		_build_shape_map(region_id, size)
	# OVERLAY de chão tileado v1.2 (render-only) p/ regiões runtime-authored registradas — NÃO converte a região.
	_maybe_overlay_ground_tiles(region_id, size)
	# CHÃO DE ARTE do Pacote 1 (render-only) p/ as 4 regiões antes 100% procedurais (cathedral/veins/fendas/iron_channels).
	_apply_region_floor_tiles(region_id, size)

## CHÃO DE ARTE do Pacote 1 (GODOT-FLOOR-TILES-PACK-01): desenha o tile base de REGION_FLOOR_TILES (+var em xadrez
## determinístico onde houver) via _build_ground_tiles, num z entre o base procedural e o decor. RENDER-ONLY (sem
## blocker/colisão/save). No-op se a região não está no mapa ou a textura sumiu (→ mantém o chão procedural).
func _apply_region_floor_tiles(region_id: String, size: Vector2) -> void:
	if not REGION_FLOOR_TILES.has(region_id):
		return
	var def: Dictionary = REGION_FLOOR_TILES[region_id]
	var base_key := str(def.get("base", ""))
	if base_key == "" or _try_load_tex("res://assets/" + base_key) == null:
		return   # arte ausente → fallback seguro: fica o chão procedural
	var tiles := { "tile_size": 96, "base_key": base_key, "layers": [] }
	var var_key := str(def.get("var", ""))
	if var_key != "" and _try_load_tex("res://assets/" + var_key) != null:
		var ts := 96
		var cols := int(ceil(size.x / float(ts)))
		var rows := int(ceil(size.y / float(ts)))
		var cells := PackedStringArray()
		for r in range(rows):
			for c in range(cols):
				if (c * 7 + r * 13) % 4 == 0:   # ~25% das células: quebra a repetição do tile base
					cells.append("%d,%d" % [c, r])
		tiles["layers"] = [ { "key": var_key, "cells": cells } ]
	_build_ground_tiles(tiles, size, REGION_FLOOR_TILES_Z, true)

## Overlay de chão TILEADO v1.2 p/ região RUNTIME-AUTHORED (GODOT-KHET-CARAVAN-CAMP-GROUND-V12-RUNTIME-1): mantém o
## builder runtime 100% intacto e só desenha o `region.ground.tiles` do JSON registrado em GROUND_TILE_OVERLAYS por
## cima do chão procedural (z_base -10: acima de base/path/decor procedural, abaixo de props/NPCs em z=pos.y; « 4095).
## RENDER-ONLY (sem blocker/colisão/interação/save). No-op se a região não estiver registrada ou o JSON não tiver tiles.
func _maybe_overlay_ground_tiles(region_id: String, size: Vector2) -> void:
	if not GROUND_TILE_OVERLAYS.has(region_id):
		return
	var path: String = GROUND_TILE_OVERLAYS[region_id]
	if not FileAccess.file_exists(path):
		return
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		return
	var j = JSON.parse_string(f.get_as_text())
	f.close()
	if typeof(j) != TYPE_DICTIONARY or not j.has("region"):
		return
	var ground = (j["region"] as Dictionary).get("ground", {})
	var tiles = ground.get("tiles", null)
	if typeof(tiles) == TYPE_DICTIONARY:
		_build_ground_tiles(tiles, size, -10)

## True se a região tem chão pintado importado (GODOT-DEEP-GROVE-VISUAL-PASS-1).
func _region_has_painted_ground(region_id: String) -> bool:
	return ResourceLoader.exists("res://assets/tilesets/%s/ground_painted.png" % region_id)

## Mapa pintado do Bosque/Deep Grove (GODOT-DEEP-GROVE-VISUAL-PASS-1): textura GRANDE única no origin
## (pixel-perfect, sem grade) + APENAS os blockers (cenário já está pintado: árvores/pedras/raízes/
## fungos/boca de raízes). Fallback procedural COMPLETO se a textura sumir. Mobs/baús/portais ficam
## SEPARADOS acima (montados em _build_<region>/_build_mobs/_build_chests).
func _build_grove_painted_map(region_id: String, size: Vector2) -> void:
	var base := ColorRect.new()
	base.size = size
	base.color = _ground_base_color(region_id)
	base.z_index = -22
	_region_node.add_child(base)
	if not _big_floor(size, Color.WHITE, "res://assets/tilesets/%s/ground_painted.png" % region_id):
		# arte sumiu → fallback procedural idêntico ao _build_shape_map (chão+trilha+bordas+decor visível)
		var p := ColorRect.new()
		p.size = Vector2(size.x, 150)
		p.position = Vector2(0, size.y * 0.5 - 75)
		p.color = _path_color(region_id)
		p.z_index = -18
		_region_node.add_child(p)
		_add_map_borders(size)
		_scatter_painted_region_decor(region_id, size, false)   # fallback: decor VISÍVEL + blockers
		return
	_add_map_borders(size)
	# chão pintado OK → só os BLOCKERS nas mesmas posições (sem duplicar o visual já pintado)
	_scatter_painted_region_decor(region_id, size, true)

## Despacha o scatter correto da região pintada (Bosque/Deep Grove/Ninho). blockers_only=true quando há
## chão pintado (cenário já na arte) → só colisões; false no fallback procedural (decor visível + colisões).
func _scatter_painted_region_decor(region_id: String, size: Vector2, blockers_only: bool) -> void:
	if region_id == "ashen_grove":
		_scatter_grove_decor(size, blockers_only)
	elif region_id == "deep_grove":
		_scatter_deep_grove_decor(size, blockers_only)
	elif region_id == "saltwind_shore":
		_scatter_coast_decor(size, blockers_only)
	elif region_id == "plains" or region_id == "cave":
		# ★★★ Ch1/Ch2 (arte do Codex 05/09): o chão pintado JÁ CONTÉM o cenário (rochas, árvores
		# mortas, arbustos nas bordas, centro de combate limpo). Espalhar decor procedural por cima
		# duplicaria props e sujaria a arte. ⛔ Sem o `else` abaixo estas regiões cairiam no scatter
		# do NINHO DAS RAÍZES — props do capítulo errado sobre o mapa novo.
		# ⚠️ Dívida consciente: sem blockers próprios, a colisão não acompanha a arte pintada.
		#    Na Hunt o jogador fica na coleira do spot, então não é bloqueante hoje.
		pass
	else:
		_scatter_ancient_nest_decor(size, blockers_only)

## Vila: CHÃO PINTADO único (praça + 4 caminhos baked, 2200x1600) no origin (GODOT-VILLAGE-HUB-VISUAL-PASS-1).
## Prédios/props/fonte/portais/blockers ficam SEPARADOS acima (em _scatter_village_props). Fallback
## procedural (grama+estradas+praça) se a arte sumir. NÃO baked blockers no chão.
func _build_village_map(size: Vector2) -> void:
	var base := ColorRect.new()
	base.size = size
	base.color = Color("3c6b34")
	base.z_index = -22
	_region_node.add_child(base)
	# chão pintado (2200x1600 = exatamente o canvas → escala 1.0, pixel-perfect, no origin)
	if not _big_floor(size, Color.WHITE, "res://assets/tilesets/starter_village/ground_painted.png"):
		# FALLBACK procedural: grama + 4 estradas radiais + praça + bordas + suavização
		var grass := _try_load_tex("res://assets/tilesets/plains/grass.png")
		if grass != null:
			var g := Sprite2D.new()
			g.texture = grass
			g.centered = false
			g.texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
			g.region_enabled = true
			g.region_rect = Rect2(0, 0, size.x, size.y)
			g.z_index = -20
			_region_node.add_child(g)
		var dirt := _try_load_tex("res://assets/tilesets/plains/dirt.png")
		if dirt != null:
			_village_road(dirt, Vector2(size.x * 0.5, 0), Vector2(170, size.y), -18)
			_village_road(dirt, Vector2(0, size.y * 0.5), Vector2(size.x, 170), -18)
		var plaza := Sprite2D.new()
		plaza.texture = _try_load_tex("res://assets/tilesets/starter_village/plaza.png")
		plaza.centered = true
		plaza.texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
		plaza.region_enabled = true
		plaza.region_rect = Rect2(0, 0, 1040, 720)
		plaza.position = Vector2(size.x * 0.5, size.y * 0.5)
		plaza.z_index = -17
		_region_node.add_child(plaza)
		_add_map_borders(size)
		_soften_plaza_edges(size)
	_scatter_village_props(size)

## Faixa de estrada de terra (provisória) centrada em `center` com tamanho `sz`. (GODOT-VILLAGE-HUB-EXPANSION-1)
