	# CATHEDRAL_CLEANUP_PACK_04: aglomerado de parede como 1 sprite se existir; senão back + 3 cristais (fallback).
	var wg_tex := _try_load_tex("res://assets/tilesets/cathedral_of_crystal/props/crystal_wall_growth.png")
