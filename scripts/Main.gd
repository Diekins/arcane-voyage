func _build_hud(vp: Vector2) -> void:
	var layer := CanvasLayer.new()
	add_child(layer)
	_hud_layer = layer   # P0.2: ref p/ atenuar a HUD na exploração (os popups ficam no _popup_layer separado)

	# HUD de vitais (canto sup. esq.) montado com as sprites do banco (GODOT-HUD-SPRITES-1):
	# medalhão de nível + barras de HP/XP emolduradas + ouro; barra de boss no topo-centro.
	_build_vitals_hud(vp, layer)
	_build_equip_hud(vp, layer)   # paperdoll de equipamento FIXO à direita (abaixo do tracker) + botão mochila
	_build_boss_bar(vp, layer)
	_build_battle_ui(vp, layer)   # lista discreta de inimigos próximos (esquerda-meio) + seleção por teclado

	# camada alta p/ o popup de reward + banner de derrota (acima do diálogo, layer 10).
