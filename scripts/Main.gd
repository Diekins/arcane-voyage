## Farol das Duas Praias: torre simples (não monumental) + lanterna no topo que pulsa (responde à luz de casa). Blocker fino no pé.
func _velas_farol(pos: Vector2) -> void:
	var z := int(pos.y)
	var node := Node2D.new(); node.position = pos; node.z_index = z
	_add_ground_shadow(node, 34.0, 10.0, 10.0)
	var shaft := Polygon2D.new(); shaft.polygon = PackedVector2Array([Vector2(-26, 0), Vector2(26, 0), Vector2(18, -150), Vector2(-18, -150)]); shaft.color = Color("c9c0ac"); node.add_child(shaft)
	var band := ColorRect.new(); band.color = Color("8a4a3a"); band.size = Vector2(40.0, 22.0); band.position = Vector2(-20.0, -96.0); node.add_child(band)
	var lantern := ColorRect.new(); lantern.color = Color("4a4742"); lantern.size = Vector2(40.0, 30.0); lantern.position = Vector2(-20.0, -182.0); node.add_child(lantern)
	var glow := Polygon2D.new(); var gp := PackedVector2Array()
	for i in range(12):
