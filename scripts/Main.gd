## Pulso verde de "alívio" (corrupção recuando): halos verdes que crescem e somem na arena. Só visual,
## z alto mas SEM CANVAS_ITEM_Z_MAX (preserva z-fix). Transiente (queue_free no fim do tween).
func _spawn_relief_pulse(pos: Vector2) -> void:
	if _region_node == null:
		return
	for i in range(3):
		var halo := Polygon2D.new()
		var hp := PackedVector2Array()
		var rr := 24.0 + i * 10.0
		for j in range(14):
			var a := TAU * j / 14.0
			hp.append(Vector2(cos(a) * rr, sin(a) * rr * 0.7))
		halo.polygon = hp
		halo.position = pos + Vector2(0, -20)
		halo.color = Color(0.45, 0.9, 0.5, 0.0)
		halo.z_index = Z_FX   # acima do mundo, abaixo do teto z (4090 < 4096); preserva z-fix
		_region_node.add_child(halo)
		var tw := create_tween()
		tw.tween_interval(0.08 * i)
		tw.tween_property(halo, "color:a", 0.32, 0.18)
		tw.parallel().tween_property(halo, "scale", Vector2(2.2, 2.2), 0.7)
		tw.tween_property(halo, "color:a", 0.0, 0.5)
		tw.tween_callback(halo.queue_free)

## ★ POLISH_PASS_02A — ESQUIVA-SUCESSO: o "eu fiz certo". Texto (já existia, mais claro) + flash/faíscas + um micro
## freeze-frame (o "snap"). Puro VFX/feel sobre a esquiva que já existe — NÃO toca dano/mecânica/save. Chamado só no
## mérito real (golpe anulado por i-frame), 1× por esquiva (cooldown _dodge_fb_t).
func _on_perfect_dodge(pos: Vector2) -> void:
	_spawn_world_text(pos, "esquiva!", Color("aef0ff"), -30.0)
	_spawn_dodge_spark(pos)
	# FATIA A3.75: freeze-frame LOCAL do herói (o "snap" da esquiva). Não toca Engine.time_scale.
	if _hitstop != null and _player != null:
		_hitstop.freeze(_player, 0.06)

## VFX da esquiva-sucesso: anel ciano que expande+some + 4 faíscas curtas radiando. Discreto, rápido, sem repetir.
func _spawn_dodge_spark(pos: Vector2) -> void:
	if _region_node == null:
		return
	var c := pos + Vector2(0, -18)
	var ring := Polygon2D.new()
	var rp := PackedVector2Array()
	for j in range(16):
		var a := TAU * float(j) / 16.0
		rp.append(Vector2(cos(a) * 22.0, sin(a) * 22.0 * 0.8))
	ring.polygon = rp; ring.position = c; ring.color = Color(0.68, 0.92, 1.0, 0.0); ring.z_index = Z_FX; _region_node.add_child(ring)
	var tw := create_tween()
	tw.tween_property(ring, "color:a", 0.55, 0.05)
	tw.parallel().tween_property(ring, "scale", Vector2(2.4, 2.4), 0.28)
	tw.tween_property(ring, "color:a", 0.0, 0.22)
	tw.tween_callback(ring.queue_free)
	for k in range(4):
		var ang := TAU * float(k) / 4.0 + 0.4
		var dir := Vector2(cos(ang), sin(ang) * 0.8)
		var spark := Line2D.new()
		spark.width = 2.4; spark.default_color = Color(0.80, 0.95, 1.0, 0.9); spark.z_index = Z_FX
		spark.points = PackedVector2Array([Vector2.ZERO, dir * 12.0]); spark.position = c + dir * 14.0
		_region_node.add_child(spark)
		var sw := create_tween()
		sw.tween_property(spark, "position", c + dir * 36.0, 0.22)
		sw.parallel().tween_property(spark, "default_color:a", 0.0, 0.22)
		sw.tween_callback(spark.queue_free)

## Hook de kill (GODOT-SIDEQUEST-KILLCOUNT-1 + BOARD-BOUNTIES-1): cada mob morto avança as quests de
## kill ATIVAS cujo target casa com o mob_id — tanto side-quests de NPC (SIDE_QUESTS) quanto bounties
## do mural (BOUNTIES). Identifica o mob por mob_id (confiável; setado em _spawn_mob_group). CAPA em
## need (não overconta) e ignora inativas/concluídas. NÃO mexe em drops/economia/quest principal — só
## lê mob_id e atualiza o progresso. Bosses usam outro caminho (defeated), não passam aqui.
func _advance_kill_quests(mob_id: String, pos: Vector2) -> void:
	if _campaign_progress_locked():
		return   # macro-zona = sandbox: kills NÃO avançam quests/bounties de campanha (XP/ouro/loot já saíram antes)
	if mob_id == "":
		return
	for src in [SIDE_QUESTS, BOUNTIES]:
		for qid in src:
			var q: Dictionary = src[qid]
			if str(q.get("kind", "collect")) != "kill":
				continue
			if str(q.get("target", "")) != mob_id:
				continue
			if GameState.sq_state(str(qid)) != "active":
				continue
			var need := int(q["need"])
			if GameState.sq_progress(str(qid)) >= need:
				continue                       # já bateu a meta: não conta nem paga de novo
			GameState.sq_add_progress(str(qid), 1)
			var cur := mini(GameState.sq_progress(str(qid)), need)
			_spawn_world_text(pos, "%s %d/%d" % [str(q["short"]), cur, need], Color("ffe08a"), -40.0)

## Hook de DESCOBERTA (GODOT-SWAMP-QUESTS-AND-SERVICE-1): ao ENTRAR numa região, completa as quests
## kind="discovery" ATIVAS cujo target casa o region_id (mesmo molde do _advance_kill_quests). A entrega
## fica pro mural (volta lá pra coletar). NÃO toca economia/save além do progresso já existente.
func _advance_discovery_quests(region_id: String) -> void:
	if _campaign_progress_locked():
		return   # macro-zona = sandbox: não dispara descobertas de campanha
	if region_id == "":
		return
	for src in [SIDE_QUESTS, BOUNTIES]:
		for qid in src:
			var q: Dictionary = src[qid]
			if str(q.get("kind", "collect")) != "discovery":
				continue
			if str(q.get("target", "")) != region_id:
				continue
			if GameState.sq_state(str(qid)) != "active":
				continue
			if GameState.sq_progress(str(qid)) >= int(q["need"]):
				continue
			GameState.sq_add_progress(str(qid), int(q["need"]))   # descoberta = completa de uma vez

func _spawn_drop(pos: Vector2, item_name: String) -> void:
	if item_name == "":
		return
	var node := Node2D.new()
	node.position = pos + Vector2(randf_range(-28.0, 28.0), randf_range(-8.0, 28.0))
	node.set_meta("item_name", item_name)
	node.z_index = 0 if _macro_mode else int(node.position.y)   # macro: grupo y-sort; produção: y-sort manual
	var icon := ColorRect.new()
	icon.color = Color("ffd27a")
	icon.size = Vector2(14, 14)
	icon.position = Vector2(-7, -7)
	icon.rotation = 0.78
	node.add_child(icon)
	var lbl := Label.new()
	lbl.text = item_name
	lbl.position = Vector2(-40, 12)
	lbl.add_theme_font_size_override("font_size", 11)
	lbl.modulate = Color(1, 1, 1, 0.9)
	node.add_child(lbl)
	_region_node.add_child(node)
	_drops.append(node)

## Coleta automática por proximidade (mais simples que [E]): andar por cima pega o drop.
func _collect_drops_near_player() -> void:
	if _player == null or _drops.is_empty():
		return
	for d in _drops.duplicate():
		if is_instance_valid(d) and _player.position.distance_to(d.position) < DROP_PICKUP:
			var item := str(d.get_meta("item_name", ""))
			# se o NOME bate com um item do catálogo → vai pra MOCHILA (equipável/consumível);
			# senão é MATERIAL de forja/venda (string→qtd em GameState.materials).
			var iid := ItemDB.id_by_name(item)
			if iid != "":
				# FATIA A3.5: o LootManager classifica/empilha/salva (silencioso — persiste no ciclo natural).
				if _lootmgr != null:
					_lootmgr.receive_world_drop(iid)   # FATIA A7.1: equipável vira ItemInstance com rolls
				else:
					GameState.backpack_add(iid, 1)
			else:
				GameState.add_material_silent(item, 1)   # material por NOME: dict já sustentável (sem save por drop)
			_spawn_world_text(d.position, "Drop: %s" % item, Color("dfe6e9"), -8.0)
			_drops.erase(d)
			d.queue_free()

## --- GAME-FEEL DO COMBATE (GODOT-COMBAT-JUICE-1) ---
## Reúne o "suco" de um golpe do Errante: hit-stop + screen shake + faísca de impacto + knockback.
## Chamado pelo melee (_attack_melee) e pelos projéteis (Projectile, via _main).
func _juice_hit(enemy, dmg: int, color: Color = Color("ffe08a"), magic: bool = false) -> void:
	if enemy == null or not is_instance_valid(enemy):
		return
	# FATIA A8.1: número de dano no inimigo pelo BUS (agrega por alvo → sem spam em x3; renderer desenha). NOVO
	# (não havia número de dano no inimigo antes; sem duplicação). O bus limita o nº de floats vivos.
	if _feedback != null and dmg > 0:
		_feedback.push_damage(dmg, "e%d" % enemy.get_instance_id(), GameFeedback.K_DAMAGE_DEALT, enemy.position)
	# PROFICIÊNCIA POR USO (GODOT-VOCATION-PROFICIENCY-MVP-1): _juice_hit SÓ roda em ACERTO REAL (melee/reach
	# instantâneo; projétil de arco/cajado ao TOCAR). Logo, +1 XP da vocação ATIVA aqui = anti-grind por
	# construção (disparo no vazio nunca chega aqui → Arqueiro/Mago só evoluem ao acertar). Síncrono, antes
	# do await do hit-stop.
	GameState.gain_proficiency(GameState.current_combat_archetype(), 1)
	# MAESTRIA ARCANA (GODOT-MAGE-ARCANE-MASTERY-MVP-1): acerto REAL com CAJADO (magic) sobe a maestria do
	# Mago. _juice_hit só roda no contato → disparo no vazio não conta. Book(support)/outras armas: não conta.
	if GameState.current_combat_archetype() == "magic":
		GameState.gain_mastery("arcane", 1)
	# MAESTRIA DE PRECISÃO (GODOT-ARCHER-PRECISION-MASTERY-MVP-1): acerto REAL com ARCO (ranged) sobe a
	# maestria do Arqueiro. _juice_hit só roda no contato → flecha no vazio não conta. Demais armas: não.
	if GameState.current_combat_archetype() == "ranged":
		GameState.gain_mastery("precision", 1)
	# MAESTRIA DE POSTURA (GODOT-SPEARMAN-STANCE-MASTERY-MVP-1): acerto REAL com LANÇA (reach) E em ALCANCE
	# IDEAL (alvo a >= STANCE_MIN_RANGE, não colado) → sobe a maestria do Lanceiro. Ataque no vazio não chega
	# aqui; outras armas não contam; ponto-blank (mob colado) não conta (recompensa o espaçamento).
	if GameState.current_combat_archetype() == "reach" and _player != null \
			and _player.position.distance_to(enemy.position) >= STANCE_MIN_RANGE:
		GameState.gain_mastery("stance", 1)
	# FATIA A3.75: hit-stop LOCAL no INIMIGO atingido (só se vivo — não pausa a animação de morte). Antes era
	# Engine.time_scale=0.05 GLOBAL (blocker da velocidade idle). Agora congela só o ator → time_scale fica 1.0.
	if _hitstop != null and enemy.has_method("is_alive") and enemy.is_alive():
		_hitstop.freeze(enemy, 0.05)
	_add_shake(clampf(2.2 + dmg * 0.12, 2.2, 7.0), 0.18)
	_spawn_impact(enemy.position, color)
	if _region_node != null:
		# cajado → impacto MÁGICO azul; demais (espada/lança/arco) → impacto físico (recortes confiáveis)
		var eff := "impact_blue_magic" if magic else "impact_small_physical"
		CombatVfx.spawn(_region_node, eff, enemy.position)
	if enemy.has_method("apply_knockback") and _player != null:
		enemy.call("apply_knockback", _player.position, 210.0)

func _add_shake(mag: float, dur: float) -> void:
	_shake_mag = maxf(_shake_mag, mag)
	_shake_dur = maxf(_shake_dur, dur)
	_shake_t = _shake_dur

func _update_camera_shake(delta: float) -> void:
	if _camera == null:
		return
	if _shake_t > 0.0:
		_shake_t -= delta
		var k := (_shake_t / _shake_dur) if _shake_dur > 0.0 else 0.0
		var m := _shake_mag * k
		_camera.offset = Vector2(randf_range(-m, m), randf_range(-m, m))
	elif _camera.offset != Vector2.ZERO:
		_camera.offset = Vector2.ZERO
		_shake_mag = 0.0

## Faísca de impacto procedural (sem arte): estilhaços que voam pra fora e somem. `color` casa com a arma.
func _spawn_impact(pos: Vector2, color: Color) -> void:
	if _region_node == null:
		return
	var fx := Node2D.new()
	fx.position = pos + Vector2(0, -12)   # na altura do corpo, não no chão
	fx.z_as_relative = false
	fx.z_index = Z_FX - 1
	_region_node.add_child(fx)
	var n := 6
	for i in range(n):
		var a := TAU * float(i) / float(n) + randf_range(-0.25, 0.25)
		var spark := Polygon2D.new()
		spark.polygon = PackedVector2Array([Vector2(0, -2.0), Vector2(11, 0), Vector2(0, 2.0)])
		spark.color = color
		spark.rotation = a
		fx.add_child(spark)
		var dist := randf_range(13.0, 20.0)
		var tw := fx.create_tween()
		tw.set_parallel(true)
		tw.tween_property(spark, "position", Vector2(cos(a), sin(a)) * dist, 0.18).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		tw.tween_property(spark, "modulate:a", 0.0, 0.2)
	var done := fx.create_tween()
	done.tween_interval(0.24)
	done.tween_callback(fx.queue_free)

func _spawn_world_text(pos: Vector2, text: String, color: Color, y_off: float) -> void:
	if _region_node == null:
		return
	var lbl := Label.new()
	lbl.text = text
	lbl.add_theme_font_size_override("font_size", 16)
	lbl.modulate = color
