func _ready() -> void:
	var vp := get_viewport_rect().size
	_player = _build_player(Vector2.ZERO)   # posição real é definida por load_region (mundo)
	_build_auto_marker()
	_build_autoplay()   # FATIA A1: caça automática infinita (idle-first, ligada por padrão)
	# FATIA A5: reconcilia a AUSÊNCIA offline ANTES do StageDirector (o stage já entra avançado; §34). Usa o CP
	# atual (equipamento já carregado) + a loot table da região salva. Não simula combate — é matemática.
	_idlerewards = IdleRewards.new()
	_idlerewards.name = "IdleRewards"
	add_child(_idlerewards)
	_idlerewards.setup(self, null, null)
	_idlerewards.boot_reconcile(int(Time.get_unix_time_from_system()))
	_build_stagedirector()   # FATIA A2: progressão automática por fases (lê o stage já avançado pelo offline)
	_lootmgr = LootManager.new()   # FATIA A3.5: sustentabilidade de loot / inventário idle / sink seguro
	_lootmgr.name = "LootManager"
	add_child(_lootmgr)
	_lootmgr.setup(self)
	_hitstop = HitStopController.new()   # FATIA A3.75: hit-stop LOCAL (sem Engine.time_scale global)
	_hitstop.name = "HitStopController"
	add_child(_hitstop)
	_speedctrl = GameSpeedController.new()   # FATIA A4: única autoridade de Engine.time_scale (x1/x2/x3)
	_speedctrl.name = "GameSpeedController"
	add_child(_speedctrl)
	_speedctrl.setup(self)
	_build_hud(vp)
	_idlerewards._sd = _stagedirector   # FATIA A5: agora que existem, liga as refs (claim/taxas usam-nas)
	_idlerewards._lm = _lootmgr
	_prestige = PrestigeManager.new()   # FATIA A6: Prestígio / Master Level / Selos (após StageDirector; antes da HUD)
	_prestige.name = "PrestigeManager"
	add_child(_prestige)
	_prestige.setup(self)
	# FATIA A7: sistemas de poder (Bestiário/Códice) + molde genérico SystemPanel.
	_bestiary = BestiaryManager.new(); _bestiary.name = "BestiaryManager"; add_child(_bestiary); _bestiary.setup(self)
	_codex = ItemCodex.new(); _codex.name = "ItemCodex"; add_child(_codex); _codex.setup(self)
	if _lootmgr != null and not _lootmgr.item_discovered.is_connected(_on_item_discovered):
		_lootmgr.item_discovered.connect(_on_item_discovered)   # descoberta ao RECEBER/COLETAR-offline (§44/§70)
	_sys_providers = _build_system_providers()
	_systempanel = SystemPanel.new(); _systempanel.name = "SystemPanel"; add_child(_systempanel)
	_systempanel.setup(self, _sys_providers)
	_idlehud = IdleHud.new()   # FATIA A4/A5: casca visual idle (orquestra painéis + baú AFK + taxas)
	_idlehud.name = "IdleHud"
	add_child(_idlehud)
	_idlehud.setup(self, _stagedirector, _autoplay, _lootmgr, _speedctrl)
	_idlehud.set_idlerewards(_idlerewards)
	_idlehud.set_prestige(_prestige)   # FATIA A6: painel de Prestígio + ▸IR + badge Master
	_build_dialog()
	GameState.state_changed.connect(_apply_player_loadout)   # equipar/desequipar reflete na velocidade
	_apply_player_loadout()
	_route_enter(GameState.current_region_id)   # GRADUATION-1: cluster graduado → mundo contínuo canônico; senão load_region legado
	# FATIA A7.4.1: liga o roteador de mundo DEPOIS da 1ª carga (boot usa o save; a partir daqui a progressão de
	# capítulo dirige a região via ContentManifest). Conectar aqui evita relocação surpresa no boot.
	_world_router = WorldContentRouter.new()
	_world_router.name = "WorldContentRouter"
	add_child(_world_router)
	_world_router.setup(self, _stagedirector)
	# FATIA A8: bus de feedback + conexão dos sinais LIVRES de baixa frequência (o render é field-deferido).
	_feedback = GameFeedback.new()
	_feedback.name = "GameFeedback"
	add_child(_feedback)
	if _prestige != null and not _prestige.prestige_done.is_connected(_on_prestige_done_fb):
		_prestige.prestige_done.connect(_on_prestige_done_fb)
	# FATIA A8.1: RENDERER real (desenha o bus). world_cb = pai no mundo (região corrente); player_cb = herói.
	_feedback_renderer = FeedbackRenderer.new()
	_feedback_renderer.name = "FeedbackRenderer"
	add_child(_feedback_renderer)
	_feedback_renderer.setup(_feedback, func(): return _region_node, func(): return _player)
	# transições de fase/capítulo → intro de boss/apex + banner de capítulo (uma vez por entrada)
	_fb_last_chapter = _stagedirector.chapter if _stagedirector != null else 1
	if _stagedirector != null and not _stagedirector.stage_changed.is_connected(_on_stage_changed_fb):
		_stagedirector.stage_changed.connect(_on_stage_changed_fb)
	# loot: descoberta/salvagem → bus (o renderer desenha). item_salvaged estava OCIOSO (auditoria A8).
	if _lootmgr != null and not _lootmgr.item_salvaged.is_connected(_on_item_salvaged_fb):
		_lootmgr.item_salvaged.connect(_on_item_salvaged_fb)
	# FATIA A9: diretor narrativo (camada sobre o idle; NÃO gateia stage). Avalia no boot e anuncia disponíveis em
	# BATCH (§24/§48) — não spam. Não marca seen, não pausa, não abre diálogo (§23/§68).
	_narrative = NarrativeDirector.new()
	_narrative.name = "NarrativeDirector"
	add_child(_narrative)
	_narrative.setup(self)
	# FATIA A9.1: painel de história (widget) — abre por atalho/ação secundária; NÃO abre cena sozinho.
	_story_panel = StoryPanel.new()
	_story_panel.name = "StoryPanel"
	add_child(_story_panel)
	_story_panel.setup(self, _narrative)
	# FATIA A10: autoridade de presença (Auto↔manual). Fina, sem progressão; lê o estado existente.
	_presence = PresenceController.new()
	_presence.name = "PresenceController"
	add_child(_presence)
	_presence.setup(self)
	var _story_pending: int = _narrative.pending_count()
	if _story_pending > 0:
		var _avail: Array = _narrative.available_unseen()
		_feedback.push_story(_story_pending, str(_avail[0]["title"]) if not _avail.is_empty() else "")
	# retorno offline: se há baú pendente, anuncia "ENQUANTO VOCÊ ESTEVE FORA" pelo bus (o painel do IdleHud continua).
	if _idlerewards != null and _idlerewards.has_pending():
		var p: Dictionary = _idlerewards.pending()
		_feedback.push_offline_claim({
			"seconds": int(p.get("seconds", 0)), "stages": int(p.get("stages_advanced", 0)),
			"gold": int(p.get("gold", 0)), "xp": int(p.get("xp", 0)),
			"items": (p.get("items", {}) as Dictionary).size(), "materials": (p.get("materials", {}) as Dictionary).size(),
		})
	_setup_world_ambience()   # WORLD AMBIENCE: fundação de áudio ambiente (dormente sem asset; não toca save/combate/economia)
	_build_hunthost()   # FATIA A16.2: liga o runtime da Hunt (A16.1) ao game loop REAL (único tick owner; UI/presence no tree)
	_autoconsumables = AutoConsumables.new(); _autoconsumables.name = "AutoConsumables"   # A17.6
