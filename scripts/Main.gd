	_eq_layer.add_child(_eq_toggle_btn)
	# conteúdo (some no toggle; o botão acima permanece)
	_eq_content = Control.new()
	_eq_content.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_eq_layer.add_child(_eq_content)
	# painel PRÓPRIO (escuro + borda dourada) — igual ao painel aberto
	var panel := Panel.new()
	var psb := StyleBoxFlat.new()
	psb.bg_color = Color(0.075, 0.085, 0.125, 0.96)
	psb.set_border_width_all(2)
	psb.border_color = Color(0.72, 0.6, 0.32, 0.6)
	psb.set_corner_radius_all(8)
	panel.add_theme_stylebox_override("panel", psb)
	panel.position = pos
	panel.size = psz
	panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_eq_content.add_child(panel)
	var title := Label.new()
	title.text = "Equipamento"
	title.position = pos + Vector2(8.0, -20.0)
	title.add_theme_font_size_override("font_size", 12)
	title.add_theme_color_override("font_color", Color("e8c267"))
	_eq_content.add_child(title)
	# BOTÃO MOCHILA no canto sup-direito do painel (persistente — não some no refresh das células)
	var bag_sz := 30.0 * s + 14.0
	_bag_btn = Button.new()
	var bsb := StyleBoxFlat.new()
	bsb.bg_color = Color(0.10, 0.12, 0.17, 0.95)
	bsb.set_border_width_all(1)
	bsb.border_color = Color(0.62, 0.52, 0.28, 0.85)
	bsb.set_corner_radius_all(5)
	_bag_btn.add_theme_stylebox_override("normal", bsb)
	_bag_btn.add_theme_stylebox_override("hover", bsb)
	_bag_btn.add_theme_stylebox_override("pressed", bsb)
	_bag_btn.position = pos + Vector2(psz.x - bag_sz - 6.0, 6.0)
