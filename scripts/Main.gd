	_build_villager(Vector2(1180, 470), "npcs/village/blacksmith", "Ferreiro Kesh", [
		"Forjo onde a estrada me joga. Traga material e a bigorna canta, mesmo no deserto.",
		"Um dia volto pra Vila ver se o velho Dorn ainda bate o metal torto como eu ensinei.",
		"E ainda devolvo o martelo dele. Se eu lembrar qual dos dois era o bom.",
		"O Dorn me ensinou mais do que ele imagina.",
		"Forjo onde a estrada me larga. Faz tempo que parei de chamar qualquer lugar de casa.",
		"Tenho três lâminas pra terminar antes de escurecer. A bigorna não espera.",
	], "blacksmith", false, 24)   # z_off +24 → desenha na frente da tenda/bigorna
	_build_villager(Vector2(520, 620), "npcs/village/elder", "Guia Imir", [
		"Bem-vindo ao Acampamento de Caravana, Errante. Aqui o sal e a areia trazem viajantes de todo canto. Viajante chega, viajante parte; já nem me despeço direito.",
		"Adiante ficam os portões da cidade de Khet-Sar — fechados ao forasteiro, por enquanto. Descanse e reabasteça antes de seguir.",
