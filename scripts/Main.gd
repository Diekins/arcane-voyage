	_build_dev_test_buttons()   # ⚠️ DEV: atalhos de teste dos pilotos WORLD LIFE (caravana + aves). Round-trip, sem perder progresso.
	_build_title_screen(vp)   # CAPA do jogo (GODOT-TITLE-SCREEN-RPG-MVP-1): mostra antes do controle normal
	_open_title()
