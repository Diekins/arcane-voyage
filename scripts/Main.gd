		"bottle": # garrafa lacrada deitada na areia (bilhete dentro)
			var b := Polygon2D.new(); b.polygon = PackedVector2Array([Vector2(-14, -2), Vector2(8, -8), Vector2(14, -6), Vector2(14, 2), Vector2(8, 4), Vector2(-14, 2)]); b.color = Color(0.36, 0.5, 0.42, 0.88); node.add_child(b)
			var neck := ColorRect.new(); neck.color = Color(0.30, 0.42, 0.36, 0.92); neck.size = Vector2(8.0, 5.0); neck.position = Vector2(12.0, -4.0); node.add_child(neck)
