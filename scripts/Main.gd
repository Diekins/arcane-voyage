## Decor do Bosque de Cinza: árvores mortas (blocker) + monólitos (colunas) nas bordas + pedras +
## pulsos de fungo (luz sutil, atravessável). Posições nas faixas padrão (longe dos spawns; validado).
func _scatter_grove_decor(size: Vector2, blockers_only: bool = false) -> void:
	var vis := not blockers_only   # com chão pintado, só os blockers (cenário já está na arte)
	var trees := [Vector2(0.1, 0.18), Vector2(0.28, 0.12), Vector2(0.5, 0.14), Vector2(0.72, 0.12), Vector2(0.9, 0.24), Vector2(0.15, 0.78), Vector2(0.38, 0.86), Vector2(0.62, 0.82), Vector2(0.86, 0.78), Vector2(0.95, 0.5)]
	for n in trees:
		_add_dead_tree(Vector2(size.x * n.x, size.y * n.y), vis)
	for n in [Vector2(0.22, 0.42), Vector2(0.78, 0.58)]:
		_add_column(Vector2(size.x * n.x, size.y * n.y), vis)   # monólitos antigos
	for n in [Vector2(0.58, 0.4), Vector2(0.35, 0.6)]:
		_add_rock(Vector2(size.x * n.x, size.y * n.y), 24.0, vis)
	if blockers_only:
		return   # fungos são puramente visuais → já estão no chão pintado
	# fungos luminescentes (atravessáveis, z negativo) — toque de magia na mata
	for n in [Vector2(0.45, 0.5), Vector2(0.6, 0.66), Vector2(0.3, 0.34), Vector2(0.7, 0.34)]:
		var glow := Polygon2D.new()
		var gp := PackedVector2Array()
		var rr := randf_range(20.0, 34.0)
		for i in range(10):
			var a := TAU * i / 10.0
			gp.append(Vector2(cos(a) * rr, sin(a) * rr * 0.7))
		glow.polygon = gp
		glow.position = Vector2(size.x * n.x, size.y * n.y)
		glow.color = Color(0.36, 0.62, 0.58, 0.18)   # halo ciano-esverdeado sutil
		glow.z_index = -15
		_region_node.add_child(glow)

## Decoração do Deep Grove (GODOT-DEEP-GROVE-1): ruínas semi-enterradas (colunas=blocker), pedras,
## árvores mortas emoldurando as bordas, RAÍZES NEGRAS (visuais, sem colisão) e pulso frio de cinza
## arcana. Mantém LIVRES: a clareira central (arena da Matriarca ~0.5,0.43) e o corredor sul (x≈0.5,
## y>0.7) por onde se entra/sai. Blockers só nos quadrantes/bordas.
func _scatter_deep_grove_decor(size: Vector2, blockers_only: bool = false) -> void:
	var vis := not blockers_only   # com chão pintado, só os blockers (cenário já está na arte)
	# árvores mortas emoldurando (blocker) — só nas bordas, fora do corredor central e da arena
	for n in [Vector2(0.08, 0.14), Vector2(0.26, 0.10), Vector2(0.74, 0.10), Vector2(0.92, 0.16), Vector2(0.06, 0.5), Vector2(0.94, 0.5), Vector2(0.10, 0.88), Vector2(0.90, 0.88)]:
		_add_dead_tree(Vector2(size.x * n.x, size.y * n.y), vis)
	# ruínas antigas semi-enterradas (colunas quebradas = blocker) nos cantos médios
	for n in [Vector2(0.20, 0.32), Vector2(0.80, 0.32), Vector2(0.20, 0.70), Vector2(0.80, 0.70)]:
		_add_column(Vector2(size.x * n.x, size.y * n.y), vis)
	for n in [Vector2(0.34, 0.20), Vector2(0.66, 0.20), Vector2(0.30, 0.82), Vector2(0.70, 0.82)]:
		_add_rock(Vector2(size.x * n.x, size.y * n.y), 22.0, vis)
	if blockers_only:
		return   # raízes/pulso são puramente visuais → já estão no chão pintado
	# RAÍZES NEGRAS rastejando (visual, SEM colisão, z negativo) — identidade da região
	var roots := [
		[Vector2(0.12, 0.30), 150.0, 0.5], [Vector2(0.86, 0.30), 150.0, -0.5],
		[Vector2(0.16, 0.62), 130.0, -0.35], [Vector2(0.84, 0.62), 130.0, 0.35],
		[Vector2(0.40, 0.30), 120.0, 1.2], [Vector2(0.60, 0.30), 120.0, -1.2],
		[Vector2(0.30, 0.50), 140.0, 0.1], [Vector2(0.70, 0.50), 140.0, -0.1],
	]
	for r in roots:
		_add_black_root(Vector2(size.x * (r[0] as Vector2).x, size.y * (r[0] as Vector2).y), r[1], r[2])
	# pulso frio de cinza arcana (atravessável, z negativo): centro da clareira + alguns pontos
	for n in [Vector2(0.5, 0.43), Vector2(0.36, 0.5), Vector2(0.64, 0.5), Vector2(0.5, 0.62)]:
		var glow := Polygon2D.new()
		var gp := PackedVector2Array()
		var rr := randf_range(22.0, 38.0)
		for i in range(10):
			var a := TAU * i / 10.0
			gp.append(Vector2(cos(a) * rr, sin(a) * rr * 0.7))
		glow.polygon = gp
		glow.position = Vector2(size.x * n.x, size.y * n.y)
		glow.color = Color(0.30, 0.52, 0.6, 0.16)   # halo ciano-frio (algo antigo pulsa sob a clareira)
		glow.z_index = -15
		_region_node.add_child(glow)

## Raiz negra rastejante (VISUAL, sem blocker): 2 segmentos escuros inclinados. z negativo (no chão).
func _add_black_root(pos: Vector2, length: float, angle: float) -> void:
	var node := Node2D.new()
	node.position = pos
	node.rotation = angle
	node.z_index = -16
	var a := ColorRect.new()
	a.size = Vector2(length, 9)
	a.position = Vector2(-length * 0.5, -4)
	a.color = Color(0.07, 0.06, 0.06, 0.9)
	node.add_child(a)
	var b := ColorRect.new()
	b.size = Vector2(length * 0.55, 7)
	b.position = Vector2(length * 0.1, -3)
	b.rotation = 0.5
	b.color = Color(0.09, 0.08, 0.08, 0.85)
	node.add_child(b)
	_region_node.add_child(node)

## Decoração do Ninho da Raiz Ancestral (GODOT-ANCIENT-ROOT-NEST-1): núcleo vivo da corrupção. Raízes
## ancestrais (árvores=blocker) + pilares de osso/ruína (colunas=blocker) emoldurando uma ARENA central
## ao norte (~0.5,0.30) deixada LIVRE p/ o boss; ossos no chão + poças de seiva escura + veios
## brilhantes (visuais, sem colisão). Corredor sul (entrada/saída) livre.
func _scatter_ancient_nest_decor(size: Vector2, blockers_only: bool = false) -> void:
	var vis := not blockers_only   # com chão pintado, só os blockers (cenário já está na arte)
	# raízes ancestrais grossas (blocker) nas bordas — moldam clareiras apertadas, fora da arena/corredor
	for n in [Vector2(0.10, 0.16), Vector2(0.30, 0.10), Vector2(0.70, 0.10), Vector2(0.90, 0.16), Vector2(0.06, 0.5), Vector2(0.94, 0.5), Vector2(0.12, 0.85), Vector2(0.88, 0.85)]:
		_add_dead_tree(Vector2(size.x * n.x, size.y * n.y), vis)
	# pilares de osso / ruína ancestral (colunas=blocker) flanqueando a arena (ring natural)
	for n in [Vector2(0.24, 0.34), Vector2(0.76, 0.34), Vector2(0.24, 0.66), Vector2(0.76, 0.66)]:
		_add_column(Vector2(size.x * n.x, size.y * n.y), vis)
	for n in [Vector2(0.36, 0.16), Vector2(0.64, 0.16), Vector2(0.34, 0.80), Vector2(0.66, 0.80)]:
		_add_rock(Vector2(size.x * n.x, size.y * n.y), 24.0, vis)
	if blockers_only:
		return   # ossos/seiva/veios/raízes são puramente visuais → já estão no chão pintado
	# raízes negras rastejantes (visual, SEM colisão)
	for r in [[Vector2(0.14, 0.30), 150.0, 0.4], [Vector2(0.86, 0.30), 150.0, -0.4], [Vector2(0.20, 0.58), 130.0, -0.3], [Vector2(0.80, 0.58), 130.0, 0.3], [Vector2(0.42, 0.20), 120.0, 1.2], [Vector2(0.58, 0.20), 120.0, -1.2]]:
		_add_black_root(Vector2(size.x * (r[0] as Vector2).x, size.y * (r[0] as Vector2).y), r[1], r[2])
	# OSSOS presos no chão (visual, z negativo) — costelas/cacos pálidos
	for n in [Vector2(0.30, 0.46), Vector2(0.70, 0.46), Vector2(0.46, 0.70), Vector2(0.54, 0.24), Vector2(0.18, 0.72), Vector2(0.82, 0.72)]:
		_add_bones(Vector2(size.x * n.x, size.y * n.y))
	# POÇAS de seiva escura (visual, z negativo)
	for n in [Vector2(0.5, 0.46), Vector2(0.38, 0.56), Vector2(0.62, 0.56)]:
		var sap := Polygon2D.new()
		var sp := PackedVector2Array()
		var sr := randf_range(34.0, 50.0)
		for i in range(12):
			var a := TAU * i / 12.0
			sp.append(Vector2(cos(a) * sr, sin(a) * sr * 0.6))
		sap.polygon = sp
		sap.position = Vector2(size.x * n.x, size.y * n.y)
		sap.color = Color(0.05, 0.04, 0.03, 0.85)   # seiva escura quase preta
		sap.z_index = -17
		_region_node.add_child(sap)
	# VEIOS brilhantes (seiva luminescente, visual, z negativo) — pulso de vida no núcleo
	for n in [Vector2(0.5, 0.30), Vector2(0.40, 0.40), Vector2(0.60, 0.40), Vector2(0.5, 0.52)]:
		var vein := Polygon2D.new()
		var vp := PackedVector2Array()
		var vr := randf_range(16.0, 26.0)
		for i in range(10):
			var a := TAU * i / 10.0
			vp.append(Vector2(cos(a) * vr, sin(a) * vr * 0.7))
		vein.polygon = vp
		vein.position = Vector2(size.x * n.x, size.y * n.y)
		vein.color = Color(0.4, 0.85, 0.45, 0.22)   # veio verde-seiva brilhante
		vein.z_index = -15
		_region_node.add_child(vein)

## EASTERN_SEA_PROPS_PACK_08 — sprite DECORATIVO costeiro (mar oriental). Espelha _khet_deco_sprite:
## NEAREST + offset por bbox_alpha (não pelo fundo do canvas) + z por y-sort (pé). Sem blocker (só arte;
## colisão fica com os props sólidos já existentes). Fallback: arte ausente → _try_load_tex null → no-op.
func _eastern_sea_deco_sprite(pos: Vector2, path: String, off: Vector2) -> void:
	var tex := _try_load_tex(path)
	if tex == null:
		return
	var s := Sprite2D.new()
	s.texture = tex
	s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	s.offset = off
	s.position = pos
	s.z_index = int(pos.y)
	_region_node.add_child(s)

