## Slot de equipamento DESENHADO por mim (célula limpa, GODOT-INVENTORY-ART-DIRECTED-REBUILD-1): recesso
## próprio → controle total e nenhum ghost embutido atrás do item. VAZIO: ghost faint do slot (alpha .22)
## contido. EQUIPADO: SÓ o ícone contido (fit, KEEP_ASPECT), sem fundo/ghost. BLOQUEADO (offhand + arma de
## 2 mãos): tom avermelhado + "ocupado" (só se a célula for grande). Botão transparente por cima (clique p/
## tirar) + tooltip RPG. `fit`=lado máx do ícone. `lbl_font>0` → rótulo centralizado sob a célula. Usado pelo
## painel ABERTO (parent=_inv_root, com rótulo) E pelo paperdoll FIXO do HUD (parent=_eq_slots_root, menor).
func _eq_slot_cell(parent: Control, slot: String, center: Vector2, cell: float, fit: float, lbl_font := 0) -> void:
	var weapon_2h := GameState.equipment.has("weapon") and ItemDB.is_two_handed(str(GameState.equipment["weapon"]))
	var equipped := GameState.equipment.has(slot)
	var blocked := slot == "offhand" and weapon_2h and not equipped
	var tl := center - Vector2(cell, cell) * 0.5
	# célula recessada (borda bronze) — o "buraco" do slot
	var p := Panel.new()
	var sb := StyleBoxFlat.new()
	# GODOT-INVENTORY-RPG-SKIN-MVP-1: nicho de couro escuro (bloqueado = avermelhado), borda bronze
	sb.bg_color = Color(0.32, 0.11, 0.11, 0.55) if blocked else Color(0.07, 0.055, 0.04, 1.0)
	sb.set_border_width_all(1)
	sb.border_color = Color(0.6, 0.38, 0.18, 0.85) if blocked else Color(0.55, 0.45, 0.26, 0.8)
	sb.set_corner_radius_all(5)
	p.add_theme_stylebox_override("panel", sb)
	p.position = tl
	p.size = Vector2(cell, cell)
	p.custom_minimum_size = Vector2(cell, cell)
	p.mouse_filter = Control.MOUSE_FILTER_IGNORE
	parent.add_child(p)
	# botão transparente por cima (clique + tooltip)
	var btn := Button.new()
	btn.flat = true
	btn.position = tl
	btn.size = Vector2(cell, cell)
	btn.custom_minimum_size = Vector2(cell, cell)
	if equipped:
		var iid := str(GameState.equipment[slot])
		_inv_icon_node(parent, ItemDB.icon_path(iid), center, fit)   # SÓ o item, contido, sem fundo
		_attach_tip(btn, _item_tooltip_bb(iid, "equip") + "\n[color=#e6c0c8](clique p/ tirar)[/color]")
		btn.pressed.connect(func(): GameState.unequip(slot))
	elif blocked:
		if cell >= 55.0:
			_inv_text(parent, "ocupado", center - Vector2(22.0, 7.0), 10, Color("e0a0a0"))
		_attach_tip(btn, "[b][color=#e07a7a]Mão secundária — ocupada[/color][/b]\n[color=#9aa0ad]A arma equipada usa as 2 mãos.[/color]")
	else:
		var gp := ItemDB.slot_icon_path(slot)
		if gp != "":
			_inv_icon_node(parent, gp, center, fit, Color(1, 1, 1, 0.22))   # ghost faint só quando vazio
		_attach_tip(btn, "[b][color=#cfd3da]%s[/color][/b]\n[color=#9aa0ad]Slot vazio — equipe um item da mochila.[/color]" % str(EQ_SLOT_LABEL.get(slot, slot)))
	parent.add_child(btn)
	# rótulo pequeno centralizado sob a célula (só se pedido)
	if lbl_font > 0:
		var lbl := _inv_text(parent, str(EQ_SLOT_LABEL.get(slot, slot)), Vector2(tl.x, tl.y + cell + 2.0), lbl_font, Color(0.62, 0.66, 0.74))
		lbl.size = Vector2(cell, float(lbl_font) + 3.0)
		lbl.custom_minimum_size = Vector2(cell, float(lbl_font) + 3.0)
		lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER

## Descrição amigável do estilo de combate atual (pela arma equipada) p/ a HUD/inventário.
func _combat_style_desc() -> String:
	match GameState.current_weapon_type():
		"bow": return "Arco — à distância (físico)"
		"staff": return "Cajado — à distância (arcano)"
		"spear": return "Lança — corpo-a-corpo de alcance"
		"sword": return "Espada — corpo-a-corpo"
		_: return "Desarmado — corpo-a-corpo"

## Detalhe compacto de um item p/ a UI (2ª linha): tipo/slot · stats · venda · descrição.
func _item_detail(iid: String) -> String:
	var it := ItemDB.get_item(iid)
	var parts := PackedStringArray()
	if ItemDB.is_equippable(iid):
		parts.append(ItemDB.rarity_label(ItemDB.rarity(iid)))   # raridade no início do tooltip
		var slbl := str(ItemDB.SLOT_LABEL.get(ItemDB.slot_of(iid), iid))
		if ItemDB.is_two_handed(iid):
			slbl += " (2 mãos)"
		parts.append(slbl)
	elif str(it.get("cat", "")) == "consumable":
		parts.append("Consumível")
	var sm := ItemDB.stat_summary(iid)
	if sm != "":
		parts.append(sm)
	var sv := ItemDB.sell_value(iid)
	if sv > 0:
		parts.append("vende %dg" % sv)
	var desc := str(it.get("desc", ""))
	if desc != "":
		parts.append(desc)
	return "   ·   ".join(parts)

## Coluna do MEIO (compacta) de um item p/ as listas: tipo/slot + stats. (desc/venda vão no tooltip.)
func _item_mid(iid: String) -> String:
	var parts := PackedStringArray()
	if ItemDB.is_equippable(iid):
		var slbl := str(ItemDB.SLOT_LABEL.get(ItemDB.slot_of(iid), ""))
		if ItemDB.is_two_handed(iid):
			slbl += " (2m)"
		if slbl != "":
			parts.append(slbl)
	elif str(ItemDB.get_item(iid).get("cat", "")) == "consumable":
		parts.append("Consumível")
	var sm := ItemDB.stat_summary(iid)
	if sm != "":
		parts.append(sm)
	return "  ·  ".join(parts)

## --- TOOLTIP RPG (GODOT-INVENTORY-TOOLTIPS-LORE-COMPARE-1) ---
## Painel (moldura StyleBoxFlat dourada) + RichTextLabel BBCode (cores por raridade, comparação
## verde/vermelho). Segue o mouse e é mantido DENTRO da tela. Camada 25 (acima de tudo).
func _build_item_tooltip() -> void:
	_tip_layer = CanvasLayer.new()
	_tip_layer.layer = 25
	add_child(_tip_layer)
	_tip_box = PanelContainer.new()
	var sb := StyleBoxFlat.new()
	sb.bg_color = Color(0.06, 0.07, 0.11, 0.98)
	sb.set_border_width_all(2)
	sb.border_color = Color(0.9, 0.78, 0.4, 0.7)
	sb.set_corner_radius_all(7)
	sb.set_content_margin_all(10)
	_tip_box.add_theme_stylebox_override("panel", sb)
	_tip_box.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_tip_layer.add_child(_tip_box)
	_tip_rich = RichTextLabel.new()
	_tip_rich.bbcode_enabled = true
	_tip_rich.fit_content = true
	_tip_rich.scroll_active = false
	_tip_rich.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_tip_rich.custom_minimum_size = Vector2(300, 0)
	_tip_rich.add_theme_font_size_override("normal_font_size", 13)
	_tip_rich.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_tip_box.add_child(_tip_rich)
	_tip_layer.visible = false

## Liga o tooltip a um Control: hover mostra o BBCode `bb`, sair esconde. bb vazio = sem tooltip.
## Usado nos painéis REMONTADOS (mochila/loja/forja) — os Controls são recriados, sem dupla conexão.
func _attach_tip(ctrl: Control, bb: String) -> void:
	if ctrl == null or bb == "":
		return
	ctrl.set_meta("bbtip", bb)
	ctrl.mouse_entered.connect(func(): _tip_show(str(ctrl.get_meta("bbtip", ""))))
	ctrl.mouse_exited.connect(_tip_hide)

func _tip_show(bb: String) -> void:
	if _tip_rich == null or bb == "":
		return
	_tip_rich.text = bb
	_tip_visible = true
	if _tip_layer != null:
		_tip_layer.visible = true
	_position_tip()

func _tip_hide() -> void:
	_tip_visible = false
	if _tip_layer != null:
		_tip_layer.visible = false

## Posiciona o tooltip perto do mouse, clampado DENTRO da tela (flip p/ esquerda/cima se estouraria).
func _position_tip() -> void:
	if not _tip_visible or _tip_box == null:
		return
	var vp := get_viewport_rect().size
	var sz := _tip_box.size
	var mp := get_viewport().get_mouse_position()
	var pos := mp + Vector2(20.0, 18.0)
	if pos.x + sz.x > vp.x - 4.0:
		pos.x = mp.x - sz.x - 14.0
	if pos.y + sz.y > vp.y - 4.0:
		pos.y = vp.y - sz.y - 6.0
	_tip_box.position = Vector2(maxf(4.0, pos.x), maxf(4.0, pos.y))

## BBCode de tooltip de um item por contexto ("inv"/"equip"/"shop_buy"/"shop_sell"/"forge").
func _item_tooltip_bb(id: String, ctx: String) -> String:
	var it := ItemDB.get_item(id)
	var out := "[b][color=#%s]%s[/color][/b]\n" % [ItemDB.rarity_color(id), ItemDB.display_name(id)]
	var typ := ""
	if ItemDB.is_equippable(id):
		typ = str(ItemDB.SLOT_LABEL.get(ItemDB.slot_of(id), ""))
		if ItemDB.is_two_handed(id):
			typ += " (2 mãos)"
	elif str(it.get("cat", "")) == "consumable":
		typ = "Consumível"
	out += "[color=#9aa0ad]%s%s[/color]\n" % [(typ + " · ") if typ != "" else "", ItemDB.rarity_label(ItemDB.rarity(id))]
	var sm := ItemDB.stat_summary(id)
	if sm != "":
		out += "[color=#cfe0d0]%s[/color]\n" % sm
	match ctx:
		"shop_buy": out += "[color=#ffe080]Preço: %d ouro[/color]\n" % ItemDB.price(id)
		"shop_sell": out += "[color=#a9e0b0]Venda: %d ouro[/color]\n" % ItemDB.sell_value(id)
		"forge": out += "[color=#cfe8cf]Forja: %s[/color]\n" % _recipe_cost_text(ItemDB.recipe(id))
		_:
			var sv := ItemDB.sell_value(id)
			if sv > 0:
				out += "[color=#9aa0ad]Vende por %d ouro[/color]\n" % sv
	var lore := str(it.get("desc", ""))
	if lore == "":
		lore = _fallback_lore(id)
	out += "[i][color=#8a8f9a]\"%s\"[/color][/i]" % lore
	if ItemDB.is_equippable(id):
		var slot := ItemDB.slot_of(id)
		if GameState.equipment.has(slot) and str(GameState.equipment[slot]) != id:
			var eq := str(GameState.equipment[slot])
			out += "\n[color=#b8c0c8]vs %s:[/color]  %s" % [ItemDB.display_name(eq), _stat_compare_bb(id, eq)]
	return out

## Comparação de stats (delta) entre dois itens, verde (+) / vermelho (−).
func _stat_compare_bb(id: String, eq: String) -> String:
	var parts := PackedStringArray()
	for k in [["attack", "Atq"], ["defense", "Def"], ["max_hp", "HP"], ["speed", "Vel"], ["magic", "Mag"]]:
		var d := ItemDB.stat(id, str(k[0])) - ItemDB.stat(eq, str(k[0]))
		if d != 0:
			parts.append("[color=#%s]%s %+d[/color]" % ["5fcf80" if d > 0 else "e07a7a", str(k[1]), d])
	if parts.is_empty():
		return "[color=#9aa0ad]mesmos atributos[/color]"
	return "  ".join(parts)

## Lore de fallback por categoria (quando o item não tem `desc`). Seguro, nunca vazio.
func _fallback_lore(id: String) -> String:
	match str(ItemDB.get_item(id).get("cat", "")):
		"weapon": return "Arma da estrada do Errante."
		"offhand": return "Defesa fiel nas mãos do Errante."
		"chest": return "Couraça batida em muitas trilhas."
