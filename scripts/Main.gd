	for fy in [30.0, 64.0, 98.0, 132.0]:   # pegadas saindo (pares, descendo) — densas
		for fx in [-12.0, 10.0]:
			var fp := Polygon2D.new(); fp.polygon = PackedVector2Array([Vector2(0, 0), Vector2(5, 1), Vector2(4, 9), Vector2(-2, 8)]); fp.position = pos + Vector2(fx, fy); fp.color = Color(0.0, 0.0, 0.0, 0.16); fp.z_index = -14; _region_node.add_child(fp)
