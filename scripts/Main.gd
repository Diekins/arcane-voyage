## Boca de raízes negras (visual da passagem aberta p/ o Deep Grove): gruta escura + raízes + pulso frio.
## SÓ apresentação (sem blocker); o transporte é o _build_portal sobreposto. (GODOT-DEEP-GROVE-1)
## Sprite ESTÁVEL de portal/entrada (GODOT-TRANSITION-PORTAL-SPRITES-1): AnimatedSprite2D de 4 quadros
## (128² por quadro) carregado de res://assets/effects/portals/<kind>_portal.png. Centrado no PONTO de
## transição (alinhado), z = nível do chão (atrás do player), loop suave. NÃO mexe em trigger/_portals
## (só o VISUAL). Retorna false se a arte faltar → o chamador cai no visual procedural antigo.
func _add_portal_sprite(pos: Vector2, kind: String) -> bool:
	if _region_node == null:
		return false
	var path := "res://assets/effects/portals/%s_portal.png" % kind
	if not ResourceLoader.exists(path):
		return false
	var tex := load(path) as Texture2D
	if tex == null:
		return false
	var fh := tex.get_height()                    # 128 (lado do quadro)
	var cols := int(tex.get_width() / fh)          # 4 quadros
	if cols < 1:
		return false
	var frames := SpriteFrames.new()
	if frames.has_animation("default"):
		frames.remove_animation("default")
	frames.add_animation("idle")
	frames.set_animation_loop("idle", true)
	frames.set_animation_speed("idle", 6.0)        # pulso lento, sem flicker
	for i in range(cols):
		var at := AtlasTexture.new()
		at.atlas = tex
		at.region = Rect2(i * fh, 0, fh, fh)
		frames.add_frame("idle", at)
	var asp := AnimatedSprite2D.new()
	asp.sprite_frames = frames
	asp.animation = "idle"
	asp.centered = true                            # alinha o quadro 128² no ponto de transição
	asp.position = pos
	asp.z_index = int(pos.y) - 6                   # nível do chão: o player (z=pé) desenha por cima
	asp.play("idle")
	_region_node.add_child(asp)
	return true

func _build_root_mouth(pos: Vector2) -> void:
	if _add_portal_sprite(pos, "root_mouth"):
		return   # sprite estável do pack (GODOT-TRANSITION-PORTAL-SPRITES-1); fallback procedural abaixo
	var node := Node2D.new()
	node.position = pos
	node.z_index = int(pos.y) - 2
	_add_ground_shadow(node, 50.0, 15.0, 6.0)
	var mouth := Polygon2D.new()
	var mp := PackedVector2Array()
	for i in range(18):
		var a := TAU * i / 18.0
		mp.append(Vector2(cos(a) * 62.0, sin(a) * 46.0 - 18.0))
	mouth.polygon = mp
	mouth.color = Color(0.03, 0.04, 0.05, 1.0)
	node.add_child(mouth)
	for i in range(4):   # raízes negras nas bordas (já não selam — passagem aberta)
		var root := ColorRect.new()
		root.size = Vector2(34, 8)
		root.position = Vector2(-62 + i * 30, -50 + (i % 2) * 12)
		root.rotation = (-0.5 if i % 2 == 0 else 0.5)
		root.color = Color(0.09, 0.08, 0.07, 0.96)
		node.add_child(root)
	var pulse := Polygon2D.new()
	var pp := PackedVector2Array()
	for i in range(12):
		var a := TAU * i / 12.0
		pp.append(Vector2(cos(a) * 24.0, sin(a) * 17.0 - 16.0))
	pulse.polygon = pp
	pulse.color = Color(0.34, 0.6, 0.7, 0.26)
	node.add_child(pulse)
	_region_node.add_child(node)

## Monta o Deep Grove / Coração das Raízes Negras (GODOT-DEEP-GROVE-1, mundo 1800x1300): subárea ao
