	# permanece está esperando." Junto à forja (1496,690) e à banca (1560,1100).
	_build_raizes_da_morada()

## ★ A CASA GUARDADA + MAREN (THE_HOMESTEAD_BUILD_01) — a prova da Morada ("o lugar de quem fica"). Um lar mantido
## pronto para um filho que partiu e NÃO volta (sem reencontro/payoff): cama feita, prato posto, porta destrancada,
## vela na janela, soleira cavada, marcas de altura, a chave sob a pedra. Maren cuida dele todo dia. 1 descoberta
## [E] (o interior) + 1 gesto [E] (renovar a vela). Procedural; sem sistema/save/recompensa/economia/reputação.
func _build_casa_guardada(pos: Vector2) -> void:
	var z := int(pos.y)
	var node := Node2D.new(); node.position = pos; node.z_index = z
	_add_ground_shadow(node, 60.0, 16.0, 12.0)
	# corpo da casa (paredes cuidadas, ≠ silhueta vazia) + telhado + porta FECHADA mas conservada
	var body := ColorRect.new(); body.color = Color("b89a6e"); body.size = Vector2(100.0, 70.0); body.position = Vector2(-50.0, -70.0); node.add_child(body)
	var roof := Polygon2D.new(); roof.polygon = PackedVector2Array([Vector2(-60, -66), Vector2(0, -112), Vector2(60, -66)]); roof.color = Color("7a5a3c"); node.add_child(roof)
	var door := ColorRect.new(); door.color = Color("5a4630"); door.size = Vector2(28.0, 40.0); door.position = Vector2(-14.0, -40.0); node.add_child(door)
	var knob := ColorRect.new(); knob.color = Color("caa14a"); knob.size = Vector2(4.0, 4.0); knob.position = Vector2(6.0, -20.0); node.add_child(knob)
	# soleira CAVADA (mil pés; mas faz tempo que só um par passa) — marca de ficar
	var sill := ColorRect.new(); sill.color = Color("6a655a"); sill.size = Vector2(36.0, 9.0); sill.position = Vector2(-18.0, -4.0); node.add_child(sill)
	var sillhollow := ColorRect.new(); sillhollow.color = Color(0.0, 0.0, 0.0, 0.18); sillhollow.size = Vector2(22.0, 5.0); sillhollow.position = Vector2(-11.0, -2.0); node.add_child(sillhollow)
	# MARCAS DE ALTURA no batente (um menino que cresceu até ir embora) — riscos a lápis
	for hy in [-22.0, -30.0, -37.0, -43.0]:
		var tick := Line2D.new(); tick.points = PackedVector2Array([Vector2(-17.0, hy), Vector2(-11.0, hy)]); tick.width = 1.4; tick.default_color = Color(0.25, 0.2, 0.15, 0.8); node.add_child(tick)
	# JANELA com a VELA acesa (a luz da espera) — glow guardado p/ o gesto
	var wframe := ColorRect.new(); wframe.color = Color("4a3a28"); wframe.size = Vector2(26.0, 26.0); wframe.position = Vector2(20.0, -60.0); node.add_child(wframe)
	var wpane := ColorRect.new(); wpane.color = Color("2b2a26"); wpane.size = Vector2(20.0, 20.0); wpane.position = Vector2(23.0, -57.0); node.add_child(wpane)
	var glow := Polygon2D.new(); var gp := PackedVector2Array()
	for i in range(10):
		var a := TAU * float(i) / 10.0
		gp.append(Vector2(cos(a) * 11.0, sin(a) * 11.0))
	glow.polygon = gp; glow.position = Vector2(33.0, -47.0); glow.color = Color(1.0, 0.82, 0.5, 0.55); node.add_child(glow)
	if glow.is_inside_tree():
		var tw := glow.create_tween(); tw.set_loops()
		tw.tween_property(glow, "modulate:a", 0.55, 2.4).set_trans(Tween.TRANS_SINE)
		tw.tween_property(glow, "modulate:a", 1.0, 2.4).set_trans(Tween.TRANS_SINE)
	# floreira ainda cuidada (verde, regada) sob a janela — vida mantida
	var box := ColorRect.new(); box.color = Color("5a4630"); box.size = Vector2(28.0, 7.0); box.position = Vector2(19.0, -34.0); node.add_child(box)
	for fx in [22.0, 28.0, 34.0, 40.0]:
		var sprout := Line2D.new(); sprout.points = PackedVector2Array([Vector2(fx, -34.0), Vector2(fx - 1.0, -42.0)]); sprout.width = 1.6; sprout.default_color = Color(0.36, 0.55, 0.30, 0.9); node.add_child(sprout)
	# banco gasto ao lado da porta (onde Maren senta, todo dia)
	var bench := ColorRect.new(); bench.color = Color("6a5236"); bench.size = Vector2(38.0, 8.0); bench.position = Vector2(34.0, -16.0); node.add_child(bench)
	var bl1 := ColorRect.new(); bl1.color = Color("4a3a26"); bl1.size = Vector2(5.0, 8.0); bl1.position = Vector2(36.0, -8.0); node.add_child(bl1)
	var bl2 := ColorRect.new(); bl2.color = Color("4a3a26"); bl2.size = Vector2(5.0, 8.0); bl2.position = Vector2(64.0, -8.0); node.add_child(bl2)
	# a CHAVE sob a pedra do degrau (descoberta-detalhe)
	var stone := Polygon2D.new(); var sp := PackedVector2Array()
	for i in range(8):
		var a := TAU * float(i) / 8.0
		sp.append(Vector2(cos(a) * 7.0, sin(a) * 5.0))
	stone.polygon = sp; stone.position = Vector2(-30.0, 6.0); stone.color = Color("8a857a"); node.add_child(stone)
	_region_node.add_child(node)
	_add_blocker(Rect2(pos.x - 50.0, pos.y - 14.0, 100.0, 22.0))   # corpo da casa (contorna; porta/janela alcançáveis ao sul)
	# ── MAREN — a Guardadora de uma Casa Vazia (NPC, só fala; sem loja/serviço/recompensa/quest) ──
	_build_villager(pos + Vector2(66.0, -8.0), "npcs/village/elder", "Maren", [
		"Esta casa é do meu filho. Ele pegou a estrada faz… já nem conto os invernos. Eu mantenho tudo no lugar.",
		"Arrumo a cama toda manhã. Ponho um prato na mesa. Deixo a porta destrancada, e a vela acesa na janela.",
		"Não, ele não escreve. O mundo é grande e a gente some nele. Mas se ele voltar — de noite, cansado — vai achar a casa pronta e a luz acesa. Vai saber que era esperado.",
		"Eu não espero que ele volte; isso cansa. Eu só deixo pronto. É diferente — é só o que eu faço, todo dia.",
	], "", false)
	# ── DESCOBERTA [E] — o interior (mostra, não explica): cama feita, prato pra um, marcas, a chave, a soleira ──
	var dmk := Node2D.new(); dmk.position = pos + Vector2(-8.0, 16.0); dmk.z_index = int(pos.y + 16.0)
