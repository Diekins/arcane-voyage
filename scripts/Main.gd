## P2-G — piloto ligado? (const de produção OU override de self-test OU env). OFF = jogo idêntico ao atual.
func _quieting_on() -> bool:
	return QUIETING_PILOT_ENABLED or _quiet_force or OS.has_environment("AV_QUIETING")

## P2-G — VIDA AMBIENTE do Pântano (atmosfera-only). Cria, com primitivas (Polygon2D+Tween, mesmo toolkit do halo/
## horizonte), a vida "de cenário": cintilar sobre as poças, vultos na beira, marolas — e um FIO de vida perto da
## saída (oeste) que NÃO recua (o puxão). NÃO toca mob/recompensa/save. Reseta a permanência (revive ao reentrar).
func _build_quiet_ambient(size: Vector2) -> void:
	_quiet_nodes = []
	_quiet_dwell = 0.0
	_quiet_active = true
	var pools := [Vector2(0.4, 0.55), Vector2(0.7, 0.72), Vector2(0.33, 0.7), Vector2(0.55, 0.4)]
	# 1) CINTILAR sobre as poças (vida pequena — recua PRIMEIRO). P2-I: mais numeroso, um pouco maior/mais nítido e
	# com deriva mais ampla → o MOVIMENTO (o melhor gancho de percepção) e o recuo passam a ter silhueta.
	for pi in range(pools.size()):
		var center := Vector2(size.x * pools[pi].x, size.y * pools[pi].y)
		for k in range(QUIET_MOTES_PER_POOL):
			var off := Vector2(-28.0 + 14.0 * k, -10.0 + 8.0 * (k % 3))
			var dot := _quiet_make_dot(center + off, 4.0, Color(0.90, 0.97, 0.62, 0.72))
			_quiet_drift(dot, 22.0 + 4.0 * k, 1.3 + 0.2 * k)
			_quiet_nodes.append({"node": dot, "onset": QUIET_MOTE_ONSET + float(pi) * 1.5, "base_a": 1.0, "exempt": false})
	# 2) VULTOS na beira (estremecimentos — recuam DEPOIS). P2-I: +2 posições, maiores/mais nítidos, deriva maior.
	var stirs := [Vector2(0.12, 0.3), Vector2(0.88, 0.4), Vector2(0.2, 0.86), Vector2(0.8, 0.84), Vector2(0.5, 0.12), Vector2(0.5, 0.92)]
	for si in range(stirs.size()):
		var sp := Vector2(size.x * stirs[si].x, size.y * stirs[si].y)
		var st := _quiet_make_dot(sp, 5.0, Color(0.55, 0.66, 0.48, 0.52))
		_quiet_drift(st, 16.0, 2.0)
		_quiet_nodes.append({"node": st, "onset": QUIET_STIR_ONSET + float(si) * 1.0, "base_a": 1.0, "exempt": false})
	# 3) MAROLAS nas poças (a água assenta por ÚLTIMO). P2-I: anel maior/mais nítido, pulso mais amplo (legível).
	for pi2 in range(pools.size()):
		var c2 := Vector2(size.x * pools[pi2].x, size.y * pools[pi2].y)
		var ring := _quiet_make_ring(c2, 22.0, Color(0.72, 0.82, 0.88, 0.34))
		_quiet_pulse_scale(ring, 1.0, 1.75, 2.4 + 0.3 * pi2)
		_quiet_nodes.append({"node": ring, "onset": QUIET_RIPPLE_ONSET + float(pi2) * 1.2, "base_a": 1.0, "exempt": false})
	# 4) FIO DE VIDA rumo à SAÍDA (oeste) — NÃO recua (o puxão de "lá ainda se mexe"). P2-I: um pouco mais nítido,
	# para o CONTRASTE com o brejo aquietado ficar perceptível (não mais forte — só visível).
	for fk in range(3):
		var fc := _quiet_make_dot(SWAMP_TO_VILLAGE + Vector2(40.0, -30.0 + 24.0 * fk), 4.0, Color(0.92, 0.97, 0.66, 0.72))
		_quiet_drift(fc, 18.0, 1.3)
		_quiet_nodes.append({"node": fc, "onset": 9999.0, "base_a": 1.0, "exempt": true})

func _quiet_make_dot(pos: Vector2, r: float, col: Color) -> Polygon2D:
	var p := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(8):
		var a := TAU * i / 8.0
		pts.append(Vector2(cos(a) * r, sin(a) * r))
	p.polygon = pts
	p.position = pos
	p.color = col
	p.z_index = -2
	p.set_meta("av_quiet", true)
	_region_node.add_child(p)
	return p

func _quiet_make_ring(pos: Vector2, r: float, col: Color) -> Polygon2D:
	var p := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(18):
		var a := TAU * i / 18.0
		pts.append(Vector2(cos(a) * r, sin(a) * r * 0.55))
	p.polygon = pts
	p.position = pos
	p.color = col
	p.z_index = -3
	p.set_meta("av_quiet", true)
	_region_node.add_child(p)
	return p

## deriva suave (vai-e-volta) — só dentro da árvore (headless/destacado = estático, seguro).
func _quiet_drift(node: Node2D, dist: float, dur: float) -> void:
	if not node.is_inside_tree():
		return
	var base := node.position
	var tw := node.create_tween()
	tw.set_loops()
	tw.tween_property(node, "position", base + Vector2(dist, -dist * 0.5), dur).set_trans(Tween.TRANS_SINE)
	tw.tween_property(node, "position", base, dur).set_trans(Tween.TRANS_SINE)

func _quiet_pulse_scale(node: Node2D, a: float, b: float, dur: float) -> void:
	if not node.is_inside_tree():
		return
	node.scale = Vector2(a, a)
	var tw := node.create_tween()
	tw.set_loops()
	tw.tween_property(node, "scale", Vector2(b, b), dur).set_trans(Tween.TRANS_SINE)
	tw.tween_property(node, "scale", Vector2(a, a), dur).set_trans(Tween.TRANS_SINE)

## P2-G — tick do Aquietar: acumula permanência e faz a vida ambiente recuar (gradual, desigual). O fio da saída
## (exempt) NÃO recua. NÃO toca nada de recompensa/mob/save. No-op fora do piloto/região.
func _quiet_tick(delta: float) -> void:
	if not _quiet_active:
		return
	_quiet_dwell += delta
	for q in _quiet_nodes:
		var node = q["node"]
		if not is_instance_valid(node) or bool(q["exempt"]):
			continue
		var onset: float = float(q["onset"])
		var t: float = clampf((_quiet_dwell - onset) / QUIET_SPAN, 0.0, 1.0)
		var target: float = float(q["base_a"]) * (1.0 - t)
		node.modulate.a = lerpf(node.modulate.a, target, minf(1.0, delta * 2.0))

## Monta o Poço do Ferro-Velho (GODOT-SWAMP-PIT-SUBAREA-1, 1000x800): arena subterrânea pequena com o
## Coloso (único elite) + escada de saída (oeste) que volta ao Pântano PERTO do buraco. Mobs/baús via
## _build_mobs/_build_chests. Visual procedural (_build_shape_map → swamp_pit). Sem boss-system (o
## Coloso é um Mob elite comum). Acesso só pelo buraco do Pântano (que já é gated pela trilha oeste).
func _build_swamp_pit(_size: Vector2) -> void:
	_current_boss = null
	_boss_name = ""
	# saída: escada de volta ao Pântano, surgindo PERTO do buraco (não no spawn principal do Pântano)
	_build_portal(PIT_TO_SWAMP, "swamp", "Escada → subir ao Pântano", true, SWAMP_PIT_ENTRANCE + Vector2(0, -80))
	# ★ A CICATRIZ DO COLOSO (HEART_SCAR_F5 → Pântano) — só após a 1ª derrota (flag): o Poço guarda o monte de ferro
	# que NÃO se ergueu. O brejo remontou o Coloso ao lado; este ferro, não. Consequência, não troféu. Mesmo do Coração.
	if GameState.is_story_flag("colossus_scarred"):
		_pit_colossus_scar(Vector2(550.0, 440.0))

## ★ CICATRIZ DO COLOSO (HEART_SCAR_F5) — só do Coloso/Poço (não framework). Um MONTE de sucata MORTA (ferro-velho
## inerte, enferrujado, SEM o laranja vivo do Coloso): chapas/engrenagens/vigas amontoadas que o brejo não voltou a
## erguer + uma poça de lodo PARADA. SEM texto/UI/pop-up/recompensa/contador. Tudo `av_colossus_scar`.
func _pit_colossus_scar(pos: Vector2) -> void:
	# a poça de lodo parada (o brejo "desistiu" deste ponto)
	var mud := Polygon2D.new(); var mp := PackedVector2Array()
	for i in range(12):
		var a := TAU * float(i) / 12.0
		mp.append(Vector2(cos(a) * (60.0 + float(i % 3) * 10.0), sin(a) * 30.0))
	mud.polygon = mp; mud.position = pos + Vector2(0, 18); mud.color = Color(0.10, 0.10, 0.08, 0.8); mud.z_index = int(pos.y) - 2; mud.set_meta("av_colossus_scar", true); _region_node.add_child(mud)
	# o MONTE de ferro-velho inerte (peças mortas amontoadas; cinza-ferrugem, sem brilho)
	var heap := Polygon2D.new(); heap.polygon = PackedVector2Array([pos + Vector2(-66, 24), pos + Vector2(-34, -34), pos + Vector2(2, -10), pos + Vector2(34, -40), pos + Vector2(60, 8), pos + Vector2(30, 30), pos + Vector2(-30, 30)]); heap.color = Color("3a332a"); heap.z_index = int(pos.y) - 1; heap.set_meta("av_colossus_scar", true); _region_node.add_child(heap)
	# chapas/vigas tombadas (retângulos enferrujados, inclinados)
	for d in [Vector2(-40, 6), Vector2(8, -2), Vector2(40, 12)]:
		var plate := ColorRect.new(); plate.color = Color("4a4036"); plate.size = Vector2(44.0, 12.0); plate.position = pos + d + Vector2(-22, -6); plate.rotation = (d.x * 0.004); plate.z_index = int(pos.y); plate.set_meta("av_colossus_scar", true); _region_node.add_child(plate)
		var rust := ColorRect.new(); rust.color = Color(0.5, 0.3, 0.16, 0.4); rust.size = Vector2(44.0, 4.0); rust.position = pos + d + Vector2(-22, 0); rust.rotation = (d.x * 0.004); rust.z_index = int(pos.y) + 1; rust.set_meta("av_colossus_scar", true); _region_node.add_child(rust)
	# uma engrenagem meio-enterrada e PARADA (a marca; eco da Engrenagem Morta do Pântano) — sem girar
	var gear := Polygon2D.new(); var gp := PackedVector2Array()
	for k in range(14):
		var a := TAU * float(k) / 14.0
		var rr: float = 24.0 if k % 2 == 0 else 17.0
		gp.append(Vector2(cos(a) * rr, sin(a) * rr * 0.8))
	gear.polygon = gp; gear.position = pos + Vector2(28, 26); gear.color = Color("443a30"); gear.z_index = int(pos.y) + 2; gear.set_meta("av_colossus_scar", true); _region_node.add_child(gear)

