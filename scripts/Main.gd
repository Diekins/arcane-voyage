	_build_stone_arrival(size)

## THE_STONE_BUILD_01 — A CHEGADA À PEDRA: o único lugar de Khet-Sar que o deserto não engole. Materializa SÓ a
## chegada (a Pedra é VISTA, não conquistada): o PAREDÃO que domina e sobe além da tela ("olhar pra cima"); SINAIS DE
## VIDA no alto (terraços, moradias, janelas acesas, fumaça) — sem NPC/interação, só EVIDÊNCIA de ocupação; o ECO
## (assinatura sonora: o som volta — única região onde o deserto responde); e um BLOCKER no pé (a subida ainda não
## existe). Sem povo/serviço/comércio/facção/subida. Continuação FÍSICA das Dunas (mesma região, sem teleporte).
func _build_stone_arrival(size: Vector2) -> void:
	var foot_y := 360.0
	var west := 1600.0
	var east := size.x   # 2400
	# (0) TRILHA que puxa o olhar/pés pro NE — some indo pra rocha (o caminho leva à Pedra)
	for i in range(6):
		var seg := Polygon2D.new()
		var sx := 1440.0 + float(i) * 95.0
		var sy := 520.0 - float(i) * 24.0
		seg.polygon = PackedVector2Array([Vector2(-44, -9), Vector2(44, -9), Vector2(40, 9), Vector2(-40, 9)])
		seg.position = Vector2(sx, sy); seg.color = Color(0.6, 0.5, 0.36, clampf(0.26 - float(i) * 0.03, 0.04, 0.26)); seg.z_index = -10
		_region_node.add_child(seg)
	# (1) APRON — a areia AFINA e a rocha-mãe AFLORA no pé (transição visual sand→bedrock)
	var apron := Polygon2D.new()
	apron.polygon = PackedVector2Array([Vector2(1560, 620), Vector2(east, 600), Vector2(east, 300), Vector2(1600, 320), Vector2(1560, 440)])
	apron.color = Color(0.62, 0.46, 0.30, 0.40); apron.z_index = -9
	_region_node.add_child(apron)
	# (2) O PAREDÃO — sobe MUITO acima da tela (topo nunca cabe = "mais alto que tudo"). Camadas p/ volume.
	var ridge := Polygon2D.new()   # cumeeira ao fundo (mais clara/distante)
	ridge.polygon = PackedVector2Array([Vector2(west, foot_y), Vector2(east, foot_y), Vector2(east, -180), Vector2(2230, -300), Vector2(2040, -210), Vector2(1850, -360), Vector2(1690, -240), Vector2(west, -120)])
	ridge.color = Color("b58a55"); ridge.z_index = -8
	_region_node.add_child(ridge)
	var face := Polygon2D.new()   # face principal (mais escura/quente que a areia → "isto é diferente, mais antigo")
	face.polygon = PackedVector2Array([Vector2(west, foot_y), Vector2(east, foot_y), Vector2(east, -120), Vector2(2280, -200), Vector2(2150, -110), Vector2(2010, -250), Vector2(1880, -140), Vector2(1740, -270), Vector2(1660, -150), Vector2(west, -30)])
	face.color = Color("8f6238"); face.z_index = -7; face.set_meta("av_stone", true)
	_region_node.add_child(face)
	var sun := Polygon2D.new()   # facet iluminada (luz rasante na parte alta-oeste) → relevo
	sun.polygon = PackedVector2Array([Vector2(1660, -150), Vector2(1880, -140), Vector2(2010, -250), Vector2(1850, -360), Vector2(1690, -240)])
	sun.color = Color(0.78, 0.6, 0.36, 0.5); sun.z_index = -6
	_region_node.add_child(sun)
	for cx in [1820.0, 2080.0, 2300.0]:   # cânions/recessos verticais escuros (escala + fendas habitáveis)
		var rec := Polygon2D.new()
		rec.polygon = PackedVector2Array([Vector2(cx - 22, foot_y), Vector2(cx + 22, foot_y), Vector2(cx + 14, -120), Vector2(cx - 14, -120)])
		rec.color = Color(0.0, 0.0, 0.0, 0.20); rec.z_index = -6
		_region_node.add_child(rec)
	for sy2 in [220.0, 130.0, 40.0, -60.0, -160.0]:   # ESTRATOS de erosão (rocha sedimentar = antiga)
		var band := Line2D.new()
		band.points = PackedVector2Array([Vector2(west, sy2), Vector2(1900, sy2 - 10.0), Vector2(2150, sy2 + 8.0), Vector2(east, sy2 - 6.0)])
		band.width = 2.2; band.default_color = Color(0.0, 0.0, 0.0, 0.16); band.z_index = -5
		_region_node.add_child(band)
	# (3) SINAIS DE VIDA NO ALTO — só EVIDÊNCIA (sem NPC/interação): terraços escavados + moradias + janelas acesas
	# y BEM no alto (<60 = acima do alcance do jogador 60px e ALÉM do limiar fechado da subida em y~92): as casas
	# são VISTAS do mirante, nunca alcançadas (THE_STONE_BUILD_02 mantém a chegada aos habitantes fechada).
	var terr_band := [Vector2(1880.0, 52.0), Vector2(1990.0, 22.0), Vector2(2110.0, 46.0), Vector2(2210.0, 16.0), Vector2(2310.0, 40.0)]
	for t in terr_band:
		var ledge := ColorRect.new()   # terraço (plataforma escavada)
		ledge.color = Color("c2a368"); ledge.size = Vector2(72.0, 11.0); ledge.position = t; ledge.z_index = -4; ledge.set_meta("av_stone", true)
		_region_node.add_child(ledge)
		var lip := ColorRect.new()   # sombra sob o terraço (volume)
		lip.color = Color(0.0, 0.0, 0.0, 0.22); lip.size = Vector2(72.0, 5.0); lip.position = t + Vector2(0.0, 11.0); lip.z_index = -4
		_region_node.add_child(lip)
		var home := ColorRect.new()   # vão escuro (moradia escavada na rocha)
		home.color = Color("241a10"); home.size = Vector2(16.0, 20.0); home.position = t + Vector2(12.0, -20.0); home.z_index = -3
		_region_node.add_child(home)
	for w in [Vector2(1900.0, 44.0), Vector2(2126.0, 30.0), Vector2(2228.0, 12.0), Vector2(2042.0, 24.0)]:   # JANELAS ACESAS (alguém está lá AGORA), bem no alto
		var glow := Polygon2D.new()
		var gp := PackedVector2Array()
		for i in range(14):
			var a := TAU * float(i) / 14.0
			gp.append(Vector2(cos(a) * 9.0, sin(a) * 7.0))
		glow.polygon = gp; glow.position = w; glow.color = Color(1.0, 0.82, 0.46, 0.55); glow.z_index = -2; glow.set_meta("av_stone_window", true)
		_region_node.add_child(glow)
		var core := ColorRect.new(); core.color = Color(1.0, 0.88, 0.6, 0.85); core.size = Vector2(6.0, 8.0); core.position = w + Vector2(-3.0, -4.0); core.z_index = -2
		_region_node.add_child(core)
	# (4) FUMAÇA — fios finos subindo do alto (vida), com deriva LENTA (único movimento, fora o jogador)
	for sp in [Vector2(1996.0, 22.0), Vector2(2218.0, 16.0)]:
		var smoke := Polygon2D.new()
		smoke.polygon = PackedVector2Array([Vector2(-5, 0), Vector2(5, 0), Vector2(8, -70), Vector2(2, -150), Vector2(-3, -150), Vector2(-9, -70)])
		smoke.position = sp; smoke.color = Color(0.82, 0.79, 0.74, 0.16); smoke.z_index = -2; smoke.set_meta("av_stone", true)
		_region_node.add_child(smoke)
		if smoke.is_inside_tree():
			var tw := smoke.create_tween()
			tw.set_loops()
			tw.tween_property(smoke, "modulate", Color(1, 1, 1, 1.5), 5.5).set_trans(Tween.TRANS_SINE)
			tw.parallel().tween_property(smoke, "position:x", sp.x + 14.0, 5.5).set_trans(Tween.TRANS_SINE)
			tw.tween_property(smoke, "modulate", Color(1, 1, 1, 0.4), 5.5).set_trans(Tween.TRANS_SINE)
			tw.parallel().tween_property(smoke, "position:x", sp.x - 6.0, 5.5).set_trans(Tween.TRANS_SINE)
	# (5) TALUS — pedregulho onde a rocha encontra a areia (cada um já bloqueia)
	_add_dry_rock(Vector2(1700.0, 410.0), 30.0)
	_add_dry_rock(Vector2(1980.0, 420.0), 26.0)
	_add_dry_rock(Vector2(2230.0, 408.0), 34.0)
	_add_dry_rock(Vector2(2120.0, 440.0), 20.0)
	# (6) A SUBIDA (THE_STONE_BUILD_02) — trilha FÍSICA escavada no paredão (zigue-zague), com brecha no pé.
	# Conquista por TRAVESSIA, não combate. Sem teleporte/portal: o jogador anda pra cima e GANHA VISÃO.
	_build_stone_ascent(foot_y, west, east)
	# (7) O ECO — assinatura sonora da região (o som VOLTA; única parte de Khet-Sar onde o deserto responde)
	_build_stone_echo(Vector2(2050.0, 470.0))
	# (8) O FUNDO (THE_STONE_BUILD_06) — a Cisterna e o Arquivo dos Nomes: o CORAÇÃO da Pedra, escavado no leito de
	# rocha ao pé (DESCE, não sobe). Água + nomes = memória guardada. Same-level (nv0), UM cômodo, identidade pura.
	_build_stone_cistern(foot_y, west, east)

## THE_STONE_BUILD_02 — A SUBIDA: a 1ª travessia VERTICAL de Arcane Voyage. Trilha escavada no paredão em ZIGUE-ZAGUE
## (3 paredes alternando a brecha oeste→leste→oeste = o jogador serpenteia e SOBE), com brecha no pé (trailhead).
## Conquista por TRAVESSIA, não combate. Física e contínua (sem teleporte/portal/troca). Ao subir o jogador GANHA
## VISÃO (a câmera, limitada às bordas, encaixa no topo e mostra as dunas LÁ EMBAIXO = "agora vejo o que eles veem").
## Caminho moldado por GERAÇÕES (degraus gastos, cairns, patamares — NÃO estrada/obra da Cidade). O LIMIAR no topo é
## FECHADO (parede cheia + cleft + fresta de luz quente): o mirante é alcançável; os habitantes, ainda não.
func _stone_wall_block(r: Rect2) -> void:
	var rock := ColorRect.new(); rock.color = Color("6f4d2c"); rock.size = r.size; rock.position = r.position
	rock.z_index = int(r.position.y + r.size.y); rock.set_meta("av_stone_ascent", true)
	_region_node.add_child(rock)
	var top := ColorRect.new(); top.color = Color(0.74, 0.58, 0.35, 0.7); top.size = Vector2(r.size.x, 4.0); top.position = r.position
	top.z_index = int(r.position.y + r.size.y); _region_node.add_child(top)
	var sh := ColorRect.new(); sh.color = Color(0.0, 0.0, 0.0, 0.22); sh.size = Vector2(r.size.x, 6.0); sh.position = r.position + Vector2(0.0, r.size.y)
	sh.z_index = int(r.position.y + r.size.y); _region_node.add_child(sh)
	_add_blocker(r)

func _build_stone_ascent(foot_y: float, west: float, east: float) -> void:
	_vertical_mode = true   # VERTICALITY FASE 3: a Pedra tem andar real. Base = plano legado (nível 0); mirante = contêiner nível 1.
	var fb := foot_y - 28.0
	# brecha no PÉ (trailhead): divide o blocker do pé em dois, deixando a entrada da trilha (x2010..2090)
	_add_blocker(Rect2(west, fb, 410.0, 44.0))            # pé OESTE (x1600..2010)
	_add_blocker(Rect2(2090.0, fb, east - 2090.0, 44.0))  # pé LESTE (x2090..2400)
	# CAMPO da trilha (rocha lavrada clara) — o chão da subida; as paredes de rocha vêm por cima
	var field := ColorRect.new(); field.color = Color("c2a86e"); field.position = Vector2(1660.0, 78.0)
	field.size = Vector2(680.0, foot_y - 78.0); field.z_index = -4; field.set_meta("av_stone_ascent", true)
	_region_node.add_child(field)
	# margens externas sólidas (não dá pra contornar a trilha)
	_stone_wall_block(Rect2(1600.0, 86.0, 60.0, 246.0))
	_stone_wall_block(Rect2(2340.0, 86.0, 60.0, 246.0))
	# ZIGUE-ZAGUE — 3 paredes alternando a brecha; o ponto-pé do jogador serpenteia e sobe
	_stone_wall_block(Rect2(1900.0, 286.0, 440.0, 26.0))   # parede 1 → brecha OESTE
	_stone_wall_block(Rect2(1660.0, 220.0, 460.0, 26.0))   # parede 2 → brecha LESTE
	_stone_wall_block(Rect2(1880.0, 152.0, 460.0, 26.0))   # parede 3 → brecha OESTE
	# (o LIMIAR FECHADO + o mirante agora são NÍVEL 1 = terraço real; construídos no fim, em contêiner próprio)
	# DEGRAUS gastos por GERAÇÕES nas pernas verticais (não é estrada/obra da Cidade)
	for leg in [[1700.0, 1860.0, 252.0, 308.0], [2140.0, 2320.0, 182.0, 240.0], [1700.0, 1860.0, 116.0, 174.0]]:
		var x0: float = leg[0]; var x1: float = leg[1]; var y0: float = leg[2]; var y1: float = leg[3]
		for s in range(5):
			var t := float(s) / 4.0
			var st := Line2D.new()
			var sy := lerpf(y1, y0, t)
			st.points = PackedVector2Array([Vector2(x0, sy), Vector2(x1, sy + 6.0)])
			st.width = 3.0; st.default_color = Color(0.0, 0.0, 0.0, 0.16); st.z_index = -3
			_region_node.add_child(st)
	# PATAMARES (descansos) nas curvas + pequenos cairns gastos (SEM texto)
	for land in [Vector2(1760.0, 320.0), Vector2(2230.0, 234.0), Vector2(1770.0, 166.0), Vector2(2000.0, 132.0)]:
		var pad := ColorRect.new(); pad.color = Color("d2bb83"); pad.size = Vector2(72.0, 28.0); pad.position = land - Vector2(36.0, 14.0)
		pad.z_index = -3; pad.set_meta("av_stone_ascent", true); _region_node.add_child(pad)
		var cairn := Polygon2D.new()
		cairn.polygon = PackedVector2Array([Vector2(-8, 8), Vector2(-5, -4), Vector2(0, -14), Vector2(5, -4), Vector2(8, 8)])
		cairn.position = land + Vector2(26.0, -2.0); cairn.color = Color("8a6a40"); cairn.z_index = int(land.y)
		_region_node.add_child(cairn)
	# ALTURA: fina bruma fria sobre o trecho alto (ar rarefeito/fresco) — nível 0 (atmosfera da subida)
	var haze := Polygon2D.new()
	haze.polygon = PackedVector2Array([Vector2(1680, 86), Vector2(2320, 86), Vector2(2300, 180), Vector2(1700, 180)])
	haze.color = Color(0.7, 0.8, 0.92, 0.07); haze.z_index = -2; _region_node.add_child(haze)
	# ── SINAIS DE ALTURA NO PLANO BASE (NÍVEL 0) — VERTICALITY_FEEL_PASS_01 ────────────────────────────────────
	# Desenhados no _region_node (z=int(y) → acima do chão da subida, ABAIXO do terraço z=2000). Fazem a base
	# "sustentar" o terraço e a subida ter começo→meio→fim. SEM blocker (a brecha segue andável).
	# (a) SOMBRA PROJETADA do terraço sobre a base (a beira do alto escurece o chão logo abaixo = "tem coisa em cima")
	var cast_sh := ColorRect.new(); cast_sh.color = Color(0.0, 0.0, 0.0, 0.22)
	cast_sh.position = Vector2(1660.0, 158.0); cast_sh.size = Vector2(680.0, 30.0); cast_sh.z_index = 157
	cast_sh.set_meta("av_stone_ascent", true); _region_node.add_child(cast_sh)
	# (b) PAREDE DE APOIO sob o parapeito (rocha mais escura + estratos verticais = o terraço se ergue sobre isto)
	var prop := ColorRect.new(); prop.color = Color("6a4d2c")
	prop.position = Vector2(1880.0, 158.0); prop.size = Vector2(460.0, 50.0); prop.z_index = 200
	prop.set_meta("av_stone_ascent", true); _region_node.add_child(prop)
	for sx in [1960.0, 2060.0, 2160.0, 2260.0]:
		var strat := Line2D.new(); strat.points = PackedVector2Array([Vector2(sx, 160.0), Vector2(sx - 4.0, 204.0)])
		strat.width = 2.0; strat.default_color = Color(0.0, 0.0, 0.0, 0.20); strat.z_index = 201; _region_node.add_child(strat)
	# (c) A escada física (chute) é construída no FIM (_build_stair_chute) — corredor estreito x1730..1810 c/ paredes
	# que fecham o resto do vão (só se sobe/desce pela escada; nada de "lado errado"). Aqui ficam só sombra + apoio.
	# ── O MIRANTE É UM TERRAÇO REAL (NÍVEL 1) — VERTICALITY FASE 3 ──────────────────────────────────────────────
	# Contêiner do andar 1, z ALTO (acima do plano legado base, cujo z=int(y) vai até ~size.y). y_sort interno.
	var terr := _floor_container(1, STONE_TERRACE_Z)
	var deck := ColorRect.new()   # PISO elevado real do terraço (superfície, não cenário)
	deck.color = Color("b29463"); deck.position = Vector2(1660.0, 104.0); deck.size = Vector2(680.0, 52.0)
	deck.z_index = -2; deck.z_as_relative = true; deck.set_meta("av_stone_terrace", true); terr.add_child(deck)
	var deck_edge := ColorRect.new()   # sombra na beira sul (volume = "isto está alto")
	deck_edge.color = Color(0.0, 0.0, 0.0, 0.22); deck_edge.position = Vector2(1660.0, 156.0); deck_edge.size = Vector2(680.0, 8.0)
	deck_edge.z_index = -2; deck_edge.z_as_relative = true; terr.add_child(deck_edge)
	# PARAPEITO SUL (a beira) — blocker NÍVEL 1, com BRECHA a oeste (x1660..1880) = a única entrada (a escada)
	for px in [1900.0, 2000.0, 2100.0, 2200.0, 2300.0]:
		var rim := ColorRect.new(); rim.color = Color("7c5a34"); rim.size = Vector2(56.0, 12.0); rim.position = Vector2(px, 150.0)
		rim.z_index = 0; rim.z_as_relative = true; terr.add_child(rim)
	_add_blocker(Rect2(1880.0, 150.0, 460.0, 12.0), 1)   # parapeito S (nv1); a oeste fica a brecha da escada
	_add_blocker(Rect2(1652.0, 104.0, 16.0, 52.0), 1)    # borda OESTE do terraço (nv1)
	_add_blocker(Rect2(2332.0, 104.0, 16.0, 52.0), 1)    # borda LESTE do terraço (nv1)
	# LIMIAR FECHADO (casas LOGO ALÉM) — blocker NÍVEL 1 + visual no terraço; o mirante é alcançável, os habitantes não
	var th_vis := ColorRect.new(); th_vis.color = Color("6f4d2c"); th_vis.position = Vector2(1660.0, 96.0); th_vis.size = Vector2(680.0, 18.0)
