## Variação de chão da Caverna: tiles ALTERNATIVOS (cave_floor2, com glints cianos) salpicados e
## ALINHADOS À GRADE de 64 — leem como variação natural do piso, NÃO como mancha/overlay translúcido.
## Posições ESTÁVEIS (passo φ; não tremem no reload). z entre o piso-base e a decoração.
func _scatter_cave_floor_patches(size: Vector2) -> void:
	var tex := _try_load_tex("res://assets/tilesets/cave/cave_floor2.png")
	if tex == null:
		return
	var cols := int(size.x / 64.0)
	var rows := int(size.y / 64.0)
	var fx := 0.137
	var fy := 0.561
	for i in range(16):
		fx = fmod(fx + 0.6180339887498949, 1.0)
		fy = fmod(fy + 0.3819660112501051, 1.0)
		var gx := 1 + int(fx * float(cols - 2))
		var gy := 1 + int(fy * float(rows - 2))
		_place_floor_tile(tex, Vector2(gx * 64, gy * 64))
		if fmod(fx + fy, 1.0) > 0.66 and gx + 1 < cols - 1:   # ~1/3: tile vizinho = aglomerado orgânico
			_place_floor_tile(tex, Vector2((gx + 1) * 64, gy * 64))

func _place_floor_tile(tex: Texture2D, pos: Vector2) -> void:
	var s := Sprite2D.new()
	s.texture = tex
	s.centered = false
	s.position = pos
	s.z_index = -19
	_region_node.add_child(s)

## Micro-detalhe de chão: pedrinhas, rachaduras e um leve musgo — POUCOS e bem espalhados (estável
## via φ). Quebram a repetição e suavizam a borda dura (z acima da moldura) SEM virar overlay.
func _scatter_cave_ground_detail(size: Vector2) -> void:
	var f := 0.211
	for i in range(20):
		f = fmod(f + 0.6180339887498949, 1.0)
		var g := fmod(f * 1.6180339887498949, 1.0)
		var pos := Vector2(40.0 + f * (size.x - 80.0), 40.0 + g * (size.y - 80.0))
		match i % 5:
			0:
				_add_crack(pos, 26.0 + g * 22.0, f * TAU)
			1:
				_add_pebble(pos, 5.0 + g * 4.0, Color(0.20, 0.23, 0.28, 0.9))
				_add_pebble(pos + Vector2(9, 4), 3.0 + f * 3.0, Color(0.16, 0.18, 0.22, 0.85))
			3:
				_add_floor_glow(pos, 10.0 + g * 8.0, Color(0.30, 0.45, 0.34, 0.10))   # musgo fraco
			_:
				_add_pebble(pos, 4.0 + f * 4.0, Color(0.22, 0.25, 0.30, 0.85))

func _add_pebble(pos: Vector2, r: float, col: Color) -> void:
	var poly := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(10):
		var a := TAU * i / 10.0
		pts.append(Vector2(cos(a) * r, sin(a) * r * 0.66))
	poly.polygon = pts
	poly.position = pos
	poly.color = col
	poly.z_index = -16
	_region_node.add_child(poly)

func _add_crack(pos: Vector2, length: float, ang: float) -> void:
	var dirv := Vector2(cos(ang), sin(ang) * 0.6)
	var perp := Vector2(-dirv.y, dirv.x)
	var line := Line2D.new()
	line.width = 2.0
	line.default_color = Color(0.04, 0.05, 0.07, 0.5)
	line.joint_mode = Line2D.LINE_JOINT_ROUND
	line.points = PackedVector2Array([
		pos - dirv * length * 0.5,
		pos + perp * 4.0,
		pos + dirv * length * 0.5 - perp * 3.0,
	])
	line.z_index = -16
	_region_node.add_child(line)

## Disco de luz/halo BAIXO e achatado (perspectiva de chão), sem shader — usado em arena/musgo/saída.
func _add_floor_glow(pos: Vector2, radius: float, col: Color) -> void:
	# CATHEDRAL_CLEANUP_PACK_04: glow suave (alpha real, modulado) se existir; senão a elipse Polygon2D (fallback).
	var glow_tex := _try_load_tex("res://assets/fx/cold_floor_glow.png")
	if glow_tex != null:
		var s := Sprite2D.new(); s.texture = glow_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
		s.modulate = col; var sc := radius / 64.0; s.scale = Vector2(sc, sc); s.position = pos; s.z_index = -16
		_region_node.add_child(s)
		return
	var poly := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(24):
		var a := TAU * i / 24.0
		pts.append(Vector2(cos(a) * radius, sin(a) * radius * 0.6))
	poly.polygon = pts
	poly.position = pos
	poly.color = col
	poly.z_index = -16
	_region_node.add_child(poly)

## ★ LAYER DE CURIOSIDADE (GODOT-WORLD-CURIOSITY-LAYER-1): marco ambiental NÃO-bloqueante. É, ao mesmo tempo:
## PONTO DE INTERESSE (interagível), OBJETO desgastado (sinal de história anterior), GANCHO/CURIOSIDADE (texto que
## aponta p/ além + faz uma PERGUNTA). Reusa `_services` kind "future_exit" → `_use_future_exit` só mostra texto,
## NÃO transporta, sem flag/save. visual_kind desenhado só com primitivas (sem blocker). NÃO revela lore preservada.
func _add_lore_marker(pos: Vector2, visual_kind: String, prompt_txt: String, title: String, lines: Array, glow := false) -> void:
	var node := Node2D.new()
	node.position = pos
	node.z_index = int(pos.y)   # y-sort (em macro vira grupo z=0 pelo reset da zona)
	# P0.6 — PRESENÇA AMBIENTE: TODO marco/micro-história ganha um halo discreto que "respira" (pulso lento), para o
	# olhar perceber À DISTÂNCIA que há algo ali para observar — sem ícone de mapa / quest / recompensa. Os marcos
	# "estranhos" (glow=true) mantêm o AZUL FRIO (mais notável = "algo estranho aqui"); os demais, um ÂMBAR quente
	# bem sutil (= "alguém esteve aqui"). Reusa Polygon2D + Tween já existentes; nenhum sistema novo.
	var halo := Polygon2D.new()
	var gp := PackedVector2Array()
	for i in range(20):
		var a := TAU * i / 20.0
		gp.append(Vector2(cos(a) * 32.0, sin(a) * 19.0 + 2.0))
	halo.polygon = gp
	halo.color = Color(0.45, 0.7, 0.85, 0.16) if glow else Color(0.95, 0.78, 0.45, 0.12)
	halo.z_index = -1
	node.add_child(halo)
	_draw_weathered_marker(node, visual_kind)
	# prompt [E] mais LEGÍVEL: contorno escuro (lê em qualquer chão), fonte um pouco maior, ✦ como "olhe aqui".
	var prompt := Label.new()
	prompt.text = "✦ [E] " + prompt_txt
	prompt.position = Vector2(-80.0, -100.0)
	prompt.modulate = Color("ffe6b0")
	prompt.add_theme_font_size_override("font_size", 15)
	prompt.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.95))
	prompt.add_theme_constant_override("outline_size", 6)
	prompt.visible = false
	node.add_child(prompt)
	_tag_on_top(prompt)
	_region_node.add_child(node)
	# pulso lento do halo (respiração) — só DENTRO da árvore; headless/destacado sem árvore = halo estático (seguro).
	var pt: Tween = null
	if node.is_inside_tree():
		pt = node.create_tween()
		pt.set_loops()
		pt.tween_property(halo, "modulate:a", 0.45, 1.7).set_trans(Tween.TRANS_SINE)
		pt.tween_property(halo, "modulate:a", 1.0, 1.7).set_trans(Tween.TRANS_SINE)
	# "halo"/"pulse" guardados p/ o P0.1 ASSENTAR o marco ao ser observado (rastro, não prêmio).
	_services.append({
		"node": node, "prompt": prompt, "pos": pos, "kind": "future_exit",
		"id": "curio_" + str(title).to_lower().replace(" ", "_"), "title": title, "msg": lines,
		"halo": halo, "pulse": pt,
	})

## MICRO-HISTÓRIA "A Lamparina de Oren" (GODOT-MICRO-STORY-OREN-1) — Vila. PASSIVA (lamparina sempre acesa num canto
## quieto + Lina, a filha que espera) → o jogador entende que alguém viveu/espera aqui mesmo sem interagir. GANHA
## PROFUNDIDADE ao investigar (falar com Lina + [E] na rede). SÓ sistemas existentes (NPC `_build_villager` + cenário
## em primitivas + `_add_lore_marker`/future_exit = só texto). SEM reward/XP/loot/flag/save/quest/cutscene.
