## cristal angular frio da Catedral (forma/cor de profundidade; NÃO loot). Pulsa leve se na árvore. z por y.
func _cath_crystal(pos: Vector2, h: float, col: Color) -> Node2D:
	# CATHEDRAL_CLEANUP_PACK_04: sprite de cristal (modulado por `col` → arte clara/branca) escalado por h se existir;
	# senão o Polygon2D triangular (fallback). O pulso (modulate:a) segue por código sobre o nó que for.
	var node: Node2D
	var shard_tex := _try_load_tex("res://assets/tilesets/cathedral_of_crystal/props/crystal_shard.png")
	if shard_tex != null:
		var s := Sprite2D.new(); s.texture = shard_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.modulate = col
		var sc := h / 96.0   # native 64x96 (altura de referência 96)
		s.scale = Vector2(sc, sc); s.offset = Vector2(0.0, -48.0)   # base do cristal na origem (pos)
		s.position = pos; s.z_index = int(pos.y)
		s.set_meta("av_cathedral", true); _region_node.add_child(s); node = s
	else:
		var p := Polygon2D.new()
		p.polygon = PackedVector2Array([
			Vector2(-h * 0.26, 0.0), Vector2(-h * 0.10, -h * 0.72), Vector2(h * 0.06, -h),
			Vector2(h * 0.20, -h * 0.5), Vector2(h * 0.30, 0.0),
		])
		p.position = pos; p.color = col; p.z_index = int(pos.y)
		p.set_meta("av_cathedral", true); _region_node.add_child(p); node = p
	if node.is_inside_tree():
		var tw := node.create_tween(); tw.set_loops()
		tw.tween_property(node, "modulate:a", 0.72, 2.4).set_trans(Tween.TRANS_SINE)
		tw.tween_property(node, "modulate:a", 1.0, 2.4).set_trans(Tween.TRANS_SINE)
	return node

## disco baixo de luz fria no chão (held light). z baixo.
func _cath_glow(pos: Vector2, r: float, col: Color) -> void:
	# CATHEDRAL_CLEANUP_PACK_04: glow suave (gradiente radial com alpha real, modulado por col) se existir; senão a
	# elipse Polygon2D chapada (fallback). Native 128x72 → escala por r/64.
	var glow_tex := _try_load_tex("res://assets/fx/cold_floor_glow.png")
	if glow_tex != null:
		var s := Sprite2D.new(); s.texture = glow_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
		s.modulate = col; var sc := r / 64.0; s.scale = Vector2(sc, sc); s.position = pos; s.z_index = -16
		s.set_meta("av_cathedral", true); _region_node.add_child(s)
		return
	var poly := Polygon2D.new(); var pts := PackedVector2Array()
	for i in range(20):
		var a := TAU * float(i) / 20.0
		pts.append(Vector2(cos(a) * r, sin(a) * r * 0.5))
	poly.polygon = pts; poly.position = pos; poly.color = col; poly.z_index = -16
	poly.set_meta("av_cathedral", true); _region_node.add_child(poly)

## COLUNA-cristal (cobertura): base sólida (blocker pequeno) + aglomerado alto de shards (2.5D). A unidade de
## cobertura da Catedral (define a Ala Norte e o gargalo da Nave). z por y.
func _cath_column(pos: Vector2, scl := 1.0) -> void:
	_cath_glow(pos + Vector2(0.0, 8.0), 30.0 * scl, Color(0.40, 0.66, 0.90, 0.10))
	var base := ColorRect.new(); base.color = Color("232a3a"); base.size = Vector2(48.0 * scl, 26.0 * scl); base.position = pos + Vector2(-24.0 * scl, -13.0 * scl); base.z_index = int(pos.y) - 1; _region_node.add_child(base)
	# CRISTAIS da coluna (LANDMARKS_PACK_02): sprite real (escala por scl) se existir; senão o procedural. A base
	# (slab) e o blocker abaixo seguem por código (cobertura/colisão).
	var col_tex := _try_load_tex("res://assets/tilesets/cathedral_of_crystal/props/crystal_column.png")
	if col_tex != null:
		var cs := Sprite2D.new(); cs.texture = col_tex; cs.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		cs.scale = Vector2(scl, scl); cs.position = pos + Vector2(0.0, -87.0 * scl); cs.z_index = int(pos.y); _region_node.add_child(cs)
	else:
		_cath_crystal(pos + Vector2(-6.0 * scl, 2.0), 86.0 * scl, Color(0.46, 0.72, 0.94, 0.85))
		_cath_crystal(pos + Vector2(12.0 * scl, 4.0), 64.0 * scl, Color(0.40, 0.64, 0.90, 0.8))
		_cath_crystal(pos + Vector2(0.0, 6.0), 50.0 * scl, Color(0.58, 0.82, 0.98, 0.75))
	_add_blocker(Rect2(pos.x - 22.0 * scl, pos.y - 8.0 * scl, 44.0 * scl, 22.0 * scl))

## massa de cristal da BARREIRA do Núcleo (cobertura SÓLIDA que sela a passagem). Maior, mais densa. z por y.
func _cath_barrier_mass(pos: Vector2, w: float) -> void:
	_cath_glow(pos + Vector2(0.0, 6.0), w * 0.6, Color(0.42, 0.70, 0.96, 0.12))
	var base := ColorRect.new(); base.color = Color("1c2436"); base.size = Vector2(w, 40.0); base.position = pos + Vector2(-w * 0.5, -20.0); base.z_index = int(pos.y) - 1; _region_node.add_child(base)
	# CATHEDRAL_CLEANUP_PACK_04: massa de barreira como sprite (escala por w) se existir; senão a fileira de cristais
	# (que já cai no sprite de shard ou no Polygon2D). Glow/base/blocker abaixo seguem por código.
	var bar_tex := _try_load_tex("res://assets/tilesets/cathedral_of_crystal/props/crystal_barrier.png")
	if bar_tex != null:
		var bs := Sprite2D.new(); bs.texture = bar_tex; bs.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		var sc := w / 256.0   # native 256x128
		bs.scale = Vector2(sc, sc); bs.offset = Vector2(0.0, -64.0); bs.position = Vector2(pos.x, pos.y + 6.0); bs.z_index = int(pos.y)
		_region_node.add_child(bs)
	else:
		var n := int(w / 26.0)
		for i in range(n):
			var fx := pos.x - w * 0.5 + 13.0 + float(i) * 26.0
			var hh := 92.0 + float((i * 37) % 40)
			_cath_crystal(Vector2(fx, pos.y + 6.0), hh, Color(0.46, 0.74, 0.96, 0.9))
	_add_blocker(Rect2(pos.x - w * 0.5, pos.y - 16.0, w, 34.0))

## o CORAÇÃO DE CRISTAL (HEART_OF_CRYSTAL_PROMOTION — o CORPO/silhueta do boss): formação colossal ENRAIZADA com
## núcleo pulsante. SEM blocker (a colisão é do boss-mob que nasce aqui, quase-imóvel = enraizado). Enorme, central, vivo.
func _cath_heart(pos: Vector2) -> void:
	_cath_glow(pos + Vector2(0.0, 20.0), 150.0, Color(0.40, 0.70, 0.98, 0.16))
	# CORPO do Coração (LANDMARKS_PACK_02): sprite real se existir; senão o procedural (fallback seguro). O GLOW (acima)
	# e o NÚCLEO pulsante (abaixo) seguem por CÓDIGO — a arte é só o corpo cristalino.
	var heart_tex := _try_load_tex("res://assets/tilesets/cathedral_of_crystal/props/crystal_heart_landmark.png")
	if heart_tex != null:
		var hs := Sprite2D.new(); hs.texture = heart_tex; hs.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		hs.position = pos + Vector2(0.0, -122.0); hs.z_index = int(pos.y); _region_node.add_child(hs)
	else:
		var root := Polygon2D.new(); root.polygon = PackedVector2Array([pos + Vector2(-140, 40), pos + Vector2(-60, 10), pos + Vector2(70, 14), pos + Vector2(150, 44), pos + Vector2(60, 70), pos + Vector2(-70, 66)]); root.color = Color("26344e"); root.z_index = int(pos.y) - 2; _region_node.add_child(root)
		_cath_crystal(pos + Vector2(-70, 30), 190.0, Color(0.40, 0.66, 0.92, 0.9))
		_cath_crystal(pos + Vector2(64, 34), 200.0, Color(0.44, 0.70, 0.94, 0.9))
		_cath_crystal(pos + Vector2(-12, 40), 256.0, Color(0.52, 0.80, 0.98, 0.92))
		_cath_crystal(pos + Vector2(34, 36), 150.0, Color(0.58, 0.84, 1.0, 0.85))
	var core := Polygon2D.new(); var cp := PackedVector2Array()
	for i in range(14):
		var a := TAU * float(i) / 14.0
		cp.append(Vector2(cos(a) * 26.0, sin(a) * 30.0))
	core.polygon = cp; core.position = pos + Vector2(0, -120); core.color = Color(0.80, 0.94, 1.0, 0.95); core.z_index = int(pos.y) + 2; _region_node.add_child(core)
	if core.is_inside_tree():
		var tw := core.create_tween(); tw.set_loops()
		tw.tween_property(core, "modulate:a", 0.5, 1.8).set_trans(Tween.TRANS_SINE)
		tw.tween_property(core, "modulate:a", 1.0, 1.8).set_trans(Tween.TRANS_SINE)

## ★ A CICATRIZ DO CORAÇÃO (HEART_SCAR_F5) — a 1ª marca de CONSEQUÊNCIA do eixo Legado, SÓ após a 1ª derrota (flag
## `heart_scarred`). NÃO é genérico (é só do Coração/Catedral): (1) cristal RACHADO atravessando o corpo do apex
## (escuro/frio/morto, sobre o cristal vivo); (2) FENDA FRIA no chão — cacos cinza-azulados MORTOS (sem o brilho/pulso
## do vivo); (3) a boca das Fendas ESCANCARADA (respiro frio escuro). A fera volta ao lado; a terra fica ferida. SEM
## texto/UI/pop-up/recompensa/contador. Tudo `av_heart_scar` (identificação). Observada no mundo, não anunciada.
func _cath_heart_scar(pos: Vector2) -> void:
	# (1) o RACHADO permanente atravessando o corpo do Coração
	var rim := Line2D.new(); rim.points = PackedVector2Array([pos + Vector2(-60, -130), pos + Vector2(-18, -40), pos + Vector2(10, 6), pos + Vector2(-6, 60), pos + Vector2(30, 92)]); rim.width = 9.0; rim.default_color = Color(0.5, 0.66, 0.82, 0.12); rim.z_index = int(pos.y) + 2; rim.set_meta("av_heart_scar", true); _region_node.add_child(rim)
	var crack := Line2D.new(); crack.points = rim.points; crack.width = 5.0; crack.default_color = Color(0.02, 0.03, 0.05, 0.96); crack.z_index = int(pos.y) + 3; crack.set_meta("av_heart_scar", true); _region_node.add_child(crack)
	var crack2 := Line2D.new(); crack2.points = PackedVector2Array([pos + Vector2(22, -92), pos + Vector2(42, -30), pos + Vector2(28, 32)]); crack2.width = 3.0; crack2.default_color = Color(0.04, 0.05, 0.08, 0.88); crack2.z_index = int(pos.y) + 3; crack2.set_meta("av_heart_scar", true); _region_node.add_child(crack2)
	# (2) a FENDA FRIA no chão — cristal MORTO (cinza-azulado, sem pulsar)
	var dead := Polygon2D.new(); var dp := PackedVector2Array()
	for i in range(10):
		var a := TAU * float(i) / 10.0
		dp.append(Vector2(cos(a) * (46.0 + float(i % 3) * 8.0), sin(a) * 22.0))
	dead.polygon = dp; dead.position = pos + Vector2(-8, 84); dead.color = Color(0.10, 0.14, 0.20, 0.85); dead.z_index = int(pos.y + 84) - 1; dead.set_meta("av_heart_scar", true); _region_node.add_child(dead)
	for off in [Vector2(-28, 80), Vector2(2, 88), Vector2(28, 82)]:
		var shard := Polygon2D.new(); shard.polygon = PackedVector2Array([pos + off + Vector2(-8, 8), pos + off + Vector2(-3, -26), pos + off + Vector2(6, -20), pos + off + Vector2(9, 8)])
		shard.color = Color(0.28, 0.36, 0.46, 0.8); shard.z_index = int(pos.y + 84); shard.set_meta("av_heart_scar", true); _region_node.add_child(shard)
	var cold := ColorRect.new(); cold.color = Color(0.30, 0.44, 0.60, 0.07); cold.size = Vector2(150.0, 70.0); cold.position = pos + Vector2(-83, 54); cold.z_index = -14; cold.set_meta("av_heart_scar", true); _region_node.add_child(cold)   # luz fria MORTA (estática, não pulsa)
	# (3) a boca das FENDAS escancarada (sobre o seal, ~1100,186): respiro frio escuro, a quebra que não fecha
	var gape := Polygon2D.new(); gape.polygon = PackedVector2Array([Vector2(1070, 150), Vector2(1090, 108), Vector2(1112, 114), Vector2(1120, 160), Vector2(1100, 198), Vector2(1078, 190)]); gape.color = Color(0.0, 0.0, 0.0, 0.93); gape.z_index = 149; gape.set_meta("av_heart_scar", true); _region_node.add_child(gape)
	var breath := ColorRect.new(); breath.color = Color(0.12, 0.16, 0.22, 0.16); breath.size = Vector2(70.0, 64.0); breath.position = Vector2(1065.0, 150.0); breath.z_index = -13; breath.set_meta("av_heart_scar", true); _region_node.add_child(breath)

## ★ A DESCIDA ÀS FENDAS PROFUNDAS (HEART_OF_CRYSTAL_PROMOTION → BUILD_FENDAS_PROFUNDAS_F5) — atrás do Coração, no fundo
## do Núcleo. Era uma promessa selada; agora DESCE de verdade (portal → região `fendas`). Visual: fenda escura no fundo
## da câmara + ar frio subindo + cacos quebrados (não mais "selando" — abertos). O Coração a GUARDA (por geografia/AoE,
## não por flag): você fura/flanqueia o apex rooteado pra alcançá-la. Sem save/sistema.
func _cath_fendas_seal(pos: Vector2) -> void:
	var crack := Polygon2D.new(); crack.polygon = PackedVector2Array([pos + Vector2(-40, 46), pos + Vector2(-14, -58), pos + Vector2(8, -52), pos + Vector2(0, 30), pos + Vector2(34, 48)]); crack.color = Color(0.01, 0.01, 0.02, 0.98); crack.z_index = int(pos.y) - 3; _region_node.add_child(crack)
	_cath_glow(pos + Vector2(0.0, 30.0), 60.0, Color(0.16, 0.18, 0.24, 0.16))   # ar frio e MORTO subindo (não luz de cristal — cinza)
	_cath_crystal(pos + Vector2(-20, 42), 48.0, Color(0.34, 0.50, 0.70, 0.55)); _cath_crystal(pos + Vector2(22, 44), 40.0, Color(0.34, 0.50, 0.70, 0.55))   # cacos quebrados (a boca abriu)
	_build_portal(pos + Vector2(0.0, 18.0), "fendas", "↓ descer → as Fendas Profundas", false, FENDAS_SPAWN)

## forma DORMENTE meio-fundida no cristal (a "pack" futura, à distância, atrás da barreira): silhueta encurvada
## presa num shard. Decorativa (SEM blocker/mob/loot) — promessa, não ameaça.
func _cath_dormant(pos: Vector2, col: Color) -> void:
	# CATHEDRAL_CLEANUP_PACK_04: husk dormente (silhueta fundida no cristal) como 1 sprite se existir; senão a
	# silhueta Polygon2D + 1 cristal (fallback).
	var hk_tex := _try_load_tex("res://assets/tilesets/cathedral_of_crystal/props/crystal_dormant_husk.png")
	if hk_tex != null:
		var s := Sprite2D.new(); s.texture = hk_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.offset = Vector2(0.0, -28.0); s.position = pos + Vector2(0.0, 12.0); s.z_index = int(pos.y)
		_region_node.add_child(s)
		return
	var sil := Polygon2D.new(); sil.polygon = PackedVector2Array([pos + Vector2(-16, 8), pos + Vector2(-10, -18), pos + Vector2(6, -24), pos + Vector2(16, -6), pos + Vector2(12, 10)]); sil.color = col; sil.z_index = int(pos.y); _region_node.add_child(sil)
	_cath_crystal(pos + Vector2(2, 12), 70.0, Color(0.46, 0.74, 0.96, 0.55))

## crescimento de cristal na parede (CATHEDRAL_RETENTION_LAYER_01): aglomerado que sugere "algo cresceu fundido aqui".
## Marca TODOS os pontos candidatos do elite (o Crescido na Parede surge fundido num deles, conforme a sessão rola).
## Decorativo — SEM blocker (não prende o elite que pode nascer ali). z por y.
func _cath_wall_growth(pos: Vector2) -> void:
