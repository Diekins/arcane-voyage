			"loot": [{"name": "Fragmento de Cristal", "chance": 0.5}, {"name": "Núcleo Trincado", "chance": 0.4}, {"name": "Pó Luminescente", "chance": 0.3}],
			"spawns": [Vector2(1120, 720), Vector2(1040, 560)],
		}
		# VARIAÇÃO DE COMPOSIÇÃO (por sessão): às vezes um 3º Sentinela patrulha a nave (gargalo + denso, anti-clip OK)
		if randf() < 0.5:
			(sentinels["spawns"] as Array).append(Vector2(1180, 640))
		var out := [bats, shards, sentinels]
		# ── RETENÇÃO (RETENTION_LAYER_01): elite + raro semi-aleatórios. Presença E lugar variam por SESSÃO (sem save).
		if randf() < 0.75:
			out.append(_cath_elite_config(CATH_ELITE_POINTS[randi() % CATH_ELITE_POINTS.size()]))
		if randf() < 0.42:
			out.append(_cath_geode_config(CATH_GEODE_POINTS[randi() % CATH_GEODE_POINTS.size()]))
		# ── ★ O CORAÇÃO DE CRISTAL (HEART_OF_CRYSTAL_PROMOTION) — apex ENRAIZADO e RECORRENTE no Núcleo. SEMPRE presente
		# (o guardião está sempre em seu posto); respawn em timer = recorrente (volta após o kill, sem save). NÃO é
		# campanha/boss-HUD/raid — é um apex-mob SOLO duro. Frase line→cone→circle em MOB_COMBAT_LANGUAGE.
		out.append(_cath_heart_config(Vector2(1100.0, 300.0)))
		return out
	return []

