# ★ CONTRATO DE OFFSETS DATA-DRIVEN (GODOT-CONTINUOUS-WORLD-EDITOR-OFFSETS-1): a geografia das macro-zonas
# (offset [x,y] do canto sup-esq de cada região, px-mundo, ABUTTING/gap=0, normalizado p/ min-corner (0,0)) vem
# deste JSON — fonte da verdade EXTERNA, autorável depois pelo Claude-Editor (🗺 Mundo). Formato:
#   { "<cluster_id>": { "members": [ {"region":"<id>", "offset":[x,y]}, ... ] }, ... }
# Cluster ausente/arquivo inválido → FALLBACK = layout horizontal (cursor) sobre a lista const de membros.
const MACRO_CLUSTERS_PATH := "res://data/macro_clusters.json"
const MACRO_ZONE_KHET := ["khet_dune_overlook", "khet_waystation", "khet_salt_scrub"]
const MACRO_ZONE_STARTER := ["starter_village", "plains", "cave"]   # cluster inicial (procedural) — Plano B
const MACRO_ZONE_FOREST := ["ashen_grove", "deep_grove", "ancient_root_nest"]   # coluna VERTICAL N→S (prova 2D)
const MACRO_GAP := 0.0   # 0 = regiões ENCOSTADAS (chão contínuo, sem vão/void entre elas)
# Mobs de CAMPANHA (boss/mini-boss com callback de story-flag) SUPRIMIDOS na macro (CONTENT-1, v1 = só mobs
# comuns + loot). São os ids com desfecho canônico em _on_mob_died; tanks-elite comuns (moss_warden etc.) FICAM.
const MACRO_SUPPRESSED_MOBS := ["ancient_root_heart", "root_matriarch", "salt_split_warden", "khet_sar_sentinel", "khet_oasis_salt_echo"]
var _macro_clusters_cache := {}
var _macro_clusters_loaded := false
var _mob_build_offset := Vector2.ZERO   # offset aplicado aos spawns de mob na macro-zona (0 em produção)

## ★ GATE DE SEGURANÇA (CONTENT-1 + GRADUATION-1) — ponto ÚNICO de verdade. Trava avanço de CAMPANHA (quests/
## bounties/discovery/tutorial/story-flags/boss) SÓ no SANDBOX (macro de DEV). Em CANONICAL (macro graduada) e em
## single-region → false (campanha progride normal). XP/ouro/loot/economia são sempre permitidos.
func _campaign_progress_locked() -> bool:
	return _macro_sandbox

## Lista de clusters GRADUADOS — DATA-DRIVEN (GODOT-CONTINUOUS-WORLD-GRADUATION-DATADRIVEN-1 / Fase B): lê o campo
## `graduated:true` de cada cluster no macro_clusters.json. Se NENHUM cluster declara o campo (contrato antigo),
## cai no const GRADUATED_CLUSTERS (retrocompat = só "starter"). Assim graduar +1 cluster = 1 campo no JSON.
func _graduated_clusters() -> Array:
	return MacroWorld.graduated_clusters(_load_macro_clusters(), GRADUATED_CLUSTERS)   # extraído p/ MacroWorld

## Cluster GRADUADO de uma região (""=nenhum). Usado no roteamento de boot/portal e na detecção region-by-position.
func _cluster_of_region(region_id: String) -> String:
	if not GRADUATION_ENABLED:
		return ""
	for cl in _graduated_clusters():
		for entry in _macro_cluster_layout(str(cl)):
			if str(entry["id"]) == region_id:
				return str(cl)
	return ""

## Roteamento ÚNICO de "entrar numa região" (boot + retorno por portal). Se a região pertence a um cluster graduado
## → monta o mundo contínuo CANÔNICO entrando por ela; senão → load_region legado (idêntico a hoje). spawn_at é o
## ponto de surgimento LOCAL da região (de um portal); INF = usa o spawn padrão / posição persistida.
## Ativação do MUNDO MESCLADO: const (default OFF) OU env `AV_FORCE_MERGE` (ativação DEV controlada, sem mudar o
## default nem o save). Permite diagnóstico/preview do merge sem ligar o caminho padrão.
func _merge_active() -> bool:
	return CONTINUOUS_MERGE_ENABLED or OS.has_environment("AV_FORCE_MERGE")

func _route_enter(region_id: String, spawn_at: Vector2 = Vector2.INF) -> void:
	var cl := _cluster_of_region(region_id)
	if cl != "":
		# Fase C: com merge ativo (const OU AV_FORCE_MERGE), monta o MUNDO MESCLADO (todos os graduados num só
		# espaço) entrando pela região salva; senão (default), monta só o cluster dela (Fase B). Ambos CANÔNICOS.
		load_macro_zone(cl, true, region_id, spawn_at, _merge_active())
	else:
		if spawn_at.x != INF:
			_pending_spawn = spawn_at
		load_region(region_id)

## Carrega (1×, cacheado) o contrato de clusters. {} se faltar/inválido (→ fallback horizontal).
func _load_macro_clusters() -> Dictionary:
	if _macro_clusters_loaded:
		return _macro_clusters_cache
	_macro_clusters_loaded = true
	if FileAccess.file_exists(MACRO_CLUSTERS_PATH):
		var f := FileAccess.open(MACRO_CLUSTERS_PATH, FileAccess.READ)
		if f != null:
			var j = JSON.parse_string(f.get_as_text())
			f.close()
			if typeof(j) == TYPE_DICTIONARY:
				_macro_clusters_cache = j
			else:
				push_warning("[MacroZone] contrato inválido (não-dict): %s" % MACRO_CLUSTERS_PATH)
	return _macro_clusters_cache

## Lista const de membros de um cluster (usada SÓ no fallback quando o contrato falta o cluster).
func _macro_fallback_ids(cluster_id: String) -> Array:
	match cluster_id:
		"khet": return MACRO_ZONE_KHET
		"starter": return MACRO_ZONE_STARTER
		"forest": return MACRO_ZONE_FOREST
		_: return []

## Layout de um cluster = [{id:String, offset:Vector2}], na ORDEM do contrato. Contrato presente → offsets do
## JSON (geografia 2D autorada). Ausente → FALLBACK horizontal (cursor sobre a lista const). [] se desconhecido.
func _macro_cluster_layout(cluster_id: String) -> Array:
	var out := []
	var data := _load_macro_clusters()
	if data.has(cluster_id) and typeof(data[cluster_id]) == TYPE_DICTIONARY:
		for m in data[cluster_id].get("members", []):
			if typeof(m) == TYPE_DICTIONARY and m.has("region"):
				out.append({"id": str(m["region"]), "offset": _mpos(m.get("offset", [0, 0]))})
		if not out.is_empty():
			return out
	# fallback: layout horizontal (cursor) sobre a lista const — sem regressão se o contrato sumir
	var cursor := 0.0
	for id in _macro_fallback_ids(cluster_id):
		var sz := _region_world_size(str(id))
		out.append({"id": str(id), "offset": Vector2(cursor, 0)})
		cursor += sz.x + MACRO_GAP
	return out

# ★ FASE C (GODOT-CONTINUOUS-WORLD-MERGE-1): posição do cluster no MUNDO (onde o (0,0) local do cluster cai em
# coords de mundo) — camada de geografia INTER-cluster. Default (0,0) se ausente.
func _cluster_world_pos(cluster_id: String) -> Vector2:
	return MacroWorld.cluster_world_pos(_load_macro_clusters(), cluster_id)   # extraído p/ MacroWorld

## Mundo MESCLADO (Fase C): membros de TODOS os clusters graduados, cada um deslocado pelo `world_pos` do seu
## cluster → coords de MUNDO únicas. É a base da continuidade ENTRE clusters (andar de um bioma ao vizinho sem
## load). Consumido por load_macro_zone quando merged=true (atrás de CONTINUOUS_MERGE_ENABLED).
func _merged_world_layout() -> Array:
	var out := []
	for cl in _graduated_clusters():
		var wp := _cluster_world_pos(str(cl))
		for entry in _macro_cluster_layout(str(cl)):
			out.append({"id": str(entry["id"]), "offset": (entry["offset"] as Vector2) + wp})
	return out

## ★ FIELD FIX 05/09/2026 — origem MUNDO de uma região no espaço mesclado.
## Usado pelo HuntHost para traduzir o SLOT do servidor em posição real (ver `HuntMapBinding`).
## `Vector2.INF` = região desconhecida. ★★★ NÃO devolver (0,0) num "não sei": quem chama tem de
## poder GRITAR em vez de teleportar o jogador para o lugar errado em silêncio.
func region_world_origin(region_id: String) -> Vector2:
	for e in _merged_world_layout():
		if str(e["id"]) == region_id:
			return e["offset"] as Vector2
	return Vector2.INF

## Monta uma MACRO-ZONA. canonical=false → SANDBOX (DEV/F4: gate on, boss suprimido, sem persistência).
## canonical=true → GRADUADA (jogo real: gate off, bosses presentes, region-by-position, posição persistida).
## enter_region/enter_spawn (opcionais, p/ boot/retorno-por-portal canônico): por onde/onde surgir no cluster.
func load_macro_zone(cluster_id: String = "khet", canonical: bool = false, enter_region: String = "", enter_spawn: Vector2 = Vector2.INF, merged: bool = false) -> void:
	# teardown idêntico ao de load_region (libera nós/refs da região anterior), MAS sem mexer no save.
	_set_world_combat(false)
	_close_overlays()
	_wolf = null; _golem = null; _current_boss = null; _boss_name = ""
	_mobs = []; _drops = []; _blockers = []
	_aldric = null; _aldric_prompt = null; _aldric_anim = null
	_portals = []; _npcs = []; _services = []; _chests = []
	_transition_cd = 0.8; _auto_zone_active = null
	_clear_auto_target(); _talking_anim = null; _guardian_seen = {}
	if _region_node != null:
		_region_node.queue_free()
	var macro := Node2D.new()
	macro.name = "MacroZone"
	macro.y_sort_enabled = true   # Y-SORT NATIVO (GODOT-CONTINUOUS-WORLD-YSORT-1): ordena por Y GLOBAL, sem teto
	add_child(macro)
	_region_node = macro
	_macro_mode = true
	_macro_canonical = canonical
	_macro_sandbox = not canonical
	_suppress_internal_borders = true
	_macro_zone_rects = []
	_macro_zone_nodes = {}
	_macro_merged = merged
	_macro_bosses = []
	_macro_current_region = ""

	# 1) layout DATA-DRIVEN: offsets vêm do contrato macro_clusters.json (geografia 2D autorável); cluster ausente
	# → fallback horizontal (cursor). bbox = envelope geral (suporta colunas VERTICAIS, não só faixas horizontais).
	# merged=true (Fase C): TODOS os clusters graduados num só espaço (por world_pos) → continuidade entre clusters.
	var bbox := Vector2.ZERO
	var members := []   # [{id,size,offset}]
	var _layout: Array = _merged_world_layout() if merged else _macro_cluster_layout(cluster_id)
	for entry in _layout:
		var id: String = str(entry["id"])
		# tamanho via fonte ÚNICA (_region_world_size): resolve manifesto (editor-authored) E procedural (match)
		var sz := _region_world_size(id)
		if sz.x <= 0.0 or sz.y <= 0.0:
			push_warning("[MacroZone] região sem tamanho, pulada: %s" % id)
			continue
		var off: Vector2 = entry["offset"]
		members.append({"id": id, "size": sz, "offset": off})
		bbox.x = max(bbox.x, off.x + sz.x)
		bbox.y = max(bbox.y, off.y + sz.y)   # +off.y → colunas verticais expandem a altura do mundo

	# 2) constrói cada região num nó-filho offsetado; torna blockers e z GLOBAIS (offset-aware)
	for m in members:
		var off: Vector2 = m["offset"]
		var sz: Vector2 = m["size"]
		var zone := Node2D.new()
		zone.name = "Zone_" + str(m["id"])
		zone.position = off
		zone.y_sort_enabled = true   # propaga o y-sort da macro → props desta zona ordenam pela Y GLOBAL (off.y incluso)
		macro.add_child(zone)
		_region_node = zone   # builders desenham em coords LOCAIS dentro deste nó offsetado
		_macro_zone_rects.append({"region": str(m["id"]), "rect": Rect2(off, sz)})   # region-by-position (canonical)
		_macro_zone_nodes[str(m["id"])] = zone   # Fase D: ref p/ cull de visibilidade
		var blk_before: int = _blockers.size()
		var por_before: int = _portals.size()
		var boss_before = _current_boss   # GRADUATION-1: detecta boss criado por este builder (canonical)
		_build_topdown_map(str(m["id"]), sz)       # chão (manifesto OU procedural); bordas internas suprimidas pela flag
		_dispatch_region_builder(str(m["id"]), sz) # props/portais/npcs (+ boss: suprimido em sandbox, PRESENTE em canonical) + blockers locais
		if _current_boss != null and _current_boss != boss_before:   # registra o boss desta zona (offset-aware adiante)
			_macro_bosses.append({"region": str(m["id"]), "node": _current_boss, "name": _boss_name, "dmg_min": _boss_dmg_min, "dmg_max": _boss_dmg_max, "offset": off})
		# blockers criados nesta região estão em coords LOCAIS → soma o offset (viram globais)
		for i in range(blk_before, _blockers.size()):
			var r: Rect2 = _blockers[i]
			_blockers[i] = Rect2(r.position + off, r.size)
		# portais desta zona: a "pos" (usada na proximidade/auto-transição vs player GLOBAL) vira GLOBAL (node já
		# está visualmente offsetado por ser filho da zona). Filtro interno×externo vem após o loop. (EXITS-1)
		for i in range(por_before, _portals.size()):
			_portals[i]["pos"] = _portals[i]["pos"] + off
		# Y-SORT NATIVO (GODOT-CONTINUOUS-WORLD-YSORT-1): props/atores (z>=0) entram num ÚNICO grupo z=0 RELATIVO;
		# o y_sort_enabled da zona+macro os ordena pela Y GLOBAL (offset.y incluso), SEM teto numérico (vs o antigo
		# z=y_global, que estourava em Y>4095 e só servia p/ off.y=0). Chão/bordas (z<0) ficam num grupo atrás
		# (intactos). CombatVfx (z=4095 absoluto) e nomes/prompts (Z_TAG absoluto) seguem por cima do y-sort.
		for child in zone.get_children():
			if child is CanvasItem and child.z_index >= 0:
				child.z_index = 0
				child.z_as_relative = true

	_region_node = macro
	# 2a) MOBS offset-aware (GODOT-CONTINUOUS-WORLD-CONTENT-1): pass SEPARADA, após os blockers globais completos.
	# Mobs vão p/ a MACRO (não a zona) com posição GLOBAL (spawn local + offset) → IA/leash/blockers/_player operam
	# todos em coords GLOBAIS coerentes. _build_mobs respeita MACRO_SUPPRESSED_MOBS (boss/mini-boss fora). z=0 (y-sort).
	for m in members:
		_mob_build_offset = m["offset"]
		_build_mobs(str(m["id"]))
	_mob_build_offset = Vector2.ZERO
	# 2a') BOSSES offset-aware (GRADUATION-1, canonical): os bosses foram criados como filhos da SUA zona (coords
	# locais). Reparent p/ a MACRO com keep_global → position vira GLOBAL (visual inalterado; Wolf/Golem NÃO guardam
	# home no _ready → IA passa a comparar com o player global corretamente). z=0 (y-sort), blockers GLOBAIS.
	for b in _macro_bosses:
		var node = b["node"]
		if is_instance_valid(node):
			if node.get_parent() != macro:
				node.reparent(macro, true)
			node.z_index = 0
			node.z_as_relative = true
			node.call("set_blockers", _blockers)
	# 2b) PORTAIS — saídas EXTERNAS globalizadas (GODOT-CONTINUOUS-WORLD-EXITS-1): mantém SÓ os portais cujo target
	# NÃO é membro do cluster (saída p/ o resto do mundo); os INTERNOS (target ∈ membros) são removidos do tracking
	# (você atravessa ANDANDO; o visual do arco fica, mas inerte). Os externos guardam pos GLOBAL (já somada acima) →
	# auto-transição/[E] disparam _use_portal → sai da macro p/ load_region(target) com o spawn/gate preservados.
	var _member_ids := {}
	for m in members:
		_member_ids[str(m["id"])] = true
	var _ext_portals := []
	for p in _portals:
		if not _member_ids.has(str(p.get("target", ""))):
			_ext_portals.append(p)   # externo → vira saída real
	_portals = _ext_portals
	_auto_zone_active = null
	# 3) borda só do MUNDO inteiro (substitui as bordas por-região suprimidas)
	_macro_world_border(bbox)
	# 3b) SEAM CONNECTORS (A2): suaviza as costuras INTERNAS entre zonas (render-only, sem blocker/layout)
	_build_seam_connectors(members)
	# 3c) TRILHA VIVA + MARCO NARRATIVO nas costuras ENTRE clusters (só no mundo mesclado): a passagem Vila→Bosque
	# vira a "Trilha das Raízes", corrompida pelo esquecimento (sinal ambiental, sem cutscene). Render + lore [E].
	if merged:
		_build_macro_narrative_seams()

	# 4) Errante REAL: posição inicial = (a) posição PERSISTIDA do save (boot, se o cluster bater) > (b) spawn da
	# região de entrada (portal/boot: local→global) > (c) centro da 1ª região. bounds/câmera = bbox; z=0 (y-sort).
	_region_size = bbox
	if not members.is_empty():
		_macro_safe_spawn = members[0]["offset"] + members[0]["size"] * 0.5   # hub do cluster (Vila) = respawn seguro
	var start := Vector2.INF
	var enter_off := Vector2.ZERO
	var enter_found := false
	for m in members:
		if str(m["id"]) == enter_region:
			enter_off = m["offset"]; enter_found = true
	if canonical and GameState.cluster_id == cluster_id and GameState.cluster_pos.size() == 2:
		start = Vector2(float(GameState.cluster_pos[0]), float(GameState.cluster_pos[1]))   # (a) restaura sessão
	if start.x == INF and enter_found:
		start = enter_off + (enter_spawn if enter_spawn.x != INF else _region_spawn(enter_region))   # (b)
	if start.x == INF and not members.is_empty():
		start = members[0]["offset"] + members[0]["size"] * 0.5   # (c)
	_player_start = start
	if _player != null:
		# Errante ENTRA na árvore y-sortada (reparent p/ a macro em 0,0 → preserva coords globais); z=0; _update_depth_sort
		# não mexe no z dele em _macro_mode (early-return) → o y-sort governa. CombatVfx/nomes (z absoluto) por cima.
		if _player.get_parent() != macro:
			_player.reparent(macro, true)
		_player.z_index = 0
		_player.z_as_relative = true
		_player.position = _player_start
		_player.set("locked", false)
		_player.call("set_bounds", Vector2(MAP_MARGIN, MAP_MARGIN), bbox - Vector2(MAP_MARGIN, MAP_MARGIN))
		_player.call("set_blockers", _blockers)
	if _camera != null:
		_camera.limit_left = 0; _camera.limit_top = 0
		_camera.limit_right = int(bbox.x); _camera.limit_bottom = int(bbox.y)
		_camera.reset_smoothing()
	# 5) CANONICAL: aplica a região-por-posição INICIAL (HUD/quest/boss/discovery/tutorial). SANDBOX: HUD genérico.
	if canonical:
		var start_region := enter_region
		if start_region == "":
			start_region = _macro_region_at(_player_start)
		if start_region == "" and not members.is_empty():
			start_region = str(members[0]["id"])
		_macro_enter_region(start_region, true)   # force: aplica mesmo sem "troca" (1ª entrada)
		_macro_toast_show("◆ MUNDO CONTÍNUO ◆  cluster '%s' — ande livremente entre as áreas (sem loading)." % cluster_id)
	else:
		_refresh_region_hud()
		_macro_toast_show("◆ MUNDO CONTÍNUO (DEV/SANDBOX) ◆  cluster '%s' — %d regiões · WASD anda · J/clique luta (XP/loot contam, campanha não) · [F4] sai" % [cluster_id, members.size()])
	print("[MacroZone] montada (%s): %d regiões | bbox=%s | bosses=%d | blockers=%d | nós=%d" % [("canonical" if canonical else "sandbox"), members.size(), str(bbox), _macro_bosses.size(), _blockers.size(), get_tree().get_node_count()])

## FASE D — distância de um ponto ao rect (0 se dentro; senão até a borda mais próxima). Base do cull.
func _zone_dist_to(p: Vector2, r: Rect2) -> float:
	return MacroWorld.zone_dist_to(p, r)   # extraído p/ MacroWorld

## FASE D — cull de visibilidade no MUNDO MESCLADO: zonas além de CONTINUOUS_CULL_RADIUS do Errante ficam
## invisíveis (poupa render). Só no merged; render-only (não mexe em colisão/save/IA). Chamado de _process.
func _macro_cull_tick() -> void:
	if not _macro_merged or _player == null:
		return
	var p: Vector2 = _player.position
	for z in _macro_zone_rects:
		var node = _macro_zone_nodes.get(str(z["region"]), null)
		if node != null and is_instance_valid(node):
			node.visible = _zone_dist_to(p, z["rect"]) <= CONTINUOUS_CULL_RADIUS

## TRILHA VIVA + MARCO NARRATIVO na costura ENTRE clusters (GODOT-CONTINUOUS-WORLD-SEAM-TRAIL-1). Só no mundo
## mesclado: a passagem Vila→Bosque vira a "Trilha das Raízes", corrompida pelo esquecimento. SINAL AMBIENTAL (trilha
## de terra + raízes infiltrando + placa-marco + lore por [E]), SEM cutscene/flag/save novo. Render + 1 future_exit
## (reusa _services kind future_exit → _use_future_exit só mostra texto, NÃO transporta).
func _build_macro_narrative_seams() -> void:
	# conexão starter↔forest: só desenha se AMBAS as pontas estão montadas (Vila + Bosque de Cinza)
	if not (_macro_zone_nodes.has("starter_village") and _macro_zone_nodes.has("ashen_grove")):
		return
	var sx := VILLAGE_TO_NORTH.x   # x do portão norte da Vila (alinha a trilha com a saída existente)
	var sy := 0.0                  # costura: village.top == ashen.bottom == y0
	# 1) TRILHA de terra batida cruzando a costura (render-only; z entre chão/costura e props)
	var trail := ColorRect.new()
	trail.color = Color(0.43, 0.34, 0.21, 0.6)
	trail.size = Vector2(150, 560)
	trail.position = Vector2(sx - 75.0, sy - 330.0)
	trail.z_index = -7
	_region_node.add_child(trail)
	# raízes infiltrando a trilha (o "esquecimento" alcançando a Vila) — manchas escuras esparsas
	for i in range(6):
		var blot := ColorRect.new()
		blot.color = Color(0.10, 0.09, 0.08, 0.5)
		blot.size = Vector2(26.0, 12.0)
		blot.position = Vector2(sx - 64.0 + float((i * 23) % 120), sy - 300.0 + float(i) * 72.0)
		blot.z_index = -6
		_region_node.add_child(blot)
	# 2) PLACA-MARCO ao lado da trilha (objeto, y-sort no grupo z=0 do mundo mesclado)
	var sign := Node2D.new()
	sign.position = Vector2(sx + 215.0, sy - 10.0)
	sign.z_index = 0
	sign.z_as_relative = true
	var post := ColorRect.new()
	post.color = Color("5a3f28"); post.size = Vector2(8.0, 46.0); post.position = Vector2(-4.0, -46.0)
	sign.add_child(post)
	var plank := ColorRect.new()
	plank.color = Color("6b4a2f"); plank.size = Vector2(78.0, 26.0); plank.position = Vector2(-39.0, -64.0)
	sign.add_child(plank)
	var tag := Label.new()
	tag.text = "⟡ Trilha das Raízes"
	tag.position = Vector2(-58.0, -92.0)
	tag.modulate = Color("c8b48a")
	tag.add_theme_font_size_override("font_size", 12)
	sign.add_child(tag)
	_tag_on_top(tag)
	_region_node.add_child(sign)
	# 3) LORE por [E] (future_exit — só texto, não transporta). Ancorado na placa.
	var lore_node := Node2D.new()
	lore_node.position = sign.position
	var prompt := Label.new()
	prompt.text = "[E] ler a placa da Trilha"
	prompt.position = Vector2(-70.0, -118.0)
	prompt.modulate = Color("f0d29a")
	prompt.add_theme_font_size_override("font_size", 13)
	prompt.visible = false
	lore_node.add_child(prompt)
	_tag_on_top(prompt)
	_region_node.add_child(lore_node)
	_services.append({
		"node": lore_node, "prompt": prompt, "pos": sign.position, "kind": "future_exit", "id": "trail_of_roots",
		"title": "A Trilha das Raízes",
		"msg": [
			"A placa ao norte está rachada, e as letras foram engolidas pelo musgo.",
			"Daqui a trilha sobe para o Bosque de Cinza — não um lugar a mais, mas um caminho que o mundo começou a ESQUECER.",
			"Raízes negras já lambem a beira do caminho. Quanto mais ao norte, mais o esquecimento se aprofunda: Bosque → Coração das Raízes → o Ninho.",
		],
	})
	# 4) ESCALADA DE RAÍZES (o esquecimento se aprofunda ao NORTE): manchas de raiz negra subindo pela trilha, cada
	# vez mais densas/escuras (sinal ambiental progressivo, render-only). De y0 (Vila) até ~y-1300 (entrada do Coração).
	for i in range(10):
		var t := float(i) / 9.0                         # 0 (Vila) → 1 (norte profundo)
		var yy := sy - 80.0 - t * 1180.0                # sobe ao norte
		var root := ColorRect.new()
		root.color = Color(0.09, 0.08, 0.07, 0.35 + t * 0.45)   # mais escuro/opaco ao norte
		var w := 30.0 + t * 70.0                        # mais largo (a corrupção espraia)
		root.size = Vector2(w, 14.0)
		root.position = Vector2(sx - w * 0.5 + (10.0 if i % 2 == 0 else -24.0), yy)
		root.z_index = -6
		_region_node.add_child(root)
	# 5) 2º MARCO discreto na entrada do CORAÇÃO DAS RAÍZES (junção ashen↔deep, world y≈-1300): label ambiente
	# (sem [E], passivo) reforçando o tema. Só se a zona deep existe no merge.
	if _macro_zone_nodes.has("deep_grove"):
		var deep_sign := Node2D.new()
		deep_sign.position = Vector2(sx + 60.0, -1300.0)
		deep_sign.z_index = 0
		deep_sign.z_as_relative = true
		var dlabel := Label.new()
		dlabel.text = "✦ aqui o esquecimento se aprofunda"
		dlabel.position = Vector2(-110.0, -16.0)
		dlabel.modulate = Color(0.78, 0.72, 0.62, 0.9)
		dlabel.add_theme_font_size_override("font_size", 12)
		deep_sign.add_child(dlabel)
		_tag_on_top(dlabel)
		_region_node.add_child(deep_sign)

## Região cuja zona (rect global) contém o ponto p (""=nenhuma). Base do region-by-position canônico.
func _macro_region_at(p: Vector2) -> String:
	return MacroWorld.region_at(_macro_zone_rects, p)   # extraído p/ MacroWorld

## REGION-BY-POSITION (GRADUATION-1, FASE 2): só em CANONICAL. A cada frame persiste a posição global (em memória;
## gravada no próximo save) e, ao o Errante entrar BEM dentro de outra zona (histerese), troca a "região atual"
## disparando a MESMA cadeia canônica de "entrei na região". Chamado de _process.
func _macro_region_tick() -> void:
	if not _macro_canonical or _player == null:
		return
	GameState.cluster_pos = [_player.position.x, _player.position.y]   # persistência (gravada no save_game seguinte)
	var p: Vector2 = _player.position
	var cand := _macro_region_at(p)
	if cand == "" or cand == _macro_current_region:
		return
	for z in _macro_zone_rects:
		if str(z["region"]) == cand and (z["rect"] as Rect2).grow(-MACRO_REGION_HYST).has_point(p):
			_macro_enter_region(cand, false)   # histerese: só troca quando bem dentro da zona candidata
			return

## "Entrar" numa região do cluster canônico: replica a cadeia canônica do load_region (set_current_region +
## quest ativa + discovery + tutorial + HUD) E aponta _current_boss p/ o boss da zona (HUD/alvo). force=true na
## 1ª entrada (boot/portal). set_current_region autosalva (incl. cluster_pos/cluster_id) — só em CANONICAL.
func _macro_enter_region(region_id: String, force: bool) -> void:
	if region_id == "" or (not force and region_id == _macro_current_region):
		return
	_macro_current_region = region_id
	if _player != null:
		GameState.cluster_pos = [_player.position.x, _player.position.y]
	GameState.cluster_id = _cluster_of_region(region_id)
	GameState.set_current_region(region_id)   # autosave (campanha progride: gate OFF em canonical)
	_update_active_quest_for_region(region_id)
	_advance_discovery_quests(region_id)
	if region_id == "plains":
		_tutorial_event("entered_plains")
	elif region_id == "starter_village":
		_tutorial_event("entered_village")
	# boss-por-região: _current_boss = boss da zona atual (HUD + alvo de [J]); null se a zona não tem boss
	_current_boss = null
	_boss_name = ""
	for b in _macro_bosses:
		if str(b["region"]) == region_id and is_instance_valid(b["node"]):
			_current_boss = b["node"]
			_boss_name = str(b["name"])
			_boss_dmg_min = int(b["dmg_min"])
			_boss_dmg_max = int(b["dmg_max"])
	_refresh_region_hud()
	_refresh_boss_hud()
	_show_arrival_card(region_id)   # P0.3 — "cheguei a um lugar" (debounce + não anuncia o ponto de partida)

## Aviso grande no topo da tela (feedback DEV da macro-zona). Lazy: cria um Label numa CanvasLayer alta 1×.
func _macro_toast_show(msg: String) -> void:
	if _macro_toast == null:
		var layer := CanvasLayer.new()
		layer.layer = 200
		add_child(layer)
		_macro_toast = Label.new()
		_macro_toast.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		_macro_toast.anchor_right = 1.0
		_macro_toast.offset_top = 24.0
		_macro_toast.add_theme_font_size_override("font_size", 18)
		_macro_toast.add_theme_color_override("font_color", Color("ffe6b0"))
		_macro_toast.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.95))
		_macro_toast.add_theme_constant_override("outline_size", 6)
		layer.add_child(_macro_toast)
	_macro_toast.text = msg
	_macro_toast.visible = true
	_macro_toast.modulate.a = 1.0
	var tw := create_tween()
	tw.tween_interval(3.0)
	tw.tween_property(_macro_toast, "modulate:a", 0.0, 1.2)

## CARTÃO discreto e breve no centro-superior: TÍTULO grande + SUBTÍTULO em tom contido, com fade-in/out.
## Reutilizado por P0.3 (chegada à região) e P0.5 (passagem ao cruzar um guardião). Lazy; NÃO persiste; NÃO toca
## save/combate/economia. Só aparece se estiver na árvore (headless/destacado = no-op seguro, sem tween).
func _show_banner_card(title: String, subtitle: String, title_color: Color = Color("ffe6b0")) -> void:
	if not is_inside_tree():
		return
	if _banner_layer == null:
		_banner_layer = CanvasLayer.new()
		_banner_layer.layer = 201
		add_child(_banner_layer)
		_banner_box = VBoxContainer.new()
		_banner_box.anchor_right = 1.0
		_banner_box.offset_top = 96.0
		_banner_box.alignment = BoxContainer.ALIGNMENT_CENTER
		_banner_box.add_theme_constant_override("separation", 2)
		_banner_box.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_banner_layer.add_child(_banner_box)
		_banner_title = Label.new()
		_banner_title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		_banner_title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		_banner_title.add_theme_font_size_override("font_size", 30)
		_banner_title.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.95))
		_banner_title.add_theme_constant_override("outline_size", 7)
		_banner_box.add_child(_banner_title)
		_banner_sub = Label.new()
		_banner_sub.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		_banner_sub.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		_banner_sub.add_theme_font_size_override("font_size", 15)
		_banner_sub.add_theme_color_override("font_color", Color(0.84, 0.79, 0.66, 0.92))   # tom contido/sépia
		_banner_sub.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.9))
		_banner_sub.add_theme_constant_override("outline_size", 5)
		_banner_box.add_child(_banner_sub)
	_banner_title.text = title
	_banner_title.add_theme_color_override("font_color", title_color)
	_banner_sub.text = subtitle
	_banner_box.visible = true
	_banner_box.modulate.a = 0.0
	var tw := create_tween()
	tw.tween_property(_banner_box, "modulate:a", 1.0, 0.6)
	tw.tween_interval(2.8)
	tw.tween_property(_banner_box, "modulate:a", 0.0, 1.4)

## P0.3 — ao CHEGAR a uma região (travessia), anuncia "cheguei a um lugar": nome + identidade emocional.
## Debounce: não repete a mesma região; e NÃO anuncia o ponto de partida (1ª região da sessão = boot/continuar) —
## a recompensa é o ATO de chegar viajando, não dar boot. Só regiões em REGION_ARRIVAL anunciam.
func _show_arrival_card(region_id: String) -> void:
	if region_id == "" or region_id == _arrival_last:
		return
	var was_first := _arrival_last == ""
	_arrival_last = region_id
	if was_first:
		return
	if not REGION_ARRIVAL.has(region_id):
		return
	_show_banner_card(_region_display_name(region_id), str(REGION_ARRIVAL[region_id]), Color("ffe6b0"))

## P0.5 — ao derrotar um GUARDIÃO, antes de qualquer recompensa material: "cruzei um limiar". Enfatiza PASSAGEM /
## caminho liberado / região alcançada. Puro enquadramento (não toca loot/economia/progressão/combate).
func _show_passage_card(boss_name: String) -> void:
	var sub := str(GUARDIAN_PASSAGE.get(boss_name, GUARDIAN_PASSAGE_FALLBACK))
	_show_banner_card("✦ Limiar cruzado", sub, Color("ffd27a"))

## Borda escura ao redor do MUNDO inteiro (macro-zona), no lugar das bordas por-região suprimidas.
func _macro_world_border(size: Vector2) -> void:
	var t := 36.0
	var col := Color(0.05, 0.06, 0.08, 0.85)
	for r in [Rect2(0, 0, size.x, t), Rect2(0, size.y - t, size.x, t), Rect2(0, 0, t, size.y), Rect2(size.x - t, 0, t, size.y)]:
		var b := ColorRect.new()
		b.size = r.size; b.position = r.position; b.color = col; b.z_index = -17
		_region_node.add_child(b)

## Cor representativa do chão de uma região, p/ o BLEND das costuras (GODOT-CONTINUOUS-WORLD-SEAM-CONNECTORS-1).
## Prioriza o base_color do manifesto (regiões editor-authored); senão _ground_base_color; com um ajuste p/ a Vila
## (procedural sem entrada própria) → tom de praça/grama aproximado p/ a costura não escurecer.
func _macro_seam_color(region_id: String) -> Color:
	var mr := _manifest_for(region_id)
	if not mr.is_empty():
		var g = mr.get("ground", {})
		if typeof(g) == TYPE_DICTIONARY and g.has("base_color"):
			return Color(str(g["base_color"]))
	if region_id == "starter_village":
		return Color("4f6a3a")   # praça/grama da Vila (aprox., só p/ o blend de costura)
	return _ground_base_color(region_id)

## SEAM CONNECTORS (A2): suaviza VISUALMENTE as junções INTERNAS do cluster (chão corta seco grama→terra→rocha)
## com uma faixa de transição feathered (gradiente dither das cores dos 2 vizinhos) só nas costuras internas — NÃO
## nas bordas externas do mundo. RENDER-ONLY: só ColorRects em z negativo (acima do chão, abaixo dos props); SEM
## blocker/colisão/mudança de layout. Detecta adjacência pelos rects abutindo (gap=0).
const SEAM_BAND := 220.0    # largura total da faixa de transição (px), centrada na costura
const SEAM_STRIPS := 24     # nº de tiras do gradiente
const SEAM_PEAK_ALPHA := 0.6
func _build_seam_connectors(members: Array) -> void:
	if members.size() < 2:
		return
	var container := Node2D.new()
	container.name = "SeamConnectors"
	_region_node.add_child(container)
	for i in members.size():
		for j in range(i + 1, members.size()):
			# ★★★ FIELD FIX 05/09/2026 — A "BANDA VERDE" DO SCREENSHOT ERA ISTO.
			# Provado pela sonda `_pve_map_probe.gd`: 24 ColorRects de ~10px, 1600px de altura,
			# com a cor CHAPADA da região (#3c6b34), em **z=-8** — ou seja, POR CIMA do chão
			# pintado (z=-21). Formavam uma faixa de 220px de altura total na costura
            # starter_village↔plains, com a borda vertical nítida que apareceu em campo.
			# O conector existe para suavizar corte seco entre chãos PROCEDURAIS (grama→terra→rocha).
			# ⛔ Chão PINTADO é arte autoral: não se mistura com cor chapada por cima.
			# Isto NÃO é máscara nem z-index: a faixa deixa de ser CRIADA quando qualquer lado é pintado.
			if _region_has_painted_ground(str(members[i]["id"])) or _region_has_painted_ground(str(members[j]["id"])):
				continue
			var ra := Rect2(members[i]["offset"], members[i]["size"])
			var rb := Rect2(members[j]["offset"], members[j]["size"])
			var ca := _macro_seam_color(str(members[i]["id"]))
			var cb := _macro_seam_color(str(members[j]["id"]))
			# costura VERTICAL: bordas direita/esquerda coincidem + faixa-Y se sobrepõe
			var ax_r := ra.position.x + ra.size.x
			var bx_r := rb.position.x + rb.size.x
			var oy0 := maxf(ra.position.y, rb.position.y)
			var oy1 := minf(ra.position.y + ra.size.y, rb.position.y + rb.size.y)
			if oy1 - oy0 > 1.0:
				if abs(ax_r - rb.position.x) < 0.5:   # A à esquerda, B à direita
					_draw_seam_band(container, "v", ax_r, oy0, oy1, ca, cb)
				elif abs(bx_r - ra.position.x) < 0.5:  # B à esquerda, A à direita
					_draw_seam_band(container, "v", bx_r, oy0, oy1, cb, ca)
			# costura HORIZONTAL: bordas baixo/cima coincidem + faixa-X se sobrepõe
			var ay_b := ra.position.y + ra.size.y
			var by_b := rb.position.y + rb.size.y
			var ox0 := maxf(ra.position.x, rb.position.x)
			var ox1 := minf(ra.position.x + ra.size.x, rb.position.x + rb.size.x)
			if ox1 - ox0 > 1.0:
				if abs(ay_b - rb.position.y) < 0.5:   # A em cima, B embaixo
					_draw_seam_band(container, "h", ay_b, ox0, ox1, ca, cb)
				elif abs(by_b - ra.position.y) < 0.5:  # B em cima, A embaixo
					_draw_seam_band(container, "h", by_b, ox0, ox1, cb, ca)

## Desenha UMA faixa de costura. axis "v" (linha vertical em seam=x) ou "h" (linha horizontal em seam=y); span0..span1
## é a extensão ao longo da costura; colA→colB do lado A p/ o lado B. Alpha triangular (0 nas pontas, pico no meio)
## → feathered, sem bordas duras. z=-8 (acima do chão/overlay, abaixo dos props em z>=0).
func _draw_seam_band(container: Node2D, axis: String, seam: float, span0: float, span1: float, col_a: Color, col_b: Color) -> void:
	var band := Node2D.new()
	band.set_meta("axis", axis)
	band.set_meta("seam", seam)
	container.add_child(band)
	var step := SEAM_BAND / float(SEAM_STRIPS)
	for s in range(SEAM_STRIPS):
		var t := float(s) / float(SEAM_STRIPS - 1)        # 0..1 de A→B
		var tri := 1.0 - absf(t - 0.5) * 2.0              # triangular: 0 nas pontas, 1 no centro
		var rect := ColorRect.new()
		var c := col_a.lerp(col_b, t)
		c.a = SEAM_PEAK_ALPHA * tri
		rect.color = c
		rect.z_index = -8
		if axis == "v":
			rect.position = Vector2(seam - SEAM_BAND * 0.5 + s * step, span0)
			rect.size = Vector2(step + 1.0, span1 - span0)
		else:
			rect.position = Vector2(span0, seam - SEAM_BAND * 0.5 + s * step)
			rect.size = Vector2(span1 - span0, step + 1.0)
		band.add_child(rect)

## Limpeza comum ao SAIR da macro-zona (por F4 OU por portal externo): desliga o modo macro e tira o Errante da
## árvore da macro ANTES que o load_region seguinte dê queue_free no _region_node (senão o Errante seria liberado
## junto). Quem chama faz o load_region (p/ a região salva no toggle, ou p/ o target do portal). NÃO toca o save.
func _macro_exit_cleanup() -> void:
	_macro_mode = false
	_macro_sandbox = false
	_macro_canonical = false
	_suppress_internal_borders = false
	_macro_current_region = ""
	_macro_zone_rects = []
	_macro_bosses = []
	# saiu do cluster → zera a marca de persistência (boot da região vizinha NÃO deve re-entrar no cluster)
	GameState.cluster_id = ""
	GameState.cluster_pos = []
	if _player != null:
		if _player.get_parent() != self:
			_player.reparent(self, true)   # Y-SORT: Errante estava reparentado na macro (=_region_node)
		_player.z_index = 1   # restaura o z normal (produção sobrescreve via _update_depth_sort por frame)
		_player.z_as_relative = true

## Sai da macro-zona (F4 de novo): recarrega a região salva. NÃO toca o save (a macro nunca chamou
## set_current_region → current_region_id segue a região real anterior).
func _exit_macro_zone() -> void:
	_macro_exit_cleanup()
	load_region(GameState.current_region_id)
	_macro_toast_show("Voltou ao mundo normal (região salva).")

## Tamanho do mundo por região (maior que a viewport 1280x720).
func _region_world_size(region_id: String) -> Vector2:
	if _is_manifest_region(region_id):
		var mr := _manifest_for(region_id)
		if not mr.is_empty() and mr.has("size"):
			return Vector2(float(mr["size"][0]), float(mr["size"][1]))
	match region_id:
		"cave": return Vector2(1800, 1200)
		"starter_village": return Vector2(2200, 1600)   # HUB ampliado (GODOT-VILLAGE-HUB-EXPANSION-1): praça central + 4 corredores
		"swamp": return Vector2(2000, 1400)              # Pântano de Ferro (MVP)
		"swamp_pit": return Vector2(1000, 800)           # Poço do Ferro-Velho (subárea/arena do Coloso)
		"old_road": return Vector2(2200, 1300)           # Ruínas da Estrada Velha (leste)
		"ashen_grove": return Vector2(2200, 1300)        # Bosque de Cinza (norte)
		"deep_grove": return Vector2(1800, 1300)         # Coração das Raízes Negras (subárea norte do Bosque)
		"ancient_root_nest": return Vector2(1700, 1200)  # Ninho da Raiz Ancestral (fechamento do arco, norte do Deep Grove)
		"saltwind_shore": return Vector2(2200, 1300)     # Costa do Sal-Vento (litoral/deserto, leste da Estrada Velha)
		"castaway_sandbar": return Vector2(1500, 950)    # Banco de Areia dos Náufragos (1ª escala pós-barco; pequena)
		"salt_split_isle": return Vector2(1800, 1200)    # Ilha do Sal Partido (2ª escala; média)
		"khet_sar_sands": return Vector2(2000, 1300)     # Areais de Khet-Sar (1ª região desértica; média)
