	path.region_rect = Rect2(0, 0, size.x, 210)
	path.position = Vector2(0, size.y * 0.5 - 40)
	path.z_index = -18
	_region_node.add_child(path)
	_add_map_borders(size)
	_scatter_path_detail(size)
	_scatter_plains_props(size)

## Bordas do caminho de terra: poucos tufos IRREGULARES quebrando as duas linhas retas da estrada
## (esparso — não cobre o mapa). O jitter perpendicular dithera o corte reto.
func _scatter_path_detail(size: Vector2) -> void:
	var top := size.y * 0.5 - 40.0
	var bot := size.y * 0.5 + 170.0
	var n := int(size.x / 340.0)   # esparso (~7 numa Planície 2400 de largura)
	_scatter_edge_tufts(Vector2(140, top), Vector2(size.x - 140, top), n, 24.0, 0.17)
	_scatter_edge_tufts(Vector2(190, bot), Vector2(size.x - 190, bot), n, 24.0, 0.61)

## Props reais da Planície: árvores/pedras/arbustos nas bordas (clareira jogável no meio) + flores
## + a ENTRADA DA CAVERNA no portal. Posições normalizadas (evitam o caminho e os atores centrais).
func _scatter_plains_props(size: Vector2) -> void:
	var P := "res://assets/tilesets/plains/props/"
	# árvores/pedras = props ALTOS → y-sort (entram na frente/atrás do Errante) + blocker no tronco
	for n in [Vector2(0.08, 0.13), Vector2(0.9, 0.15), Vector2(0.12, 0.88), Vector2(0.85, 0.85), Vector2(0.5, 0.07)]:
		var p := Vector2(size.x * n.x, size.y * n.y)
		_add_prop(P + "tree.png", p, 0, true, 36.0)
		_add_blocker(Rect2(p.x - 24, p.y + 4, 48, 38))    # tronco bloqueia (copa é atravessável)
	for n in [Vector2(0.3, 0.1), Vector2(0.68, 0.12), Vector2(0.22, 0.9), Vector2(0.62, 0.9)]:
		var p := Vector2(size.x * n.x, size.y * n.y)
		_add_prop(P + "tree2.png", p, 0, true, 30.0)
		_add_blocker(Rect2(p.x - 18, p.y + 2, 36, 30))
	for n in [Vector2(0.24, 0.4), Vector2(0.78, 0.62), Vector2(0.6, 0.3)]:
		var p := Vector2(size.x * n.x, size.y * n.y)
		_add_prop(P + "rock.png", p, 0, true, 12.0)
		_add_blocker(Rect2(p.x - 34, p.y - 8, 68, 48))
	# arbustos/flores/troncos = detalhe atravessável, no chão (z negativo, atrás dos atores)
	for n in [Vector2(0.4, 0.62), Vector2(0.15, 0.55), Vector2(0.55, 0.86)]:
		_add_prop(P + "bush.png", Vector2(size.x * n.x, size.y * n.y), -14)
	for n in [Vector2(0.35, 0.5), Vector2(0.5, 0.46), Vector2(0.7, 0.72), Vector2(0.45, 0.8), Vector2(0.28, 0.72)]:
		_add_prop(P + "flowers.png", Vector2(size.x * n.x, size.y * n.y), -13)
	# entrada da caverna: sprite no portal (y-sort) + paredes laterais bloqueantes (boca aberta p/ o [E])
	_add_prop(P + "cave.png", PLAINS_PORTAL, 0, true, 60.0)
	_add_blocker(Rect2(PLAINS_PORTAL.x - 122, PLAINS_PORTAL.y - 70, 58, 135))
	_add_blocker(Rect2(PLAINS_PORTAL.x + 64, PLAINS_PORTAL.y - 70, 58, 135))
	_build_west_exit(size)

## Saída de mapa OESTE (Planície → Vila): a estrada principal já alcança a borda oeste nesta faixa,
## então só MARCAMOS a saída com uma placa + tufos irregulares. SEM cercas/blocos sobre a estrada.
func _build_west_exit(_size: Vector2) -> void:
	var SV := "res://assets/tilesets/starter_village/"
	var y := PLAINS_TO_VILLAGE.y
	_add_prop(SV + "signpost.png", Vector2(PLAINS_TO_VILLAGE.x + 40.0, y - 92.0), 0, true, 26.0)
	# tufos quebrando as bordas da estrada perto da saída (atravessáveis, esparsos)
	_scatter_edge_tufts(Vector2(PLAINS_TO_VILLAGE.x + 40.0, y - 78.0), Vector2(PLAINS_TO_VILLAGE.x + 320.0, y - 78.0), 3, 16.0, 0.2)
	_scatter_edge_tufts(Vector2(PLAINS_TO_VILLAGE.x + 60.0, y + 80.0), Vector2(PLAINS_TO_VILLAGE.x + 340.0, y + 80.0), 3, 16.0, 0.7)

## Tufos esparsos e IRREGULARES ao longo de uma linha (borda de estrada/praça) — quebram o corte reto
## sem cobrir o mapa. Deslocamento perpendicular pseudo-aleatório estável (passo φ; não treme no reload).
func _scatter_edge_tufts(p0: Vector2, p1: Vector2, count: int, jitter: float, seed_f: float) -> void:
	if count < 1:
		return
	var O := "res://assets/tilesets/plains/overlays/"
	var dirv := (p1 - p0).normalized()
	var perp := Vector2(-dirv.y, dirv.x)
	var f := seed_f
	for i in range(count):
		f = fmod(f + 0.6180339887, 1.0)
		var t := (float(i) + 0.5) / float(count)
		var pos := p0.lerp(p1, t) + perp * (f - 0.5) * 2.0 * jitter
		_add_prop(O + "tuft%d.png" % (i % 3), pos, -15)

## `ysort=true` (props ALTOS: prédios/árvores/fonte/arco…) usa z = base_y p/ entrar na frente/atrás
## do Errante. `ysort=false` (detalhe de chão: grama/flores/tufos) usa z fixo (geralmente negativo).
## `base_off` desloca o "pé" do sprite (px abaixo do centro) p/ a ordenação por Y bater no chão.
func _add_prop(path: String, pos: Vector2, z: int = 0, ysort: bool = false, base_off: float = 0.0) -> void:
	var tex := _try_load_tex(path)
	if tex == null:
		return
	var s := Sprite2D.new()
	s.texture = tex
	s.position = pos
	s.z_index = int(pos.y + base_off) if ysort else z
	_region_node.add_child(s)

## Registra um obstáculo. `level` (default 0) = andar do blocker (VERTICALITY F1). O nível 0 também alimenta
## `_blockers` (a lista ativa legada) → TODOS os callers atuais (sem o arg) ficam IDÊNTICOS. Níveis>0 só existem
## no vlab; a colisão filtra pelo nível ativo do Errante (_set_floor_level troca a lista no player).
func _add_blocker(rect: Rect2, level := 0) -> void:
	if not _blockers_by_level.has(level):
		_blockers_by_level[level] = []
	(_blockers_by_level[level] as Array).append(rect)
	if level == 0:
		_blockers.append(rect)

# ─────────────────────────────────────────────────────────────────────────────
# VERTICALIDADE — FASE 1 (VERTICALITY_FOUNDATION_PASS_01). Fundação mínima + laboratório isolado `vlab`.
# ─────────────────────────────────────────────────────────────────────────────
## Contêiner de um andar: z_index = nível (inteiro PEQUENO, longe de 4095) ordena ENTRE andares; y_sort_enabled
## ordena DENTRO do andar (nativo, sem teto de z). Pai (_region_node) NÃO é y_sort → não reordena os andares.
func _floor_container(level: int, z := -1) -> Node2D:
	if _floor_containers.has(level):
		return _floor_containers[level]
	var c := Node2D.new()
	c.name = "Floor%d" % level
	c.y_sort_enabled = true
	# z ENTRE andares = inteiro PEQUENO. Default = o próprio nível (vlab: base é contêiner z=0). HÍBRIDO (Pedra):
	# a base é o plano legado com z=int(y) até ~size.y, então o terraço precisa de z > esse alcance (passado em `z`).
	c.z_index = z if z >= 0 else level
	c.z_as_relative = false
	_region_node.add_child(c)
	_floor_containers[level] = c
	return c

## Troca o andar ATIVO do Errante: (1) colisão passa a ver só os blockers do nível; (2) marca floor_level no player;
## (3) reparenta pro contêiner do nível (y-sort nativo do andar), preservando a posição global. Sem teleporte.
func _set_floor_level(lvl: int) -> void:
	if lvl == _floor_level:
		return
	var ascending: bool = lvl > _floor_level   # VERTICALITY_FEEL: subir tem respiro/abertura; descer é silencioso
	_floor_level = lvl
	var lst: Array = _blockers_by_level.get(lvl, [])
	if _player != null and _player.has_method("set_blockers"):
		_player.call("set_blockers", lst)
	if _player != null:
		_player.set("floor_level", lvl)
	var cont: Node2D = _floor_containers.get(lvl, null)
	if cont != null:
		if _player != null and _player.get_parent() != cont:
			_player.reparent(cont, true)   # preserva posição global (contêineres ficam em 0,0)
			_player.z_index = 0
			_player.z_as_relative = true
	else:
		# nível LEGADO (sem contêiner, ex.: base da Pedra) → Errante volta ao pai legado (Main); z manual via _update_depth_sort
		if _player != null and _player.get_parent() != self:
			_player.reparent(self, true)
			_player.z_as_relative = true
	if _player != null and _camera != null and _camera.has_method("reset_smoothing"):
		_camera.reset_smoothing()   # sem salto de câmera no reparent
	if ascending and _vertical_mode:
		_stair_ascend_feel()   # VERTICALITY_FEEL_PASS_01: a chegada ao alto é PERCEBIDA (não-UI, sem cutscene)

## VERTICALITY_FEEL_PASS_01 — o "respiro" de chegar no alto: micro-abertura de câmera (o mundo se abre = altura) +
## respiro do ECO da Pedra (dormente sem asset) + um lampejo curto de luz no terraço. Sem UI, sem texto, sem
## cutscene; tudo se desfaz sozinho. Só ao SUBIR (descer é silencioso). No-op fora do modo vertical.
func _stair_ascend_feel() -> void:
	# (1) respiro sonoro — reusa o eco da Pedra (silencioso sem o .ogg; nunca quebra)
	if _stone_echo_player != null and is_instance_valid(_stone_echo_player) and _stone_echo_player.stream != null and _stone_echo_player.is_inside_tree():
		_stone_echo_player.play()
	# (2) micro-abertura de câmera (zoom levíssimo p/ fora = "o mundo se abre lá de cima"); volta sozinha (sem cutscene)
	if _camera != null and is_instance_valid(_camera) and _camera.is_inside_tree():
		var z0: Vector2 = _camera.zoom
		var tw := _camera.create_tween()
		tw.tween_property(_camera, "zoom", z0 * 0.92, 0.45).set_trans(Tween.TRANS_SINE)
		tw.tween_property(_camera, "zoom", z0, 0.75).set_trans(Tween.TRANS_SINE)
	# (3) lampejo curto de luz no contêiner do andar alcançado (respiro VISUAL, não-UI)
	var cont: Node2D = _floor_containers.get(_floor_level, null)
	if cont != null:
		var flash := ColorRect.new()
		flash.color = Color(1.0, 0.95, 0.8, 0.0); flash.position = Vector2(1660.0, 96.0); flash.size = Vector2(680.0, 66.0)
		flash.z_index = 3; flash.z_as_relative = true; cont.add_child(flash)
		if flash.is_inside_tree():
			var ftw := flash.create_tween()
			ftw.tween_property(flash, "color:a", 0.16, 0.18).set_trans(Tween.TRANS_SINE)
			ftw.tween_property(flash, "color:a", 0.0, 0.55).set_trans(Tween.TRANS_SINE)
			ftw.tween_callback(flash.queue_free)

## VERTICALITY F2 — andar (floor_level) de um ATOR (mob/boss). Sem o campo → 0 (legado).
func _entity_floor(node) -> int:
	if node == null:
		return 0
	var v = node.get("floor_level")
	return int(v) if v != null else 0

## VERTICALITY F2 — um dict de entidade (_npcs/_services/_portals/_chests) está no andar ATIVO? (sem "level" = 0 = legado)
func _on_floor(d) -> bool:
	return int((d as Dictionary).get("level", 0)) == _floor_level

## Tick da troca de andar: a escada/rampa é um gatilho (Rect2). A troca ocorre só na ENTRADA do trecho (edge),
## com cooldown, pra não oscilar na borda. No-op fora do modo vertical (toda região não-vlab).
## VERTICALITY_FEEL_PASS_01 (revisão): a troca de andar é POSICIONAL, no TOPO da escada — não ao tocar a base.
## O Errante PERCORRE a escada (anda pra cima dela, no nível de origem) e só CRISTA no outro andar ao cruzar a linha
## de topo. Histerese (flip_up < flip_down) impede oscilação na beira. O jogador VÊ a subida e a transição no topo.
## VERTICALITY TRAVERSAL FIX (revisão 2): a troca de andar é DEPENDENTE DO CAMINHO, não uma linha mágica na coluna.
## LATCH por escada: o jogador só fica elegível a SUBIR se ENGATOU entrando pela BASE (lower_entry); a DESCER se
## engatou pelo TOPO (upper_entry). A troca só ocorre ao cruzar o limiar OPOSTO (sobe no topo / desce no pé). Sair da
## coluna cancela a travessia. Resultado: nunca troca fora do limiar, e a descida usa a MESMA conexão física da subida.
func _vertical_tick(_delta: float) -> void:
	if not _vertical_mode or _player == null:
		return
	var feet: Vector2 = _player.position + Vector2(0.0, 14.0)   # FEET_Y do PlayerController
	for z in _stair_zones:
		var r: Rect2 = z["rect"]
		var in_corr: bool = feet.x >= r.position.x and feet.x <= r.position.x + r.size.x and feet.y >= r.position.y and feet.y <= r.position.y + r.size.y
		if not in_corr:
			z["latch"] = "idle"   # saiu da escada (lateral/ponta) → cancela uma travessia pela metade
			continue
		var a := int(z["a"]); var b := int(z["b"])
		var latch := str(z.get("latch", "idle"))
		# ENGATA a travessia SÓ ao entrar pela ponta CORRETA (base p/ subir; topo p/ descer)
		if _floor_level == a and (z["lower_entry"] as Rect2).has_point(feet):
			latch = "from_lo"; z["latch"] = latch
		elif _floor_level == b and (z["upper_entry"] as Rect2).has_point(feet):
			latch = "from_hi"; z["latch"] = latch
		# TROCA só se engatado pela ponta certa E cruzou o limiar OPOSTO (mirror: sobe no topo, desce no pé)
		if latch == "from_lo" and _floor_level == a and feet.y <= float(z["flip_up"]):
			_set_floor_level(b); z["latch"] = "idle"; return
		elif latch == "from_hi" and _floor_level == b and feet.y >= float(z["flip_down"]):
			_set_floor_level(a); z["latch"] = "idle"; return

## LABORATÓRIO VERTICAL (vlab) — prova ISOLADA da arquitetura de andares (NÃO é conteúdo de mundo; só DEV).
## Nível 0 = chão (muro p/ provar colisão same-level + passagem POR BAIXO da ponte). Nível 1 = ponte/terraço
## (deck + parapeitos = blockers nível 1; passagem POR CIMA). Escada/rampa = gatilho que troca o nível. Objetivo:
## provar a arquitetura, não a beleza. Não toca Pedra/save/combate/economia/social.
