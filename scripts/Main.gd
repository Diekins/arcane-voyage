	_khet_deco_sprite(Vector2(880.0, 720.0), "res://assets/tilesets/deep_dunes/props/cracked_salt_plate.png", Vector2(-5.0, -25.0))   # piso de sal rachado da cidade
	_khet_deco_sprite(Vector2(1080.0, 800.0), "res://assets/tilesets/deep_dunes/props/cracked_salt_plate.png", Vector2(-5.0, -25.0))
	_khet_deco_sprite(Vector2(460.0, 260.0), "res://assets/tilesets/deep_dunes/props/wind_carved_stone.png", Vector2(-4.0, -21.0))   # yardangs (rocha esculpida pelo vento) no vazio
	_khet_deco_sprite(Vector2(520.0, 860.0), "res://assets/tilesets/deep_dunes/props/wind_carved_stone.png", Vector2(-4.0, -21.0))
	_khet_deco_sprite(Vector2(380.0, 720.0), "res://assets/tilesets/deep_dunes/props/dry_root_stump.png", Vector2(-3.0, -31.0))   # raízes secas mortas (sem copa)
	_khet_deco_sprite(Vector2(640.0, 300.0), "res://assets/tilesets/deep_dunes/props/dry_root_stump.png", Vector2(-3.0, -31.0))
