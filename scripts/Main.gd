## FATIA A7.2 — ciclo concluído → renda de Fragmentos escalada com a fase (fonte principal do sink de Refino).
func stagedirector_cycle_reward(global_stage: int) -> void:
	GameState.add_material_silent("Fragmentos", RewardMath.fragments_cycle(global_stage))

## FATIA A7.1 — encontro (APEX/BOSS) concluído em avanço → drops de suporte de refino (first-clear, §54/§55).
func stagedirector_encounter_cleared(global_stage: int) -> void:
	var drops: Array = GameState.grant_encounter_reward(global_stage)   # online (RNG normal); dedup por watermark
	if not drops.is_empty():
		GameState.save_game()
		for item_id in drops:
			_show_reward_popup("Suporte de refino: %s" % ItemDB.display_name(str(item_id)), Color("ffd27a"))

## FATIA A6 — reconcilia o mundo VIVO após o Prestígio (§33/§60). O GameState já foi resetado pelo PrestigeManager;
## aqui o StageDirector volta p/ 1-1 e o AutoPlay não briga com o reset (pausa breve, alvo antigo descartado,
## retoma o estado ON/OFF anterior). Fase 1-1 pronta → Auto (se estava ligado) recomeça o novo ciclo.
func prestige_apply_reset() -> void:
	var was_auto := _autoplay != null and _autoplay.enabled
	if _autoplay != null:
		_autoplay.set_enabled(false)          # pausa: nada de alvo/contador da fase antiga durante o reset
	_auto_target = null                        # descarta o alvo travado do ciclo anterior (evita stale)
	if _stagedirector != null:
		_stagedirector.reset_to_new_cycle()   # jornada idle → 1-1 (re-escala mobs vivos p/ a fase nova)
	if _autoplay != null:
		_autoplay.notify_region_changed()     # busca limpa (sem alvo antigo)
		_autoplay.set_enabled(was_auto)       # retoma exatamente o estado anterior (ON→ON, OFF→OFF)
	if _idlehud != null:
		_idlehud.refresh(true)

## FATIA A3 — re-escala os mobs VIVOS p/ a fase corrente, SEMPRE a partir do BASE IMUTÁVEL guardado no mob
## (nunca do já-escalado → sem acúmulo, §16). Encounter (mini-boss/boss) recebe o multiplicador extra.
func stagedirector_restat_mobs() -> void:
	if _stagedirector == null:
		return
	for m in _mobs:
		if not is_instance_valid(m):
			continue
		if not bool(m.get("has_base_stats")):
			continue
		var scaled: Dictionary = _stagedirector.scale_for_current(int(m.get("base_max_hp")), int(m.get("base_damage_min")), int(m.get("base_damage_max")))
		var new_max := int(scaled["max_hp"])
		m.set("max_hp", new_max)
		m.set("damage_min", int(scaled["damage_min"]))
		m.set("damage_max", int(scaled["damage_max"]))
		# ajusta o HP atual sem forçar cura: mantém, apenas cap ao novo teto (≥1 se vivo)
		var cur := int(m.get("hp"))
		if cur > new_max:
			m.set("hp", new_max)
	# FATIA A3.75: re-escala TAMBÉM o boss de região (Lobo/Golem) — SEMPRE como encontro de BOSS (×4/×1.3),
	# derivando do base imutável. Encontro novo/reset de tentativa → HP cheio escalado (§25/§26).
	if _target_alive(_current_boss) and bool(_current_boss.get("has_base_stats")):
		var bsc: Dictionary = _stagedirector.scale_boss_for_current(int(_current_boss.get("base_max_hp")), int(_current_boss.get("base_damage_min")), int(_current_boss.get("base_damage_max")))
		_current_boss.set("hp_max", int(bsc["max_hp"]))
		_current_boss.set("damage_min", int(bsc["damage_min"]))
		_current_boss.set("damage_max", int(bsc["damage_max"]))
		_current_boss.set("hp", int(bsc["max_hp"]))   # boss volta cheio na fase/tentativa (não carrega dano)

func _build_auto_marker() -> void:
	_auto_marker = Label.new()
	_auto_marker.text = "▼"
	_auto_marker.add_theme_font_size_override("font_size", 18)
	_auto_marker.add_theme_color_override("font_color", Color(1.0, 0.45, 0.38, 0.9))
	_auto_marker.z_index = Z_TAG   # acima dos props, abaixo do texto flutuante (Z_FX)
	_auto_marker.visible = false
	add_child(_auto_marker)

## Destaque discreto sobre o alvo travado (chevron flutuante). Some sem alvo.
func _update_auto_marker() -> void:
	if _auto_marker == null:
		return
	if _auto_target == null or not is_instance_valid(_auto_target):
		_auto_marker.visible = false
		return
	_auto_marker.global_position = _auto_target.position + Vector2(-6, -66)
	_auto_marker.visible = true

## --- Battle UI leve (GODOT-BATTLE-UI-1) ---

## Inimigos VIVOS (mobs + boss) da região atual dentro de BATTLE_LIST_RADIUS, ordenados por distância,
## limitados a BATTLE_LIST_MAX. Base tanto da lista quanto da navegação por [Tab].
func _battle_enemies() -> Array:
	var out: Array = []
	if _player == null:
		return out
	for m in _mobs:
		if _target_alive(m):
			var d: float = _player.position.distance_to(m.position)
			if d <= BATTLE_LIST_RADIUS:
				out.append({"e": m, "d": d})
	if _target_alive(_current_boss):
		var db: float = _player.position.distance_to(_current_boss.position)
		if db <= BATTLE_LIST_RADIUS:
			out.append({"e": _current_boss, "d": db})
	out.sort_custom(func(a, b): return a["d"] < b["d"])
	var res: Array = []
	for i in range(mini(out.size(), BATTLE_LIST_MAX)):
		res.append(out[i]["e"])
	return res

## [Tab]: move o cursor de seleção p/ o PRÓXIMO inimigo listado (sem atacar; [J] confirma).
func _battle_cycle_selection() -> void:
	var list := _battle_enemies()
	if list.is_empty():
		_battle_sel = null
		return
	var idx: int = list.find(_battle_sel)   # -1 se o cursor não está na lista → começa no 1º
	_battle_sel = list[(idx + 1) % list.size()]

## Seleciona um inimigo (via clique na linha, clique no mundo, ou confirmação): vira cursor E alvo.
## NÃO desfere golpe aqui — só TRAVA; o auto-attack existente bate respeitando cooldown/alcance (sem
## duplicar dano/XP/loot/quest). Ignora alvos mortos/inválidos. NPCs/baús/serviços nunca chegam aqui.
func _select_enemy(e) -> void:
	if not _target_alive(e):
		return
	_battle_sel = e
	_set_auto_target(e)
	_auto_lost_t = 0.0
	# clique = "vá até ele e ataque": liga a perseguição (WASD cancela). Descarta flag de WASD obsoleto.
	if _player != null:
		_player.call("take_manual_cancel")
		_auto_walk = true
		_player.call("set_move_target", e.position, _attack_range_now() * 0.85)

## Inimigo (mob ou boss) VIVO sob um ponto do mundo `mp` (nearest-to-click, raio por tipo). Só varre
## `_mobs` + `_current_boss` — NPCs/baús/serviços ficam de fora (não viram alvo por engano).
func _enemy_at_point(mp: Vector2):
	var best = null
	var bestd := INF
	for m in _mobs:
		if _target_alive(m):
			# centro do hit-test = meio do corpo (acima do pé/position), não o pezinho
			var d: float = mp.distance_to(m.position + Vector2(0.0, -MOB_CLICK_LIFT))
			if d <= MOB_CLICK_RADIUS and d < bestd:
				bestd = d
				best = m
	if _target_alive(_current_boss):
		var db: float = mp.distance_to(_current_boss.position + Vector2(0.0, -BOSS_CLICK_LIFT))
		if db <= BOSS_CLICK_RADIUS and db < bestd:
			bestd = db
			best = _current_boss
	return best

## Inimigo sob o cursor do mouse (mundo). Usa o player como referência de mundo (respeita a câmera).
func _enemy_at_mouse():
	if _player == null:
		return null
	return _enemy_at_point(_player.get_global_mouse_position())

## Clique esquerdo numa linha da Battle UI → seleciona o inimigo exibido naquela linha (sem golpe extra).
func _on_battle_row_input(event: InputEvent, idx: int) -> void:
	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
		if idx >= 0 and idx < _battle_row_enemy.size():
			_select_enemy(_battle_row_enemy[idx])

func _enemy_name(e) -> String:
	return _boss_name if e == _current_boss else str(e.get("mob_name"))

func _enemy_hp_frac(e) -> float:
	var cur: float
	var mx: float
	if e == _current_boss:
		cur = float(e.hp); mx = float(e.hp_max)
	else:
		cur = float(e.get("hp")); mx = float(e.get("max_hp"))
	if mx <= 0.0:
		return 0.0
	return clampf(cur / mx, 0.0, 1.0)

func _hp_hex(frac: float) -> String:
	if frac > 0.5: return "7fd98a"     # verde
	if frac > 0.25: return "e8c862"    # amarelo
	return "e07a6a"                    # vermelho

## Texto bbcode de Uma linha da lista: marcador (alvo/seleção) + nome + barra de HP + alcance.
func _battle_row_text(e, rng: float) -> String:
	var nm := _enemy_name(e)
	var frac := _enemy_hp_frac(e)
	var pct := int(round(frac * 100.0))
	var d: float = _player.position.distance_to(e.position)
	var mark := "  "
	var ncol := "e8eaf0"
	if e == _auto_target:
		mark = "▶ "; ncol = "ffd24a"     # alvo travado (dourado) — bate com o chevron
	elif e == _battle_sel:
		mark = "› "; ncol = "7fe0ff"      # cursor de seleção (ciano)
	var seg := 7
	var filled: int = int(round(frac * seg))
	var bar := "[color=#%s]%s[/color][color=#33383f]%s[/color]" % [_hp_hex(frac), "█".repeat(filled), "█".repeat(seg - filled)]
	var rtag := "[color=#7fd98a]•[/color]" if d <= rng else "[color=#6a7080]%dm[/color]" % int(d / 32.0)
	return "[color=#%s]%s%s[/color] %s [color=#9aa0ac]%d%%[/color] %s" % [ncol, mark, nm, bar, pct, rtag]

## Atualiza a lista a cada frame (reusa o pool de linhas). Esconde em menu/diálogo ou sem inimigos.
func _refresh_battle_ui(dialog_open: bool) -> void:
	if _battle_panel == null:
		return
	# cursor de seleção deixou de ser válido/próximo → solta
	if _battle_sel != null and (not _target_alive(_battle_sel) or _player == null or _player.position.distance_to(_battle_sel.position) > BATTLE_LIST_RADIUS):
		_battle_sel = null
	if dialog_open or _inv_open or _shop_open:
		_battle_panel.visible = false
		return
	var list := _battle_enemies()
	if list.is_empty():
		_battle_panel.visible = false
		return
	_battle_panel.visible = true
	var rng := _attack_range_now()
	for i in range(_battle_rows.size()):
		var row: RichTextLabel = _battle_rows[i]
		if i < list.size():
			row.visible = true
			_battle_row_enemy[i] = list[i]
			var txt := _battle_row_text(list[i], rng)
			if i == _battle_hover_row:   # hover discreto (fundo sutil) — sem arte nova
				txt = "[bgcolor=#ffffff14]%s[/bgcolor]" % txt
			row.text = txt
		else:
			row.visible = false
			_battle_row_enemy[i] = null
	_battle_panel.size.y = 30.0 + float(list.size()) * 20.0 + 8.0

## P0.2 — algum menu/overlay relevante aberto? (mantém a HUD cheia)
func _hud_menu_open() -> bool:
	return _inv_open or _shop_open or _mastery_open or _title_open or (_dialog != null and _dialog.is_open())

## P0.2 — momento tático? Atacando (auto-alvo) OU há inimigos próximos (reusa a visibilidade JÁ calculada do
## painel de batalha — sem recomputar). Barato; chamado depois de _refresh_battle_ui no _process.
func _hud_combat_active() -> bool:
	if _auto_target != null and is_instance_valid(_auto_target):
		return true
	return _battle_panel != null and _battle_panel.visible

## P0.2 — decide atenuar (exploração calma) × restaurar (combate/dano/menu). Lógica simples, sem framework de estados.
func _hud_explore_tick(delta: float, _dialog_open: bool) -> void:
	if _hud_layer == null:
		return
	if _hud_dmg_hold > 0.0:
		_hud_dmg_hold -= delta
	var tactical: bool = _hud_menu_open() or _hud_dmg_hold > 0.0 or _hud_combat_active()
	if tactical:
		_hud_idle_t = 0.0
		if _hud_dimmed:
			_set_hud_dim(false)   # RESTAURA imediato
		return
	# exploração calma
	if _hud_dimmed:
		return
	_hud_idle_t += delta
	if _hud_idle_t >= HUD_DIM_DELAY:
		_set_hud_dim(true)

## P0.2 — aplica a atenuação a TODOS os Controls de topo da HUD (modulate é herdado → cada subárvore inteira).
## Atenuar = fade curto e suave (não cinematográfico). Restaurar = INSTANTÂNEO (legibilidade imediata).
## NÃO toca _popup_layer (reward/level-up/derrota) nem o mundo — só a CanvasLayer da HUD persistente.
func _set_hud_dim(dim: bool) -> void:
	_hud_dimmed = dim
	if _hud_tween != null and _hud_tween.is_valid():
		_hud_tween.kill()
		_hud_tween = null
	if dim:
		if not is_inside_tree():
			return
		_hud_tween = create_tween().set_parallel(true)
		for c in _hud_layer.get_children():
			if c is CanvasItem:
				_hud_tween.tween_property(c, "modulate:a", HUD_DIM_ALPHA, 0.45)
	else:
		for c in _hud_layer.get_children():
			if c is CanvasItem:
				c.modulate.a = 1.0

## Depth-sort por Y dos atores que se MOVEM (Errante, boss, mobs): z = pé na tela, p/ entrarem na
## frente/atrás dos props altos (que recebem z = base_y no build). Props estáticos/NPCs já têm z fixo.
func _update_depth_sort() -> void:
	# MACRO-ZONA (GODOT-CONTINUOUS-WORLD-YSORT-1): a ordenação é por y_sort_enabled NATIVO (posicional, sem teto);
	# NÃO setar z manual aqui (z=pos.y estouraria em Y>4095 e brigaria com o y-sort). Produção single-region segue
	# usando o esquema manual abaixo, INTACTO (blast radius mínimo).
	if _macro_mode:
		return
	# VERTICALITY F1/F3: o Errante usa z MANUAL só quando NÃO está num contêiner de andar. Está em contêiner quando
	# o nível atual tem um (sempre p/ nível>0; no nível 0 só se a base for contêiner, ex.: vlab). Na Pedra (híbrido)
	# o nível 0 é o plano legado → z manual; no nível 1 (terraço) o y_sort do contêiner governa.
	var player_in_container: bool = _vertical_mode and (_floor_level > 0 or _floor_containers.has(0))
	if _player != null and not player_in_container:
		_player.z_index = int(_player.position.y + 14.0)   # pé do Errante (FEET_Y do controller)
	if _current_boss != null and is_instance_valid(_current_boss):
		_current_boss.z_index = int(_current_boss.position.y)
	for m in _mobs:
		if is_instance_valid(m):
			m.z_index = int(m.position.y)

## Vida ambiente dos NPCs (GODOT-WORLD-LIFE-AMBIENT-1): quando NÃO há fala/loja aberta, cada NPC dá
## viradas leves de cabeça (timer) e ENCARA o Errante quando ele chega perto — sem sair do posto. NPCs
## marcados com wander=true fazem um micro-passeio dentro de NPC_WANDER_RADIUS (volta sempre p/ o posto).
## Não toca o NPC em fala (a fala já o vira p/ o Errante) nem interfere em mob/combate.
func _npc_ambient_tick(delta: float, dialog_open: bool) -> void:
	if _player == null or dialog_open or _shop_open:
		return   # durante conversa/loja: foco na interação; a fala já cuida do encarar
	for n in _npcs:
		var anim = n["anim"]
		if anim == null:
			continue
		if anim == _talking_anim:
			continue   # NPC em fala: mantém encarando o Errante (não sobrepõe)
		if bool(n.get("wander", false)):
			_npc_microwander(n, delta)
			continue
		# ocioso: conta o timer; ao disparar, encara o Errante (se perto) ou dá uma olhada aleatória.
		var t := float(n.get("turn_t", 0.0)) - delta
		if t > 0.0:
			n["turn_t"] = t
			continue
		var to_player: Vector2 = _player.position - (n["pos"] as Vector2)
		if to_player.length() <= NPC_NOTICE_RADIUS:
			anim.set_direction(to_player)
			n["turn_t"] = randf_range(NPC_FACE_MIN, NPC_FACE_MAX)
		else:
			anim.set_direction(Vector2(randf_range(-1.0, 1.0), randf_range(-1.0, 1.0)))
			n["turn_t"] = randf_range(NPC_TURN_MIN, NPC_TURN_MAX)
		anim.play_idle()   # re-aplica a pose direcional PARADA (não vira "andar parado")

## Micro-passeio opcional de um NPC marcado (wander=true): desloca-se um tico perto do posto e volta;
## pausa entre passos; idle quando parado, walk só quando realmente desloca. Mantém o y-sort.
func _npc_microwander(n: Dictionary, delta: float) -> void:
	var node: Node2D = n["node"]
	var anim = n["anim"]
	var anchor: Vector2 = n["pos"]
	var wp := float(n.get("wpause", 0.0))
	if wp > 0.0:
		n["wpause"] = wp - delta
		anim.play_idle()
		return
	var target: Vector2 = n.get("wtarget", anchor)
	var to := target - node.position
	if to.length() <= 4.0:
		_npc_pick_wtarget(n, anchor)   # parada natural + próximo destino perto do posto (evita blockers)
		anim.play_idle()
		if randf() < 0.5:
			anim.set_direction(Vector2(randf_range(-1.0, 1.0), randf_range(-1.0, 1.0)))
		return
	var next_pos := node.position + to.normalized() * NPC_WANDER_SPEED * delta
	if _npc_blocked(next_pos):   # ia entrar num prop/pedra → escolhe outro destino, não atravessa
		_npc_pick_wtarget(n, anchor)
		anim.play_idle()
		return
	node.position = next_pos
	node.z_index = int(node.position.y) + int(n.get("z_off", 0))
	anim.play_walk(to)

## Escolhe um próximo destino do micro-wander perto do posto que NÃO caia num blocker (tenta alguns).
func _npc_pick_wtarget(n: Dictionary, anchor: Vector2) -> void:
	n["wpause"] = randf_range(NPC_TURN_MIN, NPC_TURN_MAX)
	for _i in range(5):
		var ang := randf() * TAU
		var t := anchor + Vector2(cos(ang), sin(ang)) * randf_range(8.0, NPC_WANDER_RADIUS)
		if not _npc_blocked(t):
			n["wtarget"] = t
			return
	n["wtarget"] = anchor   # fallback: volta pro posto (livre por construção)

## true se um ponto cai dentro de algum blocker da região (props/pedras) — p/ o NPC não atravessar.
func _npc_blocked(p: Vector2) -> bool:
	for r in _blockers:
		if r.has_point(p):
			return true
	return false

func _unhandled_input(event: InputEvent) -> void:
	# TELA INICIAL aberta (GODOT-TITLE-SCREEN-RPG-MVP-1): consome teclas do jogo (os botões da capa são UI
	# e seguem clicáveis); nada de andar/atacar/abrir painéis por trás. Sem [Esc]-fecha (escolha obrigatória).
	if _title_open:
		# ⚠️ DEV (GODOT-CONTINUOUS-WORLD-MACROZONE-1): F4 funciona MESMO na capa — dispensa a capa e já entra na
		# macro-zona (senão o F4 era engolido aqui e "não acontecia nada").
		if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_F4:
			_enter_game()   # dispensa a capa e já entra (F4=Khet · Shift+F4=inicial · Ctrl+F4=floresta vertical)
			var cl := "khet"
			if event.ctrl_pressed: cl = "forest"
			elif event.shift_pressed: cl = "starter"
			load_macro_zone(cl)
			get_viewport().set_input_as_handled()
			return
		if event is InputEventKey and event.pressed:
			get_viewport().set_input_as_handled()
		return
	# enquanto um diálogo está aberto, o DialoguePanel trata o avanço — ignoramos aqui.
	if _dialog != null and _dialog.is_open():
		return
	# com a loja/forja aberta: [E]/[I]/[Esc] fecham; o resto é consumido (não ataca/anda por trás).
	if _shop_open:
		if event is InputEventKey and event.pressed and not event.echo and event.keycode in [KEY_E, KEY_I, KEY_ESCAPE]:
			_close_shop()
			get_viewport().set_input_as_handled()
		return
	# Baú do Errante aberto (GODOT-VILLAGE-STASH-MVP-1): [E]/[I]/[Esc] fecham; o resto é consumido (modal).
	if _stash_open:
		if event is InputEventKey and event.pressed and not event.echo:
			if event.keycode in [KEY_E, KEY_I, KEY_ESCAPE]:
				_close_stash()
			get_viewport().set_input_as_handled()
		return
	# Painel de Maestrias aberto (GODOT-MASTERY-UI-MVP-1): [C]/[Esc] fecham; o resto é consumido (modal).
	if _mastery_open:
		if event is InputEventKey and event.pressed and not event.echo:
			if event.keycode in [KEY_C, KEY_ESCAPE]:
				_close_mastery()
			get_viewport().set_input_as_handled()
		return
	# [C] abre/fecha o Painel de Maestrias (GODOT-MASTERY-UI-MVP-1) — read-only.
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_C:
		_toggle_mastery()
		get_viewport().set_input_as_handled()
		return
	# interagir com o Aldric (Espaço/Enter via ui_accept, ou E) → dispara intro-mentor
	# pelo dispatcher (manual/direct: por id, ignora "já visto").
	var interact: bool = event.is_action_pressed("ui_accept") or (event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_E)
	# [E] escolhe a interação MAIS PRÓXIMA entre Aldric / cidadão / serviço da Vila / portal
	# (escolha previsível por distância; cada candidato respeita seu próprio raio).
	if interact:
		var act := _nearest_interaction()
		if not act.is_empty():
			match str(act["kind"]):
				"aldric":
					TriggerDispatcher.dispatch_scene(SCENE_ID)
				"npc":
					_talk_to_npc(act["ref"])
				"service":
					_use_service(act["ref"])
				"portal":
					_use_portal(act["ref"])
				"chest":
					_open_chest(act["ref"])
			get_viewport().set_input_as_handled()
			return
	# atacar com [J]: mob comum no alcance, ou o boss da região (só fora de diálogo)
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_J:
		_try_attack()
		get_viewport().set_input_as_handled()
		return
	# HABILIDADES-ASSINATURA por arquétipo (GODOT-MASTERY-ARCANA-SIGNATURE-1): [1]/[2]/[3] roteadas por arma.
	# support → kit do Oráculo (inalterado); magic + [1] → Detonação Arcana. (Precisão/Postura/Guarda virão.)
	if event is InputEventKey and event.pressed and not event.echo and event.keycode in [KEY_1, KEY_2, KEY_3]:
		_signature_ability(event.keycode)
		get_viewport().set_input_as_handled()
		return
	# (o clique no mundo é tratado em _input, antes da GUI — ver lá: cenário ColorRect=STOP rouba o clique)
	# recuperar o Errante (restaura HP + reposiciona) com [R]
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_R:
		_recover_hero()
		get_viewport().set_input_as_handled()
		return
	# abrir/fechar a mochila & equipamentos com [I]; [Esc]/[E] também FECHAM se estiver aberta
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_I:
		_toggle_inventory()
		get_viewport().set_input_as_handled()
		return
	if _inv_open and event is InputEventKey and event.pressed and not event.echo and event.keycode in [KEY_ESCAPE, KEY_E]:
		_toggle_inventory()
		get_viewport().set_input_as_handled()
		return
	# [O] esconde/mostra o paperdoll de equipamento; [M] o quadro de missão (GODOT-HUD-PANELS-ADJUST-1)
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_O:
		_toggle_equip_hud()
		get_viewport().set_input_as_handled()
		return
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_M:
		_toggle_tracker_hud()
		get_viewport().set_input_as_handled()
		return
	# [P] liga/desliga o AUTO (caça automática infinita, FATIA A1). Botão na HUD faz o mesmo.
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_P:
		_toggle_autoplay()
		get_viewport().set_input_as_handled()
		return
	# [T] TENTAR NOVAMENTE (FATIA A3): força nova tentativa da frontier quando o muro está ativo.
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_T:
		_stage_retry()
		get_viewport().set_input_as_handled()
		return
	# atalhos de DEBUG (só quando não há diálogo aberto):
	if event is InputEventKey and event.pressed and not event.echo:
		match event.keycode:
			KEY_F4:  # ⚠️ DEV: entra/sai da MACRO-ZONA contínua (offsets data-driven, GODOT-CONTINUOUS-WORLD-EDITOR-OFFSETS-1).
				# F4 = KHET · SHIFT+F4 = cluster INICIAL (Vila→Planície→Caverna) · CTRL+F4 = FLORESTA (coluna VERTICAL N→S).
				# Toggle: fora → monta; dentro → volta à região salva. Não toca o save (não chama set_current_region).
				if _macro_mode:
					_exit_macro_zone()
				else:
					var cl := "khet"
					if event.ctrl_pressed: cl = "forest"
					elif event.shift_pressed: cl = "starter"
					print("[DEV] entrando na macro-zona contínua: %s (mesma tecla sai)" % cl)
					load_macro_zone(cl)
				get_viewport().set_input_as_handled()
			KEY_F5:  # dev: dá o kit de itens de teste à mochila (espada/escudo/arco/cajado/lança/armadura/botas + poções)
				GameState.grant_test_items()
				get_viewport().set_input_as_handled()
			KEY_F6:  # próxima cena de nível pendente p/ o nível atual
				TriggerDispatcher.dispatch_next()
				get_viewport().set_input_as_handled()
			KEY_F7:  # level +1
				GameState.set_level(GameState.hero_level + 1)
				get_viewport().set_input_as_handled()
			KEY_F8:  # level -1
				GameState.set_level(GameState.hero_level - 1)
				get_viewport().set_input_as_handled()
			KEY_F9:  # simula concluir ch1-awakening → dispara after-wolf
				GameState.complete_quest("ch1-awakening")
				_tutorial_event("ch1_done")
				TriggerDispatcher.dispatch_event("quest_complete", "ch1-awakening")
				get_viewport().set_input_as_handled()
			KEY_F10: # debug: derrota instantânea do boss da região atual (Lobo OU Golem)
				if _current_boss != null and _current_boss.is_alive():
					_current_boss.call("force_defeated_state")
					_on_boss_defeated(_boss_name)
				get_viewport().set_input_as_handled()
			KEY_F11: # ⚠️ DEV TEMPORÁRIO (GODOT-MAPLOADER-LEGACY-OVERRIDE-PILOT-1): teleporta p/ as Ruínas da Estrada
				# Velha (old_road) p/ testar o legacy override SEM viajar o mapa. REMOVER após validar.
				print("[DEV] teleporte → old_road (teste do legacy override)")
				load_region("old_road")
				get_viewport().set_input_as_handled()
			KEY_F12: # resetar o save (debug) → estado inicial e recarregar a Vila dos Novatos
				GameState.reset_save()
				load_region("starter_village")   # reset volta p/ o hub seguro (herói reposicionado/destravado)
				get_viewport().set_input_as_handled()

func _near_aldric() -> bool:
	return _player != null and _aldric != null and _player.position.distance_to(_aldric.position) <= INTERACT_RADIUS

## Portal mais próximo no raio (a Planície tem 2): devolve o dict {node,prompt,target,pos} ou null.
func _nearest_portal():
	if _player == null:
		return null
	var best = null
	var best_d := PORTAL_RADIUS
	for p in _portals:
		var d: float = _player.position.distance_to(p["pos"])
		if d <= best_d:
			best_d = d
			best = p
	return best

## Cidadão da Vila mais próximo no raio de interação: devolve o dict ou null.
func _nearest_npc():
	if _player == null:
		return null
	var best = null
	var best_d := INTERACT_RADIUS
	for n in _npcs:
		var d: float = _player.position.distance_to(n["pos"])
		if d <= best_d:
			best_d = d
			best = n
	return best

## Serviço do hub mais próximo no raio de interação (curandeira/mural/santuário): dict ou null.
func _nearest_service():
	if _player == null:
		return null
	var best = null
	var best_d := INTERACT_RADIUS
	for s in _services:
		var d: float = _player.position.distance_to(s["pos"])
		if d <= best_d:
			best_d = d
			best = s
	return best

## Interação [E] mais próxima entre TODOS os candidatos da região (Aldric, cidadão, serviço,
## portal). Devolve {kind, ref?} do mais próximo (cada um já dentro do seu raio) ou {} se nenhum.
func _nearest_interaction() -> Dictionary:
	if _player == null:
		return {}
	var best := {}
	var best_d := INF
	var p := _player.position
	if _aldric != null:
		var da := p.distance_to(_aldric.position)
		if da <= INTERACT_RADIUS and da < best_d:
			best_d = da
			best = {"kind": "aldric"}
	# VERTICALITY F2: [E] só alcança entidades do MESMO andar (sem "level" = 0 = legado → idêntico).
	var npc = _nearest_npc()
	if npc != null and _on_floor(npc):
		var dn: float = p.distance_to(npc["pos"])
		if dn < best_d:
			best_d = dn
			best = {"kind": "npc", "ref": npc}
	var svc = _nearest_service()
	if svc != null and _on_floor(svc):
		var ds: float = p.distance_to(svc["pos"])
		if ds < best_d:
			best_d = ds
			best = {"kind": "service", "ref": svc}
	var portal = _nearest_portal()
	if portal != null and _on_floor(portal):
		var dp: float = p.distance_to(portal["pos"])
		if dp < best_d:
			best_d = dp
			best = {"kind": "portal", "ref": portal}
	var chest = _nearest_chest()
	if chest != null and _on_floor(chest):
		var dc: float = p.distance_to(chest["pos"])
		if dc < best_d:
			best_d = dc
			best = {"kind": "chest", "ref": chest}
	return best

## --- REGIÕES (GODOT-PHASE3-REGIONS-1) ---

## Reconstrói o conteúdo da região: libera o _region_node antigo, monta bg + entidades +
## portais da nova região, reposiciona o Errante e persiste a região atual.
func load_region(region_id: String) -> void:
	# FATIA A7.4.1: sinaliza "carga em progresso" → o WorldContentRouter se SUPRIME durante o teardown/rebuild
	# (o notify_region_changed abaixo re-emite stage_changed no meio da troca; sem este guard o router spawnaria
	# o boss na região que está sendo liberada ou re-entraria em _route_enter). Limpo no fim.
	_world_routing = true
	# desabilita o combate (boss + mobs) anterior antes de liberar (evita golpe-fantasma na transição)
	_set_world_combat(false)
	_close_overlays()   # mochila/loja/tooltip não podem ficar presos ao atravessar um portal
	# zera referências de entidades da região anterior ANTES de liberar os nós
	_wolf = null
	_golem = null
	_current_boss = null
	_boss_name = ""
	_mobs = []
	_drops = []
	_blockers = []
	# VERTICALITY F1: zera a fundação de andares (próxima região começa plana/nível 0 até um builder optar por níveis)
	_blockers_by_level = {}
	_vertical_mode = false
	_floor_level = 0
	_floor_containers = {}
	_stair_zones = []
	_stair_cd = 0.0
	_stair_inside = false
	_stone_echo_player = null
	_routine_npcs = []
	_aldric = null
	_aldric_prompt = null
	_aldric_anim = null
	_portals = []
	_npcs = []
	_services = []
	_chests = []
	_swamp_heal_used = false   # fonte do Pântano reabastece a cada nova entrada na região
	_transition_cd = 0.8       # auto-transição travada ~0.8s ao surgir (não reentra no portal de retorno)
	_auto_zone_active = null
	_clear_auto_target()       # troca de mapa cancela o auto-attack (mobs antigos viram refs inválidas)
	if _feedback_renderer != null:
		_feedback_renderer.clear_world()   # FATIA A8.1: floats/banner/warn da cena velha não sobrevivem à troca
	if _presence != null:
		_presence.clear_transient()        # FATIA A10: tentativa manual não sobrevive à troca de região (§56)
	if _autoplay != null:
		_autoplay.notify_region_changed()   # FATIA A1: reconcilia a caça com a nova região (busca limpa)
	if _stagedirector != null:
		_stagedirector.notify_region_changed()   # FATIA A2: re-resolve o conteúdo da fase p/ a nova região
	_talking_anim = null
	_guardian_seen = {}        # GUARDIAN-LANGUAGE-1: re-anuncia entradas na nova região
	_quiet_active = false; _quiet_nodes = []; _quiet_dwell = 0.0   # P2-G: zera o Aquietar (revive ao reentrar)
	# VERTICALITY F1 (CRÍTICO): se o Errante estava num contêiner de nível (filho de _region_node), reparenta p/ Main
	# ANTES de liberar a região — senão queue_free() levaria o player junto (mesmo perigo do macro). No-op em região
	# plana (player já é filho de self).
	if _player != null and _player.get_parent() != self:
		_player.reparent(self, true)
		_player.z_index = 1
		_player.z_as_relative = true
	if _region_node != null:
		_region_node.queue_free()
	_region_node = Node2D.new()
	_region_node.name = "Region"
	add_child(_region_node)

	_region_size = _region_world_size(region_id)
	_player_start = _region_spawn(region_id)
	if _pending_spawn.x != INF:   # override de spawn vindo de um portal (subárea/retorno) — uso único
		_player_start = _pending_spawn
		_pending_spawn = Vector2.INF
	_build_topdown_map(region_id, _region_size)
	# ★ MANIFESTO PRIMEIRO (GODOT-MAPLOADER-LEGACY-OVERRIDE-PILOT-1): editor-authored NOVO ou override legado
	# ATIVO+válido → layout do JSON, vencendo o _build_<id> da região antiga. Se o override estiver off/inválido,
	# _is_manifest_region é false → cai no builder original abaixo (fallback seguro). NÃO removi nenhum builder.
	_dispatch_region_builder(region_id, _region_size)
	_build_mobs(region_id)   # vila não tem config de mob → nenhum mob hostil
	_build_chests(region_id)   # baús one-time (GODOT-CHESTS-LOOT-RUNTIME-1): fechados = interagíveis; abertos = inertes
	if _current_boss != null and _current_boss.has_method("set_blockers"):
		_current_boss.call("set_blockers", _blockers)   # boss respeita props/cristais da arena

	# Errante no spawn, com clamp aos limites do MAPA; câmera limitada às bordas do mapa.
	if _player != null:
		_player.position = _player_start
		if not GameState.is_hero_defeated():
			_player.set("locked", false)
			if _player.has_method("set_downed"):
				_player.call("set_downed", false)   # limpa "abatido" ao trocar de região / F12
		_player.call("set_bounds", Vector2(MAP_MARGIN, MAP_MARGIN), _region_size - Vector2(MAP_MARGIN, MAP_MARGIN))
		_player.call("set_blockers", _blockers)   # obstáculos (árvores/pedras/paredes) montados na região
	if _camera != null:
		_camera.limit_left = 0
		_camera.limit_top = 0
		_camera.limit_right = int(_region_size.x)
		_camera.limit_bottom = int(_region_size.y)
		_camera.reset_smoothing()   # encaixa no Errante sem deslizar pelo mapa na troca

	GameState.set_current_region(region_id)   # persiste + emite state_changed (atualiza HUD)
	_update_active_quest_for_region(region_id)
	# tutorial: entrar na Planície / voltar à Vila avançam o onboarding (guardas em _tutorial_event)
	if region_id == "plains":
		_tutorial_event("entered_plains")
	elif region_id == "starter_village":
		_tutorial_event("entered_village")
	_advance_discovery_quests(region_id)   # quests kind="discovery" completam ao entrar na região (SWAMP-QUESTS)
	_refresh_region_hud()
	_refresh_boss_hud()
	_show_arrival_card(region_id)   # P0.3 — "cheguei a um lugar" (debounce + não anuncia o ponto de partida)
	if _region_diff_enabled():
		_region_diff_report(region_id)   # READ-ONLY (GODOT-MAPLOADER-DIFF-READONLY-F1): só loga; não muda nada
	_world_routing = false   # FATIA A7.4.1: carga concluída → o WorldContentRouter volta a reagir

## --- DIFF READ-ONLY código×Studio (GODOT-MAPLOADER-DIFF-READONLY-F1) ---
## Ferramenta de DEV: compara o que o código montou (estado já construído) vs o studio_<region>.json,
## logando divergências de map/spawn/markers/chests/portals/mobs/blockers/services. NÃO altera NADA do
## runtime (não troca fonte de dados; só LÊ os arrays e o JSON). Off por padrão. Ligar via:
##   const REGION_DIFF abaixo = true, OU env `AV_REGION_DIFF=1` (ex.: F5 com a variável setada).
const REGION_DIFF := false
## Regiões REAIS do runtime (p/ flagar portal-target inválido, ex.: "smoke_clearing").
const RUNTIME_REGIONS := ["plains", "cave", "starter_village", "swamp", "swamp_pit", "old_road", "ashen_grove", "deep_grove", "ancient_root_nest", "saltwind_shore", "castaway_sandbar", "salt_split_isle", "khet_sar_sands", "khet_caravan_camp", "khet_oasis", "khet_dune_overlook", "khet_salt_scrub", "khet_waystation", "khet_sar_city", "deep_dunes", "khet_sand_maw", "khet_colonnade", "khet_citadel", "great_archive", "praia_das_velas", "cais_dos_ausentes", "promontorio_do_espelho", "veins", "cathedral_of_crystal", "fendas", "iron_channels", "vlab", "arena"]

func _region_diff_enabled() -> bool:
	return REGION_DIFF or OS.has_environment("AV_REGION_DIFF")

## Conta itens distintos por uma chave num Array de dicts/nós → {valor: contagem}.
func _diff_tally_mobs() -> Dictionary:
	var t := {}
	for m in _mobs:
		if is_instance_valid(m):
			var k := str(m.get("mob_id"))
			t[k] = int(t.get(k, 0)) + 1
	return t

func _region_diff_report(region_id: String) -> void:
	var ml := MapLoader.new()
	var path := ml.find_map_for_target(region_id)
	if path == "":
		print("[RegionDiff] %s: SEM studio_*.json — runtime 100%% código (nada a comparar)" % region_id)
		return
	if not ml.load_map_json(path):
		print("[RegionDiff] %s: studio ilegível (%s) — só código" % [region_id, path])
		return
	var errs := ml.validate_min()
	if not errs.is_empty():
		print("[RegionDiff] %s: studio INVÁLIDO [%s] — só código" % [region_id, ", ".join(errs)])
		return
	print("[RegionDiff] ===== %s (%s) =====" % [region_id, path.get_file()])
	# map.id / size / spawn
	var sid := str(ml.map.get("id", ""))
	print("[RegionDiff] map.id: studio '%s' %s" % [sid, ("OK" if sid == region_id else "≠ região '%s'" % region_id)])
	var ssize := ml.map_size()
	print("[RegionDiff] size : código %s | studio %s  %s" % [_region_size, ssize, ("OK" if _region_size == ssize else "DIVERGE")])
	var sspawn := ml.map_spawn()
	print("[RegionDiff] spawn: código %s | studio %s  %s" % [_player_start, sspawn, ("OK" if _player_start == sspawn else "DIVERGE")])
	# markers por kind
	var mk := {}
	for x in ml.markers:
		if x is Dictionary:
			mk[str(x.get("kind", "?"))] = int(mk.get(str(x.get("kind", "?")), 0)) + 1
	print("[RegionDiff] markers studio por kind: %s" % str(mk))
	# CHESTS — studio markers chest vs runtime _chests (ativos). Devem casar (Studio é a fonte).
	var s_chests := int(mk.get("chest", 0))
	print("[RegionDiff] chests: runtime %d | studio %d  %s (chests JÁ vêm do Studio)" % [_chests.size(), s_chests, ("OK" if _chests.size() == s_chests else "DIVERGE")])
	# PORTALS — studio portals[] vs runtime _portals; flag target fora das regiões reais.
	var rt_targets := {}
	for p in _portals:
		rt_targets[str(p.get("target", ""))] = true
	print("[RegionDiff] portals: runtime %d | studio %d" % [_portals.size(), ml.portals.size()])
	for sp in ml.portals:
		if sp is Dictionary:
			var tgt := str(sp.get("target", ""))
			var bad := not RUNTIME_REGIONS.has(tgt)
			var miss := not rt_targets.has(tgt)
			var tags := []
			if bad: tags.append("TARGET INVÁLIDO (não é região runtime)")
			if miss and not bad: tags.append("não há portal equivalente no código")
			print("[RegionDiff]   studio portal '%s' → '%s'  %s" % [str(sp.get("id", "?")), tgt, ("⚠ " + "; ".join(tags)) if not tags.is_empty() else "OK"])
	# MOBS — markers mob do Studio vs mobs vivos do runtime (layout/contagem; stats NÃO comparados).
	var rt_mobs := _diff_tally_mobs()
	var rt_total := 0
	for k in rt_mobs: rt_total += int(rt_mobs[k])
	var s_mob_ids := {}
	for x in ml.markers:
		if x is Dictionary and str(x.get("kind", "")) == "mob":
			s_mob_ids[str(x.get("mobId", x.get("mob_id", "?")))] = true
	print("[RegionDiff] mobs: runtime %d nós (%s) | studio %d markers (%s)" % [rt_total, str(rt_mobs.keys()), int(mk.get("mob", 0)), str(s_mob_ids.keys())])
	if int(mk.get("mob", 0)) < rt_total:
		print("[RegionDiff]   ⚠ mobs do Studio DEFASADOS vs código (não migrar mobs ainda — F4 híbrido)")
	# BLOCKERS — contagem (não compara geometria célula a célula).
	print("[RegionDiff] blockers: runtime %d | studio %d  %s" % [_blockers.size(), ml.blockers.size(), ("(studio parcial)" if ml.blockers.size() < _blockers.size() else "")])
	# SERVICES — markers service do Studio vs runtime _services.
	print("[RegionDiff] services: runtime %d | studio %d  %s" % [_services.size(), int(mk.get("service", 0)), ("(studio vazio)" if int(mk.get("service", 0)) == 0 and _services.size() > 0 else "")])
	print("[RegionDiff] ===== fim %s =====" % region_id)

## ===== MUNDO CONTÍNUO — PASSO 1 (GODOT-CONTINUOUS-WORLD-MACROZONE-1) =====
## DEV/F4: monta VÁRIAS regiões editor-authored num ÚNICO espaço (sem loading) e deixa o Errante REAL andar de uma
## à outra continuamente — 1º passo de PRODUÇÃO do pivô p/ mundo aberto (a POC isolada provou viável; isto traz pro
## jogo de verdade, atrás de flag). NÃO altera load_region nem o save: ao sair (F4 de novo) recarrega a região salva.
## Reusa os builders existentes tornando-os OFFSET-AWARE: cada região é um nó-filho no seu offset; blockers e z
## (y-sort) viram GLOBAIS; bordas internas são suprimidas e só o MUNDO inteiro ganha borda.
## Despacha o builder de PROPS/entidades da região (NÃO o chão — esse vem de _build_topdown_map antes).
## Extraído de load_region (GODOT-CONTINUOUS-WORLD-STARTER-CLUSTER-1) p/ ser REUSADO pela macro-zona: manifesto
## (editor-authored / legacy override) vence; senão cai no _build_<id> procedural; fallback = Planície.
func _dispatch_region_builder(region_id: String, size: Vector2) -> void:
	_horizon_build_region = region_id   # P1.5-B: contexto p/ a borda por bioma (_add_map_borders)
	if _is_manifest_region(region_id):
		_build_from_manifest(region_id)
		_legacy_runtime_extras(region_id)   # re-adiciona runtime-only da região legada (boss/NPC); no-op p/ editor-authored e old_road
	elif region_id == "starter_village":
		_build_village(size)
	elif region_id == "cave":
		_build_cave(size)
	elif region_id == "swamp":
		_build_swamp(size)
