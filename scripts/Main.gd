	bridge.z_index = -5; c1.add_child(bridge)
	for bx in range(7):   # tábuas (textura mínima)
		var plank := ColorRect.new(); plank.color = Color(0.0, 0.0, 0.0, 0.10); plank.position = Vector2(485.0 + float(bx) * 48.0, 362.0); plank.size = Vector2(4.0, 106.0)
