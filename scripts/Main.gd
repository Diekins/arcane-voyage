## THE_HOMESTEAD_BUILD_03 — "BATER O FERRO": o gesto das Raízes. Você ergue o malho e bate a bigorna uma vez — o som
## que o Dorn faz todo dia, e alguém antes dele. Em-sessão (uma faísca salta; sem save/recompensa/sistema); você
## participa do CONTINUAR. No espírito de Manter a Vela / Deixar a Marca / Carregar um Nome.
func _forja_bater_gesture(svc) -> void:
	var ap: Vector2 = svc.get("anvil", Vector2.ZERO)
	if ap != Vector2.ZERO:
		for k in range(6):
			var ang := -PI * 0.5 + (float(k) - 2.5) * 0.28
			var spark := Line2D.new()
			spark.points = PackedVector2Array([ap + Vector2(0.0, -14.0), ap + Vector2(cos(ang) * 22.0, -14.0 + sin(ang) * 22.0)])
			spark.width = 2.0; spark.default_color = Color("ffd27a"); spark.z_index = int(ap.y) + 10
			_region_node.add_child(spark)
			if spark.is_inside_tree():
				var tw: Tween = spark.create_tween()
				tw.tween_property(spark, "modulate:a", 0.0, 0.45)
				tw.tween_callback(spark.queue_free)
	_show_local_dialogue("Bater o Ferro", [
		"Você ergue o malho e bate o ferro uma vez. A bigorna canta — um som limpo que atravessa a vila.",
		"Não forjou nada. Não mudou nada. Mas o som é o mesmo que o Dorn faz todo dia, e alguém antes dele.",
		"É assim que a vida continua aqui: não esperando — batendo. Mais uma vez. E amanhã de novo.",
	])

## Monta a Caverna (Ato 2, mundo 1800x1200): Golem de Cristal + portal p/ a Planície (à esquerda).
func _build_cave(_size: Vector2) -> void:
	_add_lore_marker(Vector2(_size.x * 0.74, _size.y * 0.30), "stone", "tocar a marca na parede", "Marca na Pedra", [
		"Um símbolo gasto, fundo demais na rocha para ser recente.",
		"Não é desta vila — nem de nenhuma que você conheça.",
		"Alguém esteve aqui muito antes de qualquer mapa, e quis deixar registro. De quê?",
	], true)
	_build_contagem_na_pedra(_size)   # MICRO-HISTÓRIA (Lote 2): A Contagem na Pedra
	if not _macro_sandbox:   # SANDBOX (DEV) = sem boss; CANONICAL/single-region = Golem presente (GRADUATION-1)
		_golem = _build_golem(CAVE_GOLEM)
		_current_boss = _golem
		_boss_name = "Golem de Cristal"
		_boss_dmg_min = 30   # o Errante golpeia mais forte o golem lento (HP ~600 vem do JSON)
		_boss_dmg_max = 45
	# com o tileset real, o arco-de-saída é o visual; sem ele (fallback) desenha a porta de shape.
	var has_tiles := ResourceLoader.exists("res://assets/tilesets/cave/cave_floor.png")
	_build_portal(CAVE_PORTAL, "plains", "Saída para a Planície", not has_tiles)
	# ★ BUILD_VEIOS_F5: a boca de descida ao FUNDO (norte-centro, longe do Golem/saída) agora desce a OS VEIOS (L1, o
	# poço de uma mina velha). A Catedral está mais funda, além da água dos Veios. Marca de boca de escada + convite.
	var cathhole := ColorRect.new(); cathhole.color = Color(0.04, 0.06, 0.10, 0.92); cathhole.size = Vector2(96.0, 46.0); cathhole.position = CAVE_TO_VEINS + Vector2(-48.0, -8.0); cathhole.z_index = int(CAVE_TO_VEINS.y) - 2; _region_node.add_child(cathhole)
	_build_portal(CAVE_TO_VEINS, "veins", "↡ descer → Os Veios", false, VEINS_SPAWN)
	var cathmk := Node2D.new(); cathmk.position = CAVE_TO_VEINS + Vector2(0.0, -50.0); cathmk.z_index = int(CAVE_TO_VEINS.y)
	var cathl := Label.new(); cathl.text = "Uma boca de mina escorada desce para o escuro, mais fundo que o Golem. Alguém já cavou aqui."; cathl.position = Vector2(-210.0, -24.0); cathl.modulate = Color("9fb6d4")
	cathl.add_theme_font_size_override("font_size", 13); cathl.add_theme_color_override("font_outline_color", Color(0.03, 0.04, 0.06, 0.9)); cathl.add_theme_constant_override("outline_size", 5)
	cathmk.add_child(cathl); _tag_on_top(cathl); _region_node.add_child(cathmk)
	if _cave_memory_on():
		_build_cave_memory(_size)   # CAVE MEMORY: "este lugar lembra" (cenário aditivo, atrás de flag, SÓ aqui)

## CAVE MEMORY — piloto ligado? (const de produção OU override de self-test OU env). OFF = Caverna idêntica.
func _cave_memory_on() -> bool:
	return CAVE_MEMORY_ENABLED or _cavemem_force or OS.has_environment("AV_CAVE_MEMORY")

## CAVE MEMORY — presença da "Memória Petrificada" (atmosfera/textura ADITIVA; NÃO toca Golem/combate/loot/save).
## Gradiente no ESPAÇO: entrada (oeste, ~x0.10–0.22) = antiguidade + luz fria presa; aproximação (~0.22–0.30) =
## desgaste/repetição/tempo; PICO na Contagem (base 0.30,0.62) = vigília + memória sendo absorvida pela pedra. A
## leste (rumo ao Golem) fica livre p/ não competir com a arena. Tudo marcado `av_cavemem` (identificação/remoção).
func _build_cave_memory(size: Vector2) -> void:
	# 1) ENTRADA — antiguidade + cristais que guardam luz fria (held light)
	for c in [Vector2(0.10, 0.45), Vector2(0.14, 0.66), Vector2(0.20, 0.52)]:
		var p := Vector2(size.x * c.x, size.y * c.y)
		_cavemem_glow(p + Vector2(0.0, 6.0), 40.0, Color(0.45, 0.72, 0.92, 0.10))   # luz fria presa no chão
		_cavemem_crystal(p, 30.0, Color(0.58, 0.80, 0.95, 0.55))
	# estratos visíveis (camadas do tempo) numa faixa de parede ao norte, cobrindo a aproximação
	for i in range(5):
		var band := ColorRect.new()
		band.color = Color(0.30 + 0.06 * i, 0.32 + 0.05 * i, 0.38 + 0.04 * i, 0.30)   # antigo (fundo/escuro) → recente
		band.size = Vector2(size.x * 0.28, 7.0)
		band.position = Vector2(size.x * 0.06, size.y * 0.12 + float(i) * 7.0)
		band.z_index = -16
		band.set_meta("av_cavemem", true)
		_region_node.add_child(band)
	# 2) APROXIMAÇÃO — desgaste por repetição (chão polido) + risco engolido por cristal
	_cavemem_polish(Vector2(size.x * 0.24, size.y * 0.60), 46.0)
	_cavemem_swallowed_scratch(Vector2(size.x * 0.265, size.y * 0.50))
	# 3) PICO na CONTAGEM (mesma base do _build_contagem_na_pedra) — vigília + memória absorvida
	var base := Vector2(size.x * 0.30, size.y * 0.62)
	_cavemem_glow(base + Vector2(-52.0, 8.0), 34.0, Color(0.45, 0.72, 0.92, 0.10))     # luz fria junto à vigília
	_cavemem_hollow(base + Vector2(-58.0, 16.0))                                       # concavidade-de-vigília (no chão)
	_cavemem_spent_light(base + Vector2(-58.0, -2.0))                                  # luz consumida (vela apagada)
	_cavemem_crystal(base + Vector2(-4.0, -8.0), 22.0, Color(0.60, 0.82, 0.96, 0.5))   # cristal CRESCENDO sobre os riscos antigos (esquerda)

## cristal angular frio (memória, NÃO loot — forma/cor distintas dos fragmentos lootáveis)
func _cavemem_crystal(pos: Vector2, h: float, col: Color) -> Polygon2D:
	var p := Polygon2D.new()
	p.polygon = PackedVector2Array([
		Vector2(-h * 0.28, 0.0), Vector2(-h * 0.12, -h * 0.7), Vector2(h * 0.05, -h),
		Vector2(h * 0.18, -h * 0.55), Vector2(h * 0.30, 0.0),
	])
	p.position = pos
	p.color = col
	p.z_index = int(pos.y)
	p.set_meta("av_cavemem", true)
	_region_node.add_child(p)
	# leve cintilar frio da luz presa (sutil; só dentro da árvore = headless/destacado estático, seguro)
	if p.is_inside_tree():
		var tw := p.create_tween()
		tw.set_loops()
		tw.tween_property(p, "modulate:a", 0.7, 2.2).set_trans(Tween.TRANS_SINE)
		tw.tween_property(p, "modulate:a", 1.0, 2.2).set_trans(Tween.TRANS_SINE)
	return p

## disco baixo de luz fria presa (held light) no chão
func _cavemem_glow(pos: Vector2, r: float, col: Color) -> void:
	var poly := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(20):
		var a := TAU * i / 20.0
		pts.append(Vector2(cos(a) * r, sin(a) * r * 0.5))
	poly.polygon = pts
	poly.position = pos
	poly.color = col
	poly.z_index = -16
	poly.set_meta("av_cavemem", true)
	_region_node.add_child(poly)

## mancha de chão polida pelo uso (desgaste por repetição) — elipse achatada, levemente mais clara
func _cavemem_polish(pos: Vector2, r: float) -> void:
	var poly := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(20):
		var a := TAU * i / 20.0
		pts.append(Vector2(cos(a) * r, sin(a) * r * 0.42))
	poly.polygon = pts
	poly.position = pos
	poly.color = Color(0.62, 0.64, 0.68, 0.12)
	poly.z_index = -15
	poly.set_meta("av_cavemem", true)
	_region_node.add_child(poly)

## risco humano (Line2D) PARCIALMENTE engolido por um cristal (a pedra retoma a marca)
func _cavemem_swallowed_scratch(pos: Vector2) -> void:
	var line := Line2D.new()
	line.width = 2.0
	line.default_color = Color(0.10, 0.11, 0.14, 0.6)
	line.points = PackedVector2Array([pos + Vector2(-22, 6), pos + Vector2(-2, -4), pos + Vector2(20, 2)])
	line.z_index = -14
	line.set_meta("av_cavemem", true)
	_region_node.add_child(line)
	_cavemem_crystal(pos + Vector2(6.0, 4.0), 18.0, Color(0.58, 0.80, 0.95, 0.62))   # cresce por cima da ponta do risco

## concavidade gasta no chão — onde alguém sentou/velou (forma-de-ausência), voltada à entrada (oeste)
func _cavemem_hollow(pos: Vector2) -> void:
	var poly := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(18):
		var a := TAU * i / 18.0
		pts.append(Vector2(cos(a) * 20.0, sin(a) * 11.0))
	poly.polygon = pts
	poly.position = pos
	poly.color = Color(0.06, 0.06, 0.08, 0.5)   # depressão escura/gasta
	poly.z_index = -15
	poly.set_meta("av_cavemem", true)
	_region_node.add_child(poly)

## luz consumida — toco de vela apagada (vigília que se acabou); SEM chama
func _cavemem_spent_light(pos: Vector2) -> void:
	var stub := ColorRect.new()
	stub.color = Color(0.20, 0.19, 0.16, 0.85)
	stub.size = Vector2(8.0, 7.0)
	stub.position = pos - Vector2(4.0, 4.0)
	stub.z_index = int(pos.y)
	stub.set_meta("av_cavemem", true)
	_region_node.add_child(stub)

## Monta o Pântano de Ferro (GODOT-SWAMP-REGION-MVP-1, mundo 2000x1400): região de hunt pós-Caverna,
