## THE_HOMESTEAD_BUILD_02 — "DEIXAR SUA MARCA": o gesto do Limiar. Você risca a sua marca no poste, entre as de todos
## os que passaram. Em-sessão (um risco aparece — sem save/recompensa/sistema); você entra, por um instante, na conta
## de quem partiu daqui. No espírito de Segurar a Tábua / Carregar um Nome / Olhar de Volta / Manter a Vela Acesa.
func _limiar_mark_gesture(svc) -> void:
	var node = svc.get("node")
	var host = svc.get("post")
	if node != null and node.has_meta("av_limiar_marked"):
		_show_local_dialogue("O Limiar", [
			"A sua marca já está lá, entre tantas. O portão não vai lembrar de você em especial.",
			"Mas você passou — e ficou o risco.",
		])
		return
	if host != null and is_instance_valid(host) and host.is_inside_tree():
		var mk := Line2D.new(); mk.points = PackedVector2Array([Vector2(-6.0, 80.0), Vector2(6.0, 84.0)]); mk.width = 1.6; mk.default_color = Color("d8c49a"); host.add_child(mk)
		var tw: Tween = mk.create_tween()
		tw.tween_property(mk, "default_color", Color(0.18, 0.13, 0.09, 0.85), 1.2)
	if node != null:
		node.set_meta("av_limiar_marked", true)
	_show_local_dialogue("Uma Marca a Mais", [
		"Você tira a faca e risca a sua marca no poste, entre as outras. Mais uma, entre tantas.",
		"Toda partida começou neste portão. Agora a sua também tem um risco aqui — pra quem souber procurar.",
	])

