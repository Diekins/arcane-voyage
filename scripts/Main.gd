## DISCOVERY_CHAIN_PILOT_01 — assinatura RECORRENTE: a mesma ESPIRAL gravada numa laje, em duas regiões distantes.
## Cada uma funciona sozinha (laje + espiral + leitura curta); juntas, recompensam a MEMÓRIA ("já vi isto"). SEM
## quest/marcador/diário/recompensa/save. Interação future_exit (só texto) — a laje É o examinável (halo azul-frio).
func _build_spiral_mark(pos: Vector2, title: String, prompt_txt: String, lines: Array) -> void:
	var slab := Polygon2D.new()
	slab.polygon = PackedVector2Array([Vector2(-34, 16), Vector2(34, 16), Vector2(28, -16), Vector2(-30, -16)])
	slab.position = pos; slab.color = Color(0.55, 0.55, 0.50, 0.95); slab.z_index = int(pos.y) - 1
	_region_node.add_child(slab)
	var sp := Line2D.new()
	var pts := PackedVector2Array()
	for i in range(65):
		var t := float(i) / 64.0
		var ang := t * 3.2 * TAU
		var r := 2.0 + t * 20.0
		pts.append(Vector2(cos(ang) * r, sin(ang) * r))
	sp.points = pts; sp.width = 2.4; sp.default_color = Color(0.18, 0.17, 0.16, 0.9)
	sp.position = pos + Vector2(0.0, -2.0); sp.z_index = int(pos.y)
	_region_node.add_child(sp)
	var node := Node2D.new(); node.position = pos; node.z_index = int(pos.y)
	var halo := Polygon2D.new()
	var gp := PackedVector2Array()
	for i in range(20):
		var a := TAU * i / 20.0
		gp.append(Vector2(cos(a) * 38.0, sin(a) * 22.0 + 2.0))
	halo.polygon = gp; halo.color = Color(0.45, 0.7, 0.85, 0.15); halo.z_index = -1; node.add_child(halo)
	var prompt := Label.new()
	prompt.text = "✦ [E] " + prompt_txt
	prompt.position = Vector2(-92.0, -92.0); prompt.modulate = Color("ffe6b0")
	prompt.add_theme_font_size_override("font_size", 15)
	prompt.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.95))
	prompt.add_theme_constant_override("outline_size", 6); prompt.visible = false
	node.add_child(prompt); _tag_on_top(prompt)
	_region_node.add_child(node)
	var pt: Tween = null
	if node.is_inside_tree():
		pt = node.create_tween(); pt.set_loops()
		pt.tween_property(halo, "modulate:a", 0.5, 1.7).set_trans(Tween.TRANS_SINE)
		pt.tween_property(halo, "modulate:a", 1.0, 1.7).set_trans(Tween.TRANS_SINE)
	_services.append({
		"node": node, "prompt": prompt, "pos": pos, "kind": "future_exit",
		"id": "spiral_%d_%d" % [int(pos.x), int(pos.y)], "title": title, "msg": lines, "halo": halo, "pulse": pt,
	})

## DISCOVERY (DISCOVERY_MYSTERY_PILOT_01) — 1 mistério pequeno FORA da rota, no sul das Ruínas da Estrada Velha.
## Um banco de pedra voltado pro LADO ERRADO (de costas pra estrada, encarando o vazio). Leitura ÚNICA e curta
## que NÃO se explica. Recompensa a CURIOSIDADE/intriga (não loot, não poder). Cenário aditivo + interação
## future_exit (só texto; SEM reward/flag/save/quest/marcador/continuação). O banco É o examinável (halo+[E]).
func _build_old_road_mystery(size: Vector2) -> void:
	var c := Vector2(size.x * 0.62, size.y * 0.88)   # sul, fora da rota W→E (y~650)
	# banco de pedra VOLTADO PRO LADO ERRADO (encosto ao norte/estrada; o assento encara o descampado ao sul)
	var back := ColorRect.new()
	back.color = Color("615a50"); back.size = Vector2(74.0, 10.0); back.position = c + Vector2(-37.0, -26.0)
	back.z_index = int(c.y); _region_node.add_child(back)
	var seat := Polygon2D.new()
	seat.polygon = PackedVector2Array([Vector2(-40, 0), Vector2(40, 0), Vector2(33, -11), Vector2(-33, -11)])
	seat.position = c; seat.color = Color("7a7268"); seat.z_index = int(c.y); _region_node.add_child(seat)
	for lx in [-31.0, 31.0]:
		var leg := ColorRect.new()
		leg.color = Color("524c43"); leg.size = Vector2(8.0, 16.0); leg.position = c + Vector2(lx - 4.0, 0.0)
		leg.z_index = int(c.y) - 1; _region_node.add_child(leg)
	# leitura única (mistério, halo azul-frio = "algo estranho aqui"); SEM ícone extra — o banco é o objeto
	var node := Node2D.new(); node.position = c; node.z_index = int(c.y)
	var halo := Polygon2D.new()
	var gp := PackedVector2Array()
	for i in range(20):
		var a := TAU * i / 20.0
		gp.append(Vector2(cos(a) * 42.0, sin(a) * 24.0 + 2.0))
	halo.polygon = gp; halo.color = Color(0.45, 0.7, 0.85, 0.16); halo.z_index = -1; node.add_child(halo)
	var prompt := Label.new()
	prompt.text = "✦ [E] examinar o banco de pedra"
	prompt.position = Vector2(-92.0, -96.0); prompt.modulate = Color("ffe6b0")
	prompt.add_theme_font_size_override("font_size", 15)
	prompt.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.95))
	prompt.add_theme_constant_override("outline_size", 6); prompt.visible = false
	node.add_child(prompt); _tag_on_top(prompt)
	_region_node.add_child(node)
	var pt: Tween = null
	if node.is_inside_tree():
		pt = node.create_tween(); pt.set_loops()
		pt.tween_property(halo, "modulate:a", 0.5, 1.7).set_trans(Tween.TRANS_SINE)
		pt.tween_property(halo, "modulate:a", 1.0, 1.7).set_trans(Tween.TRANS_SINE)
	_services.append({
		"node": node, "prompt": prompt, "pos": c, "kind": "future_exit",
		"id": "mystery_banco_voltado", "title": "O Banco Voltado", "halo": halo, "pulse": pt,
		"msg": [
			"Um banco de pedra, sozinho no descampado — de costas pra estrada, encarando o vazio.",
			"Alguém o pôs assim de propósito. Sentava aqui e olhava... o quê?",
			"Seja lá o que era, não está mais ali. E ninguém sobrou pra contar.",
		],
	})

## DISCOVERY (DISCOVERY_REWARD_PILOT_01) — 1 ponto ESCONDIDO fora da rota, no canto SUDOESTE da Costa (o fluxo é
## W→E em y~650; o barco/Sefa ficam no centro-sul). Recompensa NÃO-loot: um recanto sereno (fonte clara + pedra
## de descanso gasta) + 1 marco [E] contemplativo. Recompensa a CURIOSIDADE, não o poder. Cenário aditivo +
## _add_lore_marker (future_exit = só texto; SEM reward/flag/save/quest/marcador-de-mapa). Save-safe.
func _build_coast_hidden_spring(size: Vector2) -> void:
	var c := Vector2(size.x * 0.20, size.y * 0.89)   # SW, longe do caminho principal e do barco/NPCs
	_add_floor_glow(c, 120.0, Color(0.45, 0.6, 0.4, 0.10))   # clareira macia
	# fonte clara (poça serena) + luz na água
	var pool := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(24):
		var a := TAU * i / 24.0
		pts.append(Vector2(cos(a) * 78.0, sin(a) * 46.0))
	pool.polygon = pts
	pool.position = c
	pool.color = Color(0.32, 0.55, 0.6, 0.7)
	pool.z_index = -1
	_region_node.add_child(pool)
	_add_floor_glow(c, 70.0, Color(0.7, 0.9, 0.95, 0.16))
	for off in [Vector2(-22, -8), Vector2(14, 6), Vector2(34, -12)]:   # glints sutis na água
		var g := Polygon2D.new()
		g.polygon = PackedVector2Array([Vector2(-3, 0), Vector2(0, -1.4), Vector2(3, 0), Vector2(0, 1.4)])
		g.position = c + off
		g.color = Color(1, 1, 1, 0.5)
		g.z_index = -1
		_region_node.add_child(g)
	# rochas que abrigam o recanto
	_add_dry_rock(c + Vector2(-92, -36), 26.0)
	_add_dry_rock(c + Vector2(96, -20), 30.0)
	_add_dry_rock(c + Vector2(-54, 54), 22.0)
	# pedra de descanso gasta (assento liso)
	var seat := Polygon2D.new()
	seat.polygon = PackedVector2Array([Vector2(-26, 0), Vector2(26, 0), Vector2(20, -12), Vector2(-22, -12)])
	seat.position = c + Vector2(48, -2)
	seat.color = Color(0.62, 0.6, 0.56)
	seat.z_index = int(c.y)
	_region_node.add_child(seat)
	# o marco [E] contemplativo (cairn) — recompensa a curiosidade com recanto+memória, NÃO loot
	_add_lore_marker(c + Vector2(48, -14), "cairn", "ficar um instante", "Recanto da Fonte", [
		"A trilha não levava aqui. Mas você saiu dela — e encontrou uma fonte clara entre as pedras, longe de tudo.",
		"Alguém empilhou pedrinhas num canto e gastou esta laje de tanto sentar. Um descanso que ninguém anunciou.",
		"Nada pra levar. Só a água parada, a sombra fresca, e a vontade de ficar mais um instante.",
	], false)

## Banco de Areia dos Náufragos (GODOT-CASTAWAY-SANDBAR-MVP-1): 1ª escala pós-barco (gated por boat_repaired
## no embarque do barco da Costa). Região PEQUENA: chão procedural de areia (_build_shape_map) + retorno de
## barco à Costa. Mobs/baús vêm de _mob_defs/_chest_defs (centrais). SEM boss-system. Reusa mobs/materiais
## costeiros (zero asset novo). NÃO abre região seguinte.
func _build_castaway_sandbar(_size: Vector2) -> void:
	_current_boss = null
	_boss_name = ""
	# retorno → Costa (barco de volta). Surge na Costa LONGE do barco (COAST_RETURN_FROM_SANDBAR) p/ não
	# auto-zarpar de volta em loop. draw_door=true (sprite de fenda/porta padrão).
	_build_portal(SANDBAR_TO_COAST, "saltwind_shore", "Barco → Costa do Sal-Vento", true, COAST_RETURN_FROM_SANDBAR)
	# 2º portal (leste): travessia → Ilha do Sal Partido (GODOT-SALT-SPLIT-ISLE-MVP-1). Gated por
	# sandbar_reached em _portal_gate_open; surge na Ilha em ISLE_SPAWN (oeste).
	_build_portal(SANDBAR_TO_ISLE, "salt_split_isle", "Travessia → Ilha do Sal Partido", true, ISLE_SPAWN)
	# marco de descoberta (1ª chegada): toast persistente. Reusa story_flags (sem campo novo dedicado).
	if GameState.set_story_flag("sandbar_reached"):
		_show_reward_popup("Banco de Areia dos Náufragos — a primeira escala da rota marítima")

## Ilha do Sal Partido (GODOT-SALT-SPLIT-ISLE-MVP-1): 2ª escala marítima (média, 1800x1200), mais perigosa
## que o Banco. Chão procedural de sal/areia rachada (_build_shape_map). Retorno de barco ao Banco + mini-boss
## elite (Guardião do Sal Partido) via mob+flag (NÃO boss-system) + future_exit "Horizonte Aberto" (gancho
## do próximo arco, gated por salt_isle_cleared). Mobs/baús vêm de _mob_configs/_chest_defs (centrais).
func _build_salt_split_isle(_size: Vector2) -> void:
	_current_boss = null
	_boss_name = ""
	# retorno → Banco (surge LONGE do portal de ida no Banco → anti-loop de auto-zone)
	_build_portal(ISLE_TO_SANDBAR, "castaway_sandbar", "Barco → Banco de Areia", true, SANDBAR_RETURN_FROM_ISLE)
	# HORIZONTE ABERTO (future_exit, SÓ texto — não transporta): gancho do próximo arco, gated por salt_isle_cleared.
	var hz := Node2D.new()
	hz.position = ISLE_HORIZON_POS
	hz.z_index = int(ISLE_HORIZON_POS.y)
	var hprompt := Label.new()
	hprompt.text = "[E] olhar o horizonte aberto"
	hprompt.position = Vector2(-78, -88)
	hprompt.modulate = Color("bfe3ff")
	hprompt.add_theme_font_size_override("font_size", 14)
	hprompt.visible = false
	hz.add_child(hprompt)
	_tag_on_top(hprompt)
	_region_node.add_child(hz)
	_services.append({"node": hz, "prompt": hprompt, "pos": ISLE_HORIZON_POS, "kind": "future_exit", "id": "salt_isle_horizon", "title": "Horizonte Aberto", "msg": []})
	# marco de descoberta (1ª chegada)
	if GameState.set_story_flag("salt_isle_reached"):
		_show_reward_popup("Ilha do Sal Partido — uma fenda de sal corta a terra ao meio")
	# ── PACK08 deco ADITIVA (o desembarque que falhou — relíquias de náufrago na salina seca; sem blocker;
	# offsets por bbox_alpha). SW do spawn, fora da path_band (y525-675) e ≥246px de qualquer blocker. A ilha é
	# salina SECA → só props de naufrágio/rota (NÃO coral/tidepool/rede, que pedem água). Caminho correto = aqui no
	# build (o JSON da ilha é só overlay de chão via GROUND_TILE_OVERLAYS; o array props do JSON não é lido no runtime).
	_khet_deco_sprite(Vector2(420.0, 820.0), "res://assets/tilesets/eastern_sea/props/eastern_skiff_wreck.png", Vector2(-3.0, -31.0))
	_khet_deco_sprite(Vector2(560.0, 860.0), "res://assets/tilesets/eastern_sea/props/eastern_rusted_anchor.png", Vector2(-4.0, -25.0))

## Areais de Khet-Sar (GODOT-KHET-SAR-SANDS-MVP-1): 1ª região DESÉRTICA (novo continente, mudança de bioma),
## via Horizonte Aberto da Ilha após salt_isle_cleared. Mundo 2000x1300, chão procedural de areia. Retorno à
## Ilha + mobs desérticos (reskins, zero asset) + elite leve (Sentinela de Khet-Sar, mob+flag) + future_exit
## "Dunas Profundas" (gancho do próximo pacote, só texto). Mobs/baús vêm de _mob_configs/_chest_defs (centrais).
func _build_khet_sar_sands(_size: Vector2) -> void:
	_current_boss = null
	_boss_name = ""
	# retorno → Ilha do Sal Partido (surge na Ilha LONGE do Horizonte → anti-loop de auto-zone)
	_build_portal(KHET_TO_ISLE, "salt_split_isle", "Barco → Ilha do Sal Partido", true, ISLE_RETURN_FROM_KHET)
	# DUNAS PROFUNDAS (future_exit, SÓ texto — gancho do próximo pacote; gated narrativamente por sentinela)
	var dd := Node2D.new()
	dd.position = KHET_DEEP_DUNES_POS
	dd.z_index = int(KHET_DEEP_DUNES_POS.y)
	var dprompt := Label.new()
	dprompt.text = "[E] adentrar as dunas profundas"
	dprompt.position = Vector2(-80, -88)
	dprompt.modulate = Color("f0d29a")
	dprompt.add_theme_font_size_override("font_size", 14)
	dprompt.visible = false
	dd.add_child(dprompt)
	_tag_on_top(dprompt)
	_region_node.add_child(dd)
	_services.append({"node": dd, "prompt": dprompt, "pos": KHET_DEEP_DUNES_POS, "kind": "future_exit", "id": "khet_deep_dunes", "title": "Dunas Profundas", "msg": []})
	# marco de descoberta (1ª chegada): novo continente
	if GameState.set_story_flag("khet_sar_reached"):
		_show_reward_popup("Areais de Khet-Sar — teus pés tocam um novo continente")
	_build_desert_landmark(_size)   # LANDMARK_PILOT_01: torre arruinada visível à distância (puxa o jogador pra frente)
	# ★ CAIRN DE ROTA (WORLDLIFE_PACK_03B, aditivo): pilha de pedras marcando a trilha da caravana (rastro humano no
	# deserto). Render-only, SEM blocker/interação; no-op se a arte sumir (_try_load_tex→null).
	var cairn_tex := _try_load_tex("res://assets/tilesets/desert/props/caravan_route_cairn.png")
	if cairn_tex != null:
		var cn := Sprite2D.new(); cn.texture = cairn_tex; cn.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		cn.offset = Vector2(0.0, -32.0)   # base das pedras na origem
		cn.position = Vector2(720.0, 740.0); cn.z_index = 740; _region_node.add_child(cn)
	# ── PACK07 deco ADITIVA (sem blocker): rastros do que a caravana deixou na trilha — pano, saque, ossos e um tambor tombado ──
	_khet_deco_sprite(Vector2(820.0, 772.0), "res://assets/tilesets/khet/props/khet_torn_caravan_cloth.png", Vector2(1.0, -30.0))
	_khet_deco_sprite(Vector2(636.0, 804.0), "res://assets/tilesets/khet/props/khet_loot_scatter.png", Vector2(0.0, -26.0))
	_khet_deco_sprite(Vector2(1000.0, 716.0), "res://assets/tilesets/khet/props/khet_small_bones.png", Vector2(0.0, -18.0))
	_col_toppled(Vector2(556.0, 900.0), 170.0)   # tambor tombado meio na areia (usa o sprite PACK07 + blocker fino)
	# ★ BOCA DA GARGANTA (KHETSAR_HUNT_REGION_01): desvio de HUNT ao SUL — portal aberto + marcador ameaçador. As dunas
	# AFUNDAM aqui; ossos na borda anunciam "isto é perigoso" antes do 1º combate. Surge na Garganta pela crista norte.
	_build_portal(SANDS_TO_MAW, "khet_sand_maw", "↓ A Garganta das Areias", true, SANDMAW_SPAWN)
	_maw_ribcage(SANDS_TO_MAW + Vector2(-120.0, 30.0), 28.0)   # ossada na borda da boca (presságio)
	_maw_ribcage(SANDS_TO_MAW + Vector2(140.0, 24.0), 24.0)
	var warn := Node2D.new(); warn.position = SANDS_TO_MAW + Vector2(0.0, -40.0); warn.z_index = int(SANDS_TO_MAW.y)
	var wlbl := Label.new(); wlbl.text = "As areias afundam. Os ossos começam aqui."; wlbl.position = Vector2(-130.0, -24.0); wlbl.modulate = Color("d8b48a")
	wlbl.add_theme_font_size_override("font_size", 13); wlbl.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.9)); wlbl.add_theme_constant_override("outline_size", 5)
	warn.add_child(wlbl); _tag_on_top(wlbl); _region_node.add_child(warn)
	# ★ BOCA DA COLUNATA (KHETSAR_HUNT_REGION_02): desvio de HUNT-IRMÃ ao NORTE — pilares partidos rompem a duna,
	# anunciando "um salão aqui embaixo". Surge na Colunata pela ala oeste.
	_build_portal(SANDS_TO_COLONNADE, "khet_colonnade", "↟ A Colunata Soterrada", true, COLONNADE_SPAWN)
	_col_pillar(SANDS_TO_COLONNADE + Vector2(-130.0, 30.0), 96.0, true)   # tocos de coluna na borda da boca (presságio)
	_col_pillar(SANDS_TO_COLONNADE + Vector2(140.0, 26.0), 78.0, true)
	var cwarn := Node2D.new(); cwarn.position = SANDS_TO_COLONNADE + Vector2(0.0, -40.0); cwarn.z_index = int(SANDS_TO_COLONNADE.y)
	var cwl := Label.new(); cwl.text = "Pilares rompem a duna. Há um salão aqui embaixo."; cwl.position = Vector2(-140.0, -24.0); cwl.modulate = Color("d8cba0")
	cwl.add_theme_font_size_override("font_size", 13); cwl.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.9)); cwl.add_theme_constant_override("outline_size", 5)
	cwarn.add_child(cwl); _tag_on_top(cwl); _region_node.add_child(cwarn)
	# ★ CORTE 1 (KHETSAR_CONSOLIDATION_BUILD_01) — a SILHUETA PARTIDA da Cidadela no horizonte NORTE: longe,
	# dessaturada, SEM texto/[E]/blocker. O ápice da trilogia visível ao fundo → curiosidade pura ("o que é AQUILO?").
	# + uma fenda ESCURA ao SUL, sugerindo a abertura da Garganta. Puxa o olho aos braços de hunt sem empurrar.
	var citsil := Polygon2D.new()
	citsil.polygon = PackedVector2Array([
		Vector2(0, 86), Vector2(0, 40), Vector2(28, 40), Vector2(28, 8), Vector2(46, 8), Vector2(46, 40),
		Vector2(96, 40), Vector2(96, 22), Vector2(112, 22), Vector2(112, 40), Vector2(150, 40), Vector2(150, 0),
		Vector2(172, 0), Vector2(172, 18), Vector2(186, 18), Vector2(186, 40), Vector2(252, 40), Vector2(252, 14),
		Vector2(268, 14), Vector2(268, 40), Vector2(300, 40), Vector2(300, 30), Vector2(330, 30), Vector2(330, 86),
	])
	citsil.position = Vector2(_size.x * 0.60, 36.0); citsil.color = Color(0.34, 0.32, 0.36, 0.50); citsil.z_index = -16
	_region_node.add_child(citsil)
	var cithaze := Polygon2D.new()   # base difusa (calor/poeira) sob a silhueta → "muito longe"
	cithaze.polygon = PackedVector2Array([Vector2(-30, 86), Vector2(360, 86), Vector2(360, 104), Vector2(-30, 104)])
	cithaze.position = Vector2(_size.x * 0.60, 36.0); cithaze.color = Color(0.62, 0.55, 0.42, 0.16); cithaze.z_index = -16
	_region_node.add_child(cithaze)
	var maw_gash := Polygon2D.new()   # a abertura ESCURA da Garganta, afundando ao SUL (sombra côncava na duna)
	var gp := PackedVector2Array()
	for gi in range(16):
		var ga := TAU * float(gi) / 16.0
		gp.append(Vector2(cos(ga) * 150.0, sin(ga) * 34.0))
	maw_gash.polygon = gp; maw_gash.position = Vector2(_size.x * 0.42, _size.y - 30.0); maw_gash.color = Color(0.05, 0.05, 0.08, 0.34); maw_gash.z_index = -15
	_region_node.add_child(maw_gash)
	if _world_life_caravan_on():
		_build_world_life_caravan(_size)   # WORLD LIFE: caravana cruza O→L (aditivo, sem colisão/save; pode ser perdida)

## WORLD LIFE — piloto ligado? (const de produção OU override de self-test OU env). OFF = Areais idênticos.
func _world_life_caravan_on() -> bool:
	return WORLD_LIFE_CARAVAN_ENABLED or _caravan_force or OS.has_environment("AV_WORLD_LIFE_CARAVAN")

## WORLD LIFE — instancia a caravana no nó da região (escopo khet_sar_sands; freed ao sair). 100% aditivo:
## nenhum sistema/save/quest/colisão/interação — só um acontecimento do mundo que atravessa e ignora o jogador.
func _build_world_life_caravan(size: Vector2) -> void:
	var c := WorldLifeCaravan.new()
