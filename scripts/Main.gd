	lintel.polygon = PackedVector2Array([pos + Vector2(-120, 10), pos + Vector2(110, -6), pos + Vector2(112, 24), pos + Vector2(-118, 40)])
	lintel.color = Color("8f7a54"); lintel.z_index = int(pos.y); _region_node.add_child(lintel)

## Trono/dais (landmark central do keep): plataforma em degraus + encosto partido. SEM blocker no piso (o apex anda);
## blocker fino só no encosto (atrás), pra não prender o boss.
func _cit_dais(pos: Vector2) -> void:
	var z := int(pos.y)
	var plat := Polygon2D.new()   # plataforma elevada (losango achatado = degraus)
	plat.polygon = PackedVector2Array([pos + Vector2(-150, 0), pos + Vector2(0, -70), pos + Vector2(150, 0), pos + Vector2(0, 70)])
	plat.color = Color("9c8a64"); plat.z_index = z - 2; _region_node.add_child(plat)
	var rim := Polygon2D.new(); rim.polygon = PackedVector2Array([pos + Vector2(-150, 0), pos + Vector2(0, 70), pos + Vector2(150, 0), pos + Vector2(0, 78), pos + Vector2(-150, 8)]); rim.color = Color(0.0, 0.0, 0.0, 0.14); rim.z_index = z - 2; _region_node.add_child(rim)
	# IRON_KHET_PACK_06: trono partido como sprite (signature de Khet) se existir; senão encosto ColorRect + rachadura Line2D (fallback). Blocker mantido.
	var th_tex := _try_load_tex("res://assets/tilesets/khet/props/broken_throne.png")
	if th_tex != null:
		var k := 156.0 / 192.0   # largura-alvo ~156 mapeada à textura 192px (altura ~130)
		var s := Sprite2D.new(); s.texture = th_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.scale = Vector2(k, k); s.offset = Vector2(0.0, -80.0); s.position = pos; s.z_index = int(pos.y - 40.0); _region_node.add_child(s)   # base na laje do dais
	else:
		# encosto partido do trono (atrás/norte do dais)
		var back := ColorRect.new(); back.color = Color("7e6c4c"); back.size = Vector2(70.0, 54.0); back.position = pos + Vector2(-35.0, -96.0); back.rotation = 0.06; back.z_index = int(pos.y - 40.0); _region_node.add_child(back)
		var crack := Line2D.new(); crack.points = PackedVector2Array([pos + Vector2(0, -96), pos + Vector2(-8, -52)]); crack.width = 4.0; crack.default_color = Color(0.0, 0.0, 0.0, 0.4); crack.z_index = int(pos.y - 39.0); _region_node.add_child(crack)
	_add_blocker(Rect2(pos.x - 35.0, pos.y - 70.0, 70.0, 18.0))   # só o encosto (norte), longe do spawn do apex (sul do dais)

## ★ O GRANDE ARQUIVO = "a Permanência" (THE_GREAT_ARCHIVE_BUILD_01) — a CÂMARA-revelação após a Cidadela. NÃO é hunt:
## SEM mobs (combate acaba), SEM quest/recompensa/coletável/NPC-explicador. Você desce ao silêncio: paredes do chão ao
## teto cobertas de nomes GRAVADOS, intactos e MUDOS — ninguém vivo que os leia. 99,999% inútil; UMA marca ainda
## legível (um nome que, longe daqui, alguém ainda repete = o fio com a Pedra). + 1 assento de leitor vazio + 1 vista
## (a luz viva ao longe × o registro morto aqui) + a gota dormente. Tudo gravado, nada lembrado. Idioma da Cisterna,
## destino oposto: a Cisterna é quente/viva/carregada; o Arquivo é frio/intacto/mudo.
func _build_great_archive(size: Vector2) -> void:
	_current_boss = null
	_boss_name = ""
	# volta → Cidadela (sobe a escada). SEM combate aqui.
	_build_portal(ARCHIVE_TO_CITADEL, "khet_citadel", "↑ subir → A Cidadela Partida", true, CITADEL_RETURN_FROM_ARCHIVE)
	if GameState.set_story_flag("archive_reached"):
		_show_reward_popup("o Grande Arquivo — a Permanência")
	# ── ESCADA DE DESCIDA (brecha norte): degraus escurecendo (você DESCE para a câmara) ──
	for i in range(7):
		var st := ColorRect.new(); st.color = Color(0.10, 0.10, 0.13, 0.30 + 0.07 * float(i))
		st.size = Vector2(140.0, 22.0); st.position = Vector2(680.0, float(i) * 24.0); st.z_index = -15; _region_node.add_child(st)
	# ── PAREDES (perímetro frio; uma só entrada ao norte). Blockers encerram a câmara. ──
	# parede do FUNDO (norte) = A GRANDE PAREDE DE NOMES — duas metades em volta da brecha de entrada
	_arch_back_wall(120.0, 680.0)
	_arch_back_wall(820.0, 1380.0)
	_add_blocker(Rect2(120.0, 158.0, 560.0, 26.0)); _add_blocker(Rect2(820.0, 158.0, 560.0, 26.0))
	# parede OESTE
	var ww := ColorRect.new(); ww.color = Color("1b1b22"); ww.size = Vector2(44.0, 640.0); ww.position = Vector2(78.0, 180.0); ww.z_index = 181; _region_node.add_child(ww)
	_add_blocker(Rect2(78.0, 180.0, 44.0, 640.0)); _arch_marks(128.0, 220.0, 2, 30, 18.0, 19.0, Color(0.45, 0.45, 0.52, 0.5))
	# parede LESTE com a FENDA da VISTA (gap y440..540) → dois segmentos
	var we1 := ColorRect.new(); we1.color = Color("1b1b22"); we1.size = Vector2(44.0, 260.0); we1.position = Vector2(1378.0, 180.0); we1.z_index = 181; _region_node.add_child(we1)
	var we2 := ColorRect.new(); we2.color = Color("1b1b22"); we2.size = Vector2(44.0, 280.0); we2.position = Vector2(1378.0, 540.0); we2.z_index = 181; _region_node.add_child(we2)
	_add_blocker(Rect2(1378.0, 180.0, 44.0, 260.0)); _add_blocker(Rect2(1378.0, 540.0, 44.0, 280.0))
	# parede SUL
	var ws := ColorRect.new(); ws.color = Color("1b1b22"); ws.size = Vector2(1300.0, 44.0); ws.position = Vector2(120.0, 818.0); ws.z_index = 862; _region_node.add_child(ws)
	_add_blocker(Rect2(120.0, 818.0, 1300.0, 44.0)); _arch_marks(180.0, 826.0, 56, 1, 20.0, 12.0, Color(0.42, 0.42, 0.50, 0.45))
	# ── O ASSENTO DO LEITOR (descoberta, NÃO-interativa): estante + banco VAZIO voltado pra grande parede. Quem lia em
	#    voz alta sentava aqui. Não está mais. (a areia não levou a pedra — levou o leitor.) ──
	_arch_reader_seat(Vector2(760.0, 560.0))
	# ── A ÚNICA MARCA LEGÍVEL [E] (na grande parede; com um tom levemente + quente, o olho a encontra) ──
	var leg := ColorRect.new(); leg.color = Color("6a5f4a"); leg.size = Vector2(15.0, 19.0); leg.position = Vector2(512.0, 120.0); leg.z_index = 122; _region_node.add_child(leg)
	var legm := Line2D.new(); legm.points = PackedVector2Array([Vector2(516.0, 124.0), Vector2(524.0, 126.0), Vector2(518.0, 134.0)]); legm.width = 1.5; legm.default_color = Color(0.86, 0.78, 0.6, 0.9); legm.z_index = 123; _region_node.add_child(legm)
	var lnode := Node2D.new(); lnode.position = Vector2(520.0, 196.0); lnode.z_index = 196
	var lp := Label.new(); lp.text = "[E] a única marca legível"; lp.position = Vector2(-66.0, -34.0); lp.modulate = Color("cdb9a0")
	lp.add_theme_font_size_override("font_size", 14); lp.add_theme_color_override("font_outline_color", Color(0.03, 0.03, 0.04, 0.95)); lp.add_theme_constant_override("outline_size", 5); lp.visible = false
	lnode.add_child(lp); _tag_on_top(lp); _region_node.add_child(lnode)
	_services.append({"node": lnode, "prompt": lp, "pos": lnode.position, "kind": "future_exit", "id": "archive_name", "title": "a única marca legível", "msg": [
		"Parede após parede, do chão ao teto, nomes gravados na pedra. Milhares. Tudo intacto.",
		"E nenhum você consegue ler — a mão que sabia o que estas marcas diziam virou pó faz muito tempo.",
		"Só uma, baixa, num canto, ainda se deixa ler. Um nome: «Imen».",
		"Você já ouviu este nome. Numa pedra pequena, longe daqui, alguém ainda o repete toda noite — é o único que não virou silêncio.",
	]})
	# ── A VISTA (ambiente, sem [E]): pela fenda da parede leste, o deserto — e LONGE, pequena, a luz da Cidade VIVA.
	#    O registro morto aqui dentro × a vida que segue lá fora. ──
	_arch_vista(Vector2(1400.0, 490.0))
	# ── A GOTA dormente (assinatura sonora do silêncio; reusa CISTERN_DRIP_PATH — sem .ogg fica muda, NÃO dá erro) ──
	var drip := AudioStreamPlayer2D.new(); drip.set_meta("av_cistern_drip", true); drip.position = Vector2(240.0, 780.0)
	drip.volume_db = -15.0; drip.max_distance = 760.0; drip.attenuation = 1.6
	if AudioServer.get_bus_index("Ambient") != -1:
		drip.bus = "Ambient"
	if ResourceLoader.exists(CISTERN_DRIP_PATH):
		var ds = load(CISTERN_DRIP_PATH)
		if ds != null: drip.stream = ds
	_region_node.add_child(drip)
	var dt := Timer.new(); dt.one_shot = false; dt.wait_time = 7.0; _region_node.add_child(dt)
	dt.timeout.connect(func() -> void:
		if drip.stream == null or not drip.is_inside_tree():
			return
		drip.play())
	dt.start()

## A GRANDE PAREDE DE NOMES (fundo): face de pedra alta (y40..158) coberta de marcas gravadas — densas, idênticas,
## ilegíveis. O 99,999% inútil. (THE_GREAT_ARCHIVE_BUILD_01)
func _arch_back_wall(x0: float, x1: float) -> void:
	# FACE da parede (LANDMARKS_PACK_02): backdrop OPACO tileado na horizontal (TextureRect TILE, clipado à largura) se
	# existir; senão o ColorRect + marcas procedurais (fallback). z=120 (frontal). O cap (borda superior) segue por código.
	var wall_tex := _try_load_tex("res://assets/tilesets/great_archive/name_wall_archive.png")
	if wall_tex != null:
		var tr := TextureRect.new(); tr.texture = wall_tex
		tr.stretch_mode = TextureRect.STRETCH_TILE
		tr.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		tr.size = Vector2(x1 - x0, 120.0); tr.position = Vector2(x0, 40.0); tr.z_index = 120
		tr.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_region_node.add_child(tr)
	else:
		var face := ColorRect.new(); face.color = Color("24242c"); face.size = Vector2(x1 - x0, 120.0); face.position = Vector2(x0, 40.0); face.z_index = 120; _region_node.add_child(face)
		var cols := int((x1 - x0 - 24.0) / 18.0)
		_arch_marks(x0 + 14.0, 58.0, cols, 5, 18.0, 19.0, Color(0.40, 0.40, 0.48, 0.55))
	var cap := ColorRect.new(); cap.color = Color("2e2e38"); cap.size = Vector2(x1 - x0, 8.0); cap.position = Vector2(x0, 40.0); cap.z_index = 121; _region_node.add_child(cap)

## Tile de marcas gravadas (ticks minúsculos, idênticos = ilegíveis). Jitter por índice (determinístico, sem rng).
func _arch_marks(x0: float, y0: float, cols: int, rows: int, dx: float, dy: float, col: Color) -> void:
	for r in range(rows):
		for c in range(cols):
			var px: float = x0 + float(c) * dx + sin(float(c * 7 + r * 13)) * 2.0
			var py: float = y0 + float(r) * dy + cos(float(c * 5 + r * 11)) * 1.4
			var mk := Line2D.new()
			mk.points = PackedVector2Array([Vector2(px, py), Vector2(px + 3.0, py + 1.0), Vector2(px + 1.0, py + 4.0)])
			mk.width = 1.0; mk.default_color = col; mk.z_index = int(py) + 1
			_region_node.add_child(mk)

## O assento do leitor (descoberta): estante baixa de pedra + banco vazio voltado pra grande parede. Quem lia em voz
## alta sentava aqui — e não está mais. Sem interação, sem blocker (você passa). (THE_GREAT_ARCHIVE_BUILD_01)
func _arch_reader_seat(pos: Vector2) -> void:
	var z := int(pos.y)
	var lect := ColorRect.new(); lect.color = Color("3a3a44"); lect.size = Vector2(54.0, 30.0); lect.position = pos + Vector2(-27.0, -54.0); lect.rotation = -0.06; lect.z_index = z; _region_node.add_child(lect)
	var slab := ColorRect.new(); slab.color = Color("4a4a56"); slab.size = Vector2(54.0, 8.0); slab.position = pos + Vector2(-27.0, -56.0); slab.rotation = -0.06; slab.z_index = z + 1; _region_node.add_child(slab)
	var seat := ColorRect.new(); seat.color = Color("2f2f39"); seat.size = Vector2(40.0, 16.0); seat.position = pos + Vector2(-20.0, 8.0); seat.z_index = z; _region_node.add_child(seat)
	var legs := ColorRect.new(); legs.color = Color("262630"); legs.size = Vector2(40.0, 8.0); legs.position = pos + Vector2(-20.0, 22.0); legs.z_index = z - 1; _region_node.add_child(legs)
	# poeira no assento (ninguém senta há muito) — uma película pálida
	var dust := ColorRect.new(); dust.color = Color(0.7, 0.68, 0.6, 0.10); dust.size = Vector2(40.0, 16.0); dust.position = pos + Vector2(-20.0, 8.0); dust.z_index = z + 1; _region_node.add_child(dust)

## A VISTA pela fenda da parede leste: o deserto pálido lá fora — e LONGE, pequena, a luz QUENTE da Cidade viva (pulsa).
## O registro morto aqui × a vida que segue. Ambiente puro (sem [E]); a luz puxa o olhar. (THE_GREAT_ARCHIVE_BUILD_01)
func _arch_vista(pos: Vector2) -> void:
	# o "lado de fora" visto pela fenda (atrás da parede leste): céu/duna pálidos
	var sky := ColorRect.new(); sky.color = Color("6f6a78"); sky.size = Vector2(70.0, 100.0); sky.position = pos + Vector2(22.0, -50.0); sky.z_index = 179; _region_node.add_child(sky)
	var dune := ColorRect.new(); dune.color = Color("8a7a5a"); dune.size = Vector2(70.0, 40.0); dune.position = pos + Vector2(22.0, 10.0); dune.z_index = 179; _region_node.add_child(dune)
	# a fenda em si (rasgo de luz na parede)
	var crack := Polygon2D.new(); crack.polygon = PackedVector2Array([pos + Vector2(-4, -50), pos + Vector2(10, -36), pos + Vector2(4, 0), pos + Vector2(12, 30), pos + Vector2(-2, 50), pos + Vector2(-10, 0)])
	crack.color = Color(0.86, 0.84, 0.78, 0.85); crack.z_index = 182; _region_node.add_child(crack)
	# ★ a luz da Cidade VIVA, longe e pequena (quente, pulsa) — o único calor visível do Arquivo
	var far := Polygon2D.new(); var fp := PackedVector2Array()
	for i in range(10):
		var a := TAU * float(i) / 10.0
		fp.append(Vector2(cos(a) * 5.0, sin(a) * 5.0))
	far.polygon = fp; far.position = pos + Vector2(54.0, 6.0); far.color = Color("ffcf8a"); far.z_index = 180; _region_node.add_child(far)
	var halo := Polygon2D.new(); var hp := PackedVector2Array()
	for i in range(12):
		var a := TAU * float(i) / 12.0
		hp.append(Vector2(cos(a) * 12.0, sin(a) * 12.0))
	halo.polygon = hp; halo.position = pos + Vector2(54.0, 6.0); halo.color = Color(1.0, 0.81, 0.5, 0.22); halo.z_index = 179; _region_node.add_child(halo)
	if far.is_inside_tree():
		var tw := far.create_tween(); tw.set_loops()
		tw.tween_property(far, "modulate:a", 0.55, 2.6).set_trans(Tween.TRANS_SINE)
		tw.tween_property(far, "modulate:a", 1.0, 2.6).set_trans(Tween.TRANS_SINE)

## ★ A CATEDRAL DE CRISTAL (CATHEDRAL_PRODUCTION_SLICE_F5) — a 1ª PROFUNDIDADE de CAÇA da Caverna, jogável e
## REVERSÍVEL. Câmara única grande (2200x1500) com gradiente "mais fundo = mais cristal/perigo", em 4 setores de
## intensidade crescente: ENTRADA/Varanda (sul, SEGURA, sem mob) → ALA NORTE (oeste, farm leve/médio) → NAVE central
## (gargalo médio/alto) → NÚCLEO (norte, BLOQUEADO por cristal; promessa visual do Coração de Cristal + packs
## dormentes, SEM boss/loot-raro). O combate REUSA mobs da Caverna (sprites REAIS): crystal_bat=INVESTIDA(line),
## living_shard=ABALO(circle), stone_sentinel=VARREDURA(cone) → as 3 formas testáveis + a esquiva. Eixo visual
## ABERTO sul→norte: da varanda vê-se a nave e o Núcleo brilhar ao fundo. SEM multiplayer/instância/sistema/economia/
## save/quest novos. Props procedurais (helpers _cath_*). Save-safe: nada aqui persiste.
## ★ OS VEIOS (BUILD_VEIOS_F5) — L1 da masmorra vertical: a 1ª camada ABAIXO da Caverna, ANTES da Catedral. Minas
## velhas (escavadas + abandonadas), o cristal ainda BRUTO na parede; a mina afunda até a ÁGUA (boca do Lago, L2).
## Cadeia: Caverna → OS VEIOS → [Lago placeholder] → Catedral. Identidade "a mesma Caverna, mais funda": mesma paleta,
## só escavada/funda + 4 deltas (rocha trabalhada/estreito/veio bruto/luz baixa). 3 faixas de profundidade no eixo
## N→S: BOCA seca (norte) → GALERIAS-farm (meio) → FUNDO ALAGADO (sul, elite-gate + Lago placeholder + descida à
## Catedral). Mobs reusados (configs em _mob_configs), props procedurais (_veins_*), ZERO sistema/save/NPC/lore novo.
func _build_veins(size: Vector2) -> void:
	_current_boss = null
	_boss_name = ""
	# ── PORTAIS: volta → Caverna (norte) · desce → Catedral (sul/água, o 2º degrau) ──
	_build_portal(VEINS_TO_CAVE, "cave", "↑ subir → a Caverna", true, CAVE_RETURN_FROM_VEINS)
	_build_portal(VEINS_TO_CATHEDRAL, "cathedral_of_crystal", "↡ descer → a Catedral de Cristal", false, CATHEDRAL_SPAWN)

	# ════════ BOCA (norte, seca) — a chegada da Caverna por um poço de mina escorado ════════
	# degraus que DESCEM da boca (você caiu de cima) — leem como profundidade
	for i in range(5):
		var st := ColorRect.new(); st.color = Color(0.10, 0.12, 0.18, 0.34 + 0.05 * float(i))
		st.size = Vector2(220.0, 15.0); st.position = Vector2(840.0, 150.0 + float(i) * 13.0); st.z_index = -15; _region_node.add_child(st)
	_veins_beam(Vector2(770.0, 250.0), 120.0); _veins_beam(Vector2(1130.0, 250.0), 120.0)   # escoras emoldurando a boca
	_veins_rail(Vector2(950.0, 300.0), Vector2(950.0, 980.0))   # o trilho central que some na água (o eixo da descida)
	_maw_marker(Vector2(950.0, 360.0), "veins_top", "✦ [E] a boca da mina", [
		"Você desce abaixo de onde o Golem ronda. Aqui não é caverna bruta — é rocha CAVADA, de corte reto, escorada com madeira podre.",
		"Alguém minerou cristal neste veio há muito tempo, e foi embora. Os trilhos seguem fundo adentro e somem.",
	])

	# ════════ GALERIAS (meio) — o farm aberto: estrutura de mina (cobertura) + veios de cristal BRUTO ════════
	# escoras (cobertura vertical) + carrinhos tombados (cobertura baixa) — a "mão humana" que se foi
	_veins_beam(Vector2(500.0, 500.0), 110.0); _veins_beam(Vector2(1400.0, 520.0), 110.0)
	_veins_beam(Vector2(560.0, 700.0), 100.0); _veins_beam(Vector2(1150.0, 640.0), 100.0)
	_veins_beam(Vector2(700.0, 820.0), 110.0); _veins_beam(Vector2(1250.0, 840.0), 110.0)
	_veins_cart(Vector2(620.0, 680.0)); _veins_cart(Vector2(1300.0, 700.0)); _veins_cart(Vector2(880.0, 900.0))
	_veins_rail(Vector2(560.0, 520.0), Vector2(1320.0, 690.0))   # um ramal de trilho diagonal (deco)
	# veios de cristal BRUTO na parede (deco; o precursor cru da Catedral) — nas bordas + 1 nó RICO visível
	_veins_vein(Vector2(180.0, 500.0), 120.0); _veins_vein(Vector2(1720.0, 600.0), 130.0)
