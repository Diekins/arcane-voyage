	var corner := Vector2(size.x * 0.16, size.y * 0.58)   # canto oeste quieto da Vila
	# 1) LAMPARINA SEMPRE ACESA (cenário passivo: alguém mantém uma luz aqui)
	_add_floor_glow(corner + Vector2(0.0, 6.0), 46.0, Color(1.0, 0.82, 0.45, 0.16))   # luz quente no chão
	var post := ColorRect.new(); post.color = Color("3a2c1e"); post.size = Vector2(6.0, 52.0); post.position = corner + Vector2(-3.0, -52.0); post.z_index = int(corner.y); _region_node.add_child(post)
	var lamp := ColorRect.new(); lamp.color = Color("2a2620"); lamp.size = Vector2(16.0, 16.0); lamp.position = corner + Vector2(-8.0, -64.0); lamp.z_index = int(corner.y); _region_node.add_child(lamp)
	var flame := Polygon2D.new(); flame.polygon = PackedVector2Array([Vector2(0.0, -6.0), Vector2(4.0, 2.0), Vector2(-4.0, 2.0)]); flame.color = Color(1.0, 0.78, 0.36, 0.95); flame.position = corner + Vector2(0.0, -58.0); flame.z_index = int(corner.y) + 1; _region_node.add_child(flame)
	# 2) LINA — a filha que espera (NPC existente; fala curta = rumor passivo + profundidade ao conversar)
	_build_villager(corner + Vector2(64.0, 18.0), "npcs/village/farmer", "Lina", [
		"Eu mantenho a lamparina acesa — pro caso de o meu pai achar o caminho de volta.",
		"Ele só foi 'até a curva do rio'. Faz tempo. Mas a luz fica.",
		"Dizem que tem uma moça lá na costa que faz o mesmo — fica olhando o mar pelo irmão que não voltou. Não sou a única a deixar uma luz acesa.",
		"Quando o vento muda, fico imaginando se ela está olhando o mesmo mar que eu.",
	], "", false)
	# 3) A REDE — objeto OPCIONAL [E] (aprofunda; future_exit = só texto, sem recompensa)
	_add_lore_marker(corner + Vector2(-58.0, 10.0), "net", "examinar a rede de pesca", "A Rede de Oren", [
		"Uma rede meio remendada, pendurada como se fosse usada amanhã.",
		"O anzol ainda tem isca seca. Alguém parou no meio do conserto — e não voltou para terminar.",
	])

