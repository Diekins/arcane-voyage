func _process(delta: float) -> void:
	# TELA INICIAL aberta (GODOT-TITLE-SCREEN-RPG-MVP-1): pausa TODO o tick de jogo (inclusive regen de
	# mana, que escreveria no save) até o jogador escolher na capa. Player já fica travado.
	if _title_open:
		return
	if _hud_target != null: _hud_target.refresh()   # A35 — atualiza a HUD alvo (só display)
	_attack_cd = maxf(0.0, _attack_cd - delta)
	# RECURSOS DE CLASSE (GODOT-CLASS-RESOURCES-MVP-1): throttle do aviso + regen lento de mana (sem salvar
	# no tick; persiste no próximo save natural). Conservador → não trivializa, mas evita softlock do Mago.
	_resource_warn_cd = maxf(0.0, _resource_warn_cd - delta)
	_mana_regen_t += delta
	if _mana_regen_t >= MANA_REGEN_INTERVAL:
		_mana_regen_t = 0.0
		GameState.restore_mana(MANA_REGEN_AMOUNT)
	# KIT DO ORÁCULO (GODOT-ORACLE-SUPPORT-KIT-1): decai escudo, cooldowns das habilidades e debuffs.
	GameState.tick_shield(delta)
	for _k in _ability_cd:
		_ability_cd[_k] = maxf(0.0, float(_ability_cd[_k]) - delta)
	_guard_dr_t = maxf(0.0, _guard_dr_t - delta)   # Brado de Guarda: decai o buff defensivo transiente
	if not _weaken.is_empty():
		for e in _weaken.keys():
			if not is_instance_valid(e):
				_weaken.erase(e)
				continue
			_weaken[e]["t"] = float(_weaken[e]["t"]) - delta
			if float(_weaken[e]["t"]) <= 0.0:
				_weaken.erase(e)
	_update_camera_shake(delta)
	_dodge_fb_t = maxf(0.0, _dodge_fb_t - delta)   # POLISH_PASS_02A: cooldown do feedback de esquiva
	_refresh_boss_hud()
	if _tip_visible:
		_position_tip()   # tooltip RPG segue o mouse, clampado na tela
	_collect_drops_near_player()
	var dialog_open: bool = _dialog != null and _dialog.is_open()
	if _player == null:
		return
	if _aldric_prompt != null:
		_aldric_prompt.visible = _near_aldric() and not dialog_open
	# VERTICALITY F2: o prompt [E] só aparece p/ entidade do MESMO andar (sem "level" = 0 = legado → idêntico).
	for p in _portals:
		var pr = p["prompt"]
		if pr != null:
			pr.visible = _on_floor(p) and _player.position.distance_to(p["pos"]) <= PORTAL_RADIUS and not dialog_open
	for n in _npcs:
		var npr = n["prompt"]
		if npr != null:
			npr.visible = _on_floor(n) and _player.position.distance_to(n["pos"]) <= INTERACT_RADIUS and not dialog_open
	for s in _services:
		var spr = s["prompt"]
		if spr != null:
			spr.visible = _on_floor(s) and _player.position.distance_to(s["pos"]) <= INTERACT_RADIUS and not dialog_open
	for ch in _chests:
		var chpr = ch["prompt"]
		if chpr != null:
			chpr.visible = _on_floor(ch) and _player.position.distance_to(ch["pos"]) <= INTERACT_RADIUS and not dialog_open
	# FATIA A16.2: o HuntHost é o ÚNICO tick owner do HuntRuntime. host_process avança a Hunt (quando ativa) e devolve
	# se a PROGRESSÃO pode rodar neste frame — Progression e Hunting são EXCLUSIVOS (§97). Sem host, roda Progression.
	if _autoconsumables != null:     # A17.6/A17.10C: auto poções rodam em AMBOS os modos (progressão e hunt)
		var mend_pending := _hunthost != null and _hunthost.is_hunting() and _hunthost.support_self_heal_ready()
		_autoconsumables.tick(delta, mend_pending)
	# A18: MISSÃO tem prioridade; MISSÃO xor HUNT xor PROGRESSÃO (tick owner exclusivo, movement lock no encounter).
	var run_progression := true
	if _missionhost != null and _missionhost.is_active():
		_missionhost.host_process(delta)
		run_progression = false
	elif _hunthost != null:
		run_progression = _hunthost.host_process(delta)
		_hunt_dev_tick()
	if _acq_controller != null:
		_acq_controller.process_ux()   # A24: detecta objetivo concluído durante a Hunt (overlay 1×, Hunt continua)
	if _environment != null and is_instance_valid(_environment):
		_environment.tick_wind(delta); _environment.update_occlusion(_player, delta)   # A28: vento + oclusão de copa
	if run_progression:
		_auto_transition_tick(delta, dialog_open)
		_auto_attack_tick(delta, dialog_open)
		if _autoplay != null:            # FATIA A1: escolhe o próximo alvo sozinho (após o auto-attack legado)
			_autoplay.tick(delta)
	if _stagedirector != null:       # FATIA A2: cronômetro de transição de fase
		_stagedirector.tick(delta)
	if _idlehud != null:             # FATIA A4: casca visual idle (refresh THROTTLED internamente ~8Hz)
		_idlehud.refresh()
	_refresh_battle_ui(dialog_open)
	_hud_explore_tick(delta, dialog_open)   # P0.2: atenua a HUD em exploração calma; restaura em combate/dano/menu
	_quiet_tick(delta)                      # P2-G: O Aquietar (no-op fora do piloto/Pântano)
	_npc_ambient_tick(delta, dialog_open)
	_update_depth_sort()
	_vertical_tick(delta)  # VERTICALITY F1: troca de andar pela escada/rampa (no-op fora do modo vertical/vlab)
	_stair_npc_tick(delta) # VERTICALITY F4 MÍNIMA: NPCs roteirizados que sobem/descem sozinhos (no-op se nenhum)
	_macro_region_tick()   # GRADUATION-1: region-by-position (no-op fora de _macro_canonical)
	_macro_cull_tick()     # FASE D: cull de visibilidade de zonas distantes (no-op fora do mundo mesclado)
	_guardian_entry_tick(dialog_open)   # GUARDIAN-LANGUAGE-1: batida de ENTRADA ao se aproximar de um guardião

## [Tab]/[K] tratados em _input (antes da navegação de foco da GUI, p/ o Tab não ser roubado por Button).
func _input(event: InputEvent) -> void:
	if (_dialog != null and _dialog.is_open()) or _inv_open or _shop_open:
		return
	if event is InputEventKey and event.pressed and not event.echo:
		if event.keycode == KEY_TAB:
			_battle_cycle_selection()
			get_viewport().set_input_as_handled()
		elif event.keycode == KEY_K:
			_clear_auto_target()   # cancela auto-attack + cursor + marker
			get_viewport().set_input_as_handled()
		elif event.keycode == KEY_H:
			if _hunthost != null:   # FATIA A16.2: abre/fecha as Hunting Grounds (o jogador entra/sai da Hunt aqui)
				_hunthost.toggle_panel()
				get_viewport().set_input_as_handled()
		elif event.keycode == KEY_F3:
			_toggle_hunt_dev()      # A17.2: overlay técnico da Hunt (debug)
			get_viewport().set_input_as_handled()
		elif event.keycode == KEY_F4:
			_toggle_dev_drawer()    # A17.2: drawer dos botões DEV (debug)
			get_viewport().set_input_as_handled()
		return
	# CLIQUE NO MUNDO tratado AQUI (em _input, ANTES da GUI). Necessário porque os ColorRects de
	# cenário (fundo/props) são Controls com mouse_filter STOP e roubariam o clique no _unhandled_input.
	# esq OU dir sobre um inimigo → vai e ataca; dir no vazio → cancela. Cliques sobre o painel da
	# Battle UI são deixados passar (a lista trata via gui_input das linhas).
	if event is InputEventMouseButton and event.pressed and (event.button_index == MOUSE_BUTTON_LEFT or event.button_index == MOUSE_BUTTON_RIGHT):
		if _over_battle_panel():
			return
		var clicked = _enemy_at_mouse()
		if clicked != null:
			_select_enemy(clicked)
			get_viewport().set_input_as_handled()
			return
		if event.button_index == MOUSE_BUTTON_RIGHT:
			_clear_auto_target()
			get_viewport().set_input_as_handled()

## True se o cursor está sobre o painel (visível) da Battle UI — aí o clique é da LISTA (gui_input das
## linhas), não do mundo.
func _over_battle_panel() -> bool:
	return _battle_panel != null and _battle_panel.visible \
		and _battle_panel.get_global_rect().has_point(_battle_panel.get_global_mouse_position())

## Auto-transição por proximidade (GODOT-AUTO-MAP-TRANSITIONS-1): ao ENTRAR na boca de um portal (ou da
## future_exit), dispara a MESMA lógica segura do [E] (`_use_portal`/`_use_future_exit`) — gate preservado.
## EDGE-trigger (só ao entrar, não a cada frame) + cooldown (anti-loop ao surgir/após disparar).
func _auto_transition_tick(delta: float, dialog_open: bool) -> void:
	_transition_cd = maxf(0.0, _transition_cd - delta)
	var zone = _nearest_auto_zone()   # computa SEMPRE (mesmo em diálogo) p/ manter o tracking de "estou na boca"
	if zone == null:
		_auto_zone_active = null
		return
	# player DENTRO da boca: durante diálogo OU cooldown, só marca presença (não dispara → anti-loop)
	if dialog_open or _transition_cd > 0.0:
		_auto_zone_active = zone
		return
	if zone != _auto_zone_active:   # EDGE: acabou de ENTRAR → dispara uma vez
		_auto_zone_active = zone
		_transition_cd = 1.0       # lockout (transição bem-sucedida re-seta a 0.8 no load_region)
		if str(zone.get("kind", "portal")) == "future_exit":
			_use_future_exit(zone)
		else:
			_use_portal(zone)

## Portal OU future_exit cuja BOCA o player está dentro (raio pequeno), senão null.
func _nearest_auto_zone():
	if _player == null:
		return null
	var best = null
	var bd := PORTAL_AUTO_RADIUS
	for p in _portals:
		var d: float = _player.position.distance_to(p["pos"])
		if d <= bd:
			bd = d
			best = p
	for s in _services:
		if str(s.get("kind", "")) == "future_exit":
			var d2: float = _player.position.distance_to(s["pos"])
			if d2 <= bd:
				bd = d2
				best = s
	return best

## Auto-attack (GODOT-AUTO-ATTACK-1): com um alvo travado, repete o golpe no ritmo do `_attack_cd` já
## existente (sem nova lógica de dano/XP/loot). PAUSA em menu/diálogo (não golpeia → sem hit fantasma);
## CANCELA por: herói morto, alvo morto/despawnado, ou fora de alcance por mais de AUTO_LOST_GRACE.
## (troca de mapa zera o alvo em load_region.)
func _auto_attack_tick(delta: float, dialog_open: bool) -> void:
	if _auto_target != null and not _target_alive(_auto_target):
		_clear_auto_target()
	if GameState.is_hero_defeated():
		_clear_auto_target()
	_update_auto_marker()
	if _auto_target == null:
		return
	# WASD do jogador cancela a perseguição (ele assumiu o controle do movimento)
	if _auto_walk and _player.call("take_manual_cancel"):
		_auto_walk = false
		_player.call("clear_move_target")
	# menu/diálogo/loja aberto: pausa (mantém o alvo travado, mas não golpeia nem persegue)
	if dialog_open or _inv_open or _shop_open:
		if _auto_walk:
			_player.call("clear_move_target")
		return
	var rng := _attack_range_now()
	if _player.position.distance_to(_auto_target.position) > rng:
		if _auto_walk:
			# perseguindo: re-mira no alvo (que pode andar/fugir) e não conta a tolerância
			_player.call("set_move_target", _auto_target.position, rng * 0.85)
			_auto_lost_t = 0.0
		else:
			# sem perseguição (aproximação manual): tolera um tempo e solta o alvo
			_auto_lost_t += delta
			if _auto_lost_t >= AUTO_LOST_GRACE:
				_clear_auto_target()
		return
	# em alcance: para de andar (mantém _auto_walk p/ re-perseguir se o alvo fugir) e golpeia
	_auto_lost_t = 0.0
	if _player.get("move_target") != Vector2.INF:
		_player.call("clear_move_target")
	if _attack_cd > 0.0:
		return
	_attack_target(_auto_target)

## Inimigo (mob ou boss) ainda válido E vivo.
func _target_alive(t) -> bool:
	return t != null and is_instance_valid(t) and t.has_method("is_alive") and t.is_alive()

func _set_auto_target(t) -> void:
	if t != _auto_target:
		_auto_target = t
		_auto_lost_t = 0.0

func _clear_auto_target() -> void:
	_auto_target = null
	_auto_lost_t = 0.0
	_battle_sel = null
	_auto_walk = false
	if _player != null:
		_player.call("clear_move_target")
	if _auto_marker != null:
		_auto_marker.visible = false

