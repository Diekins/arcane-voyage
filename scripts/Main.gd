	_build_stone_witness(terr, Vector2(1928.0, 144.0), 1, "stone_rep", "a Reparadora", Color("6f7a52"), Color("4c5536"), "work", false, [
		"O vento desfia tudo. A gente refaz. Ficar é isso.",
		"Um nó solto hoje é uma queda amanhã. Então eu aperto hoje.",
