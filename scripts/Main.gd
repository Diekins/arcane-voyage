		plip.z_index = 1; plip.z_as_relative = true; terr.add_child(plip)
	var tlip := ColorRect.new(); tlip.color = Color(0.9, 0.8, 0.58, 0.4); tlip.position = Vector2(1660.0, 95.0); tlip.size = Vector2(680.0, 3.0)
	tlip.z_index = 1; tlip.z_as_relative = true; terr.add_child(tlip)
	# DAIS da Vigia (uma pedra plana na beira) — ela parece POSTADA no mirante, não só deslocada
	var dais := ColorRect.new(); dais.color = Color("a98a52"); dais.position = Vector2(1978.0, 138.0); dais.size = Vector2(64.0, 18.0)
