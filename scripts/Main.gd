func _on_mob_died(mob) -> void:
	if not is_instance_valid(mob):
		return
	if _autoplay != null:   # FATIA A1: instrumentação dos 50 kills (1 por morte; o `died` do Mob dispara 1x)
		_autoplay.notify_kill(mob)
	if _stagedirector != null:   # FATIA A2: progressão de fase (dedup por instância+serial de morte)
		_stagedirector.notify_kill(str(mob.get("mob_id")), false, "%d:%d" % [mob.get_instance_id(), int(mob.get("deaths"))])
	if _bestiary != null:   # FATIA A7: kill lifetime por mob (Bestiário; debounced, sem write storm)
		_bestiary.notify_kill(str(mob.get("mob_id")))
	var pos: Vector2 = mob.position
	var xp := int(mob.get("xp_reward"))
	var gold := int(mob.get("gold_reward"))
	GameState.add_xp(xp)
	GameState.add_gold(gold)
	_spawn_world_text(pos, "+%d XP" % xp, Color("9fe0a0"), -22.0)
	_spawn_world_text(pos, "+%d ouro" % gold, Color("e8c267"), -4.0)
	for entry in mob.get("loot_table"):
		if randf() <= float(entry.get("chance", 0.0)):
			_spawn_drop(pos, str(entry.get("name", "")))
	_advance_kill_quests(str(mob.get("mob_id")), pos)   # side-quests de kill (após XP/gold/loot)
	if str(mob.get("mob_id")) == "ancient_root_heart":
		_on_ancient_heart_defeated(pos)   # fechamento do arco das Raízes Negras (GODOT-ROOT-ARC-CLOSURE-1)
	if str(mob.get("mob_id")) == "salt_split_warden":
		_on_salt_isle_boss_defeated(pos)   # mini-boss da Ilha do Sal Partido (GODOT-SALT-SPLIT-ISLE-MVP-1)
	if str(mob.get("mob_id")) == "khet_sar_sentinel":
		_on_khet_sentinel_defeated(pos)   # elite dos Areais de Khet-Sar (GODOT-KHET-SAR-SANDS-MVP-1)
	if str(mob.get("mob_id")) == "khet_oasis_salt_echo":
		_on_oasis_salt_echo_defeated(pos)   # mini-evento opcional do Oásis (GODOT-KHET-OASIS-SALT-ECHO-EVENT-1)
	if str(mob.get("mob_id")) == "vigia_da_mare":
		_on_vigia_da_mare_defeated(pos)     # R02: abre a passagem ao Promontório (não tesouro — passagem)
	if str(mob.get("mob_id")) == "coracao_de_cristal":
		_on_coracao_defeated(pos)           # HEART_OF_CRYSTAL: pontua "a fenda cede" (RECORRENTE, cosmético, sem save)
	if str(mob.get("mob_id")) == "remontado":
		_on_remontado_defeated(pos)         # CANAIS: "o brejo já recolhe a sucata" (o brejo REMONTA; cosmético, sem save)
	if str(mob.get("mob_id")) == "scrap_colossus":
		_on_colossus_defeated(pos)          # COLOSO_SCAR: marca o Poço (flag persistido; a fera volta, o ferro fica)
	# LINGUAGEM DOS GUARDIÕES: batida de MORTE (texto) dos elites-guardião (fecha o conceito; sem flag/save).
	var gd := _guardian_lines(str(mob.get("mob_id")))
	if gd.has("death") and str(gd["death"]) != "":
		_spawn_world_text(pos, str(gd["death"]), Color("d7c9a0"), -58.0)

