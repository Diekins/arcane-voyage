	_build_service(Vector2(_size.x * 0.30, _size.y * 0.36), "quest_board", "[E] ler o mural")       # mural de missões (NO)
	_build_service(Vector2(_size.x * 0.63, _size.y * 0.62), "shrine", "[E] tocar o santuário")       # santuário de surgimento (SE)
	# BAÚ DO ERRANTE (GODOT-VILLAGE-STASH-MVP-1): depósito permanente, perto da praça, fora dos corredores
