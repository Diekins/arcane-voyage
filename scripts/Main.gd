var _guardian_seen := {}   # instance_id → true: entrada já anunciada nesta montagem (reset no load)

func _guardian_lines(key: String) -> Dictionary:
	return GUARDIAN_LINES.get(key, {})

## ENTRADA dos guardiões: ao chegar perto pela 1ª vez, anuncia a "fala" (texto), comunicando o conceito. Chamado
## de _process (barato; 1× por instância). Não toca save (só _spawn_world_text). Vale em produção e no contínuo.
func _guardian_entry_tick(dialog_open: bool) -> void:
	if _player == null or dialog_open or _title_open:
		return
	if _current_boss != null and is_instance_valid(_current_boss):
		_maybe_announce_guardian(_current_boss, _boss_name)
	for m in _mobs:
		if is_instance_valid(m):
			_maybe_announce_guardian(m, str(m.get("mob_id")))

func _maybe_announce_guardian(node, key: String) -> void:
	var gl := _guardian_lines(key)
	if gl.is_empty() or not gl.has("entry"):
		return
	var idk: int = node.get_instance_id()
	if _guardian_seen.has(idk):
		return
	if _player.position.distance_to(node.position) > 560.0:
		return
	_guardian_seen[idk] = true
	_spawn_world_text(node.position, str(gl["entry"]), Color("ffd27a"), -72.0)

func _on_boss_defeated(boss_name: String) -> void:
	_presence_end_challenge()   # FATIA A10 (§18): vitória (manual ou auto) → encerra tentativa, restaura Auto anterior
	if _campaign_progress_locked():
		return   # macro-zona = sandbox: bosses estão suprimidos; defesa extra contra avanço canônico
	# P0.5 — PASSAGEM PRIMEIRO: antes de qualquer recompensa material (quest/loot/cena), o cartão de "Limiar
	# cruzado" sobe — o guardião protegia um CAMINHO, não um prêmio. Puro enquadramento; não toca a lógica abaixo.
	_show_passage_card(boss_name)
	# marca boss + completa a quest do boss (Lobo→ch1, Golem→ch2) → concede o reward
	# narrativo (Manto/Botas) pela rota data-driven; depois dispara a cena de desfecho.
	GameState.mark_boss_defeated(boss_name)
	if _current_boss != null:
		var qid := str(_current_boss.get("quest_id"))
		GameState.complete_quest(qid)
		if qid == "ch1-awakening":
			_tutorial_event("ch1_done")   # Lobo Alfa → avança o onboarding
	# LINGUAGEM DOS GUARDIÕES: batida de MORTE (texto) que fecha o conceito do guardião (Lobo/Golem).
	var gb := _guardian_lines(boss_name)
	if gb.has("death") and str(gb["death"]) != "":
		var bp: Vector2 = _current_boss.position if _current_boss != null and is_instance_valid(_current_boss) else (_player.position if _player != null else Vector2.ZERO)
		_spawn_world_text(bp, str(gb["death"]), Color("d7c9a0"), -64.0)
	# FATIA A2: o StageDirector OBSERVA a morte do boss (fecha a fase-10 do capítulo). Só observa — a narrativa
	# acima é a rota EXISTENTE do jogo (não é o StageDirector que marca quest/flag). Sem dedup_key: a proteção é o
	# GUARD DE ESTADO (completar a fase-boss flipa p/ TRANSITIONING no mesmo frame → 2º report é ignorado), e assim
	# um boss de um capítulo FUTURO (nova fase-boss) ainda conta.
	if _stagedirector != null:
		_stagedirector.notify_kill(boss_name.to_lower(), true, "")
	if _bestiary != null:   # FATIA A7: o boss também conta no Bestiário (por nome, minúsculas)
		_bestiary.notify_kill(boss_name.to_lower())
	# respeita "já vista" (não repete a cena).
	TriggerDispatcher.dispatch_event("boss_defeated", boss_name)

## Golpe de QUALQUER inimigo (boss ou mob). `enemy` vem via .bind() na conexão do sinal.
func _on_enemy_attack(amount: int, enemy) -> void:
	if _dialog != null and _dialog.is_open():
		return
	if GameState.is_hero_defeated():
		return
	# VERTICALITY F2: dano de inimigo só atinge o Errante no MESMO andar (melee E projétil — ambos passam por aqui).
	# Legado: tudo é nível 0 → _entity_floor==_floor_level==0 → nunca barra.
	if _entity_floor(enemy) != _floor_level:
		return
	# ESQUIVA / "O SEGUNDO VERBO" (COMBAT_FEEL_BUILD_01): i-frames durante o dash ANULAM qualquer golpe
	# (melee, projétil de mob e spell do Golem — todos chegam aqui). Off (DODGE_ENABLED=false) → nunca invulnerável.
	if _player != null and _player.has_method("is_invulnerable") and _player.call("is_invulnerable"):
		# ★ POLISH_PASS_02A — ESQUIVA QUE PAGA. Este ponto é o MÉRITO REAL: um golpe de inimigo (melee/projétil/spell)
		# REALMENTE chegou e foi ANULADO pelos i-frames do dash → não há falso positivo (dash no vazio/fora de combate
		# nunca chega aqui; tomar o golpe sem i-frame cai no caminho de dano abaixo). Cooldown = 1 feedback por esquiva.
		if _dodge_fb_t <= 0.0:
			_dodge_fb_t = 0.45
			_on_perfect_dodge(_player.position)
		return
	_hud_dmg_hold = HUD_DMG_HOLD   # P0.2: sofreu dano → mantém a HUD cheia (restaura imediato se estava atenuada)
	if _hud_dimmed:
		_set_hud_dim(false)
	# PRESSÁGIO FRÁGIL (GODOT-ORACLE-SUPPORT-KIT-1): inimigo enfraquecido causa menos dano.
	if _weaken.has(enemy):
		amount = maxi(1, int(round(float(amount) * float(_weaken[enemy]["mult"]))))
	# MAESTRIA DE GUARDA (GODOT-WARRIOR-GUARD-MASTERY-MVP-1): golpe REAL recebido (amount>0) por um Guerreiro
	# (melee) COM ESCUDO defensivo = defesa atuou → sobe a maestria. NÃO ganha parado/sem dano/sem escudo/
	# com book/bow/staff/spear. (A condição melee+escudo é a mesma de guard_defense_bonus → consistente.)
	if amount > 0 and GameState.current_combat_archetype() == "melee" and GameState.has_defensive_offhand():
		GameState.gain_mastery("guard", 1)
	var amt := GameState.mitigated_damage(amount)   # defesa = retornos decrescentes (GODOT-DEFENSE-SCALING-PASS-1)
	# BRADO DE GUARDA (GODOT-MASTERY-GUARD-SIGNATURE-1): redução TRANSIENTE só durante a janela do buff
	# (_guard_dr_t>0). Aplicada DEPOIS da defesa permanente, NÃO altera a fórmula nem o save; mín 1 de dano.
	if _guard_dr_t > 0.0 and amt > 0:
		amt = maxi(1, int(ceil(float(amt) * (1.0 - GUARD_SIG_DR))))
	# PÁGINA DE GUARDA: o escudo absorve ANTES do HP; absorver dano REAL evolui o Oráculo.
	var absorbed := GameState.shield_absorb(amt)
	if absorbed > 0:
		GameState.gain_proficiency("support", 1)
		GameState.gain_mastery("presage", 1)   # maestria exclusiva (só quando o escudo absorve dano REAL)
		if _player != null:
			# FATIA A8.1: absorção pelo bus (renderer desenha ⛊N); legado só se o bus não existe (anti-duplicar)
			if _feedback != null:
				_feedback.push_shield(absorbed, _player.position)
			else:
				_spawn_world_text(_player.position, "Escudo -%d" % absorbed, Color("b78cff"), -22.0)
	amt -= absorbed
	if amt <= 0:
		return   # totalmente absorvido → sem dano/flinch
	GameState.damage_hero(amt)
	# FATIA A8.1: dano recebido pelo bus (renderer desenha -N no herói); legado só sem bus (anti-duplicar)
	if _feedback != null:
		_feedback.push_damage_taken(amt, _player.position if _player != null else Vector2.ZERO)
	else:
		_spawn_hero_damage(amt)
	# FATIA A3: se este golpe ABATEU o herói, é uma FALHA de tentativa (o StageDirector conta/aplica o muro).
	# Dispara UMA vez por morte: golpes seguintes com o herói já abatido saem no early-return do topo desta função.
	if _stagedirector != null and GameState.is_hero_defeated():
		_stagedirector.notify_player_defeated()
		_presence_end_challenge()   # FATIA A10 (§19/§57): derrota manual → restaura o Auto anterior (sem reward)
	# flinch do Errante (flash + squash), na direção oposta ao inimigo
	if _player != null and _player.has_method("hit_recoil"):
		var src: Vector2 = enemy.position if is_instance_valid(enemy) else _player.position
		_player.call("hit_recoil", src)

