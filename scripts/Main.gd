## THE_STONE_BUILD_07 — "CARREGAR UM NOME": o 1º ritual da Vigília (RITUAL_SURVEY = R2). A Guardiã dá ao visitante UM
## nome de uma pessoa COMUM que o deserto levou; o jogador o REPETE uma vez; ela agradece e RECUSA um segundo. Em-sessão
## (estado em meta no node, como o gesto do cais; reseta na troca de região — P0.1, mundo sem livro-razão). SEM item/
## moeda/progresso/objetivo/marcador/checklist/save/contador/coleção/UI. Máquina de 3 estados (intro→repeat→done) no [E].
## ★ LEGADO (PEDRA_LEGACY_F5) — A PAREDE DO ERRANTE: uma corda+nó por NOME carregado (GameState.carried_names, persiste),
## em colunas que envolvem (sem teto = só cresce). Seixo quente nos mais recentes (os "ainda repetidos"). SEM texto na
## parede (idioma da Pedra: o vento apagaria a tinta; o nome vive na boca). + a RELEITURA [E]: fala os nomes de volta,
## contemplativa — sem placar, sem contador-troféu, sem recompensa. O valor nasce da própria existência da parede.
func _stone_carried_wall(base: Vector2) -> void:
	var names: Array = GameState.carried_names
	var per_col := 8
	for i in range(names.size()):
		var cx := base.x + float(i / per_col) * 26.0
		var ry := base.y + float(i % per_col) * 20.0
		var cord := Line2D.new()
		cord.points = PackedVector2Array([Vector2(cx, ry - 13.0), Vector2(cx + 2.0, ry), Vector2(cx - 1.0, ry + 11.0)])
		cord.width = 2.2; cord.default_color = Color("6a5836"); cord.z_index = int(ry)
		cord.set_meta("av_stone_archive", true); _region_node.add_child(cord)
		var knot := Polygon2D.new(); var kp := PackedVector2Array()
		for k in range(7):
			var a := TAU * float(k) / 7.0
			kp.append(Vector2(cos(a) * 2.6, sin(a) * 2.6))
		knot.polygon = kp; knot.position = Vector2(cx + 1.0, ry); knot.color = Color(0.62, 0.54, 0.38); knot.z_index = int(ry) + 1; _region_node.add_child(knot)
		if i >= names.size() - 6:   # seixo quente só nos últimos ~6 (os recém-repetidos) — não vira guirlanda
			var bead := Polygon2D.new(); var bp := PackedVector2Array()
			for k in range(8):
				var a := TAU * float(k) / 8.0
				bp.append(Vector2(cos(a) * 2.6, sin(a) * 2.6))
			bead.polygon = bp; bead.position = Vector2(cx + 1.0, ry + 6.0); bead.color = Color("f0c87a"); bead.z_index = int(ry) + 2; _region_node.add_child(bead)
	# a RELEITURA [E] — fala os nomes de volta (releitura, não placar). Marcador na base da coluna.
	var node := Node2D.new(); node.position = base + Vector2(40.0, -22.0); node.z_index = int(base.y) + 40
	var prompt := Label.new(); prompt.text = "[E] os nomes que você carrega"; prompt.position = Vector2(-66.0, -34.0); prompt.modulate = Color("cdb9e0")
	prompt.add_theme_font_size_override("font_size", 14); prompt.add_theme_color_override("font_outline_color", Color(0.04, 0.03, 0.05, 0.95)); prompt.add_theme_constant_override("outline_size", 5); prompt.visible = false
	node.add_child(prompt); _tag_on_top(prompt); _region_node.add_child(node)
	var msg: Array = []
	if names.is_empty():
		msg = [
			"Cordas vazias, à espera. Você ainda não carrega nenhum nome — a Guardiã guarda todos; você, nenhum, por ora.",
			"Repetir um é o que faz um nome sobreviver a uma morte. Um dia, talvez, você leve um consigo.",
		]
	else:
		var joined := ""
		for i in range(names.size()):
			joined += "«%s»" % str(names[i])
			if i < names.size() - 1: joined += ", "
		msg = [
			"Os nomes que você leva consigo, e repete quando lembra:",
			joined,
			"Nenhum deles era seu. Nenhum virou silêncio enquanto você o carrega. É só isso — e é tudo.",
		]
	_services.append({"node": node, "prompt": prompt, "pos": node.position, "kind": "future_exit", "id": "stone_carried", "title": "os nomes que você carrega", "level": 0, "msg": msg})

func _stone_carry_a_name(svc) -> void:
	var node = svc.get("node")
	var pr = svc.get("prompt")
	var state := "intro"
	if node != null and node.has_meta("av_ritual_state"):
		state = str(node.get_meta("av_ritual_state"))
	if state == "intro":
		# ENTREGA: a Guardiã escolhe o nome (o jogador NÃO escolhe; sem opções). Pessoa comum, não-herói.
		var nm: String = STONE_NAMES[randi() % STONE_NAMES.size()]
		if node != null:
			node.set_meta("av_ritual_state", "repeat")
			node.set_meta("av_ritual_name", nm)
		if pr != null:
			pr.text = "[E] repetir «%s»" % nm
		_show_local_dialogue("a Guardiã dos Nomes", [
			"Lá em cima eles veem os nomes chegarem. Aqui embaixo, eu faço eles ficarem.",
			"Um nome que ninguém repete vira só um nó cego. Eu repito todos, toda noite — mas sou só uma.",
			"Leve um comigo. Esta se chamava «%s». Uma pessoa comum; o deserto a levou, como leva todos." % nm,
			"Diga o nome. Uma vez. Pra não ser só eu a guardá-la.",
		])
		return
	if state == "repeat":
		# PARTICIPAÇÃO: o jogador repete o nome (o ato dura segundos). Nada é dado; ela agradece.
		var nm: String = str(node.get_meta("av_ritual_name")) if node != null and node.has_meta("av_ritual_name") else "ela"
		if node != null:
			node.set_meta("av_ritual_state", "done")
		if pr != null:
			pr.text = "[E] a Guardiã dos Nomes"
		# ★ LEGADO (PEDRA_LEGACY_F5): o nome PASSA A FICAR — persiste no save e a parede do Arquivo cresce na próxima
		# visita. SEM fanfarra/pop-up/recompensa: o valor nasce da própria permanência (você o vê crescido ao voltar).
		GameState.carry_name(nm)
		_show_local_dialogue("Carregar um Nome", [
			"Você repete, baixo: «%s»." % nm,
			"— %s. — repete ela, junto, de olhos fechados. — Agora somos dois a carregar. É assim que um nome sobrevive a uma morte." % nm,
			"Ela não te dá nada. Não há nada a dar. Você sai com um nome que não era seu — e o leva consigo.",
		])
		return
	# ENCERRAMENTO: recusa um segundo. Um basta. A responsabilidade passou pro jogador (o jogo não prova que ele lembrou).
	var carried: String = str(node.get_meta("av_ritual_name")) if node != null and node.has_meta("av_ritual_name") else "o nome"
	_show_local_dialogue("a Guardiã dos Nomes", [
		"— Só um. — diz ela, antes que você pergunte. — Você carrega um bem. Dois, e derrubaria os dois.",
		"— %s basta. Repita quando lembrar. Ou não. A partir de agora é com você." % carried,
	])

## Mural da Vila (GODOT-SIDEQUEST-BOARD-BOUNTIES-1): abre o PAINEL de contratos (reusa a UI da loja,
## kind "board") — topo mostra o objetivo da campanha + nudge do tutorial (read-only, conteúdo antigo
## preservado); embaixo, os bounties opcionais (aceitar/entregar). NÃO toca a campanha data-driven.
func _use_quest_board() -> void:
	if _campaign_progress_locked():
		_show_local_dialogue("Mural de Recados", ["(área de teste do mundo contínuo) o mural não aceita nem entrega recados aqui."])
		return   # macro = sandbox: nada de aceitar/entregar bounty (campanha)
	_open_shop("board")
	_tutorial_event("checked_board")   # avança o onboarding após consultar o mural (igual antes)

## Texto do mural: nudge do tutorial (não-bloqueante) no topo + objetivo contextual de ch1/ch2.
## ch1 pendente → Planície/Lobo; ch1 feito & ch2 pendente → Caverna/Golem; ambos → sem novos.
func _quest_board_lines() -> Array:
	var ch1 := GameState.is_quest_completed("ch1-awakening")
	var ch2 := GameState.is_quest_completed("ch2-crystal-heart")
	var lines := []
	# nudge do tutorial (sem bloquear o objetivo): antes da Anciã, manda procurá-la; no retorno
	# vitorioso, manda fechar com ela.
	if GameState.tutorial_step == "talk_elder":
		lines.append("Recém-chegado? A Anciã Maelis, na praça, conhece bem estas terras.")
	elif GameState.tutorial_step == "wrapup":
		lines.append("Você voltou. A Anciã Maelis, na praça, há de querer saber da trilha.")
	# objetivo contextual (lógica existente)
	if not ch1:
		lines.append_array([
			"A trilha a leste, pela Planície, está barrada — um lobo se fez senhor dela.",
			"Cruze o portão a leste, até a Planície dos Novatos; o Lobo Alfa guarda o caminho adiante.",
			"Os lobos jovens rondam a planície ao longo do caminho.",
		])
	elif not ch2:
		lines.append_array([
			"O Lobo não barra mais a trilha. Adiante, a Caverna guarda algo mais antigo.",
			"Atravesse a Planície e desça à Caverna, a leste — o Golem de Cristal guarda as profundezas.",
		])
	else:
		lines.append_array([
			"O Lobo e o Golem se calaram. O mural não traz recados novos por ora.",
			"Descanse na vila, Errante — novas trilhas hão de surgir.",
		])
	return lines

## --- TUTORIAL / ONBOARDING DA VILA (GODOT-VILLAGE-TUTORIAL-QUEST-1) ---
## Máquina de etapas monotônica (só avança), guardada por etapa esperada. O valor guardado em
## GameState.tutorial_step É a próxima meta; a dica da HUD é derivada dele.
## start(talk_elder) → read_board → go_plains → defeat_wolf → return → wrapup → done

## Aplica um evento de gameplay, avançando a etapa só a partir da(s) etapa(s) esperada(s).
func _tutorial_event(ev: String) -> void:
	if _campaign_progress_locked():
		return   # macro-zona = sandbox: não avança o onboarding/tutorial
	var step := GameState.tutorial_step
	if step == GameState.TUTORIAL_DONE:
		return
	match ev:
		"talked_elder":
			if step == "talk_elder":
				GameState.set_tutorial_step("read_board")
			elif step == "wrapup":
				GameState.set_tutorial_step(GameState.TUTORIAL_DONE)
		"checked_board":
			if step == "read_board":
				GameState.set_tutorial_step("go_plains")
			elif step == "wrapup":
				GameState.set_tutorial_step(GameState.TUTORIAL_DONE)
		"entered_plains":
			if step in ["talk_elder", "read_board", "go_plains"]:
				GameState.set_tutorial_step("defeat_wolf")
		"ch1_done":
			if step in ["talk_elder", "read_board", "go_plains", "defeat_wolf"]:
				GameState.set_tutorial_step("return")
		"entered_village":
			if step == "return":
				GameState.set_tutorial_step("wrapup")

## Dica curta exibida no tracker (vazia quando done → a linha some).
func _tutorial_hint() -> String:
	match GameState.tutorial_step:
		"talk_elder": return "A Anciã Maelis aguarda na praça"
		"read_board": return "Há um mural de recados na praça"
		"go_plains": return "A trilha leste leva à Planície"
		"defeat_wolf": return "Algo barra a trilha na Planície"
		"return": return "A trilha de volta leva à Vila"
		"wrapup": return "A Anciã Maelis aguarda na praça"
		_: return ""

## Fala da Anciã Maelis conforme a etapa do tutorial (local; NÃO toca a campanha data-driven).
