		"salt_split_isle": return Color("c9c2ad")    # sal/areia ressecada e rachada da ilha (mais cinza-claro)
		"khet_sar_sands": return Color("d8b87a")     # areia quente/dourada do deserto (novo continente)
		"khet_caravan_camp": return Color("c9a86a")  # areia batida/terra pisada do acampamento (um tom + escuro/firme)
		"khet_oasis": return Color("cdb083")         # areia mais clara/úmida do oásis (vida perto da água)
		"deep_dunes": return Color("c9b27e")         # areia mais pálida/morta das Dunas Profundas (a vida recua)
