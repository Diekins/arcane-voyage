		"dead_tree": _add_dead_tree(pos)   # árvore morta (bosques de cinza/raízes); helper já existente, gera blocker
		"crystal": _add_crystal(pos, float(params.get("h", 60)))   # cristal de caverna; helper já existente, gera blocker
		"column", "pillar": _add_column(pos)   # ruína: coluna partida real (não placeholder); gera blocker próprio
		"dry_rock": _add_dry_rock(pos, float(params.get("r", 24)))
		"driftwood": _add_driftwood(pos, float(params.get("angle", 0.0)), false)   # madeira à deriva; helper existente, decorativo (solid=false)
		"boat": _build_coast_boat(pos)   # bote encalhado; reusa o builder de sprite real (saltwind_boat.png) + blocker no casco
		"anchor": _add_anchor(pos)   # âncora quebrada; helper existente, gera blocker na base
		"cactus": _add_cactus(pos, float(params.get("h", 50)))
		"bones": _add_bones(pos)
		"dry_tuft": _add_dry_tuft(pos)
		"salt_altar": _build_salt_altar(pos)
		"water_ellipse": _build_oasis_lake(pos, float(params.get("rx", 160)), float(params.get("ry", 100)))
		"campfire": _build_camp_campfire(pos)
		"tent": _build_camp_tent(pos, float(params.get("w", 150)), float(params.get("h", 120)), Color(str(params.get("cloth", "c98b54"))))
		"wagon": _build_camp_wagon(pos)
		"sand_patch": _add_floor_glow(pos, float(params.get("r", 42)), Color(0.85, 0.74, 0.5, 0.12))
		_: _add_dry_rock(pos, 18.0)   # fallback: placeholder pequeno (tipo desconhecido)

## Mobs editor-authored (GODOT-MAPLOADER-MOBS-CHESTS-PILOT-1): converte region.mobs[] do manifesto v1.1 no
## formato de config que _spawn_mob_group já espera (REUSA o pipeline _build_mobs → zero sistema paralelo).
## 1 entrada de manifesto = 1 config com spawns=[position]. Campos de combate ausentes recebem defaults de
## "mob leve". spawn_condition/elite/defeat_flag/reward são IGNORADOS no piloto (runtime-only; sem boss/flag aqui).
func _manifest_mob_configs(region_id: String) -> Array:
	var mr := _manifest_for(region_id)
	var out := []
	for mb in mr.get("mobs", []):
		var pos := _mpos(mb.get("position", [0, 0]))
		var loot := []
		for l in mb.get("loot", []):
			loot.append({"name": str(l.get("name", "")), "chance": float(l.get("chance", 0.3))})
		var cfg := {
			"id": str(mb.get("mob_id", mb.get("id", "mob"))),   # usa o TIPO (mob_id) p/ comportamento/kill-quests
			"name": str(mb.get("name", "Criatura")),
			"visual": str(mb.get("visual", "")),
			"hp": int(mb.get("hp", 60)), "xp": int(mb.get("xp", 40)), "gold": int(mb.get("gold", 12)),
			"dmg_min": int(mb.get("dmg_min", 10)), "dmg_max": int(mb.get("dmg_max", 16)),
			"aggro": float(mb.get("aggro", 380.0)), "atk_range": float(mb.get("atk_range", 84.0)),
			"cooldown": float(mb.get("cooldown", 1.05)), "speed": float(mb.get("speed", 168.0)),
			"respawn": float(mb.get("respawn", 8.0)), "windup": float(mb.get("windup", 0.25)), "recover": float(mb.get("recover", 0.2)),
			"color": Color(str(mb.get("color", "b89a5e"))), "radius": float(mb.get("radius", 18.0)), "shape": str(mb.get("shape", "circle")),
			"side_left": bool(mb.get("side_left", false)), "can_flip": bool(mb.get("can_flip", true)),
			"loot": loot, "spawns": [pos],
		}
		if mb.has("wander_radius"):
			cfg["wander_radius"] = float(mb["wander_radius"])
		if bool(mb.get("ranged", false)):   # ranged opcional (reusa o caminho ranged já existente do Mob.gd)
			cfg["ranged"] = true
			cfg["proj_speed"] = float(mb.get("proj_speed", 430.0))
			if not mb.has("atk_range"):
				cfg["atk_range"] = 360.0
		out.append(cfg)
	return out

## Baús editor-authored (GODOT-MAPLOADER-MOBS-CHESTS-PILOT-1): converte region.chests[] do manifesto v1.1 no
## contrato de _chest_defs ({id,x,y,loot:{gold?,materials?,items?}}). REUSA _build_chests → one-time por id
