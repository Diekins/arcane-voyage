	lbl.z_as_relative = false
	lbl.z_index = Z_FX
	_region_node.add_child(lbl)
	var tw := create_tween()
	tw.tween_property(lbl, "position:y", lbl.position.y - 42.0, 0.8)
	tw.parallel().tween_property(lbl, "modulate:a", 0.0, 0.8)
	tw.tween_callback(lbl.queue_free)

func _recover_hero() -> void:
	# retry simples ([R]): restaura HP, reposiciona o Errante e reabilita o combate do Lobo
	# (se vivo). NÃO mexe no HP atual do Lobo nem reseta a campanha.
	if not GameState.is_hero_defeated() and GameState.hero_hp == GameState.hero_hp_max:
		return
	GameState.reset_hero_hp()
	if _player != null:
		# CANONICAL (GRADUATION-1/A3): respawn no SANTUÁRIO do cluster (hub/Vila), SEM recarregar cena (mundo contínuo
		# permanece montado). Single-region/sandbox: comportamento legado (reposiciona no _player_start).
		_player.position = _macro_safe_spawn if _macro_canonical else _player_start
		_player.set("locked", false)
		if _player.has_method("set_downed"):
			_player.call("set_downed", false)
	_set_world_combat(true)
	_heal_vfx()

## Anel de cura verde/azul do pack no Errante (só apresentação) — recover/descanso.
func _heal_vfx() -> void:
	if _region_node != null and _player != null:
		CombatVfx.spawn(_region_node, "heal_ring_green_blue", _player.position, Vector2.RIGHT, 1.0, 16.0)

func _spawn_hero_damage(amount: int) -> void:
	if _player == null:
		return
	var lbl := Label.new()
	lbl.text = "-%d" % amount
	lbl.add_theme_font_size_override("font_size", 22)
	lbl.modulate = Color("ff6b6b")
	lbl.position = _player.position + Vector2(randf_range(-20.0, 20.0), -70.0)
	lbl.z_as_relative = false
	lbl.z_index = Z_FX
	add_child(lbl)
	var tw := create_tween()
	tw.tween_property(lbl, "position:y", lbl.position.y - 46.0, 0.6)
	tw.parallel().tween_property(lbl, "modulate:a", 0.0, 0.6)
	tw.tween_callback(lbl.queue_free)

func _on_request_scene(scene: Dictionary) -> void:
	# o TriggerDispatcher pediu para mostrar uma cena. Ignora se já há diálogo aberto.
	if _dialog == null or _dialog.is_open() or scene.is_empty():
		return
	if _player.has_method("set"):
		_player.set("locked", true)
	_set_world_combat(false)   # o boss não ataca durante o diálogo
	if _aldric_anim != null and str(scene.get("id", "")) == "intro-mentor":
		if _aldric != null:
			_aldric_anim.set_direction(_player.position - _aldric.position)   # vira p/ o Errante
		_aldric_anim.play_talk()   # Aldric gesticula durante a fala dele
	_dialog.show_scene(scene)

func _on_dialogue_closed(choice_id: String) -> void:
	# só destrava/reabilita o combate se o herói não estiver derrotado (aí o [R] cuida disso).
	if not GameState.is_hero_defeated():
		if _player.has_method("set"):
			_player.set("locked", false)
		_set_world_combat(true)
	if _aldric_anim != null:
		_aldric_anim.play_idle()   # Aldric volta ao idle ao fechar o diálogo
	if _talking_anim != null:
		_talking_anim.play_idle()   # cidadão da Vila volta ao idle
		_talking_anim = null
	# FATIA A9.1: se a cena era de um BEAT narrativo (viewing), conclui (SEEN + choice exato-uma-vez) e sai.
	if _narrative_viewing:
		_finish_story_viewing(choice_id)
	print("[Main] diálogo fechado. escolha = '%s'" % choice_id)

## --- construção de nós ---

func _try_load_tex(path: String) -> Texture2D:
	if ResourceLoader.exists(path):
		return load(path) as Texture2D
	push_warning("[Main] asset ausente (importe no editor): %s" % path)
	return null

## Sombra elíptica (Polygon2D) sob um personagem, p/ "ancorar" no chão (assetless).
func _add_ground_shadow(node: Node2D, rx: float, ry: float, y_off: float) -> void:
	var poly := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(20):
		var a := TAU * i / 20.0
		pts.append(Vector2(cos(a) * rx, sin(a) * ry + y_off))
	poly.polygon = pts
	poly.color = Color(0, 0, 0, 0.25)
	poly.z_index = -1
	node.add_child(poly)

func _build_player(pos: Vector2) -> Node2D:
	var node := Node2D.new()
	node.name = "Player"
	node.set_script(load("res://scripts/PlayerController.gd"))
	node.position = pos
	node.z_index = 1   # acima do chão e da decoração da região
	_add_ground_shadow(node, 20.0, 6.0, 20.0)   # pés do sprite top-down (errante.png) na sombra
	# sprite-placeholder (side-view antigo): o ActorAnimator o ESCONDE quando há spritesheet real
	# (hero/errante.png) e mostra o AnimatedSprite2D; sem sheet, ele continua como fallback.
	var spr := Sprite2D.new()
	var tex := _try_load_tex("res://assets/scenes/hero-sprite.png")
	if tex != null:
		spr.texture = tex
		spr.scale = Vector2(0.2, 0.2)
	node.add_child(spr)
	var tag := Label.new()
	tag.text = "Errante"
	tag.position = Vector2(-22, -52)   # nameplate: nome acima da cabeça (HP do herói fica na HUD)
	tag.add_theme_font_size_override("font_size", 11)
	tag.modulate = Color(1, 1, 1, 0.85)
	node.add_child(tag)
	_tag_on_top(tag)
	# câmera top-down que SEGUE o Errante (limites do mapa definidos por região em load_region)
	_camera = Camera2D.new()
	_camera.position_smoothing_enabled = true
	_camera.position_smoothing_speed = 7.0
	node.add_child(_camera)
	add_child(node)
	_camera.make_current()   # só depois do nó estar na árvore
	return node

func _build_aldric(pos: Vector2) -> Node2D:
	var node := Node2D.new()
	node.name = "Aldric"
	node.position = pos
	node.z_index = int(pos.y)   # y-sort com os props do mundo
	_add_ground_shadow(node, 20.0, 6.0, 18.0)   # pés do sprite NPC top-down na sombra
	# placeholder = o retrato como marcador; o ActorAnimator o ESCONDE quando há a sheet de NPC
	# (npcs/aldric_vaelor.png) e mostra o corpo animado. O retrato segue só no DIÁLOGO.
	var spr := Sprite2D.new()
	var tex := _try_load_tex("res://assets/npcs/aldric-vaelor.png")
	if tex != null:
		spr.texture = tex
		spr.scale = Vector2(0.13, 0.13)
	node.add_child(spr)
	var name_tag := Label.new()
	name_tag.text = "Mestre Aldric"
	name_tag.position = Vector2(-40, -64)   # nameplate: nome acima da cabeça
	name_tag.add_theme_font_size_override("font_size", 12)
	name_tag.modulate = Color(1, 1, 1, 0.9)
	node.add_child(name_tag)
	_tag_on_top(name_tag)
	_aldric_prompt = Label.new()
	_aldric_prompt.text = "[E] falar"
	_aldric_prompt.position = Vector2(-26, -52)
	_aldric_prompt.modulate = Color("e8c267")
	_aldric_prompt.add_theme_font_size_override("font_size", 14)
	_aldric_prompt.visible = false
	node.add_child(_aldric_prompt)
	_tag_on_top(_aldric_prompt)
	_region_node.add_child(node)
	# corpo animado de NPC (idle + talk reais se a sheet existir; senão o marcador-retrato fica)
	var anim := ActorAnimator.new()
	node.add_child(anim)
	anim.setup(spr, "npcs/aldric_vaelor", 2.0)
	_aldric_anim = anim
	return node

## Cidadão da Vila: corpo animado (idle real via npcs/village/<x>.png) + nome + prompt [E] +
## fala local curta. Registrado em _npcs (interação por proximidade). Sem combate.
## `wander` (default false) = NPC dá um micro-passeio perto do posto. `z_off` = ajuste do z-sort
## (ex.: Ferreiro +24 p/ desenhar NA FRENTE da forja `hearth`, que tem z = y+24 e cortava a cabeça dele).
func _build_villager(pos: Vector2, key: String, npc_name: String, lines: Array, service: String = "", wander: bool = false, z_off: int = 0) -> void:
	var node := Node2D.new()
	node.name = npc_name
	node.position = pos
	node.z_index = int(pos.y) + z_off   # y-sort com os props (z_off p/ o Ferreiro ficar na frente da forja)
	_add_ground_shadow(node, 18.0, 5.0, 26.0)
	# placeholder mínimo (ColorRect) — o ActorAnimator o esconde e mostra a sheet real do cidadão
	var spr := Sprite2D.new()
	node.add_child(spr)
	var name_tag := Label.new()
	name_tag.text = npc_name
	name_tag.position = Vector2(-46, -60)   # nameplate: nome acima da cabeça (prompt fica logo abaixo)
	name_tag.add_theme_font_size_override("font_size", 12)
	name_tag.modulate = Color(1, 1, 1, 0.9)
	node.add_child(name_tag)
	_tag_on_top(name_tag)
	var prompt := Label.new()
	prompt.text = "[E] falar"
	prompt.position = Vector2(-26, -46)
	prompt.modulate = Color("e8c267")
	prompt.add_theme_font_size_override("font_size", 14)
	prompt.visible = false
	node.add_child(prompt)
	_tag_on_top(prompt)
	_region_node.add_child(node)
	var anim := ActorAnimator.new()
	node.add_child(anim)
	anim.setup(spr, key, 2.0, false, true, true)   # skip_back: NPC não usa a vista de costas (cabeça cortada na arte)
	anim.play_idle()
	var scene := _village_npc_scene(npc_name, lines)
	# estado de vida ambiente: timer da próxima virada + alvo/pausa do micro-wander (se permitido)
	_npcs.append({"node": node, "anim": anim, "pos": pos, "name": npc_name, "scene": scene, "prompt": prompt,
		"service": service, "wander": wander, "z_off": z_off, "turn_t": randf_range(NPC_TURN_MIN, NPC_TURN_MAX),
		"wtarget": pos, "wpause": randf_range(0.5, 2.0)})

## Monta uma "cena" local (mesmo formato do DialoguePanel) a partir de falas simples. Sem npcId
## (usa iniciais como retrato), sem choices (fecha ao avançar). NÃO toca a campanha data-driven.
func _village_npc_scene(npc_name: String, lines: Array) -> Dictionary:
	var initials := npc_name.substr(0, 1)
	var arr := []
	for t in lines:
		arr.append({"speaker": npc_name, "text": str(t), "tone": "neutral", "portraitInitials": initials})
	return {"id": "village-" + npc_name.to_lower().replace(" ", "-"), "lines": arr, "choices": []}

## Abre a fala local de um cidadão: trava o herói, vira o NPC p/ o Errante + gesto de fala.
## A Anciã Maelis é o GUIA do tutorial → fala dinâmica por etapa + avança o onboarding.
func _talk_to_npc(npc) -> void:
	if _dialog == null or _dialog.is_open() or _shop_open:
		return
	if _player != null and _player.has_method("set"):
		_player.set("locked", true)
	var anim = npc["anim"]
	if anim != null:
		var npc_pos: Vector2 = npc["node"].position if npc.has("node") and npc["node"] != null else (npc["pos"] as Vector2)
		anim.set_direction(_player.position - npc_pos)   # encara pela posição REAL (o NPC pode ter andado)
		anim.play_idle()   # re-seleciona a anim direcional (4-dir) p/ ENCARAR o Errante ao falar
	# Mercadora/Ferreiro: [E] abre o painel de LOJA/FORJA em vez de uma fala (herói segue travado).
	var service := str(npc.get("service", ""))
	if service != "":
		_open_shop(service)
		return
	if anim != null:
		anim.play_talk()
		_talking_anim = anim
	var nm := str(npc["name"])
	var is_elder := nm == ELDER_NAME
	var qid := _dialogue_quest_for(nm)   # side-quest de DIÁLOGO deste NPC (Tomas/Bran), se houver
	var scene
	if is_elder:
		scene = _village_npc_scene(ELDER_NAME, _elder_lines())
	elif qid != "":
		scene = _sidequest_scene(qid)   # fala dinâmica + aceita/entrega
	else:
		scene = npc["scene"]
	_dialog.show_scene(scene)
	if is_elder:
		_tutorial_event("talked_elder")   # avança a etapa após mostrar a fala da etapa atual

## id da side-quest de DIÁLOGO associada a um NPC, "" se nenhuma. Com várias quests por NPC
## (encadeamento), escolhe: a ATIVA (prioridade) → senão a 1ª AINDA NÃO aceita → senão a 1ª (todas
## concluídas, p/ a fala de fecho). Iteração na ordem do dict = couro antes de bandido, presa antes de javali.
func _dialogue_quest_for(npc_name: String) -> String:
	var first_open := ""
	var any := ""
	for qid in SIDE_QUESTS:
		var q: Dictionary = SIDE_QUESTS[qid]
		if str(q.get("via", "")) != "dialogue" or str(q["npc"]) != npc_name:
			continue
		if any == "":
			any = str(qid)
		var st := GameState.sq_state(str(qid))
		if st == "active":
			return str(qid)              # quest em andamento tem prioridade
		if st == "" and first_open == "":
			first_open = str(qid)        # próxima ainda não aceita
	return first_open if first_open != "" else any

## Definição de uma quest por id: procura nos NPCs (SIDE_QUESTS) e, senão, nos bounties do mural
## (BOUNTIES). {} se inexistente. Fonte única p/ os helpers funcionarem com ambos sem duplicar lógica.
func _quest_def(qid: String) -> Dictionary:
	if SIDE_QUESTS.has(qid):
		return SIDE_QUESTS[qid]
	return BOUNTIES.get(qid, {})

## Tipo do objetivo da quest: "collect" (material) ou "kill" (kill-count). Default "collect"
## (mantém compat com as quests antigas que não têm o campo).
func _sq_kind(qid: String) -> String:
	return str(_quest_def(qid).get("kind", "collect"))

## Progresso atual rumo à meta, CAPADO em need: materiais coletados (collect) ou mobs abatidos (kill).
func _sq_have(qid: String) -> int:
	var q: Dictionary = _quest_def(qid)
	var need := int(q["need"])
	if _sq_kind(qid) == "kill" or _sq_kind(qid) == "discovery":
		return mini(GameState.sq_progress(qid), need)   # discovery: progresso setado ao entrar na região
	return mini(GameState.material_count(str(q["mat"])), need)

## Fala dinâmica genérica de uma side-quest (GODOT-VILLAGE-SIDEQUESTS-CHAIN-1): oferece/aceita ao
## falar; com material suficiente ENTREGA (consome+recompensa); senão mostra progresso; depois, fecho.
func _sidequest_scene(qid: String) -> Dictionary:
	var q: Dictionary = _quest_def(qid)
	var lines := []
	match GameState.sq_state(qid):
		"":
			for l in q["offer"]:
				lines.append(str(l))
			GameState.sq_set(qid, "active")
		"active":
			var have := _sq_have(qid)
			var need := int(q["need"])
			if have >= need:
				_sidequest_reward(qid)
				var extra := ", uma Poção Menor," if str(q["item"]) != "" else ""
				lines.append("Perfeito, era disso que eu precisava!")
				lines.append("Tome: %d ouro%s e experiência pela estrada." % [int(q["gold"]), extra])
			elif _sq_kind(qid) == "kill":
				lines.append("Continue a caçada — %s." % str(q["where"]))
				lines.append("Abatidos: %d de %d." % [have, need])
			else:
				lines.append("Ainda preciso de %s — %s." % [str(q["mat"]), str(q["where"])])
				lines.append("Você tem %d de %d." % [have, need])
		_:
			for l in q["done"]:
				lines.append(str(l))
	return _village_npc_scene(str(q["npc"]), lines)

## Consome o material (collect), paga as recompensas e fecha a quest/bounty. Serve NPC side-quests E
## bounties do mural (ambos via _quest_def). GUARD anti-duplo-pagamento: só paga com a quest "active"
## (qualquer rebuild/clique repetido fora desse estado é no-op). Repetível (REPEATABLE-ROTATION-1):
## em vez de "done", volta a "" (disponível) e ZERA o progresso → pode repetir; paga 1× por entrega.
func _sidequest_reward(qid: String) -> void:
	if GameState.sq_state(qid) != "active":
		return   # blindagem: entrega só a partir do estado ativo (evita pagamento duplicado)
	var q: Dictionary = _quest_def(qid)
	if _sq_kind(qid) == "collect":
		GameState.consume_material(str(q["mat"]), int(q["need"]))   # kill: nada a consumir (só o abate conta)
	GameState.add_gold(int(q["gold"]))
	GameState.add_xp(int(q["xp"]))
	if str(q["item"]) != "":
		GameState.backpack_add(str(q["item"]), 1)
	if BOUNTIES.has(qid):
		GameState.add_bounty_completed()   # conta só contratos do MURAL (não NPC quests); guard acima garante 1 reward
	if bool(q.get("repeatable", false)):
		GameState.sq_set(qid, "")            # repetível: volta a disponível p/ aceitar de novo
		GameState.sq_reset_progress(qid)     # zera o kill-count (collect já foi consumido na entrega)
		_show_reward_popup("Um pedido a menos na estrada: +%d ouro" % int(q["gold"]))
	else:
		GameState.sq_set(qid, "done")
		_show_reward_popup("Um pedido atendido: +%d ouro" % int(q["gold"]))

## --- SERVIÇOS DO HUB DA VILA (GODOT-VILLAGE-SERVICES-1) ---
