	if _roots_place_on():
		_build_roots_place(_size)   # ROOTS PLACE: "este lugar me acolhe demais" (cenário aditivo, atrás de flag, SÓ aqui)

## ROOTS PLACE — piloto ligado? (const de produção OU override de self-test OU env). OFF = Coração idêntico.
func _roots_place_on() -> bool:
	return ROOTS_PLACE_ENABLED or _rootsplace_force or OS.has_environment("AV_ROOTS_PLACE")

## ROOTS PLACE — presença do "Cuidado que Sufoca" (atmosfera/textura ADITIVA; NÃO toca Matriarca/combate/loot/save).
## Gradiente no ESPAÇO: entrada (sul, ~0.5,0.84) = acolhimento/abrigo; aproximação (rumo à Colhedora) = envolvimento/
## fechamento; PICO no Rastro da Colhedora (0.32,0.64) = nest moldado + pertences aninhados (abrigo OU prisão). A
## clareira central (avatar) fica LIVRE. Tudo marcado `av_rootsplace`. Morno/macio/pulsante (contraste c/ a Caverna).
func _build_roots_place(size: Vector2) -> void:
	var warm := Color(0.90, 0.50, 0.42, 0.10)        # calor dim (âmbar-rosa, NÃO fogo)
	var warm_peak := Color(0.92, 0.52, 0.44, 0.15)
	var pulse_col := Color(0.55, 0.26, 0.30, 0.55)   # raiz que respira (morno-escuro)
	# 1) ENTRADA (sul) — acolhimento/abrigo
	var ent := Vector2(size.x * 0.5, size.y * 0.84)
	_roots_warmth(ent, 72.0, warm)
	_roots_moss(ent + Vector2(0.0, 10.0), 60.0)
	_roots_canopy(ent + Vector2(0.0, -44.0), 190.0)                 # teto baixo de raízes (invólucro)
	_roots_overgrown_passage(Vector2(size.x * 0.5, size.y * 0.95))  # passagem de volta parcialmente tomada (selar suave)
	# 2) AVANÇO (entre entrada e Colhedora) — envolvimento/fechamento
	for p in [Vector2(0.44, 0.78), Vector2(0.38, 0.73), Vector2(0.42, 0.70)]:
		_roots_vine_embrace(Vector2(size.x * p.x, size.y * p.y))
	_roots_warmth(Vector2(size.x * 0.42, size.y * 0.72), 64.0, warm)   # calor subindo
	_roots_pulse_node(Vector2(size.x * 0.40, size.y * 0.74), 10.0, pulse_col)   # pulso fraco
	_roots_canopy(Vector2(size.x * 0.40, size.y * 0.70), 210.0)        # teto adensando
	# 3) PICO no Rastro da Colhedora (mesma base do _build_rastro_colhedora) — acolhimento DEMAIS
	var base := Vector2(size.x * 0.32, size.y * 0.64)
	_roots_warmth(base, 84.0, warm_peak)              # calor máximo
	_roots_nest_hollow(base + Vector2(6.0, 14.0))     # concavidade macia moldada a um corpo
	_roots_cradle(base + Vector2(-30.0, -2.0))        # raízes aninhando os pertences/cesta (cesta ~ base+(-30,-4))
	_roots_pulse_node(base + Vector2(-4.0, -8.0), 14.0, pulse_col)   # pulso no máximo
	# 4) raiz que pulsa (0.76,0.28) — pulso lento (o lugar respira)
	_roots_pulse_node(Vector2(size.x * 0.76, size.y * 0.28), 12.0, pulse_col)

## disco baixo de CALOR dim (held-warmth) no chão — âmbar-rosa, nutritivo (não fogo)
func _roots_warmth(pos: Vector2, r: float, col: Color) -> void:
	var poly := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(20):
		var a := TAU * i / 20.0
		pts.append(Vector2(cos(a) * r, sin(a) * r * 0.5))
	poly.polygon = pts; poly.position = pos; poly.color = col; poly.z_index = -16
	poly.set_meta("av_rootsplace", true)
	_region_node.add_child(poly)

## leito de musgo macio (verde-úmido, baixo)
func _roots_moss(pos: Vector2, r: float) -> void:
	var poly := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(18):
		var a := TAU * i / 18.0
		pts.append(Vector2(cos(a) * r, sin(a) * r * 0.44))
	poly.polygon = pts; poly.position = pos; poly.color = Color(0.30, 0.46, 0.28, 0.18); poly.z_index = -15
	poly.set_meta("av_rootsplace", true)
	_region_node.add_child(poly)

## teto/arco de raízes por cima (invólucro VISUAL — sem blocker, não toca colisão)
func _roots_canopy(pos: Vector2, w: float) -> void:
	var arc := Line2D.new()
	arc.width = 6.0
	arc.default_color = Color(0.12, 0.09, 0.08, 0.85)
	arc.joint_mode = Line2D.LINE_JOINT_ROUND
	arc.points = PackedVector2Array([
		pos + Vector2(-w * 0.5, 0.0), pos + Vector2(-w * 0.25, -26.0),
		pos + Vector2(0.0, -34.0), pos + Vector2(w * 0.25, -26.0), pos + Vector2(w * 0.5, 0.0),
	])
	arc.z_index = int(pos.y) + 40   # "acima"; visual, sem colisão
	arc.set_meta("av_rootsplace", true)
	_region_node.add_child(arc)

## passagem parcialmente TOMADA por raízes (selar SUAVE, estático — preenche, NÃO é parede; deixa frestas)
func _roots_overgrown_passage(pos: Vector2) -> void:
	for k in range(5):
		var strand := Line2D.new()
		strand.width = 5.0
		strand.default_color = Color(0.11, 0.09, 0.08, 0.8)
		strand.joint_mode = Line2D.LINE_JOINT_ROUND
		var x := -44.0 + 22.0 * k
		strand.points = PackedVector2Array([pos + Vector2(x, -40.0), pos + Vector2(x + 8.0, 0.0), pos + Vector2(x - 6.0, 40.0)])
		strand.z_index = int(pos.y) + 20
		strand.set_meta("av_rootsplace", true)
		_region_node.add_child(strand)

## vinha ENVOLVENDO uma pedra (apego: a raiz abraça o objeto em vez de passar)
func _roots_vine_embrace(pos: Vector2) -> void:
	var stone := Polygon2D.new()
	var sp := PackedVector2Array()
	for i in range(10):
		var a := TAU * i / 10.0
		sp.append(Vector2(cos(a) * 16.0, sin(a) * 12.0))
	stone.polygon = sp; stone.position = pos; stone.color = Color(0.22, 0.23, 0.26); stone.z_index = int(pos.y)
	stone.set_meta("av_rootsplace", true)
	_region_node.add_child(stone)
	var vine := Line2D.new()
	vine.width = 4.0
	vine.default_color = Color(0.13, 0.11, 0.09, 0.9)
	vine.joint_mode = Line2D.LINE_JOINT_ROUND
	vine.points = PackedVector2Array([pos + Vector2(-20, 8), pos + Vector2(-6, -10), pos + Vector2(10, 6), pos + Vector2(20, -8)])
	vine.z_index = int(pos.y) + 1
	vine.set_meta("av_rootsplace", true)
	_region_node.add_child(vine)

## raiz/knot que PULSA devagar (o lugar respira) — looping tween só dentro da árvore (headless/destacado = estático)
func _roots_pulse_node(pos: Vector2, r: float, col: Color) -> void:
	var knot := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(10):
		var a := TAU * i / 10.0
		pts.append(Vector2(cos(a) * r, sin(a) * r * 0.8))
	knot.polygon = pts; knot.position = pos; knot.color = col; knot.z_index = int(pos.y)
	knot.set_meta("av_rootsplace", true)
	_region_node.add_child(knot)
	if knot.is_inside_tree():
		var tw := knot.create_tween()
		tw.set_loops()
		tw.tween_property(knot, "scale", Vector2(1.18, 1.18), 1.6).set_trans(Tween.TRANS_SINE)
		tw.tween_property(knot, "scale", Vector2(1.0, 1.0), 1.6).set_trans(Tween.TRANS_SINE)

## concavidade macia já MOLDADA a um corpo (forma-de-ausência morna: nest pronto)
func _roots_nest_hollow(pos: Vector2) -> void:
	var poly := Polygon2D.new()
	var pts := PackedVector2Array()
	for i in range(18):
		var a := TAU * i / 18.0
		pts.append(Vector2(cos(a) * 24.0, sin(a) * 13.0))
	poly.polygon = pts; poly.position = pos; poly.color = Color(0.18, 0.10, 0.10, 0.55); poly.z_index = -15
	poly.set_meta("av_rootsplace", true)
	_region_node.add_child(poly)

## raízes ANINHANDO/cradleando os pertences (arcos que abraçam o ponto — o lugar guardou o que ficou)
func _roots_cradle(pos: Vector2) -> void:
	for s in [-1.0, 1.0]:
		var arc := Line2D.new()
		arc.width = 4.0
		arc.default_color = Color(0.13, 0.11, 0.09, 0.9)
		arc.joint_mode = Line2D.LINE_JOINT_ROUND
		arc.points = PackedVector2Array([
			pos + Vector2(28.0 * s, -14.0), pos + Vector2(20.0 * s, 6.0), pos + Vector2(4.0 * s, 16.0),
		])
		arc.z_index = int(pos.y) + 1
		arc.set_meta("av_rootsplace", true)
		_region_node.add_child(arc)

