		"veins": return Color("161a26")                   # rocha de mina ENTRE Caverna (#1b2030) e Catedral (#141826) = profundidade lida na cor
		"cathedral_of_crystal": return Color("141826")    # rocha-cristal FRIA e funda (mais escura/azul que a Caverna; "você desceu")
		"fendas": return Color("0a0b10")                  # rocha NUA quase-preta: o cristal acabou, a memória acabou (o negativo da Caverna)
