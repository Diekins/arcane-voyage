## THE_STONE_BUILD_03 — A VIGIA: a 1ª Testemunha da Pedra encarnada no mirante. JÁ presente quando o jogador chega,
## na BORDA, de COSTAS, olhando o deserto (ao sul), movendo a CORDA DE NÓS (o contador da Vigília — único movimento).
## NÃO espera/aproxima/vira/abandona o posto. [E] mostra SÓ as 5 falas aprovadas (WITNESS_VOICE_PASS_01) via
## _show_local_dialogue (não usa _talk_to_npc, que viraria o NPC pro jogador); a própria Vigia ENCERRA na 5ª fala e
## tudo segue — ela não se moveu. Sem vila/habitantes/comércio/quest/serviço/acesso além do limiar. Identidade/voz
## 100% pré-aprovadas: THE_STONE_WITNESS_PASS_01 + THE_STONE_WITNESS_VOICE_PASS_01.
func _build_stone_vigia(pos: Vector2, parent: Node2D = null, level := 0) -> void:
	var host: Node2D = parent if parent != null else _region_node
	var in_container: bool = parent != null   # no terraço (nível 1) ela y-sorta dentro do contêiner (z relativo)
	var node := Node2D.new(); node.position = pos
	node.z_index = 0 if in_container else int(pos.y)
	node.z_as_relative = in_container
	node.set_meta("av_stone_vigia", true)
	_add_ground_shadow(node, 16.0, 5.0, 16.0)
	var cloak := Polygon2D.new()   # manto de pó (silhueta curvada na beira, de COSTAS pro jogador)
	cloak.polygon = PackedVector2Array([Vector2(-20, 6), Vector2(-13, -26), Vector2(0, -34), Vector2(13, -26), Vector2(20, 6)])
	cloak.color = Color("8a7350"); node.add_child(cloak)
	var fold := Polygon2D.new()   # dobra central (volume das costas)
	fold.polygon = PackedVector2Array([Vector2(-5, 4), Vector2(-3, -24), Vector2(3, -24), Vector2(5, 4)])
	fold.color = Color(0.0, 0.0, 0.0, 0.14); node.add_child(fold)
	var head := Polygon2D.new()   # cabeça (vista de trás)
	var hp := PackedVector2Array()
	for i in range(14):
		var a := TAU * float(i) / 14.0
		hp.append(Vector2(cos(a) * 10.0, sin(a) * 9.0 - 38.0))
	head.polygon = hp; head.color = Color("6f5b3c"); node.add_child(head)
	var hood := Polygon2D.new()   # capuz pela nuca (back of hood = lado do jogador)
	hood.polygon = PackedVector2Array([Vector2(-11, -39), Vector2(0, -50), Vector2(11, -39), Vector2(8, -33), Vector2(-8, -33)])
	hood.color = Color("5c4a30"); node.add_child(hood)
	var cord := Line2D.new()   # CORDA DE NÓS (na mão, pendendo ao lado) — o contador da Vigília
	cord.points = PackedVector2Array([Vector2(16, -18), Vector2(24, -4), Vector2(22, 14), Vector2(28, 30)])
	cord.width = 2.0; cord.default_color = Color("4a3a24"); cord.z_index = 1; node.add_child(cord)
	var beads: Array = []
	for bp in [Vector2(20, -11), Vector2(24, 2), Vector2(24, 16), Vector2(27, 27)]:
		var b := Polygon2D.new()
		var bpts := PackedVector2Array()
		for i in range(8):
			var a := TAU * float(i) / 8.0
			bpts.append(Vector2(cos(a) * 3.0, sin(a) * 3.0))
		b.polygon = bpts; b.position = bp; b.color = Color("c9b483"); b.z_index = 2; node.add_child(b)
		beads.append(b)
	host.add_child(node)
	# o GESTO: o seixo "atual" pulsa devagar (o único movimento — ela conta os nomes). Guard is_inside_tree (self-test).
	if not beads.is_empty():
		var cur: Polygon2D = beads[beads.size() - 1]
		cur.color = Color("f0d8a0")
		if cur.is_inside_tree():
			var tw := cur.create_tween(); tw.set_loops()
			tw.tween_property(cur, "modulate:a", 0.35, 2.6).set_trans(Tween.TRANS_SINE)
			tw.tween_property(cur, "modulate:a", 1.0, 2.6).set_trans(Tween.TRANS_SINE)
	var prompt := Label.new()
	prompt.text = "[E] falar"
	prompt.position = Vector2(-26.0, -70.0); prompt.modulate = Color("e8c267")
	prompt.add_theme_font_size_override("font_size", 14)
	prompt.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.95))
	prompt.add_theme_constant_override("outline_size", 5); prompt.visible = false
	node.add_child(prompt); _tag_on_top(prompt)
	# [E] = future_exit → _use_future_exit cai no _show_local_dialogue(title, msg); a 5ª fala encerra. SÓ falas aprovadas.
	_services.append({"node": node, "prompt": prompt, "pos": pos, "kind": "future_exit", "id": "stone_vigia", "title": "a Vigia", "level": level, "msg": [
		"Você chegou. Eu vi.",
		"São nomes. Gente que o deserto levou. Alguém tem que segurar.",
		"Aquela poeira ali é uma caravana. Metade não chega. Eu fico pra saber qual.",
		"Um dia você também vira um nó nesta corda. Todo mundo que eu vejo vira. Não é castigo — é só o que eu faço.",
		"Pronto. Já te olhei o bastante pra lembrar. Pode descer.",
	]})

## THE_STONE_BUILD_04 — uma TESTEMUNHA genérica (presença, não NPC-de-quest). Figura procedural simples + 1 gesto
## (vida) + poucas falas (calmas, contemplativas — NÃO ensinam). Mesmo padrão da Vigia: serviço future_exit
## level-gated (interação same-level), não-bloqueante, não vira pro jogador. Cada uma comunica uma faceta do PERMANECER.
func _build_stone_witness(parent: Node2D, pos: Vector2, level: int, wid: String, wname: String, body_col: Color, hood_col: Color, gesture: String, sitting: bool, lines: Array) -> void:
	var in_container: bool = parent != null and parent.y_sort_enabled
	var node := Node2D.new(); node.position = pos
	node.z_index = 0 if in_container else int(pos.y)
	node.z_as_relative = in_container; node.set_meta("av_stone_witness", true)
	_add_ground_shadow(node, 15.0, 5.0, 14.0)
	var cloak := Polygon2D.new()
	if sitting:
		cloak.polygon = PackedVector2Array([Vector2(-18, 8), Vector2(-14, -12), Vector2(0, -18), Vector2(14, -12), Vector2(18, 8)])
	else:
		cloak.polygon = PackedVector2Array([Vector2(-17, 6), Vector2(-12, -24), Vector2(0, -32), Vector2(12, -24), Vector2(17, 6)])
	cloak.color = body_col; node.add_child(cloak)
	var head := Polygon2D.new()
	var hy: float = -20.0 if sitting else -36.0
	var hpts := PackedVector2Array()
	for i in range(12):
		var a := TAU * float(i) / 12.0
		hpts.append(Vector2(cos(a) * 9.0, sin(a) * 8.0 + hy))
	head.polygon = hpts; head.color = hood_col; node.add_child(head)
	var gn: CanvasItem = null   # nó do GESTO (a "vida" — único movimento)
	if gesture == "work":
		var hands := ColorRect.new(); hands.color = Color("c9b483"); hands.size = Vector2(8.0, 6.0); hands.position = Vector2(8.0, -12.0)
		node.add_child(hands); gn = hands
	elif gesture == "sway" or gesture == "breathe":
		gn = cloak
	parent.add_child(node)
	if gn != null and gn.is_inside_tree():
		var tw := gn.create_tween(); tw.set_loops()
		if gesture == "work":
			tw.tween_property(gn, "position:y", -6.0, 0.55).set_trans(Tween.TRANS_SINE)
			tw.tween_property(gn, "position:y", -14.0, 0.65).set_trans(Tween.TRANS_SINE)
		elif gesture == "sway":
			tw.tween_property(gn, "rotation", 0.05, 2.2).set_trans(Tween.TRANS_SINE)
			tw.tween_property(gn, "rotation", -0.05, 2.4).set_trans(Tween.TRANS_SINE)
		elif gesture == "breathe":
			tw.tween_property(gn, "modulate:a", 0.8, 2.8).set_trans(Tween.TRANS_SINE)
			tw.tween_property(gn, "modulate:a", 1.0, 2.8).set_trans(Tween.TRANS_SINE)
	var prompt := Label.new(); prompt.text = "[E] falar"; prompt.position = Vector2(-26.0, -58.0); prompt.modulate = Color("e8c267")
	prompt.add_theme_font_size_override("font_size", 14)
	prompt.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.95))
	prompt.add_theme_constant_override("outline_size", 5); prompt.visible = false
	node.add_child(prompt); _tag_on_top(prompt)
	_services.append({"node": node, "prompt": prompt, "pos": pos, "kind": "future_exit", "id": wid, "title": wname, "level": level, "msg": lines})

## THE_STONE_BUILD_05 — a Testemunha ANDANTE ("a Ronda"): a 1ª aplicação da VERTICALITY F4 (waypoint-stair) a
## CONTEÚDO REAL (até agora só provada no vlab DEV). Diferente das 4 Testemunhas estáticas, esta VIVE uma rotina entre
## os dois andares da Pedra: mingla no terraço (nível 1), DESCE a escada física (o chute x1770) até a trilha (nível 0)
## pra "ver de perto", e SOBE de volta — sozinha, em loop. Faceta do PERMANECER = vigília EM MOVIMENTO (os outros
## ficam parados; ela fica andando — "é o meu jeito de ficar"). Reusa _routine_npcs (o _stair_npc_tick a move/troca de
## andar) + _npcs (interação same-level com NPC em trânsito). Sem IA/pathfinding (waypoints declarados, linha reta, sem
## colisão no próprio NPC). z ciente-do-pai via _routine_apply_z (terraço=contêiner y_sort; base=plano legado z=int(y)).
func _build_stone_routine_witness(terr: Node2D) -> void:
	var route := [
		{"kind": "walk", "pos": Vector2(1880.0, 142.0), "level": 1, "wait": 1.6},   # i0: terraço, perto das outras (spawn aqui)
		{"kind": "walk", "pos": Vector2(1986.0, 140.0), "level": 1, "wait": 1.6},   # i1: cruza o terraço (entre as Testemunhas)
		{"kind": "walk", "pos": Vector2(1788.0, 146.0), "level": 1, "wait": 0.3},   # i2: vai ao topo da escada (brecha oeste)
		{"kind": "stair", "lo_level": 0, "hi_level": 1, "foot": Vector2(1770.0, 224.0), "top": Vector2(1770.0, 150.0)},   # i3: DESCE (está no nv1)
		{"kind": "walk", "pos": Vector2(1770.0, 292.0), "level": 0, "wait": 2.2},   # i4: na trilha (nv0), olha de perto / espera a poeira
		{"kind": "walk", "pos": Vector2(1770.0, 232.0), "level": 0, "wait": 0.3},   # i5: volta ao pé da escada
		{"kind": "stair", "lo_level": 0, "hi_level": 1, "foot": Vector2(1770.0, 224.0), "top": Vector2(1770.0, 150.0)},   # i6: SOBE (está no nv0)
	]
	var start_pos: Vector2 = route[0]["pos"]
	var node := Node2D.new(); node.position = start_pos
	node.z_index = 0; node.z_as_relative = true   # spawn no terraço (contêiner y_sort)
	node.set_meta("av_stone_witness", true); node.set_meta("av_stone_routine", true)
	_add_ground_shadow(node, 15.0, 5.0, 14.0)
	var cloak := Polygon2D.new()   # figura caminhante (manto + cabeça); paleta distinta das 4 estáticas (índigo poeirento)
	cloak.polygon = PackedVector2Array([Vector2(-16, 6), Vector2(-12, -23), Vector2(0, -31), Vector2(12, -23), Vector2(16, 6)])
	cloak.color = Color("6c6f86"); node.add_child(cloak)
	var head := Polygon2D.new()
	var hpts := PackedVector2Array()
	for i in range(12):
		var a := TAU * float(i) / 12.0
		hpts.append(Vector2(cos(a) * 9.0, sin(a) * 8.0 - 35.0))
	head.polygon = hpts; head.color = Color("474a60"); node.add_child(head)
	var prompt := Label.new(); prompt.text = "[E] falar"; prompt.position = Vector2(-26.0, -56.0); prompt.modulate = Color("e8c267")
	prompt.add_theme_font_size_override("font_size", 14)
	prompt.add_theme_color_override("font_outline_color", Color(0.05, 0.04, 0.02, 0.95))
	prompt.add_theme_constant_override("outline_size", 5); prompt.visible = false
	node.add_child(prompt); _tag_on_top(prompt)
	terr.add_child(node)
	var lines := [
		"Eu faço a ronda da Pedra, de cima a baixo. Enquanto eu ando, ela continua viva.",
		"Desço pra ver a trilha de perto. Subo pra não me esquecer do alto.",
		"Os outros ficam parados, e isso basta pra eles. Eu fico andando — é o meu jeito de ficar.",
	]
	var entry := {"node": node, "anim": null, "pos": start_pos, "name": "a Ronda",
		"scene": _village_npc_scene("a Ronda", lines),
		"prompt": prompt, "service": "", "wander": false, "z_off": 0, "turn_t": 999.0, "wtarget": start_pos, "wpause": 999.0, "level": 1}
	_npcs.append(entry)
	_routine_npcs.append({"node": node, "npcs": entry, "route": route, "i": 0, "state": "walk", "wait_left": 0.0, "t": 0.0,
		"floor_level": 1, "climb_from": start_pos, "climb_to": start_pos, "climb_target_level": 1})

## THE_STONE_BUILD_04 — um pequeno objeto de "vida cotidiana" no terraço (jarro/corda/esteira). Puramente visual,
## sem interação/serviço — só comunica "aqui se vive". Desenhado no contêiner do andar (z relativo, y_sort).
func _stone_terrace_prop(parent: Node2D, pos: Vector2, kind: String) -> void:
	var n := Node2D.new(); n.position = pos; n.z_index = -1; n.z_as_relative = true; n.set_meta("av_stone_terrace", true)
	if kind == "jar":
		var jar := Polygon2D.new(); jar.polygon = PackedVector2Array([Vector2(-7, 8), Vector2(-9, -6), Vector2(-4, -14), Vector2(4, -14), Vector2(9, -6), Vector2(7, 8)]); jar.color = Color("9c6f44"); n.add_child(jar)
	elif kind == "rope":
		for r in [10.0, 7.0, 4.0]:
			var ring := Line2D.new(); var rp := PackedVector2Array()
			for i in range(13):
				var a := TAU * float(i) / 12.0
				rp.append(Vector2(cos(a) * r, sin(a) * r * 0.5))
			ring.points = rp; ring.width = 2.0; ring.default_color = Color("6b573a"); n.add_child(ring)
	elif kind == "mat":
		var mat := ColorRect.new(); mat.color = Color("8a7a52"); mat.size = Vector2(34.0, 16.0); mat.position = Vector2(-17.0, -8.0); n.add_child(mat)
	parent.add_child(n)

## THE_STONE_BUILD_01 — O ECO: assinatura sonora da Pedra. Camada DORMENTE (padrão _dca_murmur/WorldAmbience): nó
## fiado + asset OPCIONAL — sem o .ogg fica silenciosa e NÃO dá erro; um drop-in em STONE_ECHO_PATH acende. Um tom
## que VOLTA, esparso, espacial (AudioStreamPlayer2D no pé do paredão), só quando o jogador está perto da Pedra (o
## deserto responde DE PERTO). Não explica, não comenta — apenas se sente. Tudo fiado em _region_node (morre na troca).
func _build_stone_echo(pos: Vector2) -> void:
	var ap := AudioStreamPlayer2D.new()
	ap.set_meta("av_stone_echo", true)
	ap.position = pos
	ap.volume_db = -13.0
	ap.max_distance = 1000.0
	ap.attenuation = 1.4
	if AudioServer.get_bus_index("Ambient") != -1:
		ap.bus = "Ambient"
	if ResourceLoader.exists(STONE_ECHO_PATH):
		var st = load(STONE_ECHO_PATH)
		if st != null:
			ap.stream = st
	_region_node.add_child(ap)
	_stone_echo_player = ap   # ref p/ o respiro de chegada ao terraço (VERTICALITY_FEEL_PASS_01)
	var t := Timer.new()
	t.one_shot = false
	t.wait_time = 11.0
	_region_node.add_child(t)
	t.timeout.connect(func() -> void:
		if ap.stream == null or not ap.is_inside_tree() or not is_instance_valid(_player):
			return
		if _player.global_position.distance_to(pos) < 760.0:   # só ecoa perto do paredão (o som volta DA Pedra)
			ap.play()
	)
	if t.is_inside_tree():
		t.start()

## THE_STONE_BUILD_06 — O FUNDO: a Cisterna e o Arquivo dos Nomes (o CORAÇÃO da Pedra). O survey concluiu que o 3º
## espaço da Pedra não SOBE, DESCE: uma câmara escavada no leito de rocha (bedrock) ao PÉ da Pedra, ao lado do
## trailhead — fria, quieta, no escuro. Dentro vivem a CISTERNA (água parada = preservação) e o ARQUIVO DOS NOMES
## (cordas de nós + pedras gravadas = a memória GUARDADA; "se a Vigília sumisse amanhã, isto restaria como prova de que
## existiu"). Cuidados pela GUARDIÃ DOS NOMES (6ª presença; faceta = memória guardada/preservação; reusa
## _build_stone_witness no nível 0 legado). NÃO é dungeon/caverna de exploração/loot/combate/puzzle/quest/economia/
## sistema novo — é UM cômodo, identidade pura, same-level (nv0). A "descida" é LEITURA (degraus, lintel, escuro,
## frescor), não um andar novo. Tudo fiado em _region_node (z=int(y)); morre na troca de região.
func _build_stone_cistern(foot_y: float, west: float, east: float) -> void:
	var WX0 := 1660.0; var WX1 := 2074.0; var WY0 := 448.0; var WY1 := 648.0   # câmara (interior)
	var GAP0 := 1812.0; var GAP1 := 1912.0   # a fenda de entrada (no muro norte, alinhada a bandas livres do talus)
	var COOL_FLOOR := Color("2b2f3a")        # pedra fria/escura do fundo (≠ areia quente lá fora)
	var COOL_WALL := Color("3a3d49")
	var COOL_WALL_LO := Color("23262f")
	# (a) CHÃO da câmara — escuro e frio, cobre a areia quente do apron dentro dos limites (z baixo, props desenham acima)
	var floor_r := ColorRect.new(); floor_r.color = COOL_FLOOR; floor_r.position = Vector2(WX0 + 6.0, WY0 + 10.0)
	floor_r.size = Vector2(WX1 - WX0 - 12.0, WY1 - WY0 - 10.0); floor_r.z_index = -4; floor_r.set_meta("av_stone_cistern", true)
	_region_node.add_child(floor_r)
	# bruma fria sobre o piso (o ar "de baixo" — fresco, parado)
	var haze := ColorRect.new(); haze.color = Color(0.42, 0.5, 0.62, 0.10); haze.position = floor_r.position
	haze.size = floor_r.size; haze.z_index = -2; haze.set_meta("av_stone_cistern", true); _region_node.add_child(haze)
	# (b) PAREDES (blocker nv0 + rocha escura). Muro norte em DUAS partes, deixando a fenda de entrada GAP0..GAP1.
	var walls := [
		Rect2(WX0, WY0, GAP0 - WX0, 16.0),            # norte-oeste
		Rect2(GAP1, WY0, WX1 - GAP1, 16.0),           # norte-leste
		Rect2(WX0 - 8.0, WY0, 14.0, WY1 - WY0),       # oeste
		Rect2(WX1 - 6.0, WY0, 14.0, WY1 - WY0),       # leste
		Rect2(WX0 - 8.0, WY1 - 16.0, WX1 - WX0 + 14.0, 16.0),  # sul (o fundo = a face do Arquivo fica colada nela)
	]
	for wr in walls:
		_add_blocker(wr)
		var wv := ColorRect.new(); wv.color = COOL_WALL; wv.position = wr.position; wv.size = wr.size
		wv.z_index = int(wr.position.y + wr.size.y); wv.set_meta("av_stone_cistern", true); _region_node.add_child(wv)
		var wsh := ColorRect.new(); wsh.color = COOL_WALL_LO; wsh.position = wr.position + Vector2(0.0, wr.size.y - 4.0)
		wsh.size = Vector2(wr.size.x, 4.0); wsh.z_index = int(wr.position.y + wr.size.y); _region_node.add_child(wsh)
	# (c) ENTRADA: degraus DESCENDO na fenda (apron y~404 → piso y~462), escurecendo (leitura de "desço pra dentro")
	for i in range(7):
		var t := float(i) / 6.0
		var sy := lerpf(404.0, 462.0, t)
		var st := ColorRect.new()
		st.color = Color(0.40 - t * 0.16, 0.42 - t * 0.16, 0.30 - t * 0.10, 1.0)   # vai do quente do apron ao frio do fundo
		st.position = Vector2(GAP0 + 6.0, sy); st.size = Vector2((GAP1 - GAP0) - 12.0, 7.0)
		st.z_index = int(sy) - 2; st.set_meta("av_stone_cistern", true); _region_node.add_child(st)
	# sombra de boca (gradiente escuro abaixo do lintel) + LINTEL de rocha por cima (o jogador passa POR BAIXO = "entrei")
	var mouth_sh := ColorRect.new(); mouth_sh.color = Color(0.0, 0.0, 0.0, 0.5); mouth_sh.position = Vector2(GAP0, 430.0)
	mouth_sh.size = Vector2(GAP1 - GAP0, 30.0); mouth_sh.z_index = 460; mouth_sh.set_meta("av_stone_cistern", true); _region_node.add_child(mouth_sh)
	var lintel := ColorRect.new(); lintel.color = Color("1c1f27"); lintel.position = Vector2(GAP0 - 14.0, 392.0)
	lintel.size = Vector2((GAP1 - GAP0) + 28.0, 22.0); lintel.z_index = 950; lintel.set_meta("av_stone_cistern", true); _region_node.add_child(lintel)
	# isca: um halo FRIO de luz de lamparina vazando da boca escura (convida a descer, como o leak quente do terraço)
	var lure := Polygon2D.new(); var lp := PackedVector2Array()
	for i in range(16):
		var a := TAU * float(i) / 16.0
		lp.append(Vector2(cos(a) * 40.0, sin(a) * 14.0))
	lure.polygon = lp; lure.position = Vector2((GAP0 + GAP1) * 0.5, 452.0); lure.color = Color(0.6, 0.74, 0.9, 0.16)
	lure.z_index = -1; lure.set_meta("av_stone_cistern", true); _region_node.add_child(lure)
	# (d) A CISTERNA — água PARADA, escura, fria (o ponto mais baixo; a coisa mais preciosa). Lip de pedra + reflexo lento.
	var pool_c := Vector2(1962.0, 548.0)
	var lip := Polygon2D.new(); var lipp := PackedVector2Array()
	for i in range(20):
		var a := TAU * float(i) / 20.0
		lipp.append(Vector2(cos(a) * 96.0, sin(a) * 50.0))
	lip.polygon = lipp; lip.position = pool_c; lip.color = Color("4a4e59"); lip.z_index = int(pool_c.y) - 3
	lip.set_meta("av_stone_cistern", true); _region_node.add_child(lip)
	var water := Polygon2D.new(); var wp := PackedVector2Array()
	for i in range(20):
		var a := TAU * float(i) / 20.0
		wp.append(Vector2(cos(a) * 82.0, sin(a) * 40.0))
	water.polygon = wp; water.position = pool_c; water.color = Color("10202e"); water.z_index = -3
	water.set_meta("av_stone_cistern", true); _region_node.add_child(water)
	var sheen := Polygon2D.new(); var shp := PackedVector2Array()   # reflexo pálido (único movimento: respira devagar)
	for i in range(16):
		var a := TAU * float(i) / 16.0
		shp.append(Vector2(cos(a) * 44.0, sin(a) * 18.0))
	sheen.polygon = shp; sheen.position = pool_c + Vector2(-10.0, -8.0); sheen.color = Color(0.55, 0.68, 0.82, 0.16)
	sheen.z_index = -2; sheen.set_meta("av_stone_cistern", true); _region_node.add_child(sheen)
	if sheen.is_inside_tree():
		var tw := sheen.create_tween(); tw.set_loops()
		tw.tween_property(sheen, "modulate:a", 0.4, 3.4).set_trans(Tween.TRANS_SINE)
		tw.tween_property(sheen, "modulate:a", 1.0, 3.4).set_trans(Tween.TRANS_SINE)
	# balde de tirar água pendurado + corda (uso diário; sem interação) + jarro na borda
	var rope := Line2D.new(); rope.points = PackedVector2Array([Vector2(2040.0, 470.0), Vector2(2044.0, 512.0), Vector2(2040.0, 540.0)])
	rope.width = 2.0; rope.default_color = Color("6b573a"); rope.z_index = int(pool_c.y); _region_node.add_child(rope)
	var bucket := Polygon2D.new(); bucket.polygon = PackedVector2Array([Vector2(-9, -8), Vector2(9, -8), Vector2(7, 8), Vector2(-7, 8)])
	bucket.position = Vector2(2040.0, 548.0); bucket.color = Color("5b4630"); bucket.z_index = int(pool_c.y) + 2; _region_node.add_child(bucket)
	var jar := Polygon2D.new(); jar.polygon = PackedVector2Array([Vector2(-7, 8), Vector2(-9, -6), Vector2(-4, -14), Vector2(4, -14), Vector2(9, -6), Vector2(7, 8)])
	jar.position = Vector2(1884.0, 588.0); jar.color = Color("7a5f3e"); jar.z_index = int(588.0); _region_node.add_child(jar)
	# (e) O ARQUIVO DOS NOMES — a alma: cordas de nós (gerações) + pedras gravadas (de antes das cordas), na face sul.
	# Linhas mais ao fundo desbotam (idade); a corda mais nova traz um seixo QUENTE (acabou de descer da Vigia: ALTO→FUNDO).
	var arc_y0 := 560.0
	for row in range(4):
		var ry := arc_y0 + float(row) * 16.0
		var age_a := 0.30 + float(row) * 0.20   # fileiras da frente (row alto) mais vivas; do fundo, desbotadas
		for c in range(9):
			var cx := 1700.0 + float(c) * 30.0
			var cord := Line2D.new()
			cord.points = PackedVector2Array([Vector2(cx, ry - 14.0), Vector2(cx + 2.0, ry), Vector2(cx - 1.0, ry + 12.0)])
			cord.width = 2.0; cord.default_color = Color(0.42, 0.36, 0.24, age_a); cord.z_index = int(ry)
			cord.set_meta("av_stone_archive", true); _region_node.add_child(cord)
			for kn in [ry - 8.0, ry + 2.0, ry + 10.0]:   # nós = pessoas
				var knot := Polygon2D.new(); var kp := PackedVector2Array()
				for i in range(7):
					var a := TAU * float(i) / 7.0
					kp.append(Vector2(cos(a) * 2.4, sin(a) * 2.4))
				knot.polygon = kp; knot.position = Vector2(cx + 1.0, kn); knot.color = Color(0.6, 0.52, 0.36, age_a)
				knot.z_index = int(ry) + 1; _region_node.add_child(knot)
	# a corda MAIS NOVA (ponta direita, fileira da frente) com um seixo quente pulsando — o último nome, recém-descido
	var newcord := Line2D.new(); newcord.points = PackedVector2Array([Vector2(1992.0, arc_y0 + 34.0), Vector2(1994.0, arc_y0 + 48.0), Vector2(1992.0, arc_y0 + 62.0)])
	newcord.width = 2.4; newcord.default_color = Color("6a5836"); newcord.z_index = int(arc_y0 + 62.0); _region_node.add_child(newcord)
	var newbead := Polygon2D.new(); var nbp := PackedVector2Array()
	for i in range(8):
		var a := TAU * float(i) / 8.0
		nbp.append(Vector2(cos(a) * 3.2, sin(a) * 3.2))
	newbead.polygon = nbp; newbead.position = Vector2(1993.0, arc_y0 + 54.0); newbead.color = Color("f0c87a")
	newbead.z_index = int(arc_y0 + 62.0) + 1; newbead.set_meta("av_stone_archive", true); _region_node.add_child(newbead)
	if newbead.is_inside_tree():
		var tw2 := newbead.create_tween(); tw2.set_loops()
		tw2.tween_property(newbead, "modulate:a", 0.45, 2.8).set_trans(Tween.TRANS_SINE)
		tw2.tween_property(newbead, "modulate:a", 1.0, 2.8).set_trans(Tween.TRANS_SINE)
	# pedras gravadas (nichos) — os nomes de ANTES das cordas, mais permanentes que tudo
	for sp in [Vector2(1720.0, 612.0), Vector2(1756.0, 614.0), Vector2(1792.0, 612.0)]:
		var niche := ColorRect.new(); niche.color = Color("15171d"); niche.position = sp - Vector2(9.0, 11.0); niche.size = Vector2(18.0, 22.0)
		niche.z_index = int(sp.y); _region_node.add_child(niche)
		var stone := ColorRect.new(); stone.color = Color("8a8576"); stone.position = sp - Vector2(6.0, 8.0); stone.size = Vector2(12.0, 16.0)
		stone.z_index = int(sp.y) + 1; stone.set_meta("av_stone_archive", true); _region_node.add_child(stone)
		var mark := Line2D.new(); mark.points = PackedVector2Array([sp + Vector2(-3, -3), sp + Vector2(3, 0), sp + Vector2(-2, 4)])
		mark.width = 1.0; mark.default_color = Color(0.1, 0.1, 0.12, 0.7); mark.z_index = int(sp.y) + 2; _region_node.add_child(mark)
	# uma lamparina baixa junto ao arquivo (alguém cuida disto à noite) — halo quente pequeno
	var lamp := Polygon2D.new(); var lampp := PackedVector2Array()
	for i in range(14):
		var a := TAU * float(i) / 14.0
		lampp.append(Vector2(cos(a) * 30.0, sin(a) * 16.0))
	lamp.polygon = lampp; lamp.position = Vector2(1820.0, 598.0); lamp.color = Color(1.0, 0.82, 0.5, 0.20); lamp.z_index = -1; _region_node.add_child(lamp)
	# marcador de leitura do Arquivo (objeto): [E] = future_exit → texto contemplativo (responde "o que é / como / o que acontece se esquecido")
	var amark := Node2D.new(); amark.position = Vector2(1772.0, 600.0); amark.z_index = int(600.0); amark.set_meta("av_stone_archive", true)
	var aprompt := Label.new(); aprompt.text = "[E] o Arquivo dos Nomes"; aprompt.position = Vector2(-58.0, -38.0); aprompt.modulate = Color("cdb9e0")
	aprompt.add_theme_font_size_override("font_size", 14)
	aprompt.add_theme_color_override("font_outline_color", Color(0.04, 0.03, 0.05, 0.95))
	aprompt.add_theme_constant_override("outline_size", 5); aprompt.visible = false
	amark.add_child(aprompt); _tag_on_top(aprompt); _region_node.add_child(amark)
	_services.append({"node": amark, "prompt": aprompt, "pos": amark.position, "kind": "future_exit", "id": "stone_archive", "title": "o Arquivo dos Nomes", "level": 0, "msg": [
		"Cordas e pedras, do chão ao teto. Cada nó é uma pessoa que o deserto levou; cada pedra, uma de antes das cordas.",
		"Não há tinta aqui — o vento apagaria. Há nós, que mãos relêem no escuro, para que os nomes não virem só silêncio.",
		"Se a Vigília acabasse amanhã, isto restaria: a prova de que essas pessoas existiram.",
	]})
	# (f) A GUARDIÃ DOS NOMES — a 6ª presença (memória GUARDADA, distinta da Vigia=memória viva). Sentada no escuro,
	# junto ao arquivo; reusa _build_stone_witness no nível 0 legado (z=int(y), interação same-level, sem quest/recompensa).
	_build_stone_witness(_region_node, Vector2(1730.0, 614.0), 0, "stone_guard", "a Guardiã dos Nomes", Color("4a4c63"), Color("2f3144"), "breathe", true, [
		"Lá em cima eles veem os nomes chegarem. Aqui embaixo, eu faço eles ficarem.",
		"A água não esquece. Por isso os nomes moram com ela.",
		"Cada corda dessas foi uma pessoa. Eu não desato nenhum nó.",
		"Quando a corda da Vigia enche, ela desce até mim. É assim que ninguém some de vez.",
		"Um nome que ninguém repete vira só um nó cego. Então eu repito — todos, toda noite.",
		"Houve quem quisesse poupar esta lida: gravar todos os nomes na pedra, de uma vez, pra nunca mais precisar de uma boca que os dissesse. A areia mostrou no que dá — pedra cheia, e ninguém pra ler. Por isso eu ainda repito.",
	])
	# ★ LEGADO (PEDRA_LEGACY_F5) — A PAREDE DO ERRANTE: uma corda por NOME que ele carregou (persiste no save), com
	# o seixo quente dos "que ainda são repetidos". Cresce a cada visita. SEM texto na parede (o vento apagaria; o
	# nome vive na boca, não na tinta) — os nomes se RELÊEM por [E]. Observada, não celebrada.
	_stone_carried_wall(Vector2(1995.0, arc_y0 + 84.0))
	# (g) a GOTA — assinatura sonora do fundo (dormente: sem o .ogg fica silenciosa e NÃO dá erro; drop-in acende)
	var drip := AudioStreamPlayer2D.new(); drip.set_meta("av_cistern_drip", true); drip.position = pool_c
	drip.volume_db = -16.0; drip.max_distance = 700.0; drip.attenuation = 1.6
	if AudioServer.get_bus_index("Ambient") != -1:
		drip.bus = "Ambient"
	if ResourceLoader.exists(CISTERN_DRIP_PATH):
		var ds = load(CISTERN_DRIP_PATH)
		if ds != null: drip.stream = ds
	_region_node.add_child(drip)
	var dt := Timer.new(); dt.one_shot = false; dt.wait_time = 6.5; _region_node.add_child(dt)
	dt.timeout.connect(func() -> void:
		if drip.stream == null or not drip.is_inside_tree() or not is_instance_valid(_player):
			return
		if _player.global_position.distance_to(pool_c) < 520.0:
			drip.play()
	)
	if dt.is_inside_tree():
		dt.start()

## VERTICALITY TRAVERSAL FIX — constrói uma ESCADA FÍSICA (chute) entre dois andares: corredor ESTREITO com PAREDES
## laterais (blocker nos DOIS níveis → só se entra/sai pelas pontas), degraus visíveis (pé→topo), lip no topo, e um
## stair_link EXPLÍCITO (lower_entry/upper_entry + limiares espelhados flip_up=topo / flip_down=pé + latch). A subida
## e a descida usam a MESMA conexão física. `ww` = espessura/alcance das paredes (Pedra=70 fecha o vão; vlab=20 trilho).
func _build_stair_chute(lo: int, hi: int, cx: float, half_w: float, bottom_y: float, top_y: float, lo_parent: Node2D, hi_parent: Node2D, ww: float) -> void:
	var x0 := cx - half_w
	var x1 := cx + half_w
	var lo_cont: bool = lo_parent.y_sort_enabled
	var hi_cont: bool = hi_parent.y_sort_enabled
	# DEGRAUS (no nível baixo, o jogador anda sobre) — apertam pro topo (perspectiva de altura)
	for i in range(9):
		var t := float(i) / 8.0
		var ry := lerpf(bottom_y, top_y, t * t)
		var tread := ColorRect.new()
		tread.color = Color(0.75 - t * 0.05, 0.63 - t * 0.04, 0.40, 0.96)
		tread.position = Vector2(x0 + 3.0, ry - 4.0); tread.size = Vector2((x1 - x0) - 6.0, 4.0)
		if lo_cont: tread.z_as_relative = true; tread.z_index = -1
		else: tread.z_index = int(ry) - 2
		tread.set_meta("av_stair", true); lo_parent.add_child(tread)
	var lip := ColorRect.new()   # LIP do topo = a crista (onde se vira de andar ao subir)
	lip.color = Color(0.97, 0.88, 0.64, 0.6); lip.position = Vector2(x0 + 4.0, top_y - 3.0); lip.size = Vector2((x1 - x0) - 8.0, 4.0)
	if lo_cont: lip.z_as_relative = true; lip.z_index = 0
	else: lip.z_index = int(top_y)
	lip.set_meta("av_stair", true); lo_parent.add_child(lip)
	# PAREDES LATERAIS: blocker nos DOIS níveis (só entra/sai pelas pontas) + visual em cada nível
	for sx in [x0 - ww, x1]:
		_add_blocker(Rect2(sx, top_y, ww, bottom_y - top_y), lo)
		_add_blocker(Rect2(sx, top_y, ww, bottom_y - top_y), hi)
		var vlo := ColorRect.new(); vlo.color = Color("5c4427"); vlo.position = Vector2(sx, top_y); vlo.size = Vector2(ww, bottom_y - top_y)
		if lo_cont: vlo.z_as_relative = true; vlo.z_index = 0
		else: vlo.z_index = int(bottom_y)
		vlo.set_meta("av_stair", true); lo_parent.add_child(vlo)
		var vhi := ColorRect.new(); vhi.color = Color("6f4d2c"); vhi.position = Vector2(sx, top_y); vhi.size = Vector2(ww, (bottom_y - top_y) * 0.55)
		if hi_cont: vhi.z_as_relative = true; vhi.z_index = 0
		else: vhi.z_index = int(top_y)
		vhi.set_meta("av_stair", true); hi_parent.add_child(vhi)
	# STAIR LINK EXPLÍCITO + latch (consumido em _vertical_tick)
	_stair_zones.append({
		"rect": Rect2(x0, top_y - 12.0, x1 - x0, (bottom_y - top_y) + 24.0),
		"a": lo, "b": hi, "flip_up": top_y, "flip_down": bottom_y,
		"lower_entry": Rect2(x0, bottom_y - 6.0, x1 - x0, 22.0),   # ponta de BAIXO (engata subida)
		"upper_entry": Rect2(x0, top_y - 16.0, x1 - x0, 22.0),     # ponta de CIMA (engata descida)
		"latch": "idle", "cx": cx,
	})

## VERTICALITY FASE 4 MÍNIMA — tick dos NPCs roteirizados (waypoint-stair). Anda até cada waypoint (no nível atual);
## num step "stair" PERCORRE a escada e troca de nível NO MEIO (reparent + atualiza o nível na entrada de _npcs p/ a
## interação same-level). Rotina em LOOP. NÃO é pathfinding (sem desvio/navmesh) — só waypoints declarados. No-op vazio.
func _stair_npc_tick(delta: float) -> void:
	if _routine_npcs.is_empty():
		return
	for rn in _routine_npcs:
		var node: Node2D = rn["node"]
		if not is_instance_valid(node):
			continue
		match str(rn["state"]):
			"wait":
				rn["wait_left"] = float(rn["wait_left"]) - delta
				if float(rn["wait_left"]) <= 0.0:
					_routine_advance(rn)
			"walk":
				var step: Dictionary = rn["route"][int(rn["i"])]
				var target: Vector2 = step["pos"]
				var to: Vector2 = target - node.position
				var step_len: float = STAIR_NPC_SPEED * delta
				if to.length() <= maxf(4.0, step_len):   # chega quando está a ≤1 passo (evita oscilar/overshoot no waypoint)
					node.position = target
					rn["wait_left"] = float(step.get("wait", 0.0))
					rn["state"] = "wait"
				else:
					node.position += to.normalized() * step_len
				rn["npcs"]["pos"] = node.position   # a entrada move junto → prompts/_nearest usam a pos VIVA
				_routine_apply_z(node)   # no plano legado (base da Pedra) o z acompanha o y enquanto anda
			"climb":
				rn["t"] = float(rn["t"]) + delta / STAIR_NPC_CLIMB_DUR
				var t: float = float(rn["t"])
				var cfrom: Vector2 = rn["climb_from"]
				var cto: Vector2 = rn["climb_to"]
				var tgt := int(rn["climb_target_level"])
				if t < 1.0:
					node.position = cfrom.lerp(cto, t)
					if t >= 0.5 and int(rn["floor_level"]) != tgt:
						_routine_set_level(rn, tgt)   # troca NO MEIO da escada (vê-se cristar)
				else:
					node.position = cto
					if int(rn["floor_level"]) != tgt:
						_routine_set_level(rn, tgt)
					_routine_advance(rn)
				rn["npcs"]["pos"] = node.position
				_routine_apply_z(node)   # mantém o z certo durante a travessia da escada (legado vs contêiner)

## Avança o índice da rotina (loop). Se o próximo step é "stair", prepara o trecho de subida/descida conforme o
## nível ATUAL do NPC (no nível baixo → sobe pé→topo; no alto → desce topo→pé).
func _routine_advance(rn: Dictionary) -> void:
	rn["i"] = (int(rn["i"]) + 1) % (rn["route"] as Array).size()
	var step: Dictionary = rn["route"][int(rn["i"])]
	if str(step.get("kind", "walk")) == "stair":
		var lo := int(step["lo_level"]); var hi := int(step["hi_level"])
		var foot: Vector2 = step["foot"]; var top: Vector2 = step["top"]
		if int(rn["floor_level"]) == lo:
			rn["climb_from"] = foot; rn["climb_to"] = top; rn["climb_target_level"] = hi
		else:
			rn["climb_from"] = top; rn["climb_to"] = foot; rn["climb_target_level"] = lo
		rn["t"] = 0.0
		rn["state"] = "climb"
	else:
		rn["state"] = "walk"

## Troca o andar de um NPC roteirizado: reparenta pro contêiner do nível (preserva pos global; nível sem contêiner →
## _region_node legado) e atualiza o "level" na entrada de _npcs (a interação same-level lê isto AO VIVO). Não toca o player.
func _routine_set_level(rn: Dictionary, lvl: int) -> void:
	rn["floor_level"] = lvl
	var node: Node2D = rn["node"]
	var cont: Node2D = _floor_containers.get(lvl, null)
	var dest: Node2D = cont if cont != null else _region_node
	if node.get_parent() != dest:
		node.reparent(dest, true)
	_routine_apply_z(node)   # z ciente-do-pai (contêiner y_sort = relativo 0; plano legado = z=int(y))
	rn["npcs"]["level"] = lvl

## VERTICALITY F4 — z de um NPC roteirizado conforme o PAI: dentro de contêiner de andar (y_sort) usa z relativo 0 (o
## y_sort nativo ordena DENTRO do andar); no plano LEGADO (ex.: base da Pedra, não-y_sort) usa z=int(y) (ordena com os
## props legados de z=int(y)). Mantém o vlab IDÊNTICO (lá os dois níveis são contêiner y_sort → sempre z relativo 0).
func _routine_apply_z(node: Node2D) -> void:
	var par := node.get_parent()
	if par != null and (par as Node2D).y_sort_enabled:
		node.z_as_relative = true
		node.z_index = 0
	else:
		node.z_as_relative = false
		node.z_index = int(node.position.y)

## KHET-SAR_BUILD_05 — 1º CONTATO com O SAL QUE DORME: uma planície de sal pálida e IMÓVEL, fundo nas Dunas.
## Percebida antes de compreendida: contraste pálido com a areia quente, rachaduras paradas, formações de sal
## ESTÁTICAS, nenhuma poeira/movimento (tudo congelado) e um PULSO pálido LENTÍSSIMO no centro (o único movimento —
## "algo respira sob o sal"). Reverência/silêncio/pequenez, NÃO terror. Sem [E]/texto/combate/blocker (entra, olha, vai).
func _build_dunes_sleeping_salt(pos: Vector2) -> void:
	# halo de aura pálida + "rim" (a borda onde a areia quente cede ao sal)
	var rim := Polygon2D.new()
	var rp := PackedVector2Array()
	for i in range(30):
		var a := TAU * float(i) / 30.0
		rp.append(Vector2(cos(a) * 178.0, sin(a) * 108.0))
	rim.polygon = rp; rim.position = pos; rim.color = Color(0.78, 0.77, 0.72, 0.85); rim.z_index = -3
	_region_node.add_child(rim)
	var flat := Polygon2D.new()   # a planície de sal (pálida, quase branca, lisa)
	var fp := PackedVector2Array()
	for i in range(30):
		var a := TAU * float(i) / 30.0
		fp.append(Vector2(cos(a) * 152.0, sin(a) * 90.0))
	flat.polygon = fp; flat.position = pos; flat.color = Color(0.87, 0.86, 0.81, 0.96); flat.z_index = -2
	_region_node.add_child(flat)
	for seg in [[Vector2(-120, -20), Vector2(-30, 10), Vector2(40, -16)], [Vector2(-10, 60), Vector2(20, -4), Vector2(70, -50)], [Vector2(60, 40), Vector2(110, -10)]]:   # rachaduras paradas (pan de sal seco)
		var crack := Line2D.new()
		var cp := PackedVector2Array()
		for v in seg:
			cp.append(pos + v)
		crack.points = cp; crack.width = 1.8; crack.default_color = Color(0.62, 0.6, 0.55, 0.5); crack.z_index = -1
		_region_node.add_child(crack)
	for fpos in [Vector2(-130.0, -40.0), Vector2(120.0, -30.0), Vector2(-70.0, 70.0), Vector2(90.0, 64.0)]:   # formações de sal ESTÁTICAS na borda
		var cr := Polygon2D.new()
		cr.polygon = PackedVector2Array([Vector2(-9, 6), Vector2(-3, -22), Vector2(3, -10), Vector2(7, -28), Vector2(10, 6)])
		cr.position = pos + fpos; cr.color = Color(0.90, 0.89, 0.85, 0.95); cr.z_index = int(pos.y + fpos.y)
		_region_node.add_child(cr)
	# PULSO pálido lentíssimo no centro — o ÚNICO movimento (algo respira sob o sal). Não explicado.
	var pulse := Polygon2D.new()
	var pp := PackedVector2Array()
	for i in range(24):
		var a := TAU * float(i) / 24.0
		pp.append(Vector2(cos(a) * 60.0, sin(a) * 36.0))
	pulse.polygon = pp; pulse.position = pos; pulse.color = Color(0.95, 0.95, 0.92, 0.10); pulse.z_index = -1
	_region_node.add_child(pulse)
	if pulse.is_inside_tree():
		var tw := pulse.create_tween()
		tw.set_loops()
		tw.tween_property(pulse, "modulate:a", 1.7, 4.2).set_trans(Tween.TRANS_SINE)   # respiração MUITO lenta
		tw.tween_property(pulse, "modulate:a", 0.5, 4.2).set_trans(Tween.TRANS_SINE)

## KHET-SAR_BUILD_04 — O TERRITÓRIO: uma GRADE soterrada aflorando (avenida + cruzamento + muro colinear + degraus).
## Cada peça é pouco; o ALINHAMENTO regular e a frequência crescente fazem o jogador perceber que anda SOBRE uma
## cidade. Tudo baixo/andável (sem blocker — pisa-se em cima), sem texto/[E]/confirmação.
func _dunes_grid_base(pos: Vector2) -> void:
	var base := ColorRect.new(); base.color = Color("b0996a"); base.size = Vector2(30.0, 30.0); base.position = pos + Vector2(-15.0, -15.0); base.z_index = int(pos.y); _region_node.add_child(base)
	var s := ColorRect.new(); s.color = Color("c9b27e"); s.size = Vector2(42.0, 12.0); s.position = pos + Vector2(-21.0, 8.0); s.z_index = int(pos.y) + 1; _region_node.add_child(s)

func _dunes_grid_paver(pos: Vector2, covered: bool) -> void:
	var p := ColorRect.new(); p.color = Color("9c8a5e"); p.size = Vector2(46.0, 30.0); p.position = pos + Vector2(-23.0, -15.0); p.rotation = 0.04; p.z_index = int(pos.y) - 1; _region_node.add_child(p)
	if covered:
		var c := ColorRect.new(); c.color = Color("c9b27e"); c.size = Vector2(54.0, 22.0); c.position = pos + Vector2(-27.0, -2.0); c.z_index = int(pos.y); _region_node.add_child(c)

func _build_dunes_buried_grid() -> void:
	var ay := 640.0
	var ax := [620.0, 740.0, 860.0, 980.0, 1100.0, 1220.0]   # AVENIDA: bases em intervalo REGULAR (120px) = alinhamento
	for i in range(ax.size()):
		if i < 2 and i % 2 == 1:
			continue   # oeste ESPARSO (densidade cresce indo pro leste)
		_dunes_grid_base(Vector2(ax[i], ay))
		if i < ax.size() - 1:
			_dunes_grid_paver(Vector2((ax[i] + ax[i + 1]) * 0.5, ay), i % 2 == 0)   # pavimento alterna some/reaparece
		if ax[i] > 1050.0:
			_dunes_grid_paver(Vector2(ax[i], ay + 26.0), false)   # leste mais denso
	for cy in [520.0, 760.0, 880.0]:   # CRUZAMENTO perpendicular → grade → "cidade, não monumento"
		_dunes_grid_base(Vector2(980.0, cy))
		_dunes_grid_paver(Vector2(980.0, (cy + ay) * 0.5), true)
	# PACK10: MURO colinear como cacos de muro reais (ruined_wall_chunk; flip por paridade) se existir; senão 2 ColorRects (fallback). Sem blocker (baixo/andável).
	var wall_tex := _try_load_tex("res://assets/tilesets/deep_dunes/props/ruined_wall_chunk.png")
	for wx in [700.0, 820.0, 940.0, 1060.0]:   # MURO colinear (fragmentos baixos alinhados em y=708)
		if wall_tex != null:
			var k := 92.0 / 111.0   # content-width 111 → ~92px (perto do muro original de 80)
			var s := Sprite2D.new(); s.texture = wall_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
			s.scale = Vector2(k, k); s.offset = Vector2(-2.0, -16.0); s.flip_h = (int(wx) % 240 == 220); s.position = Vector2(wx + 35.0, 722.0); s.z_index = 722; _region_node.add_child(s)
		else:
			var w := ColorRect.new(); w.color = Color("a89564"); w.size = Vector2(70.0, 14.0); w.position = Vector2(wx, 708.0); w.z_index = 708; _region_node.add_child(w)
			var ws := ColorRect.new(); ws.color = Color("c9b27e"); ws.size = Vector2(80.0, 10.0); ws.position = Vector2(wx - 4.0, 716.0); ws.z_index = 709; _region_node.add_child(ws)
	for s in range(5):   # DEGRAUS meio soterrados descendo numa duna (NÃO é entrada — somem na areia)
		var st := ColorRect.new()
		st.color = Color(0.62, 0.55, 0.40, 1.0 - float(s) * 0.12)
		st.size = Vector2(70.0 - float(s) * 8.0, 12.0)
		st.position = Vector2(1150.0 + float(s) * 10.0, 540.0 + float(s) * 14.0)
		st.z_index = int(540.0 + float(s) * 14.0)
		_region_node.add_child(st)
	var stsand := ColorRect.new(); stsand.color = Color("c9b27e"); stsand.size = Vector2(60.0, 16.0); stsand.position = Vector2(1188.0, 604.0); stsand.z_index = 620; _region_node.add_child(stsand)

## KHET-SAR_BUILD_03 — A SOMBRA DO SOTERRADO: arquitetura MONUMENTAL aflorando da areia (escala de CIDADE).
## Arco quebrado + pilares maciços + colunas isoladas em fila + laje de pavimento = uma avenida soterrada. Puramente
## VISUAL (sem texto/[E]). Diz, sem dizer: "isto não pertence a uma caravana — havia um LUGAR INTEIRO aqui."
func _build_dunes_buried_arch(pos: Vector2) -> void:
	var z := int(pos.y)
	_add_floor_glow(pos, 230.0, Color(0.84, 0.74, 0.52, 0.16))   # grande duna acumulada sobre tudo
	var mon := Node2D.new(); mon.position = pos; mon.rotation = 0.05; mon.z_index = z
	_region_node.add_child(mon)
	# PACK10: arco monumental soterrado como sprite (dune_buried_arch; base via bbox off.y=-54, escala ~largura dos
	# pilares) se existir; senão pilares+arco-quebrado+cover de polígono (fallback). Colunas/laje/glow/blocker mantidos.
	var arch_tex := _try_load_tex("res://assets/tilesets/deep_dunes/props/dune_buried_arch.png")
	if arch_tex != null:
		var k := 232.0 / 159.0   # content-width 159 → ~232px (largura dos 2 pilares)
		var s := Sprite2D.new(); s.texture = arch_tex; s.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		s.scale = Vector2(k, k); s.offset = Vector2(-5.0, -54.0); mon.add_child(s)
	else:
		for sgn in [-1.0, 1.0]:   # pilares maciços, meio soterrados
			var pier := Polygon2D.new()
			pier.polygon = PackedVector2Array([Vector2(-26, 30), Vector2(26, 30), Vector2(22, -150), Vector2(-22, -150)])
			pier.position = Vector2(sgn * 90.0, 0.0); pier.color = Color("b0996a"); mon.add_child(pier)
			var sh := Polygon2D.new()
			sh.polygon = PackedVector2Array([Vector2(8, 28), Vector2(26, 30), Vector2(22, -150), Vector2(8, -150)]); sh.position = Vector2(sgn * 90.0, 0.0); sh.color = Color(0.0, 0.0, 0.0, 0.14); mon.add_child(sh)
			var band := Line2D.new()   # faixa de relevo (cerimonial — "isto foi um monumento")
			band.points = PackedVector2Array([Vector2(sgn * 90.0 - 22.0, -64.0), Vector2(sgn * 90.0 + 22.0, -64.0)]); band.width = 4.0; band.default_color = Color(0.0, 0.0, 0.0, 0.18); mon.add_child(band)
		var arch := Line2D.new()   # arco QUEBRADO: arranca do pilar esquerdo, sobe e parte (~60%)
		var ap := PackedVector2Array()
		for i in range(14):
			var tt := float(i) / 13.0
			if tt > 0.60:
				break
			var ang := PI * tt
			ap.append(Vector2(-90.0 + (ang / PI) * 180.0, -150.0 - sin(ang) * 70.0))
		arch.points = ap; arch.width = 26.0; arch.default_color = Color("a89564"); mon.add_child(arch)
		var cover := Polygon2D.new()   # areia selando a base (meio soterrado), z relativo acima dos pilares
		cover.polygon = PackedVector2Array([Vector2(-150, 18), Vector2(150, 18), Vector2(162, 58), Vector2(-162, 58)]); cover.color = Color("c9b27e"); cover.z_index = 4; mon.add_child(cover)
	# COLUNAS isoladas aflorando, numa fila (uma avenida soterrada → "um LUGAR, não um objeto")
	for cp in [Vector2(-235.0, 80.0), Vector2(-150.0, 130.0), Vector2(215.0, 96.0)]:
		var col := Polygon2D.new(); col.polygon = PackedVector2Array([Vector2(-16, 18), Vector2(16, 18), Vector2(13, -46), Vector2(-13, -46)]); col.position = pos + cp; col.color = Color("b0996a"); col.z_index = int(pos.y + cp.y); _region_node.add_child(col)
		var cap := ColorRect.new(); cap.color = Color("a89564"); cap.size = Vector2(40.0, 10.0); cap.position = pos + cp + Vector2(-20.0, -46.0); cap.z_index = int(pos.y + cp.y); _region_node.add_child(cap)
		var cs := ColorRect.new(); cs.color = Color("c9b27e"); cs.size = Vector2(46.0, 14.0); cs.position = pos + cp + Vector2(-23.0, 8.0); cs.z_index = int(pos.y + cp.y) + 1; _region_node.add_child(cs)
	var slab := Polygon2D.new()   # laje gigante de pavimento aflorando (chão da praça)
	slab.polygon = PackedVector2Array([Vector2(-70, 0), Vector2(80, -14), Vector2(96, 20), Vector2(-58, 34)]); slab.position = pos + Vector2(-30.0, 150.0); slab.color = Color("9c8a5e"); slab.z_index = int(pos.y + 150.0); _region_node.add_child(slab)
	_add_blocker(Rect2(pos.x - 116.0, pos.y - 6.0, 232.0, 24.0))   # pilares sólidos; contorna-se

## KHET-SAR_BUILD_02 — A EVIDÊNCIA: uma caravana INTEIRA meio engolida pela areia (covered wagon: capota sumiu, só as
## costelas; corpo inclinado e afundado; uma roda alta + outra soterrada; carga espalhada e meio coberta; lança fincada
## na areia). Puramente VISUAL (sem texto/[E]/narração). Diz, sem dizer: "isto esteve inteiro um dia — a areia engoliu."
func _build_dunes_swallowed_caravan(pos: Vector2) -> void:
	var z := int(pos.y)
	_add_floor_glow(pos + Vector2(-6.0, 22.0), 140.0, Color(0.84, 0.74, 0.52, 0.18))   # duna acumulada contra o casco
	var car := Node2D.new(); car.position = pos; car.rotation = 0.22; car.z_index = z   # carroça inclinada (afundou askew)
	_region_node.add_child(car)
	var body := Polygon2D.new()
	body.polygon = PackedVector2Array([Vector2(-66, 8), Vector2(66, 8), Vector2(58, -34), Vector2(-58, -34)])
	body.color = Color("6b4f30"); car.add_child(body)
	for px in [-44.0, -12.0, 20.0, 50.0]:   # tábuas verticais do corpo
		var plank := ColorRect.new(); plank.color = Color(0.0, 0.0, 0.0, 0.14); plank.size = Vector2(3.0, 42.0); plank.position = Vector2(px, -34.0); car.add_child(plank)
	for rx in [-44.0, -16.0, 14.0, 46.0]:   # COSTELAS da capota (o pano sumiu — só os arcos)
		var rib := Line2D.new()
		var pts := PackedVector2Array()
		for i in range(9):
			var t := float(i) / 8.0
			pts.append(Vector2(rx + (t - 0.5) * 34.0, -34.0 - sin(t * PI) * 30.0))
		rib.points = pts; rib.width = 3.0; rib.default_color = Color("4a3a26"); car.add_child(rib)
	var shaft := ColorRect.new(); shaft.color = Color("5a4632"); shaft.size = Vector2(70.0, 7.0); shaft.position = Vector2(56.0, 2.0); shaft.rotation = 0.25; car.add_child(shaft)   # lança fincada na areia
	# roda traseira ALTA (fora da areia)
	var wheel := Polygon2D.new()
	var wp := PackedVector2Array()
	for i in range(16):
		var a := TAU * i / 16.0
		wp.append(Vector2(cos(a) * 22.0, sin(a) * 22.0))
	wheel.polygon = wp; wheel.position = Vector2(-58.0, -2.0); wheel.color = Color("4a3a26"); car.add_child(wheel)
	var hub := Polygon2D.new(); hub.polygon = PackedVector2Array([Vector2(-5,0),Vector2(0,-5),Vector2(5,0),Vector2(0,5)]); hub.position = Vector2(-58.0, -2.0); hub.color = Color("6b4f30"); car.add_child(hub)
	# AREIA cobrindo a metade de baixo (sela o "afundado") — z relativo acima das peças
	var cover := Polygon2D.new()
	cover.polygon = PackedVector2Array([Vector2(-80, 2), Vector2(80, 2), Vector2(86, 26), Vector2(-86, 26)])
	cover.color = Color("c9b27e"); cover.z_index = 3; car.add_child(cover)
	var cover2 := ColorRect.new(); cover2.color = Color("c9b27e"); cover2.size = Vector2(46.0, 14.0); cover2.position = Vector2(40.0, -2.0); cover2.z_index = 3; car.add_child(cover2)   # duna subindo num canto
	# CARGA espalhada e meio coberta ao redor (não-rotacionada; scatter natural)
	for c in [Vector2(96.0, 70.0), Vector2(-110.0, 56.0), Vector2(40.0, 96.0)]:
		var crate := ColorRect.new(); crate.color = Color("7a5a34"); crate.size = Vector2(28.0, 24.0); crate.position = pos + c; crate.rotation = 0.1; crate.z_index = int(pos.y + c.y); _region_node.add_child(crate)
		var s := ColorRect.new(); s.color = Color("c9b27e"); s.size = Vector2(40.0, 12.0); s.position = pos + c + Vector2(-6.0, 10.0); s.z_index = int(pos.y + c.y) + 1; _region_node.add_child(s)
	_dunes_buried_wheel(pos + Vector2(130.0, 90.0))   # uma roda solta, soterrada, lançada longe
	# blocker fino no casco (objeto sólido; o jogador contorna — não prende)
	_add_blocker(Rect2(pos.x - 60.0, pos.y - 18.0, 120.0, 28.0))

