## Desenha um prop procedural pelo procedural_type (reusa os helpers assetless já existentes do deserto/camp).
func _manifest_prop(pt: String, pos: Vector2, params: Dictionary) -> void:
	match pt:
		"palm": _add_palm(pos, float(params.get("h", 140)))
