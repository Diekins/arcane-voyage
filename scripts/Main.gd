## ════════ FATIA A9.1 — STORY VIEWING FLOW (reusa DialoguePanel; NÃO gateia gameplay) ════════
func narrative_viewing() -> bool:
	return _narrative_viewing

## Abre o painel de história (ação secundária; NÃO abre cena sozinho §5). No-op se já em viewing.
func open_story() -> void:
	if _story_panel != null and not _narrative_viewing:
		_story_panel.open_panel()

## Extrai o scene_id do source_ref do beat.
func _beat_scene_id(beat: Dictionary) -> String:
	for part in str(beat.get("source_ref", "")).split(";"):
		if part.begins_with("scene:"):
			return part.substr(6)
	return ""

## Resolve beat → cena canônica (DataLoader). Se faltar conteúdo, devolve cena NEUTRA (CANON_CONTENT_REQUIRED,
## §9) sem inventar texto; preserva as choices do beat (ENDING/shadow-final persistem mesmo sem cena completa).
func _resolve_beat_scene(beat: Dictionary) -> Dictionary:
	var sid := _beat_scene_id(beat)
	var s: Dictionary = DataLoader.scene(sid) if sid != "" else {}
	if s.is_empty():
		s = {
			"id": sid if sid != "" else str(beat.get("beat_id", "")),
			"lines": [{"speaker": str(beat.get("title", "")), "text": "Conteúdo narrativo ainda não disponível.", "tone": "neutral"}],
			"_canon_content_required": true,
		}
		var cids: Array = beat.get("choice_ids", [])
		if not cids.is_empty():
			var chs: Array = []
			for c in cids:
				chs.append({"id": str(c), "label": str(c)})
			s["choices"] = chs
	return s

## ★ ABRIR UM BEAT (clique no StoryPanel). Revalida disponibilidade (§7), entra em VIEWING (lock local seguro:
## trava player + desliga combate + limpa alvo; AutoPlay já fica suspenso porque _dialog.is_open()), e mostra a
## cena no DialoguePanel EXISTENTE. NÃO marca seen aqui (só na conclusão, §10). Guarda contra abrir dois (§31).
func open_story_beat(beat_id: String) -> void:
	if _narrative == null or _narrative_viewing:
		return
	if _dialog == null or _dialog.is_open():
		return
	var b := NarrativeManifest.beat(beat_id)
	if b.is_empty():
		return
	var st := _narrative.beat_state(b)
	if st == NarrativeDirector.ST_LOCKED:
		return   # revalida: não abre o que não está disponível
	_narrative_replay = (st == NarrativeDirector.ST_SEEN)
	_viewing_beat = beat_id
	_narrative_viewing = true
	if _player != null and _player.has_method("set"):
		_player.set("locked", true)
	_set_world_combat(false)
	_clear_auto_target()   # §16: sem alvo stale ao voltar
	_dialog.show_scene(_resolve_beat_scene(b))

## Fecha o viewing narrativo (chamado por _on_dialogue_closed quando a cena era de um beat). Marca SEEN na
## CONCLUSÃO, registra a escolha exato-uma-vez (replay não troca §18/§22), e sai de viewing. O resume de player/
## combate/AutoPlay é do próprio _on_dialogue_closed (compartilhado). game_speed intocado (§15).
func _finish_story_viewing(choice_id: String) -> void:
	var b := _viewing_beat
	_narrative_viewing = false
	_viewing_beat = ""
	if b == "" or _narrative == null:
		return
	_narrative.open_beat(b)   # SEEN na conclusão (também cobre cena sintética)
	if not _narrative_replay:
		_narrative.record_choice(b, choice_id)   # exact-once
	# replay: restaura a escolha AUTORITATIVA (desfaz qualquer overwrite do DialoguePanel §18/§22)
	var auth := _narrative.choice_of(b)
	var beat := NarrativeManifest.beat(b)
	var sid := _beat_scene_id(beat)
	if auth != "" and sid != "" and GameState.choices != null:
		GameState.choices[sid] = auth
		GameState._dirty = true

