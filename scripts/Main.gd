	var floorpolish := Polygon2D.new(); var fp := PackedVector2Array()
	for i in range(12):
		var a := TAU * float(i) / 12.0
		fp.append(Vector2(cos(a) * 30.0, sin(a) * 16.0))
	floorpolish.polygon = fp; floorpolish.position = Vector2(1518.0, 740.0); floorpolish.color = Color(0.0, 0.0, 0.0, 0.10); floorpolish.z_index = -14; _region_node.add_child(floorpolish)
	# GESTO [E] — bater o ferro uma vez (o ato de continuar; em-sessão, sem save/recompensa)
