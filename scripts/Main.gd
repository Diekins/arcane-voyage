## Marcador de transição (uma "porta"): retângulo + nome + prompt [E] (mostrado por proximidade).
## `spawn_at` (opcional): ponto de surgimento no destino — usado por subáreas p/ devolver o jogador
## PERTO da entrada (não no spawn padrão da região). INF = usa o spawn padrão.
func _build_portal(pos: Vector2, target_region: String, title: String, draw_door: bool = true, spawn_at: Vector2 = Vector2.INF) -> void:
	var node := Node2D.new()
	node.position = pos
	if draw_door:   # portal genérico: sprite estável (fenda) do pack; senão a "porta" de shape antiga
		if not _add_portal_sprite(pos, "shadow_rift"):
			var door := ColorRect.new()
			door.color = Color(0.08, 0.09, 0.13, 0.92)
			door.size = Vector2(70, 110)
			door.position = Vector2(-35, -55)
			node.add_child(door)
			var frame := ColorRect.new()
			frame.color = Color("e8c267")
			frame.size = Vector2(74, 6)
			frame.position = Vector2(-37, -61)
			node.add_child(frame)
	var name_tag := Label.new()
	name_tag.text = title
	name_tag.position = Vector2(-60, 62)
	name_tag.add_theme_font_size_override("font_size", 13)
	node.add_child(name_tag)
	_tag_on_top(name_tag)
	var prompt := Label.new()
	prompt.text = "↦ atravessar"   # auto-transição por proximidade (GODOT-AUTO-MAP-TRANSITIONS-1); [E] também funciona
	prompt.position = Vector2(-40, -86)
	prompt.modulate = Color("e8c267")
	prompt.add_theme_font_size_override("font_size", 15)
	prompt.visible = false
	node.add_child(prompt)
	_tag_on_top(prompt)
	_region_node.add_child(node)
	_portals.append({"node": node, "prompt": prompt, "target": target_region, "pos": pos, "spawn_at": spawn_at})

## Usa um portal: se o destino está BLOQUEADO (gate), mostra mensagem e NÃO troca de região; senão entra.
## (GODOT-SWAMP-REGION-MVP-1). Gate avaliado por DESTINO em _portal_gate_open (estado existente, sem save novo).
func _use_portal(portal: Dictionary) -> void:
	var target := str(portal.get("target", ""))
	if not _portal_gate_open(target):
		_show_local_dialogue("Trilha bloqueada", [_portal_locked_message(target)])
		return
	var sp: Vector2 = portal.get("spawn_at", Vector2.INF)
	# SAÍDA da macro-zona (EXITS-1): se estamos no espaço contínuo, desliga o modo macro + reparenta o Errante ANTES
	# de (re)entrar (senão a região carregada herdaria _macro_mode=true). Em produção (não-macro) é no-op.
	if _macro_mode:
		_macro_exit_cleanup()
	# ROTEAMENTO (GRADUATION-1): target de cluster GRADUADO → re-entra no mundo contínuo CANÔNICO (spawn local→global);
	# senão → load_region legado (com _pending_spawn). _route_enter cuida dos dois casos.
	_route_enter(target, sp)

## Destino liberado? Pântano exige Golem de Cristal derrotado OU nível >= SWAMP_LEVEL_GATE (fallback
## confiável). Demais destinos sempre abertos. has_defeated_boss é case-insensitive e confiável aqui.
func _portal_gate_open(target: String) -> bool:
	if target == "swamp":
		return GameState.has_defeated_boss("Golem de Cristal") or GameState.hero_level >= SWAMP_LEVEL_GATE
	if target == "salt_split_isle":
		return GameState.is_story_flag("sandbar_reached")   # 2ª escala: só após chegar ao Banco de Areia
	if target == "khet_oasis":
		return GameState.is_story_flag("caravan_camp_reached")   # respiro: só após chegar ao Acampamento
	if target == "khet_dune_overlook":
		return GameState.is_story_flag("khet_oasis_reached")   # mirante (piloto MapLoader): só após chegar ao Oásis
	if target == "khet_salt_scrub":
		return GameState.is_story_flag("khet_oasis_reached")   # micro-hunt (piloto MapLoader): mesma corrente do Mirante
	if target == "khet_waystation":
		return GameState.is_story_flag("khet_oasis_reached")   # mini-hub (piloto MapLoader): mesma corrente do Mirante
	return true

func _portal_locked_message(target: String) -> String:
	if target == "swamp":
		return "Uma névoa de ferro corta a trilha oeste.\nDizem que só quem silenciou o Golem de Cristal — ou um andarilho calejado (nível %d) — ousa cruzá-la." % SWAMP_LEVEL_GATE
	if target == "salt_split_isle":
		return "O mar aberto ruge para além do Banco. É preciso primeiro alcançar o Banco de Areia."
	if target == "khet_oasis":
		return "A trilha do oásis só se revela a quem já alcançou o Acampamento de Caravana."
	if target == "khet_dune_overlook":
		return "O caminho para o Mirante das Dunas parte do Oásis."
	return "O caminho está bloqueado por enquanto."

## Aplica ao player os stats de equipamento que afetam diretamente o nó (velocidade = base 300 +
## bônus de botas). attack/defense entram no combate; max_hp no GameState; magic fica preparado.
func _apply_player_loadout() -> void:
	if _player != null:
		_player.set("speed", 300.0 + float(GameState.speed_bonus()))
		_player.call("set_weapon_visual", GameState.current_weapon_type())   # arma → visual do arquétipo (runtime)

## [J]: ataca o alvo válido mais próximo — prioriza MOB comum vivo no alcance; senão o BOSS.
## [J]: o ESTILO de ataque vem da arma equipada (GODOT-WEAPON-ARCHETYPE-1).
##   melee (espada/desarmado) e reach (lança) = corpo-a-corpo (alvo no alcance);
##   ranged (arco) e magic (cajado) = projétil na direção mirada.
## [J]: adquire o inimigo mais próximo no alcance da arma e TRAVA o auto-attack nele (troca se for
## outro). Dispara já se o cooldown permitir; a continuação fica por conta de `_auto_attack_tick`.
## Sem alvo, o ranged ainda atira na direção encarada (comportamento manual de hoje preservado).
func _try_attack() -> void:
	if GameState.is_hero_defeated() or _player == null:
		return
	var rng := _attack_range_now()
	# [J] confirma o alvo SELECIONADO pela Battle UI (se vivo e no alcance); senão, o mais próximo.
	var target = null
	if _target_alive(_battle_sel) and _player.position.distance_to(_battle_sel.position) <= rng:
		target = _battle_sel
	if target == null:
		target = _nearest_enemy_in_range(rng)   # mob OU boss vivo mais próximo no alcance
	if target != null:
		_set_auto_target(target)   # J trava/renova/troca o alvo
		_auto_lost_t = 0.0
	if _attack_cd > 0.0:
		return
	_attack_target(target)

## Alcance efetivo da arma atual (melee/reach/ranged/magic) — usado p/ mira do [J] e p/ o gating do auto.
func _attack_range_now() -> float:
	match GameState.current_combat_archetype():
		"ranged": return BOW_RANGE
		"magic": return STAFF_RANGE
		"reach": return SPEAR_RANGE
		"support": return BOOK_RANGE   # Oráculo (GODOT-ORACLE-WEAPON-BOOK-1)
		_: return ATTACK_RANGE

## Executa UM golpe contra `target` (mob ou boss) usando a rota do arquétipo atual. Reusa exatamente a
## mesma lógica de dano/anim/VFX/juice de sempre. target=null => ranged atira encarando; melee não golpeia.
func _attack_target(target) -> void:
	match GameState.current_combat_archetype():
		"ranged": _attack_ranged("bow", target)
		"magic": _attack_ranged("staff", target)
		"reach": _attack_melee(SPEAR_RANGE, SPEAR_COOLDOWN, target)
		"support": _attack_ranged("book", target)   # Página Cortante (GODOT-ORACLE-WEAPON-BOOK-1)
		_: _attack_melee(ATTACK_RANGE, _melee_cooldown(), target)   # espada/machado/martelo (cooldown por arma)

## Cooldown do golpe melee conforme a arma (GODOT-WARRIOR-WEAPONS-AXE-HAMMER-1): espada base, machado e
## martelo mais lentos. Default = ATTACK_COOLDOWN (espada/desarmado/qualquer melee desconhecido).
func _melee_cooldown() -> float:
	match GameState.current_weapon_type():
		"axe": return AXE_COOLDOWN
		"hammer": return HAMMER_COOLDOWN
		_: return ATTACK_COOLDOWN

## Ataque corpo-a-corpo (espada/lança): alvo travado tem prioridade (se vivo no alcance); senão mob
## comum mais próximo e por fim o boss — preservando a ordem original do [J].
func _attack_melee(rng: float, cd: float, target = null) -> void:
	var e = _pick_melee_target(rng, target)
	if e == null:
		return
	_attack_cd = cd
	_player.call("attack", e.position - _player.position)
	_melee_vfx(e.position - _player.position)
	var is_boss: bool = (e == _current_boss)
	# CombatMath (A1.5): fonte central. Faixa base = MOB_DMG (vs mob) ou faixa do boss (vs boss, quirk legado);
	# bônus melee/reach = attack + vocation("attack") + postura(capada). Equivalente 1:1 ao cálculo anterior.
	var base_min := _boss_dmg_min if is_boss else MOB_DMG_MIN
	var base_max := _boss_dmg_max if is_boss else MOB_DMG_MAX
	var dmg: int = CombatMath.player_roll(GameState.current_combat_archetype(), base_min, base_max)
	e.take_damage(dmg)
	_juice_hit(e, dmg)
	if is_boss:
		print("[Main] Você atingiu %s por %d." % [_boss_name, dmg])

## Escolhe o alvo do golpe melee: alvo travado (se vivo e no alcance) > mob comum mais próximo > boss.
func _pick_melee_target(rng: float, target):
	if _target_in_melee(target, rng):
		return target
	var mob = _nearest_mob_in_range(rng)
	if mob != null:
		return mob
	if _current_boss != null and _current_boss.is_alive() and _player.position.distance_to(_current_boss.position) <= rng:
		return _current_boss
	return null

func _target_in_melee(t, rng: float) -> bool:
	return _target_alive(t) and _player.position.distance_to(t.position) <= rng

## VFX do golpe melee por tipo de arma (slash p/ espada/adaga, thrust p/ lança) — só apresentação.
## Nasce NA FRENTE do Errante e na ALTURA DO CORPO (não nos pés): body lift -18 + avanço por arma
## (lança avança mais que espada; adaga menos). Alpha levemente < 1 p/ não ficar brusco.
func _melee_vfx(aim: Vector2) -> void:
	if _region_node == null or _player == null:
		return
	var wt := GameState.current_weapon_type()
	var base := "thrust_line" if wt == "spear" else "slash_arc"
	var sc := 0.72 if wt == "dagger" else 1.0           # adaga = corte menor (mapping)
	var fwd := 56.0 if wt == "spear" else (32.0 if wt == "dagger" else 40.0)   # lança avança mais
	var at: Vector2 = aim if aim.length() > 0.01 else _player.call("get_facing")
	var origin: Vector2 = _player.position + VFX_BODY_LIFT + at.normalized() * fwd
	CombatVfx.spawn_directional(_region_node, base, origin, at, sc, 22.0, Color(1, 1, 1, 0.92))

## Ataque à distância (arco=físico, cajado=arcano): auto-mira no inimigo mais próximo no alcance;
## sem alvo, dispara na direção que o Errante encara. Spawna um Projectile que aplica o dano ao tocar.
func _attack_ranged(wtype: String, target = null) -> void:
	# RECURSO DE CLASSE (GODOT-CLASS-RESOURCES-MVP-1): arco gasta flecha, cajado gasta mana. Checa ANTES de
	# tocar cooldown/projétil → falhar NÃO pune (cd preservado, sem disparo). Feedback curto (throttled).
	if wtype == "bow" and not GameState.can_spend_arrow():
		_warn_resource("Sem flechas")
		return
	if wtype == "staff" and not GameState.can_spend_mana(STAFF_MANA_COST):
		_warn_resource("Mana insuficiente")
		return
	if wtype == "book" and not GameState.can_spend_mana(BOOK_MANA_COST):
		_warn_resource("Mana insuficiente")
		return
	var rng := BOW_RANGE if wtype == "bow" else (BOOK_RANGE if wtype == "book" else STAFF_RANGE)
	var cd := BOW_COOLDOWN if wtype == "bow" else (BOOK_COOLDOWN if wtype == "book" else STAFF_COOLDOWN)
	# alvo travado (se vivo no alcance) tem prioridade; senão auto-mira no mais próximo (como hoje)
	if not (_target_alive(target) and _player.position.distance_to(target.position) <= rng):
		target = _nearest_enemy_in_range(rng)
	var aim: Vector2
	if target != null:
		aim = (target.position - _player.position).normalized()
	else:
		aim = _player.call("get_facing")
		if aim.length() < 0.01:
			aim = Vector2.DOWN
	var dmg: int
	var color: Color
	var pspeed: float
	# CombatMath (A1.5): fonte central por arquétipo (arco=ranged 8-13, cajado=magic 8-13, livro=support 5-9).
	# Equivalente 1:1 às fórmulas anteriores (mesma base + mesma pilha de bônus).
	if wtype == "bow":
		dmg = CombatMath.player_roll("ranged")   # físico + proficiência + MAESTRIA DE PRECISÃO (só arco, capada)
		color = Color("ecdfa6")
		pspeed = ARROW_SPEED
	elif wtype == "book":
		# PÁGINA CORTANTE (GODOT-ORACLE-WEAPON-BOOK-1): arcano de SUPORTE, dano MENOR que o cajado (5-9 vs
		# 8-13), escala só com magia + proficiência de Oráculo (capada). Oráculo mata mais devagar.
		dmg = CombatMath.player_roll("support")
		color = Color("b78cff")   # violeta-presságio (distinto do ciano do cajado)
		pspeed = ARCANE_SPEED
	else:
		dmg = CombatMath.player_roll("magic")   # arcano + proficiência + MAESTRIA ARCANA (só cajado, capada)
		color = Color("6fe0ff")
		pspeed = ARCANE_SPEED
	_attack_cd = cd
	# consome o recurso NO DISPARO (flecha gasta mesmo se errar = munição física; mana no lançamento)
	if wtype == "bow":
		GameState.spend_arrow()
	elif wtype == "book":
		GameState.spend_mana(BOOK_MANA_COST)
	else:
		GameState.spend_mana(STAFF_MANA_COST)
	_player.call("attack", aim)
	# VFX de disparo na boca de saída (altura da mão/arco): arco = trilha de flecha seguindo a mira;
	# cajado = bolt azul rotacionado p/ a mira. Nascem à frente do Errante, não nos pés.
	var muzzle: Vector2 = _player.position + VFX_BODY_LIFT + aim * 36.0
	if wtype == "bow":
		CombatVfx.spawn_directional(_region_node, "arrow_trail", muzzle, aim, 1.0, 22.0, Color(1, 1, 1, 0.95))
	elif wtype == "book":
		CombatVfx.spawn(_region_node, "projectile_magic_violet", muzzle, Vector2.RIGHT, 1.0, 22.0, Color(1, 1, 1, 0.95), aim.angle())   # Página Cortante (violeta)
	else:
		CombatVfx.spawn(_region_node, "projectile_magic_blue", muzzle, Vector2.RIGHT, 1.0, 22.0, Color(1, 1, 1, 0.95), aim.angle())
	_spawn_projectile(aim, pspeed, rng, dmg, color, wtype)

## Aviso curto de recurso esgotado (GODOT-CLASS-RESOURCES-MVP-1): texto flutuante no herói, THROTTLED
## (1.2s) p/ não spammar ao segurar [J]. Reusa _spawn_world_text (sem nó de z alto novo → z-fix intacto).
func _warn_resource(msg: String) -> void:
	if _resource_warn_cd > 0.0 or _player == null:
		return
	_resource_warn_cd = 1.2
	_spawn_world_text(_player.position, msg, Color("ffce6b"), -10.0)

## --- KIT DE SUPORTE DO ORÁCULO (GODOT-ORACLE-SUPPORT-KIT-1) ---
## Dispatcher das habilidades. SÓ com o Livro equipado (arquétipo support). Proficiência support só por
## EFEITO REAL (cura HP perdido / escudo absorve / debuff em inimigo válido).
## Dispatcher das habilidades-assinatura por arma (GODOT-MASTERY-ARCANA-SIGNATURE-1). Mantém o kit do
## Oráculo 100% intacto (delega) e adiciona a Detonação Arcana do Mago na tecla [1]. Outras classes (Precisão/
## Postura/Guarda) entram aqui em checkpoints futuros.
func _signature_ability(keycode: int) -> void:
	if GameState.is_hero_defeated() or _player == null:
		return
	match GameState.current_combat_archetype():
		"support":
			_oracle_ability(keycode)   # comportamento do Oráculo inalterado
		"magic":
			if keycode == KEY_1:
				_arcana_detonation()   # Mago / Maestria Arcana
		"ranged":
			if keycode == KEY_1:
				_precision_true_shot()   # Arqueiro / Maestria de Precisão
		"reach":
			if keycode == KEY_1:
				_stance_piercing_thrust()   # Lanceiro / Maestria de Postura
		"melee":
			if keycode == KEY_1:
				_guard_battle_cry()   # Guerreiro / Maestria de Guarda (exige escudo, checado dentro)

## Detonação Arcana (Maestria Arcana): AoE PEQUENA no alvo/inimigo próximo. Ativa, custa mana + cooldown,
## gate Nv2+ da maestria. Dano moderado por alvo (faixa do golpe base + magic + arcane_damage_bonus). NÃO
## toca flechas/Oráculo/boss spell/ranged mobs. Reusa _nearest_enemy_in_range/_mobs/_juice_hit/CombatVfx.
func _arcana_detonation() -> void:
	if GameState.mastery_level("arcane") < ARCANA_SIG_MIN_LEVEL:
		_warn_resource("Requer Maestria Arcana Nv %d" % ARCANA_SIG_MIN_LEVEL)
		return
	if float(_ability_cd["arcana"]) > 0.0:
		return   # em recarga
	var target = _nearest_enemy_in_range(STAFF_RANGE)
	if target == null:
		_warn_resource("Sem alvo no alcance")   # não gasta mana
		return
	if not GameState.can_spend_mana(ARCANA_SIG_MANA):
		_warn_resource("Mana insuficiente")     # não gasta nada
		return
	GameState.spend_mana(ARCANA_SIG_MANA)
	_ability_cd["arcana"] = ARCANA_SIG_CD
	var center: Vector2 = target.position
	var bonus := GameState.arcane_damage_bonus()   # +Maestria Arcana (capada), só com cajado
	# AoE pequena: mobs comuns dentro do raio do alvo
	for m in _mobs:
		if is_instance_valid(m) and m.is_alive() and _entity_floor(m) == _floor_level and m.position.distance_to(center) <= ARCANA_SIG_RADIUS:   # VERTICALITY F2: AoE só no andar atual
			var d := CombatMath.rolled_damage(ARCANA_SIG_DMG_MIN, ARCANA_SIG_DMG_MAX, GameState.magic_bonus() + bonus)   # A1.5: fonte central
			m.take_damage(d)
			if m == target:
				_juice_hit(m, d, Color("8fbaff"), true)   # alvo principal: suco completo + sobe Maestria Arcana
			elif _region_node != null:
				CombatVfx.spawn(_region_node, "impact_blue_magic", m.position, Vector2.RIGHT, 0.8, 20.0, Color("8fbaff"))
	# boss (se dentro do raio) — mesmo tratamento, sem tocar a spell do boss
	if _current_boss != null and _current_boss.is_alive() and _current_boss.position.distance_to(center) <= ARCANA_SIG_RADIUS:
		var db := CombatMath.rolled_damage(ARCANA_SIG_DMG_MIN, ARCANA_SIG_DMG_MAX, GameState.magic_bonus() + bonus)   # A1.5: fonte central
		_current_boss.take_damage(db)
		if _current_boss == target:
			_juice_hit(_current_boss, db, Color("8fbaff"), true)
		elif _region_node != null:
			CombatVfx.spawn(_region_node, "impact_blue_magic", _current_boss.position, Vector2.RIGHT, 0.8, 20.0, Color("8fbaff"))
	# estouro central (sempre) + rótulo
	if _region_node != null:
		CombatVfx.spawn(_region_node, "impact_blue_magic", center, Vector2.RIGHT, 1.3, 18.0, Color("a9c8ff"))
	_spawn_world_text(center, "Detonação Arcana", Color("8fbaff"), -14.0)
	# (a Maestria Arcana sobe via _juice_hit no alvo principal — magic → gain_mastery("arcane",1); sem duplicar)

## Tiro Certeiro (Maestria de Precisão): 1 flecha FORTE (alvo único) ~2× a base do tiro normal. Ativa, custa
## 2 flechas + cooldown, gate Nv2+. Reusa o mesmo Projectile do arco (dano aplicado no impacto + _juice_hit
## ranged → sobe a Maestria de Precisão, sem duplicar). NÃO toca arco normal/Arcana/Oráculo/boss-spell.
func _precision_true_shot() -> void:
	if GameState.mastery_level("precision") < PRECISION_SIG_MIN_LEVEL:
		_warn_resource("Requer Maestria de Precisão Nv %d" % PRECISION_SIG_MIN_LEVEL)
		return
	if float(_ability_cd["precision"]) > 0.0:
		return   # em recarga
	if GameState.arrows_current < PRECISION_SIG_ARROWS:
		_warn_resource("Flechas insuficientes")   # não dispara
		return
	var target = _nearest_enemy_in_range(BOW_RANGE)
	if target == null:
		_warn_resource("Sem alvo no alcance")      # não gasta flecha
		return
	var aim: Vector2 = (target.position - _player.position).normalized()
	# consome 2 flechas + cooldown
	GameState.spend_arrow()
	GameState.spend_arrow()
	_ability_cd["precision"] = PRECISION_SIG_CD
	var dmg := CombatMath.rolled_damage(PRECISION_SIG_DMG_MIN, PRECISION_SIG_DMG_MAX, CombatMath.player_flat_bonus("ranged"))   # A1.5: mesma pilha do arco
	_player.call("attack", aim)
	# VFX: trilha de flecha MAIOR/dourada (reusa arrow_trail; sem asset novo) + projétil forte
	var muzzle: Vector2 = _player.position + VFX_BODY_LIFT + aim * 36.0
	if _region_node != null:
		CombatVfx.spawn_directional(_region_node, "arrow_trail", muzzle, aim, 1.35, 22.0, Color("fff0b0"))
	_spawn_projectile(aim, ARROW_SPEED, BOW_RANGE, dmg, Color("ffe9a0"), "bow")
	_spawn_world_text(_player.position, "Tiro Certeiro", Color("ffe9a0"), -14.0)
	# (a Maestria de Precisão sobe via _juice_hit no impacto — ranged → gain_mastery("precision",1); sem duplicar)

## Estocada Perfurante (Maestria de Postura): estocada de ALCANCE em LINHA FINA (perfura alinhados na
## frente), SEM dash/movimento. Ativa, sem recurso (só cooldown), gate Nv2+. Dano ~1.8× o golpe normal de
## lança. Reusa thrust_line + _juice_hit (reach + alcance ideal → sobe a Maestria de Postura, sem duplicar).
## NÃO toca Arcana/Precisão/Oráculo nem o ataque normal da lança.
func _stance_piercing_thrust() -> void:
	if GameState.mastery_level("stance") < STANCE_SIG_MIN_LEVEL:
		_warn_resource("Requer Maestria de Postura Nv %d" % STANCE_SIG_MIN_LEVEL)
		return
	if float(_ability_cd["stance"]) > 0.0:
		return   # em recarga
	var primary = _nearest_enemy_in_range(STANCE_SIG_RANGE)
	if primary == null:
		_warn_resource("Sem alvo no alcance")
		return
	_ability_cd["stance"] = STANCE_SIG_CD
	var aim: Vector2 = (primary.position - _player.position).normalized()
	if aim.length() < 0.01:
		aim = Vector2.RIGHT
	_player.call("attack", aim)
	# VFX: estocada direcional (reusa thrust_line, maior/dourada; sem asset novo)
	if _region_node != null:
		var origin: Vector2 = _player.position + VFX_BODY_LIFT + aim * 56.0
		CombatVfx.spawn_directional(_region_node, "thrust_line", origin, aim, 1.4, 22.0, Color("ffe6b0"))
	# PERFURA: alvo principal + inimigos ALINHADOS à frente, dentro da linha fina (não é AoE ampla)
	var enemies: Array = []
	for m in _mobs:
		if is_instance_valid(m) and m.is_alive() and _entity_floor(m) == _floor_level:   # VERTICALITY F2: AoE/linha só no andar atual
			enemies.append(m)
	if _current_boss != null and _current_boss.is_alive() and _entity_floor(_current_boss) == _floor_level:
		enemies.append(_current_boss)
	for e in enemies:
		var to_e: Vector2 = e.position - _player.position
		var along := to_e.dot(aim)
		if along <= 0.0 or along > STANCE_SIG_RANGE:
			continue   # atrás do Errante ou fora do alcance
		var perp := (to_e - aim * along).length()
		if perp > STANCE_SIG_WIDTH:
			continue   # fora da linha da estocada
		var d := CombatMath.rolled_damage(STANCE_SIG_DMG_MIN, STANCE_SIG_DMG_MAX, CombatMath.player_flat_bonus("reach"))   # A1.5: mesma pilha da lança
		e.take_damage(d)
		if e == primary:
			_juice_hit(e, d, Color("ffe6b0"))   # alvo principal: suco completo + sobe Maestria de Postura
		elif _region_node != null:
			CombatVfx.spawn(_region_node, "impact_small_physical", e.position)
	_spawn_world_text(_player.position, "Estocada Perfurante", Color("ffe6b0"), -14.0)
	# (a Maestria de Postura sobe via _juice_hit no alvo principal — reach + alcance ideal; sem ganho duplicado)

## Brado de Guarda (Maestria de Guarda): controle DEFENSIVO — empurra inimigos próximos + buff curto de
## redução de dano. SEM dano, SEM recurso (só cooldown). Exige melee + ESCUDO (mesma regra da maestria).
## A mitigação transiente é aplicada em _on_enemy_attack enquanto _guard_dr_t > 0 (NÃO toca a fórmula
## permanente de defesa nem o save). Ativa mesmo sem inimigos por perto (o buff vale; aviso limpo).
func _guard_battle_cry() -> void:
	if GameState.mastery_level("guard") < GUARD_SIG_MIN_LEVEL:
		_warn_resource("Requer Maestria de Guarda Nv %d" % GUARD_SIG_MIN_LEVEL)
		return
	if not GameState.has_defensive_offhand():
		_warn_resource("Requer escudo equipado")
		return
	if float(_ability_cd["guard"]) > 0.0:
		return   # em recarga
	_ability_cd["guard"] = GUARD_SIG_CD
	_guard_dr_t = GUARD_SIG_DUR   # ativa o buff defensivo transiente (lido em _on_enemy_attack)
	# EMPURRÃO (sem dano) nos inimigos no raio curto — reusa apply_knockback + faísca de impacto
	var pushed := 0
	var enemies: Array = []
	for m in _mobs:
		if is_instance_valid(m) and m.is_alive() and _entity_floor(m) == _floor_level:   # VERTICALITY F2: AoE/linha só no andar atual
			enemies.append(m)
	if _current_boss != null and _current_boss.is_alive() and _entity_floor(_current_boss) == _floor_level:
		enemies.append(_current_boss)
	for e in enemies:
		if _player.position.distance_to(e.position) <= GUARD_SIG_RADIUS:
			if e.has_method("apply_knockback"):
				e.call("apply_knockback", _player.position, GUARD_SIG_KNOCKBACK)
			if _region_node != null:
				CombatVfx.spawn(_region_node, "impact_small_physical", e.position)
			pushed += 1
	# pulso defensivo no Errante (reusa _spawn_impact, tom bronze) + rótulo
	_spawn_impact(_player.position, Color("ffd9a0"))
	_spawn_world_text(_player.position, "Brado de Guarda", Color("ffd9a0"), -14.0)
	if pushed == 0:
		_warn_resource("Guarda erguida")   # sem inimigos por perto: o buff vale, aviso limpo
	GameState.gain_mastery("guard", 1)   # uso bem-sucedido (gatilho distinto do dano-recebido; sem duplicar)

func _oracle_ability(keycode: int) -> void:
	if GameState.is_hero_defeated() or _player == null:
		return
	if GameState.current_combat_archetype() != "support":
		return   # habilidades de Oráculo só com o Livro de Presságios
	match keycode:
		KEY_1: _oracle_heal()
		KEY_2: _oracle_shield()
		KEY_3: _oracle_omen()

## Remendo de Memória: cura PEQUENA real. Não cura com HP cheio (sem gastar mana). Proficiência só se curou >0.
func _oracle_heal() -> void:
	if float(_ability_cd["heal"]) > 0.0:
		return
	if GameState.hero_hp >= GameState.max_hp_total():
		_warn_resource("HP cheio")   # não gasta mana
		return
	if not GameState.can_spend_mana(ORACLE_HEAL_MANA):
		_warn_resource("Mana insuficiente")
		return
	GameState.spend_mana(ORACLE_HEAL_MANA)
	_ability_cd["heal"] = ORACLE_HEAL_CD
	var before := GameState.hero_hp
	# base pequena/capada + MAESTRIA DE PRESSÁGIO (GODOT-ORACLE-PRESAGE-MASTERY-MVP-1): +3 HP por nível de
	# maestria (capado). SÓ afeta o kit do Oráculo (cura), nunca o dano do cajado/Mago.
	var amt := mini(40, maxi(20, int(round(float(GameState.max_hp_total()) * 0.22)))) + GameState.mastery_bonus("presage") * 3
	GameState.heal_hero(amt)
	var healed := GameState.hero_hp - before
	_heal_vfx()
	_spawn_world_text(_player.position, "Remendo +%d" % healed, Color("9fe0a0"), -10.0)
	if healed > 0:
		GameState.gain_proficiency("support", 1)   # EFEITO REAL: recuperou HP perdido
		GameState.gain_mastery("presage", 1)        # maestria exclusiva (só por cura real)

## Página de Guarda: escudo pequeno e curto. Proficiência só quando ABSORVER (em _on_enemy_attack).
func _oracle_shield() -> void:
	if float(_ability_cd["shield"]) > 0.0:
		return
	if not GameState.can_spend_mana(ORACLE_SHIELD_MANA):
		_warn_resource("Mana insuficiente")
		return
	GameState.spend_mana(ORACLE_SHIELD_MANA)
	_ability_cd["shield"] = ORACLE_SHIELD_CD
	# absorção base + MAESTRIA DE PRESSÁGIO: +3 de absorção por nível (capado). Só o escudo do Oráculo.
	var shield_amt := ORACLE_SHIELD_AMOUNT + GameState.mastery_bonus("presage") * 3
	GameState.activate_shield(shield_amt, ORACLE_SHIELD_DUR)   # renova, não stacka
	_spawn_world_text(_player.position, "Página de Guarda", Color("b78cff"), -10.0)

## Presságio Frágil: debuff leve (-10% dano) no inimigo mais próximo no alcance. Não stacka (renova). Sobe
## proficiência só se aplicado em inimigo VÁLIDO.
func _oracle_omen() -> void:
	if float(_ability_cd["omen"]) > 0.0:
		return
	var target = _nearest_enemy_in_range(BOOK_RANGE)
	if target == null:
		_warn_resource("Alvo inválido")   # não gasta mana
		return
	if not GameState.can_spend_mana(ORACLE_OMEN_MANA):
		_warn_resource("Mana insuficiente")
		return
	GameState.spend_mana(ORACLE_OMEN_MANA)
	_ability_cd["omen"] = ORACLE_OMEN_CD
	# duração base + MAESTRIA DE PRESSÁGIO: +0.5s por nível (capado). Efeito (-10%) fixo no MVP.
	var omen_dur := ORACLE_OMEN_DUR + float(GameState.mastery_bonus("presage")) * 0.5
	_weaken[target] = {"mult": ORACLE_OMEN_MULT, "t": omen_dur}   # refresh → sem stack infinito
	_spawn_world_text(target.position, "Presságio Frágil", Color("c89bff"), -12.0)
	if _region_node != null:
		CombatVfx.spawn(_region_node, "impact_blue_magic", target.position, Vector2.RIGHT, 0.7, 20.0, Color("c89bff"))
	GameState.gain_proficiency("support", 1)   # EFEITO REAL: debuff em inimigo válido
	GameState.gain_mastery("presage", 1)        # maestria exclusiva (só em alvo válido)

func _spawn_projectile(dir: Vector2, speed: float, max_dist: float, damage: int, color: Color, kind: String) -> void:
	if _region_node == null or _player == null:
		return
	var enemies: Array = []
	for m in _mobs:
		if is_instance_valid(m):
			enemies.append(m)
	if _current_boss != null and is_instance_valid(_current_boss):
		enemies.append(_current_boss)
	var proj = load("res://scripts/Projectile.gd").new()
	_region_node.add_child(proj)
	proj.position = _player.position + dir * 30.0   # sai logo à frente do herói
	proj.call("setup", dir, speed, max_dist, damage, color, enemies, kind)
	proj.set("_main", self)   # p/ o projétil chamar _juice_hit no impacto (game-feel)

func _nearest_mob_in_range(rng: float = ATTACK_RANGE):
	var best = null
	var best_d := rng
	for m in _mobs:
		if is_instance_valid(m) and m.is_alive() and _entity_floor(m) == _floor_level:   # VERTICALITY F2: só alveja mob do MESMO andar
			var d: float = _player.position.distance_to(m.position)
			if d <= best_d:
				best_d = d
				best = m
	return best

## Inimigo VIVO mais próximo (mob comum OU boss) dentro de `rng` — alvo do auto-mira à distância.
func _nearest_enemy_in_range(rng: float):
	var best = _nearest_mob_in_range(rng)
	var best_d := _player.position.distance_to(best.position) if best != null else rng
	if _current_boss != null and _current_boss.is_alive() and _entity_floor(_current_boss) == _floor_level:   # VERTICALITY F2: boss same-level
		var db: float = _player.position.distance_to(_current_boss.position)
		if db <= best_d:
			best = _current_boss
	return best

